{"spans": [{"label": "QUOTE", "head": "གདམས་མཛོད་སྤྲུལ་པའི་གླེགས་བམ་", "tail": "དལ་རྟེན་སྙིང་པོར་བྱས་པ་ཡིན་ནོ། །"}, {"label": "QUOTE", "head": "ཡོན་ཏན་ལྡན་ན་སྐྱེ་བོ་ཀུན། །\n", "tail": "བུང་བ་སྤྲིན་གྱི་ཚོགས་བཞིན་འཁོར་། །"}, {"label": "QUOTE", "head": "སྐུ་དང་ཡེ་ཤེས་འཇུག་ལུགས་ནི། །", "tail": "འཚང་རྒྱ་བ་ལ་ཐེ་ཚོམ་མེ། །"}, {"label": "QUOTE", "head": "བྱང་ཆུབ་སེམས་ལ་རིང་བསྲེལ་འཛག །", "tail": "ཐུགས་དང་ལྗགས་ནི་འབྱུང་བ་ཡིན། །"}, {"label": "QUOTE", "head": "ཕྱིར་མི་ལྡོག་པའི་རྟགས་སུ་ནི། །", "tail": "སྒྲ་དང་ས་གཡོ་མེ་ཏོག་འབབ། །"}, {"label": "QUOTE", "head": "འཇིག་རྟེན་པ་ཡི་ཡང་དག་ལྟ། །", "tail": "ངན་འགྲོར་འགྲོ་བར་མི་འགྱུར་རོ། །"}, {"label": "QUOTE", "head": "ལྷ་དང་བཅས་པའི་འཇིག་རྟེན་ན། །", "tail": "དངོས་པོ་ཀུན་གྱིས་དེ་ལ་མཆོད། །"}, {"label": "QUOTE", "head": "བཞུགས་པའི་ཚེ་ན་གང་གིས་མཆོད། །", "tail": "བསོད་ནམས་ལ་ནི་ཁྱད་པར་མེད། །"}, {"label": "QUOTE", "head": "དེ་བཞིན་གཤེགས་པའི་ཐབས་ལ་མཁས་པ་དང་", "tail": "དེས་ནི་མྱུར་དུ་བྱང་ཆུབ་མཆོག་རྟོགས་འགྱུར། །"}, {"label": "QUOTE", "head": "བཅོམ་ལྡན་འདས་ལ་དགེ་སློང་རྣམས་ཀྱིས།", "tail": "ཕན་ཡོན་ལྔ་པ་ཡིན་ནོ། །"}, {"label": "QUOTE", "head": "བཅོམ་ལྡན་འདས་ཀྱིས་ཀུན་དགའ་བོ་ལ་བཀའ་སྩལ་པ། ཀུན་དགའ་བོ་", "tail": "ཡོན་ཏན་དཔག་ཏུ་མེད་པ་དང་ལྡན་པའི་ཕྱིར་རོ། །"}, {"label": "QUOTE", "head": "བཅོམ་ལྡན་འདས་ཀྱིས་བྱང་ཆུབ་སེམས་དཔའ་བློ་གྲོས་", "tail": "དེས་ནི་མྱུར་དུ་བྱང་ཆུབ་མཆོག་རྟོགས་འགྱུར། །"}, {"label": "QUOTE", "head": "བྱང་ཆུབ་སེམས་དཔའ་སེམས་དཔའ་ཆེན་པོ་མི་ཡི་དབང་པོ་", "tail": "མངོན་པར་བརྩོན་པར་བྱེད་པ་ཡིན་ནོ། །"}, {"label": "QUOTE", "head": "བཅོམ་ལྡན་འདས་རྒྱལ་བྱེད་ཀྱི་ཚལ་ན་", "tail": "རྣམ་པ་སུམ་ཅུ་རྩ་བདུན་པོ་དེ་དག་སྦྱིན་ནོ། །"}, {"label": "QUOTE", "head": "བཅོམ་ལྡན་འདས་ཀྱིས་དགེ་སློང་རྣམས་ལ་", "tail": "འབྲས་བུ་རྣམ་པར་སྨིན་པ་འདི་ལ་འདོད་པར་བྱའོ། །"}, {"label": "QUOTE", "head": "དགའ་བོས་གསོལ་པ། བཅོམ་ལྡན་འདས་", "tail": "དགའ་བོ་ཁྱོད་ཀྱིས་རབ་ཏུ་བྱུང༌། །"}, {"label": "QUOTE", "head": "ཚུལ་ཁྲིམས་ལྡན་པ་སངས་རྒྱས་འབྱུང་དང་ཕྲད། །", "tail": "དེ་བཞིན་ཚུལ་ཁྲིམས་ཆོས་རྣམས་བསྐྱེད་པའི་གཞི། །"}, {"label": "QUOTE", "head": "ཚུལ་ཁྲིམས་འདི་ནི་བདེ་བའི་མཆོག །\n", "tail": "མིག་གི་འབྲས་བུ་བཞིན་དུ་སྲུངས། །"}, {"label": "QUOTE", "head": "བཅོམ་ལྡན་འདས་ཀྱིས་བྲམ་ཟེ་གནས་འཇོག་", "tail": "འདོད་པ་ལ་ཡང་སྤྱད་པར་གྱིས་ཤིག་"}, {"label": "QUOTE", "head": "ལ་ལའི་ཚུལ་ཁྲིམས་བདེ་བ་སྟེ། །", "tail": "ཚུལ་ཁྲིམས་ཕྱི་ནས་དེ་ལྟ་མིན། །"}, {"label": "QUOTE", "head": "བཅོམ་ལྡན་འདས་བྱ་རྒོད་ཕུང་པོའི་རི་ལ་", "tail": "བསླབ་གཞིའི་ཆོས་ནི་རབ་ཏུ་བསྟན་པ་ཡིན། །"}, {"label": "QUOTE", "head": "བཅོམ་ལྡན་འདས་ཀྱིས་བཀའ་སྩལ་པ། ཀུན་དགའ་བོ་གང་ལ་ལ་", "tail": "ཐོབ་པར་བྱེད་པ་ཡིན་ནོ། །"}, {"label": "QUOTE", "head": "སྐྱབས་སུ་སོང་བའི་བསོད་ནམས་གང༌། །", "tail": "དེ་ནི་དེ་བས་ལྷག་པར་འགྱུར། །"}, {"label": "QUOTE", "head": "མི་གང་གསུམ་ལ་སྐྱབས་འགྲོ་བ། །", "tail": "ཆོས་དང་དགེ་འདུན་ཐོབ་པར་འགྱུར། །"}, {"label": "QUOTE", "head": "སྐྱེས་བུ་གང་ཞིག་བྱང་ཆུབ་སེམས། །", "tail": "རྒྱལ་བ་ཡིས་ཀྱང་བགྲང་མི་སྤྱོད། །"}, {"label": "QUOTE", "head": "བྱང་ཆུབ་སེམས་ཀྱི་བསོད་ནམས་གང༌། །", "tail": "དེ་བས་ཀྱང་ནི་ལྷག་པར་འགྱུར། །"}, {"label": "QUOTE", "head": "ཚངས་སྤྱོད་ལེགས་པར་སྤྱོད་པ་དང༌། །", "tail": "འབར་བའི་ཁྱིམ་ནས་ཐར་པ་བཞིན། །"}, {"label": "QUOTE", "head": "དགེ་བ་དང་ནི་སྡིག་པའི་ཆོས། །\n", "tail": "ཚེ་འདི་ཉིད་ལ་མྱ་ངན་འདའ། །"}, {"label": "QUOTE", "head": "བཅོམ་ལྡན་འདས་ཀྱིས་བྱང་ཆུབ་སེམས་དཔའ་རྒྱལ་བའི་བློ་གྲོས་", "tail": "དཀོན་མཆོག་ལ་མཆོད་པར་བྱའོ། །"}, {"label": "QUOTE", "head": "སྲོག་གཅོད་པ་ལས་ཕྱིར་ལྡོག་ཅིང༌། །", "tail": "སྐྱེ་བོ་དེ་དག་མཐོ་རིས་འགྲོ། །"}, {"label": "QUOTE", "head": "བཅོམ་ལྡན་འདས་རྒྱལ་བྱེད་ཀྱི་ཚལ་ན་བཞུགས་པའི་ཚེ་དགེ་སློང་", "tail": "མངོན་པར་བསྒྲུབ་པར་མི་བྱའོ། །"}, {"label": "QUOTE", "head": "སྟོན་པ་སེར་སྐྱའི་གྲོང་དུ་གཤེགས་པའི་ཚེ་", "tail": "དེ་ལྟར་མཁྱེན་པར་མཛོད་ཅིག"}, {"label": "QUOTE", "head": "བཅོམ་ལྡན་འདས་ཀུ་ཤའི་གྲོང་ཁྱེར་ན་", "tail": "མྱ་ངན་ལས་འདས་པ་ནི་ཞི་བའོ་སྙམ་པའི་འདུ་ཤེས་མངོན་དུ་བྱའོ། །"}, {"label": "QUOTE", "head": "ཆོས་རྣམས་རང་བཞིན་རྣམ་དག་པས། །", "tail": "སངས་རྒྱས་གཞན་དུ་མ་ཚོལ་ཅིག །"}, {"label": "QUOTE", "head": "ཅི་འདྲ་བ་ཡི་ལས་བྱས་པ། །", "tail": "དེ་ནི་ཅུང་ཟད་འགྱུར་བ་མེད། །"}, {"label": "QUOTE", "head": "དགེ་བ་ཡིས་ནི་བདེ་བ་ཐོབ། །", "tail": "ལས་ཀྱི་འབྲས་བུ་གསལ་བར་སྟོན། །"}, {"label": "QUOTE", "head": "ས་བོན་ཚ་བ་རྣམས་ལས་ནི། །", "tail": "གཞན་དག་ལ་ཡང་ཡི་རང་བྱ། །"}, {"label": "QUOTE", "head": "སྡིག་པ་ཅི་ཡང་མི་བྱ་སྟེ། །", "tail": "དགེ་བས་བརྟན་པ་གང་བར་འགྱུར། །"}, {"label": "QUOTE", "head": "བདག་གི་ཕྱིར་དང་གཞན་གྱི་ཕྱིར་དག་ཏུ། །", "tail": "རྣམ་དག་མིག་གིས་མི་མཐོང་མི་སྲིད་དོ། །"}, {"label": "QUOTE", "head": "གདུགས་དང་རྒྱལ་མཚན་བ་དན་དང༌། །", "tail": "ང་ཡི་བསྟན་ལ་ལྷགས་པ་ཡིན། །"}, {"label": "QUOTE", "head": "བཙུན་པ་ཤཱ་རིའི་བུ་དགེ་བའི་རྩ་བ་", "tail": "ཟད་ཅིང་མེད་པར་མི་འགྱུར་རོ། །"}, {"label": "QUOTE", "head": "དཔེར་ན་རྒྱ་མཚོ་ཆེན་པོར་ཆུ་གང་", "tail": "རྒྱ་ཆེར་འཕེལ་བར་འགྱུར་རོ། །"}, {"label": "QUOTE", "head": "རིགས་ཀྱི་བུ་འདི་ལ་བྱང་ཆུབ་སེམས་དཔའ་", "tail": "ཐབས་ལ་མཁས་པ་ཡིན་ནོ། །"}, {"label": "QUOTE", "head": "རྒྱལ་པོ་ཆེན་པོ་ཁྱོད་ནི་འདི་ལྟར་བྱ་བ་མང་བ།", "tail": "ཡོངས་སུ་རྫོགས་པར་འགྱུར་རོ། །"}, {"label": "QUOTE", "head": "གང་ཇི་ལྟར་དགེ་བའི་སེམས་སྐྱེས་ཤིང་", "tail": "གཏུག་པར་འགྱུར་བ་གང་ཡང་མེད་དོ། །"}, {"label": "QUOTE", "head": "ཀྱེ་མ་འདུ་བྱེད་རྣམས་མི་རྟག །", "tail": "དགེ་སློང་དག་གོ་སྐྱེ་ཤིའི་ཕ་རོལ་འགྲོ་བར་གྱིས། །"}, {"label": "QUOTE", "head": "ནད་མེད་མི་རྟག་ལང་ཚོ་རྟག་མ་ཡིན། །", "tail": "འདོད་པའི་ཡོན་ཏན་དགའ་བ་ཇི་ལྟར་སྐྱེ། །"}, {"label": "QUOTE", "head": "འཆི་བདག་འཇིགས་པ་དྲན་པ་ནི། །", "tail": "ཐམས་ཅད་རྟག་ཏུ་ཞི་བར་འགྱུར། །"}, {"label": "QUOTE", "head": "ངག་རྣམས་བསྲུང་ཞིང་ཡིད་ནི་ལེགས་བསྡམས་ཏེ། །", "tail": "དྲང་སྲོང་གསུངས་པའི་ལམ་ནི་ཐོབ་པར་འགྱུར་། །"}, {"label": "QUOTE", "head": "སངས་རྒྱས་འདྲ་བའི་སྟོན་པ་མེད། །", "tail": "དེ་ཕྱིར་གསུམ་ལ་དབུལ་བར་བྱ། །"}, {"label": "QUOTE", "head": "སངས་རྒྱས་ཡོན་ཏན་བསམ་མི་ཁྱབ། །", "tail": "རྣམ་པར་སྨིན་པའང་བསམ་མི་ཁྱབ་"}, {"label": "QUOTE", "head": "བཟང་པོ་རྒྱལ་བ་གཅིག་ལ་མཆོད་བྱེད་ན། །", "tail": "སངས་རྒྱས་རྣམས་ལ་ཐ་དད་བྱ་བའང་མེད། །"}, {"label": "QUOTE", "head": "སྐུ་གཟུགས་རྣམ་པ་མང་པོ་དེར་སྤྲུལ་", "tail": "དགེ་ལ་སྦྱོར་བའི་དོན་མཛད་དོ། །"}, {"label": "QUOTE", "head": "ང་ནི་སྙིགས་མའི་དུས་ཀྱི་ཚེ། །", "tail": "དེ་ཚེ་ང་ལ་གུས་པ་གྱིས། །"}, {"label": "QUOTE", "head": "ཡུམ་ཆེན་མོ་ནི་གཎྜིའི་གཟུགས་", "tail": "གཟུགས་ཀྱིས་བཞུགས་སོ། །"}, {"label": "QUOTE", "head": "མྱ་ངན་མ་བྱེད་ཀུན་དགའ་བོ། །", "tail": "ཁྱོད་ལ་སོགས་པའི་དོན་བྱེད་འགྱུར། །"}, {"label": "QUOTE", "head": "ད་ལྟར་ང་ལ་མཆོད་པ་དང༌། །", "tail": "འདི་གཉིས་ཐ་དད་ཅུང་ཟད་མེད། །"}, {"label": "QUOTE", "head": "འཆག་དང་འདུག་དང་འགྲེང་དང་", "tail": "དེ་ནི་རྒྱ་ཆེན་མྱ་ངན་འདའ་བར་འགྱུར། །"}, {"label": "QUOTE", "head": "ཆོས་རྣམས་ཐམས་ཅད་རྐྱེན་ཡིན་ཏེ། །", "tail": "འདུན་པའི་རྩེ་ལ་རབ་ཏུ་གནས། །"}, {"label": "QUOTE", "head": "ངས་སྔོན་སེམས་ཅན་ཞིང་དང་ནི། །", "tail": "ལོ་ཏོག་ཕུན་སུམ་ཚོགས་པར་འཐོབ། །"}, {"label": "QUOTE", "head": "བྱེ་བ་ཁྲག་ཁྲིག་གཏམས་པའི་ཞིང་", "tail": "བྱམས་པའི་སེམས་ལ་གྲངས་དང་ཆར་མི་ཕོད། །"}, {"label": "QUOTE", "head": "གང་ཞིག་སེམས་ཅན་རྣམས་ལ་", "tail": "བསྟན་པ་གཅེས་པར་རབ་ཏུ་བཟུང༌། །"}, {"label": "QUOTE", "head": "འཚེ་བའི་བདག་ཉིད་ཅན་དང་གཞན་ལ་", "tail": "གནོད་བྱེད་དེ་ནི་ང་ལ་ཇི་ལྟར་མོས། །"}, {"label": "QUOTE", "head": "རྫོགས་པའི་བྱང་ཆུབ་སེམས་དང་", "tail": "འདི་དག་མཐའ་ནི་རྒྱལ་བས་མི་གསུང་ངོ༌། །"}, {"label": "QUOTE", "head": "གང་དག་ང་ཡི་བསྟན་པ་ལ། །", "tail": "ལོངས་སྤྱོད་ཆེ་ཞིང་ནོར་ཡང་མང༌། །"}, {"label": "QUOTE", "head": "བསྐལ་པ་བྱེ་བ་གང་གཱའི་བྱེ་སྙེད་དུ། །", "tail": "དེ་ནི་དེ་ལས་བསོད་ནམས་ཁྱད་པར་འཕགས། །"}, {"label": "QUOTE", "head": "ཐང་ཅིག་བསམ་གཏན་ཐུན་ཞུགས་ན། །", "tail": "སྲོག་སྦྱིན་པས་ནི་འདི་དོན་ཆེ། །"}, {"label": "QUOTE", "head": "དམ་ཆོས་བཤད་པའི་དུས་བསྟན་ཕྱིར། །", "tail": "ཉན་ཕྱིར་ལྷགས་པར་སྨོས་ཅི་དགོས། །"}, {"label": "QUOTE", "head": "གང་གིས་གང་གཱའི་བྱེ་སྙེད་སངས་རྒྱས་", "tail": "གཉིས་དང་གསུམ་ལ་བསམ་དུ་ག་ལ་ཡོད། །"}, {"label": "QUOTE", "head": "ཤཱ་རིའི་བུ། གང་གིས་བསྐལ་པ་གཅིག་", "tail": "འདི་གཞན་ལ་ནན་གྱིས་གདམས་པར་བྱའོ། །"}, {"label": "QUOTE", "head": "དམ་ཆོས་འཛིན་པའི་བསོད་ནམས་ནི། །", "tail": "མཐར་མི་ཕྱིན་པས་འགྱུར་བ་ལགས། །"}, {"label": "QUOTE", "head": "རྒྱལ་བ་ཡི་ནི་རྟེན་གསུམ་ལ། །", "tail": "རྫོགས་པའི་སངས་རྒྱས་ཐོབ་པར་འགྱུར། །"}, {"label": "QUOTE", "head": "ནམ་མཁའ་དག་ནི་ཚད་དག་བཟུང་བ་དང༌། །", "tail": "བག་ཡོད་མིས་ནི་བཀུར་སྟིས་མཆོད་པར་གྱིས། །"}, {"label": "QUOTE", "head": "ཕྱི་མའི་དུས་དམ་པའི་ཆོས་ཟད་པར་", "tail": "ཡོངས་སུ་མྱ་ངན་ལས་འདའ་བར་འགྱུར་རོ། །"}, {"label": "QUOTE", "head": "མེ་ནི་གྲང་བར་འགྱུར་ཡང་སྲིད། །", "tail": "ལས་ཀྱི་འབྲས་བུ་བསླུ་མི་སྲིད། །"}, {"label": "QUOTE", "head": "ཟླ་བ་སྐར་མ་བཅས་པ་གནས་ལྷུང་ཞིང༌། །", "tail": "ཁྱོད་ཀྱིས་མི་བདེན་པ་ཡིས་ཚིག་མི་གསུང༌། །"}, {"label": "QUOTE", "head": "སྲིད་པ་གསུམ་ན་སེམས་ཅན་ཇི་སྙེད་", "tail": "ཡོངས་སུ་བསྔོ་བས་འགྲོ་བ་ཐམས་ཅད་ཟིལ་གྱིས་གནོན། །"}, {"label": "QUOTE", "head": "ཇི་ལྟར་ཆུ་ཐིགས་རྒྱ་མཚོ་ཆེ་ནང་ལྷུང༌། །", "tail": "བྱང་ཆུབ་མ་ཟད་བར་དུ་དེ་མི་འཛད། །"}, {"label": "QUOTE", "head": "རབ་འབྱོར་བྱང་ཆུབ་སེམས་དཔའ་གང་དག་", "tail": "བསྔགས་སོ། །བསྟོད་དོ་བཀུར་རོ་"}, {"label": "QUOTE", "head": "སངས་རྒྱས་འཇིག་རྟེན་སྐྱོང་བ་", "tail": "གལ་ཏེ་ཐར་འདོད་བག་མེད་སྤོང་བར་གྱིས། །"}]}
