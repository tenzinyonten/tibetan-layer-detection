  "raw_text": "{\"spans\":[{\"label\":\"QUOTE\",\"frame\":\"ལཱུ་ཡི་པའི་ཁྱད་པར་གསལ་བྱེད་ལས།\",\"head\":\"དེ་ལ་སེམས་ཅན་ཐམས་ཅད་ལ། །\",\"tail\":\"ཐམས་ཅད་དོན་བྱེད་བཏང་སྙོམས་སོ། །\"},{\"label\":\"QUOTE\",\"frame\":\"ལཱུ་ཡི་པའི་དཀའ་འགྲེལ་སྡོམ་པ་འབྱུང་བ་ལས།\",\"head\":\"ཤྲཱི་ཧེ་རུ་ཀ་ཡི་དོན། །\",\"tail\":\"བགེགས་བསྐྲད་ཚངས་པའི་གནས་བཞི་བསྒོམ། །\"},{\"label\":\"QUOTE\",\"frame\":\"ལཱུ་ཡི་པའི་མངོན་རྟོགས་འགྲེལ་བ་ལས།\",\"head\":\"གཟུགས་ལ་རྒྱལ་བ་རྣམ་སྣང་མཛད། །\",\"tail\":\"ཐམས་ཅད་སྟོང་ཉིད་ཧེ་རུ་ཀའོ། །\"},{\"label\":\"QUOTE\",\"frame\":\"པྲཛྙཱ་རཀྵི་ཏའི་དཔའ་བོ་གཅིག་པའི་སྒྲུབ་ཐབས་ལས།\",\"head\":\"གཏི་མུག་རྣམ་པར་འཇོམས་པས་ན་གཏི་མུག་རྡོ་རྗེའོ། །\",\"tail\":\"ཐམས་ཅད་ལ་དབང་ཕྱུག་སྟེར་བས་ན་དབང་ཕྱུག་རྡོ་རྗེའོ། །\"},{\"label\":\"QUOTE\",\"frame\":\"ལཱུ་ཡི་པའི་མངོན་རྟོགས་ཀྱི་དཀའ་འགྲེལ་ལས\",\"head\":\"ངོ་བོ་ནི་རིམ་པ་ལྟར་སངས་རྒྱས་སྤྱན་མ་མཱ་མ་ཀི་\",\"tail\":\"ཆོས་ཀྱི་དབྱིངས་ཀྱི་རྡོ་རྗེ་མའི་རང་བཞིན་ཡིན་པར\"},{\"label\":\"QUOTE\",\"frame\":\"ལཱུ་ཡི་པའི་སྡོམ་པ་འབྱུང་བ་ལས།\",\"head\":\"གཏི་མུག་རྡོ་རྗེ་མིག་དག་ལ། །\",\"tail\":\"མགྲིན་པ་དཔྲལ་བ་གསང་གནས་སུ། །\"},{\"label\":\"QUOTE\",\"head\":\"ཡང་ནི་གཟུགས་ལ་སོགས་པ་རྣམས། །\",\"tail\":\"གཟུགས་བརྙན་ལ་སོགས་བཞིན་དུ་བསམ། །\"},{\"label\":\"QUOTE\",\"frame\":\"ལཱུ་ཡི་པའི་མངོན་རྟོགས་ལས།\",\"head\":\"དེ་ནས་གཡོན་པའི་མཐེབ་མཛུབ་ཀྱིས། །\",\"tail\":\"སེ་གོལ་གཏོགས་པ་སྔོན་བཏང་ནས། །\"},{\"label\":\"QUOTE\",\"frame\":\"དྲིལ་བུ་བའི་སྒྲུབ་ཐབས་ཡིད་བཞིན་ནོར་བུ་ལས།\",\"head\":\"ཧཱུྃ་གྱུར་བདེ་ཆེན་ཕྱག་གཉིས་བསམ། །\",\"tail\":\"ལུགས་མཐུན་གཡོན་མཛུབ་སེ་གོལ་གཏོགས། །\"},{\"label\":\"QUOTE\",\"frame\":\"ལཱུ་ཡི་པའི་གཞུང་ལས།\",\"head\":\"སུམྦྷ་ལ་སོགས་སྔགས་བཞི་པོ། །\",\"tail\":\"ར་བ་བཞི་པོ་དེ་བཞིན་བསམ། །\"},{\"label\":\"QUOTE\",\"frame\":\"ལཱུ་ཡི་པའི་གཞུང་ལས།\",\"head\":\"ཁ་གདོང་མ་ལ་སོགས་པ་བཞི། །\",\"tail\":\"ར་བ་རྣམ་ཀྱང་བསམ་པར་བྱ། །\"},{\"label\":\"QUOTE\",\"frame\":\"རྣལ་འབྱོར་མའི་ཀུན་སྤྱོད་ལས།\",\"head\":\"ལྷ་སྔགས་བཟློག་ཏེ་བཀོད་པ་དང༌། །\",\"tail\":\"དངོས་གྲུབ་ཐམས་ཅད་སྒྲུབ་བྱེད་པའོ། །\"},{\"label\":\"QUOTE\",\"frame\":\"ལཱུ་ཡི་པའི་གཞུང་ལས།\",\"head\":\"དེ་ནས་སྙིང་གར་ཨཾ་ལས་ཟླ་བའི་དཀྱིལ་འཁོར་ཏེ། །\",\"tail\":\"རིམ་པས་བལྟས་ཏེ་སྟོང་པ་ཉིད་བསྒོམ་གསང་སྔགས་བརྗོད། །\"},{\"label\":\"QUOTE\",\"frame\":\"རྡོ་རྗེ་མཁའ་འགྲོ་ལས།\",\"head\":\"གཟུགས་ནི་ཐམས་ཅད་སྟོང་པ་ཉིད། །\",\"tail\":\"རྣམ་པར་མི་རྟོག་པ་ཡིས་བལྟ། །\"},{\"label\":\"QUOTE\",\"frame\":\"རྒྱུད་གསེར་ཕྲེང་ལས།\",\"head\":\"ཡེ་ནས་གནས་པའི་དོན་གང་ཞིག\",\"tail\":\"མངོན་པར་ཤེས་ཕྱིར་ཡེ་ཤེས་བརྗོད། །\"},{\"label\":\"QUOTE\",\"frame\":\"མཁའ་འགྲོ་མ་གསང་བ་འབར་བའི་རྒྱུད་ལས།\",\"head\":\"གཟུང་འཛིན་རྟོག་པས་མི་ཕྱེད་ཕྱིར། །\",\"tail\":\"དོན་གྱི་རྡོ་རྗེར་བཤད་པའོ། །\"},{\"label\":\"QUOTE\",\"frame\":\"སློབ་དཔོན་ཆེན་པོ་ནཱ་གཱརཛུ་ནས།\",\"head\":\"རང་བཞིན་དག་ནི་བཅོས་མིན་ཏེ། །\",\"tail\":\"གཞན་ལ་ལྟོས་པ་མེད་པའོ། །\"},{\"label\":\"QUOTE\",\"frame\":\"དཔལ་སྡོམ་པའི་རྒྱུད་ལས།\",\"head\":\"དབང་ཕྱུག་དང་ནི་གཟུགས་བཟང་དང༌། །\",\"tail\":\"དྲུག་པོ་དེ་ལ་ལྡན་ཅེས་གསུངས། །\"},{\"label\":\"QUOTE\",\"frame\":\"རྒྱུད་དེ་ཉིད་ལས\",\"head\":\"རྡོ་རྗེ་རྭ་བའི་ཕྱི་རོལ་དུ། །\",\"tail\":\"རླུང་མཚམས་ཀཱི་ལི་ཀཱི་ལར་སྒྲོག །\"},{\"label\":\"QUOTE\",\"head\":\"ཤར་དུ་ཧ་རིའི་ཤིང་ཆེན་ལ། །\",\"tail\":\"ཤིང་ལོའི་གསེབ་ནས་སྟོད་ཕྱུང་ངོ༌། །\"},{\"label\":\"QUOTE\",\"frame\":\"རྒྱུད་ལས\",\"head\":\"ཤར་དུ་བརྒྱ་བྱིན་དཀར་པོ་ལ། །\",\"tail\":\"ཐམས་ཅད་རང་རང་རིག་མས་འཁྱུད། །\"},{\"label\":\"QUOTE\",\"head\":\"ནོར་རྒྱས་དང་ནི་འཇོག་པོ་དང༌། །\",\"tail\":\"གཡས་ཀྱི་ཕྱོགས་སུ་དགོད་པའོ། །\"},{\"label\":\"QUOTE\",\"head\":\"སྒྲ་སྒྲོག་པ་དང་རྨུགས་པ་དང༌། །\",\"tail\":\"དྲག་པོ་སྤྲིན་ཚོགས་མཚམས་ལ་དགོད། །\"},{\"label\":\"QUOTE\",\"frame\":\"རྒྱུད་ལས\",\"head\":\"སེང་གེ་ཅེ་སྤྱང་ཁྱི་སྒྲ་སྒྲོག །\",\"tail\":\"གྲུབ་ཆེན་བརྒྱད་ཀྱིས་བརྒྱན་པའོ། །\"},{\"label\":\"QUOTE\",\"head\":\"རྣམ་ཤེས་བརྒྱད་ཀྱི་དག་པ་ཡང༌། །\",\"tail\":\"སྟོན་པ་འདི་ཡི་དུར་ཁྲོད་དོ། །\"},{\"label\":\"QUOTE\",\"frame\":\"རྒྱུད་ལས\",\"head\":\"ཆོས་ཀྱི་དབྱིངས་ཀྱི་དུར་དུ་མཆི། །\",\"tail\":\"མེ་སོགས་རྟོག་པ་བྲལ་བའོ། །\"},{\"label\":\"QUOTE\",\"frame\":\"འདུས་པའི་རྒྱུད་ཕྱི་མ་ལས\",\"head\":\"དང་པོ་སྟོང་ཉིད་བྱང་ཆུབ་སྟེ། །\",\"tail\":\"ཐ་མལ་སྒྲུབ་པ་བསྙེན་པར་བྱ། །\"},{\"label\":\"QUOTE\",\"frame\":\"རྒྱུད་ལས\",\"head\":\"དཔལ་ནི་གཉིས་མེད་ཡེ་ཤེས་ཏེ། །\",\"tail\":\"དབྱེར་མེད་གཉུག་མའི་ངང་དུ་སྡོམ། །\"},{\"label\":\"QUOTE\",\"frame\":\"རྣལ་འབྱོར་མའི་ཀུན་སྤྱོད་ལས\",\"head\":\"མགུར་ཆུ་དཔུང་རྒྱན་རྣ་ཆ་དང༌། །\",\"tail\":\"ཕྱག་རྒྱ་དྲུག་གིས་རྣམ་པར་བརྒྱན། །\"},{\"label\":\"QUOTE\",\"frame\":\"གློག་གི་ཕྲེང་བ་ལས\",\"head\":\"སྒེག་པ་དཔའ་བ་མི་སྡུག་པ། །\",\"tail\":\"གར་དགུའི་ཉམས་དང་ལྡན་པའོ། །\"},{\"label\":\"QUOTE\",\"frame\":\"ཕག་མོ་མངོན་པར་འབྱུང་བའི་རྒྱུད་ལས\",\"head\":\"རྣམ་རྟོག་ཅིས་ཀྱང་མ་གོས་པས། །\",\"tail\":\"མོ་ཞེས་བྱ་བ་དབྱིངས་སུ་ཐིམ། །\"},{\"label\":\"QUOTE\",\"head\":\"དོན་དམ་སྐྱེ་མེད་ཕག་མོ་ནི། །\",\"tail\":\"རྟོག་པ་མེད་པས་སྤྲུལ་སྐུའོ། །\"},{\"label\":\"QUOTE\",\"frame\":\"ཨིནྡྲ་བྷུ་ཏིའི་རྒྱ་གཞུང་ལས\",\"head\":\"རྡོ་རྗེ་མཁའ་འགྲོ་མ་ནི་ཉེ་བའི་མཱ་མ་ཀཱི་སྟེ\",\"tail\":\"གྲི་གུག་དང་ཀ་པཱ་ལ་ཐོགས་པ་སེར་མོའོ། །\"},{\"label\":\"QUOTE\",\"frame\":\"ཨིནྡྲ་བྷུ་ཏིའི་བདེ་མཆོག་ཉུང་ངུའི་རྣམ་བཤད་ལས\",\"head\":\"མཚམས་བཞིའི་བུམ་པ་ནི། རྣམ་སྣང་དང༌། རིན་འབྱུང་དང༌།\",\"tail\":\"པདྨས་མཚན་པའི་གྲི་གུག་གི་ཕྲེང་བས་སྐོར་བ་ནི་འགྲེལ་བས་ཁ་སྐོང་བའོ། །\"},{\"label\":\"QUOTE\",\"frame\":\"དཔྱིད་ཀྱི་ཐིག་ལེ་ལས\",\"head\":\"འདབ་མ་རྣམས་ན་བཞི་པོ་ཡང༌། །\",\"tail\":\"ལུས་ཅན་སྙིང་གི་ནང་དུ་ནི། །\"},{\"label\":\"QUOTE\",\"frame\":\"བློ་དཔོན་བཱི་ར་བཛྲའི་མངོན་རྟོགས་དཀའ་འགྲེལ་དུ\",\"head\":\"རྒྱ་དང་རྒྱ་ཡི་འབུར་བཞིན་དུ་ཤེས་པར་བྱའོ\",\"tail\":\"\"},{\"label\":\"QUOTE\",\"frame\":\"ཀུན་སྤྱོད་དང་མངོན་འབྱུང་གི་རྒྱུད་ལས\",\"head\":\"མཛུབ་མོ་མདུད་བྱ་གུང་མོ་ངེས་པར་སྦྱར། །\",\"tail\":\"དཔའ་བོ་རྣལ་འབྱོར་མ་རྣམས་འགུགས། །\"},{\"label\":\"QUOTE\",\"frame\":\"ཇི་སྐད་དུ\",\"head\":\"སྙིང་ག་ནུ་མ་གཡས་དང་ནི། །\",\"tail\":\"རིམ་པར་ལག་གཉིས་པད་ཀོར་བཅས། །\"},{\"label\":\"QUOTE\",\"frame\":\"ལཱུ་ཡི་པའི་རྒྱ་གཞུང་ལས\",\"head\":\"རྐང་གཡས་གཡོན་གྱིས་མནན་ནས་ནི། །\",\"tail\":\"འཁྱུད་པའི་སྟངས་ཀྱིས་མཉེས་པར་བྱ། །\"},{\"label\":\"QUOTE\",\"frame\":\"རྡོ་རྗེ་མཁའ་འགྲོ་ལས\",\"head\":\"མཐེ་བོང་ལྕགས་ཀྱུར་བྱས་ནས་ནི། །\",\"tail\":\"ལྷ་རྣམས་ཐམས་ཅད་འགུགས་པར་བསམ། །\"},{\"label\":\"QUOTE\",\"frame\":\"རྡོ་རྗེ་རྩེ་མོ་ལས\",\"head\":\"ཨོཾ་ནི་ཅི་ཞིག་ཡིན་པར་བརྗོད། །\",\"tail\":\"ནོར་བུ་འཛིན་པའི་སྙིང་པོ་ཡིན། །\"},{\"label\":\"QUOTE\",\"frame\":\"དཔལ་དྲྭ་བ་སྡོམ་པའི་རྒྱུད་ལས\",\"head\":\"དཔལ་ནི་གཉིས་མེད་ཡེ་ཤེས་ཏེ། །\",\"tail\":\"གཉིས་མེད་བདེ་བས་མཆོད་པར་བྱ། །\"},{\"label\":\"QUOTE\",\"frame\":\"བདེ་མཆོག་ཉུང་ངུའི་བཀའ་འགྲེལ་ལས\",\"head\":\"གཉིས་སུ་མེད་པའི་ཡེ་ཤེས་ནི་ཤྲཱི་སྟེ\",\"tail\":\"དཔལ་ཕུན་སུམ་ཚོགས་པ་དང་ལྡན་པའོ། །\"},{\"label\":\"QUOTE\",\"frame\":\"རྡོ་རྗེ་རྩེ་མོ་ལས\",\"head\":\"ཧཱུྃ་གི་ཡི་གེ་ཅི་ཞིག་བརྗོད། །\",\"tail\":\"ཧཱུྃ་ཡིག་མཆོག་ཏུ་དྲན་པར་བྱ། །\"},{\"label\":\"QUOTE\",\"frame\":\"དེ་ཉིད་ལས\",\"head\":\"ཡི་གེ་ཕཊ྄་ནི་ཅི་ཡིན་བརྗོད། །\",\"tail\":\"བདེ་བ་དག་ནི་འགུགས་པར་བྱེད། །\"},{\"label\":\"QUOTE\",\"frame\":\"རྒྱུད་ལས\",\"head\":\"ཌཱ་ནི་ནམ་མཁར་འགྲོ་མ་ཞེས། །\",\"tail\":\"མཁའ་འགྲོ་མ་ཞེས་བརྡར་བཏགས་སོ། །\"},{\"label\":\"QUOTE\",\"frame\":\"བདེ་མཆོག་ཉུང་ངུའི་རྒྱུད་ལས\",\"head\":\"འདི་ནི་རང་བྱུང་བཅོམ་ལྡན་འདས། །\",\"tail\":\"མཁའ་འགྲོ་དྲྭ་བའི་སྡོམ་པ་ཡིན། །\"},{\"label\":\"QUOTE\",\"frame\":\"དགོངས་འགྲེལ་གྲུ་གཟིངས་མ་ལས\",\"head\":\"མཁའ་འགྲོ་མ་རྣམས་ནི་རྩ་སྟོང་ཕྲག་བདུན་ཅུ་དེ་རྣམས་ཀྱི་དྲྭ་བ་སྟེ་ཚོགས་སོ\",\"tail\":\"དེའི་རང་བཞིན་དུ་སྡོམ་པས་སྡོམ་པའོ། །\"},{\"label\":\"QUOTE\",\"frame\":\"བདེ་མཆོག་ཉུང་ངུའི་བཀའ་འགྲེལ་ལས\",\"head\":\"མཁའ་འགྲོ་མ་ནི་རྡོ་རྗེ་ཌཱ་ཀི་ལ་སོགས་པ་གནས་གསུམ་གྱིས་བསྡུས་པའི་མཁའ་འགྲོ་ཐམས་ཅད\",\"tail\":\"སྙིང་པོ་རྡོ་རྗེའི་གནས་སུ་སྡོམ་པ་ཉིད་དོ། །\"},{\"label\":\"QUOTE\",\"frame\":\"དཔལ་རྡོ་རྗེ་གྲུབ་པ་དྲྭ་བ་སྡོམ་པའི་རྒྱུད་ལས\",\"head\":\"དྲྭ་བ་ཞེས་བྱ་མང་པོའི་དོན། །\",\"tail\":\"ནམ་མཁའ་དང་མཚུངས་སྡོམ་པའི་དོན། །\"},{\"label\":\"QUOTE\",\"frame\":\"རྡོ་རྗེ་རྩེ་མོ་ལས\",\"head\":\"སྭཱ་ཧཱ་ཞེས་པ་ཅི་ཡིན་བརྗོད། །\",\"tail\":\"དགེ་བའི་ཚོགས་ནི་འཕེལ་བར་བྱེད། །\"},{\"label\":\"QUOTE\",\"frame\":\"ངེས་བརྗོད་བླ་མའི་དཀའ་འགྲེལ་ལས\",\"head\":\"དཔའ་བོའི་སྙིང་པོས་ནི་ཆོས་སྐུའི་ཡེ་ཤེས་སྟོན\",\"tail\":\"ཡུམ་བཞིའི་སྔགས་ཀྱིས་ནི་ཕྲིན་ལས་བཞི་མཛད་དོ\"},{\"label\":\"QUOTE\",\"frame\":\"ཁྲག་འཐུང་མངོན་པར་འབྱུང་བའི་རྒྱུད་ལས\",\"head\":\"རང་མིང་བརྗོད་པའི་སྔགས་དག་ལ། །\",\"tail\":\"ཧཱུྃ་ཧཱུྃ་ཕཊ་ཀྱིས་མཐའ་ལ་བརྒྱན། །\"},{\"label\":\"QUOTE\",\"frame\":\"ནམ་མཁའ་དང་མཉམ་པའི་རྒྱུད་ལས\",\"head\":\"སྙིང་པོ་དང་ནི་ཉེ་སྙིང་གི །\",\"tail\":\"སྡིག་པ་མ་ལུས་དག་བྱེད་ཆུ། །\"},{\"label\":\"QUOTE\",\"frame\":\"ངེས་བརྗོད་བླ་མ་ལས\",\"head\":\"གསང་སྔགས་འདི་ནི་གསང་སྔགས་ཆེ། །\",\"tail\":\"འདི་ནི་བཀླགས་པ་ཙམ་གྱིས་འགྲུབ། །\"},{\"label\":\"QUOTE\",\"frame\":\"ཀུན་སྤྱོད་ལས\",\"head\":\"གང་ཞིག་འདི་སྒོམ་རྣལ་འབྱོར་པ། །\",\"tail\":\"དེ་ཡི་བསོད་ནམས་དེས་འཐོབ་བོ། །\"},{\"label\":\"QUOTE\",\"frame\":\"ཁྲག་འཐུང་མངོན་འབྱུང་གི་རྒྱུད་ལས\",\"head\":\"དཀྱིལ་འཁོར་མཐོང་བ་ཉིད་ཀྱི་རྟེན། །\",\"tail\":\"སྡིག་པ་ཀུན་ལས་རྣམ་པར་གྲོལ། །\"},{\"label\":\"QUOTE\",\"frame\":\"ཀུན་སྤྱོད་ཀྱི་རྒྱུད་ལས\",\"head\":\"རྣལ་འབྱོར་པ་ནི་འཕོ་བའི་ཚེ། །\",\"tail\":\"རྣལ་འབྱོར་མ་ནི་ས་སྟེང་དཀོན། །\"},{\"label\":\"QUOTE\",\"frame\":\"ལཱུ་ཡི་པའི་རྒྱ་གཞུང་ལས\",\"head\":\"དཀྱིལ་འཁོར་པ་ནི་ཐམས་ཅད་ཀྱི། །\",\"tail\":\"མཁས་པས་བུམ་པའི་ལོགས་ལ་དགོད། །\"},{\"label\":\"QUOTE\",\"frame\":\"ལཱུ་ཡི་པས\",\"head\":\"རས་ནི་དཀར་པོ་མ་ཉམས་པས། །\",\"tail\":\"བུམ་པའི་མགུལ་བ་དཀྲི་བར་བྱ། །\"},{\"label\":\"QUOTE\",\"frame\":\"ལཱུ་ཡི་པས\",\"head\":\"ཆོ་ག་མཁས་པས་སྲད་བུ་ནི། །\",\"tail\":\"དཀར་པོས་རས་ཀྱི་སྟེང་ནས་འཆིང༌། །\"},{\"label\":\"QUOTE\",\"head\":\"ཨ་མྲ་ཨུ་དུམ་ཝཱ་ར་དང༌། །\",\"tail\":\"བུམ་པ་རྣམས་ཀྱི་ཁ་རྒྱན་བྱ། །\"},{\"label\":\"QUOTE\",\"frame\":\"རྒྱུད་ལས\",\"head\":\"རྩ་བ་ནག་པོ་ར་རི་མེད། །\",\"tail\":\"མཆུ་འཕྱང་མགྲིན་རིང་ལྟོ་བ་ཆེ། །\"},{\"label\":\"QUOTE\",\"head\":\"བུམ་པ་ཞབས་མེད་ལྟོ་བ་ཟླུམ\",\"tail\":\"\"},{\"label\":\"QUOTE\",\"frame\":\"ལཱུ་ཡི་པའི་རྒྱ་གཞུང་ལས\",\"head\":\"དཀྱིལ་འཁོར་པ་ནི་ཐམས་ཅད་ཀྱི། །\",\"tail\":\"མཁས་པས་བུམ་པའི་ལོགས་ལ་དགོད། །\"},{\"label\":\"QUOTE\",\"frame\":\"རྒྱུད་ལས\",\"head\":\"གུ་གུལ་དང་ནི་ཨ་ག་རུས། །\",\"tail\":\"བདུག་ཅིང་དྲི་ལྔའི་ཆུ་ཡིས་དགང༌། །\"},{\"label\":\"QUOTE\",\"frame\":\"ལཱུ་ཡི་པའི་གཞུང་ལས\",\"head\":\"རྐང་གཡས་གཡོན་གྱིས་མནན་ནས་ནི། །\",\"tail\":\"འཁྱུད་པའི་སྟངས་ཀྱིས་མཉེས་པར་བྱ། །\"},{\"label\":\"QUOTE\",\"frame\":\"དེ་བཞིན་གཤེགས་པའི་རྡོ་རྗེའི་རྒྱ་གཞུང་ལས\",\"head\":\"དུང་དང༌། འདབ་མའི་ཀོང་བུ་དང༌། ཟངས་ལ་སོགས་པ\",\"tail\":\"དེའི་མདུན་དུ་བཟེད་ཞལ་ཡང་མཉྫིའི་སྟེང་དུའོ\"},{\"label\":\"QUOTE\",\"frame\":\"རྒྱུད་ལས\",\"head\":\"རྒྱུ་ཚད་ནང་བཅུད་ཕྱ