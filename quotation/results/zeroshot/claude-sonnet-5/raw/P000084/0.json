  "raw_text": "{\"spans\":[{\"label\":\"QUOTE\",\"frame\":\"འཕགས་པ་ཏིང་ངེ་འཛིན་རྒྱལ་པོ་ལས།\",\"head\":\"སྟོན་པ་བདེ་བར་གཤེགས་པས་གསུངས་པ་ལྟར།\",\"tail\":\"ཆོས་དེ་ཐམས་ཅད་དྲང་བའི་དོན་དུ་ཤེས།\"},{\"label\":\"QUOTE\",\"frame\":\"འཕགས་པ་བློ་གྲོས་མི་ཟད་པས་བསྟན་པའི་མདོ་ལས།\",\"head\":\"ངེས་པའི་དོན་གྱི་མདོ་དེ་ནི་གང༌།\",\"tail\":\"དེ་དག་ནི་དྲང་བའི་དོན་ཞེས་བྱའོ།\"},{\"label\":\"QUOTE\",\"head\":\"མདོ་སྡེ་གང་དག་བདག་དང༌།\",\"tail\":\"དེ་དག་ནི་དྲང་བའི་དོན་ཞེས་བྱའོ།\"},{\"label\":\"QUOTE\",\"frame\":\"དབུ་མ་བསམ་གྱིས་མི་ཁྱབ་པར་བསྟོད་པ་ལས།\",\"head\":\"གང་ལ་སྐྱེ་དང་འགག་ལ་སོགས།\",\"tail\":\"དེ་ནི་དྲང་དོན་དེ་ཀུན་རྫོབ།\"},{\"label\":\"QUOTE\",\"frame\":\"བློ་གྲོས་མི་ཟད་པས་ཞུས་པ་ལས།\",\"head\":\"མདོ་སྡེ་གང་དག་འབྲས་བུ་ལ་འཇུག་པའི་ཕྱིར་བསྟན་པ།\",\"tail\":\"ནི་ངེས་པའི་དོན་ཞེས་བྱའོ།\"},{\"label\":\"QUOTE\",\"head\":\"མདོ་སྡེ་གང་དག་སྟོང་པ་ཉིད་དང༌།\",\"tail\":\"དེ་དག་ནི་ངེས་པའི་དོན་ཞེས་བྱའོ།\"},{\"label\":\"QUOTE\",\"frame\":\"བསམ་གྱིས་མི་ཁྱབ་པར་བསྟོད་པ་ལས།\",\"head\":\"ཆོས་རྣམས་ཀྱི་ནི་སྟོང་པ་ཉིད།\",\"tail\":\"ངེས་པའི་དོན་ནོ་ཞེས་ཀྱང་བསྟན།\"},{\"label\":\"QUOTE\",\"frame\":\"རྒྱུད་བླ་མར།\",\"head\":\"སེམས་ཞུམ་སེམས་ཅན་དམན་ལ་བརྙས་པ་དང༌།\",\"tail\":\"ཡོད་པ་དེ་དག་དེ་སྤོང་དོན་དུ་གསུངས།\"},{\"label\":\"QUOTE\",\"frame\":\"བློ་གྲོས་མི་ཟད་པས་བསྟན་པའི་མདོ་ལས།\",\"head\":\"མདོ་སྡེ་གང་དག་འབྲས་བུ་ལ་འཇུག་པ་དང༌།\",\"tail\":\"དེ་ལས་ཟློག་པ་དྲང་དོན་དུ་བཟུང་བར་གསུངས་ཤིང༌།\"},{\"label\":\"QUOTE\",\"frame\":\"གསང་བདག་ཕྱག་ན་རྡོ་རྗེས།\",\"head\":\"དྲང་བའི་དོན་གྱིས་ལས་ཀྱི་ཕྱག་རྒྱ་བྷ་ག་ལ་བརྗོད་དོ།\",\"tail\":\"ཆོས་ཀྱི་སྐུའི་མཚན་ཉིད་ཀྱི་སྟོང་པ་ཉིད་ཀྱི་བདག་ཉིད་ཅན་ནོ།\"},{\"label\":\"QUOTE\",\"frame\":\"ཡེ་ཤེས་སྣང་བ་རྒྱན་གྱི་མདོ་ལས།\",\"head\":\"འཇམ་དཔལ། རྨི་ལམ་ནི་སྣང་ལ་ཡོད་པ་མ་ཡིན་ནོ།\",\"tail\":\"སྤྲུལ་པའི་བར་དུ་གསུངས་སོ།\"},{\"label\":\"QUOTE\",\"frame\":\"དེ་སྐད་དུ། མདོ་སྡེ་དགོངས་པ་ངེས་པར་འགྲེལ་བ་ལས།\",\"head\":\"མཚན་ཉིད་ངོ་བོ་ཉིད་མེད་པ་ཉིད་དང༌།\",\"tail\":\"ངོ་བོ་ཉིད་མེད་པའོ་ཞེས་བསྟན་ཏོ་ཞེས་སོ།\"},{\"label\":\"QUOTE\",\"frame\":\"ཧེ་བཛྲ་ལས།\",\"head\":\"ལུས་ལ་ཡེ་ཤེས་ཆེན་པོ་གནས།\",\"tail\":\"ལུས་གནས་ལུས་ལས་མ་སྐྱེས་པའོ།\"},{\"label\":\"QUOTE\",\"frame\":\"ཧེ་བཛྲ་ལས།\",\"head\":\"ཁྱོད་ཀྱིས་སྲོག་ཆགས་གསད་པར་བྱ།\",\"tail\":\"\"},{\"label\":\"QUOTE\",\"head\":\"ཁྱོད་ཀྱིས་སྲོག་ཆགས་གསད་མི་བྱ།\",\"tail\":\"ཞེས་གསུངས་པ་ལྟ་བུའོ།\"},{\"label\":\"QUOTE\",\"frame\":\"ཆེད་དུ་བརྗོད་པའི་ཚོམས་ལས།\",\"head\":\"ཕ་དང་མ་ནི་གསད་བྱ་ཞིང༌།\",\"tail\":\"མི་དེ་དག་པ་ཉིད་དུ་འགྱུར།\"},{\"label\":\"QUOTE\",\"frame\":\"ཐེག་བསྡུས་ཀྱི་འགྲེལ་པ་བཤད་སྦྱར་ལས།\",\"head\":\"དགོངས་པ་ནི་ཡིད་ལ་རྣམ་པར་གཞག་པ་ཙམ་ཡིན་གྱི།\",\"tail\":\"ལྡེམ་པོར་དགོངས་པ་ནི་ཕ་རོལ་གཟུང་བ་ལ་ལྟོས་པའོ།\"},{\"label\":\"QUOTE\",\"frame\":\"ཀུན་མཁྱེན་དྲི་མེད་འོད་ཟེར་གྱི་ཞལ་ནས།\",\"head\":\"འགའ་ཞིག་ལ་ལྟོས་ནས་དེའི་ཆ་ལྡན་དུ་བཤད་པ་ནི།\",\"tail\":\"བརྫུན་དུའང་མ་གྱུར་ཙམ་དུ་གནས་པའི་ཕྱིར་རོ།\"},{\"label\":\"QUOTE\",\"frame\":\"མྱ་ངན་ལས་འདས་པ་ཆེན་པོའི་མདོ་ལས།\",\"head\":\"དགེ་སློང་རྣམས་ནི་ཆོས་རྣམ་པ་བཞི་པོ་ལ་གནས་པར་བགྱིའོ།\",\"tail\":\"སྐྱེས་བུ་རྣམ་པ་བཞི་ནི་མ་ལགས་སོ།\"},{\"label\":\"QUOTE\",\"frame\":\"དུས་འཁོར་རྩ་རྒྱུད་ལས།\",\"head\":\"དགོངས་པའི་སྐད་དང་དེ་བཞིན་མིན།\",\"tail\":\"རྒྱུད་ནི་མཐའ་དྲུག་མཚན་ཉིད་དོ།\"},{\"label\":\"QUOTE\",\"frame\":\"ཡེ་ཤེས་རྡོ་རྗེ་ཀུན་ལས་བཏུས་པའི་རྒྱུད་ལས།\",\"head\":\"བཤད་པ་བཞི་ནི། ཡི་གེ་དང་སྤྱི་དང་སྦས་པ་དང་མཐར་ཐུག་གོ།\",\"tail\":\"\"},{\"label\":\"QUOTE\",\"frame\":\"གཟུངས་ཀྱི་དབང་ཕྱུག་རྒྱལ་པོས་ཞུས་པའི་མདོར།\",\"head\":\"བདེན་པ་བཞིའི་ཚུལ། སྟོང་པ་ཉིད་ཀྱི་ཚུལ།\",\"tail\":\"དེ་བཞིན་གཤེགས་པའི་སྙིང་པོའི་ཚུལ་ཞེས་གསུངས།\"},{\"label\":\"QUOTE\",\"frame\":\"འཕགས་པ་དགོངས་པ་ངེས་པར་འགྲེལ་པ་ལས།\",\"head\":\"བཅོམ་ལྡན་འདས་ཀྱིས་དང་པོར་ཡུལ་ཝཱ་རཱ་ཎ་སཱི་དྲང་སྲོང་ལྷུང་བ་རི་དྭགས་ཀྱི་ནགས་སུ།\",\"tail\":\"རྩོད་པའི་གཞིའི་གནས་སུ་གྱུར་པ་མ་ལགས་སོ།\"},{\"label\":\"QUOTE\",\"frame\":\"གཟུངས་ཀྱི་དབང་ཕྱུག་རྒྱལ་པོས་ཞུས་པ་ལས།\",\"head\":\"རིགས་ཀྱི་བུ་འདི་ལྟ་སྟེ་དཔེར་ན་ནོར་བུ་མཁན་མཁས་པ།\",\"tail\":\"དེ་བཞིན་གཤེགས་པའི་ཡུལ་ལ་འཇུག་པར་མཛད་དོ།\"},{\"label\":\"QUOTE\",\"frame\":\"རྩ་ཤེ་ལས།\",\"head\":\"བཅོམ་ལྡན་དངོས་དང་དངོས་མེད་པ།\",\"tail\":\"མེད་པ་གཉིས་ཀ་དགག་པར་མཛད།\"},{\"label\":\"QUOTE\",\"head\":\"མྱ་ངན་འདས་པ་བདེན་གཅིག་པུ།\",\"tail\":\"མཁས་པ་སུ་ཞིག་རྟོགས་མི་བྱེད།\"},{\"label\":\"QUOTE\",\"frame\":\"དབུ་མ་སྒོམ་རིམ་ལས།\",\"head\":\"དེ་ལྟར་ཤེས་རབ་དག་པ་ཡིས།\",\"tail\":\"བརྟགས་པས་གཞན་དངོས་འགྱུར་མ་ཡིན།\"},{\"label\":\"QUOTE\",\"frame\":\"ཡབ་སྲས་མཇལ་བ་ལས།\",\"head\":\"འཇིག་རྟེན་མཁྱེན་པས་གཞན་ལ་མ་གསན་པར།\",\"tail\":\"བདེན་པ་གསུམ་པ་གང་ཡང་མ་མཆིས་སོ།\"},{\"label\":\"QUOTE\",\"head\":\"སངས་རྒྱས་རྣམས་ཀྱིས་ཆོས་བསྟན་པ།\",\"tail\":\"དམ་པའི་དོན་གྱི་བདེན་པའོ།\"},{\"label\":\"QUOTE\",\"frame\":\"ཇི་སྐད་དུ། དེ་ཉིད་ལས།\",\"head\":\"མ་རིག་རང་བཞིན་སྒྲིབ་ཕྱིར་ཀུན་རྫོབ་སྟེ།\",\"tail\":\"བཅོས་མར་གྱུར་པའི་དངོས་ནི་ཀུན་རྫོབ་ཏུའོ།\"},{\"label\":\"QUOTE\",\"frame\":\"ཚིག་གསལ་ལས།\",\"head\":\"ཡང་ན་ཀུན་རྫོབ་ནི་བརྡ་སྟེ་འཇིག་རྟེན་གྱི་ཐ་སྙད།\",\"tail\":\"ཤེས་པ་དང་ཤེས་བྱ་ལ་སོགས་པའི་མཚན་ཉིད་ཅན་ནོ།\"},{\"label\":\"QUOTE\",\"frame\":\"རྟོག་གེ་འབར་པ་ལས།\",\"head\":\"གཟུགས་ལ་སོགས་པའི་དངོས་པོ་ཀུན་རྣམ་པར་འབྱེད་པའི་དོན་གྱིས་ན་ཀུན་རྫོབ་སྟེ།\",\"tail\":\"\"},{\"label\":\"QUOTE\",\"frame\":\"སློབ་དཔོན་སེང་གེ་བཟང་པོས།\",\"head\":\"རྣམ་པར་དཔྱད་པའི་དཔུང་མི་བཟོད་པས་ན་ཀུན་རྫོབ།\",\"tail\":\"\"},{\"label\":\"QUOTE\",\"frame\":\"དབུས་མཐའ་ལས།\",\"head\":\"སྟོང་པ་ཉིད་ནི་མདོར་བསྡུ་ན།\",\"tail\":\"གཞན་མིང་ཕྱིན་ཅི་མ་ལོག་ཡིན།\"},{\"label\":\"QUOTE\",\"frame\":\"དབུས་མཐའ་ལས།\",\"head\":\"ཟ་བ་པོ་དང་དེ་ཡི་ལུས།\",\"tail\":\"གང་ཕྱིར་དེ་ཡང་སྟོང་པ་ཉིད།\"},{\"label\":\"QUOTE\",\"head\":\"ཤེས་པར་བྱ་བ་ལ་བདེན་པ་གཉིས་པོ་འདི་ཙམ་དུ་ཟད་དོ།\",\"tail\":\"\"},{\"label\":\"QUOTE\",\"frame\":\"རྩ་ཤེས་ལས།\",\"head\":\"འཇིག་རྟེན་ཀུན་རྫོབ་བདེན་པ་དང༌།\",\"tail\":\"དམ་པའི་དོན་གྱི་བདེན་པའོ།\"},{\"label\":\"QUOTE\",\"frame\":\"ལང་གཤེགས་ལས།\",\"head\":\"ཀུན་རྫོབ་དང་ནི་དོན་དམ་སྟེ།\",\"tail\":\"དེ་ཟད་འཕགས་པའི་སྤྱོད་ཡུལ་ལོ།\"},{\"label\":\"QUOTE\",\"frame\":\"ཡབ་སྲས་མཇལ་བ་ལས།\",\"head\":\"དེ་ལྟར་དེ་བཞིན་གཤེགས་པས་ཀུན་རྫོབ་དང་དོན་དམ་པ་གཉིས་ཐུགས་སུ་ཆུད་དེ།\",\"tail\":\"ཀུན་རྫོབ་དང་དོན་དམ་པའི་བདེན་པ་འདིར་ཟད་དོ།\"},{\"label\":\"QUOTE\",\"frame\":\"བདེན་གཉིས་ལས།\",\"head\":\"བདེན་གཉིས་རྣམ་དབྱེ་ཤེས་པ་དག\",\"tail\":\"ཕུན་ཚོགས་ཕ་རོལ་འགྲོ་བ་ཉིད།\"},{\"label\":\"QUOTE\",\"frame\":\"རྩ་བ་ཤེས་རབ་ལས།\",\"head\":\"རྟེན་ཅིང་འབྲེལ་བར་འབྱུང་བ་གང༌།\",\"tail\":\"དེ་ཉིད་དབུ་མའི་ལམ་ཡིན་ནོ།\"},{\"label\":\"QUOTE\",\"frame\":\"བཤེས་སྤྲིང་ལས།\",\"head\":\"གང་ཟག་ལོག་པར་ལྟ་བས་ལེགས་སྤྱད་ཀྱང༌།\",\"tail\":\"ཐམས་ཅད་རྣམ་པར་སྨིན་པ་མི་བཟད་ལྡན།\"},{\"label\":\"QUOTE\",\"frame\":\"རྩ་ཤེས་ལས།\",\"head\":\"གང་གིས་རྟེན་ཅིང་འབྲེལ་བར་འབྱུང༌།\",\"tail\":\"ལམ་ཉིད་དེ་དག་མཐོང་བ་ཡིན།\"},{\"label\":\"QUOTE\",\"frame\":\"སློབ་སྤྲིངས་ལས།\",\"head\":\"བདེར་གཤེགས་ལམ་བརྟེན་འགྲོ་བ་འདྲེན་པར་ཆས་གྱུར་ཅིང༌།\",\"tail\":\"མཁའ་ལྡིང་རིག་འཛིན་མིའམ་ཅི་དང་ལྟོ་འཕྱེས་མིན།\"},{\"label\":\"QUOTE\",\"frame\":\"ཞི་བ་ལྷས།\",\"head\":\"རྒྱ་མཚོ་ཆེར་གཡེང་གཉའ་ཤིང་གི།\",\"tail\":\"མི་ཉིད་ཤིན་ཏུ་འཐོབ་དཀའ་གསུངས།\"},{\"label\":\"QUOTE\",\"head\":\"རབ་ཏུ་ཚ་ཞིང་གྲང་བ་ཡི།\",\"tail\":\"རབ་ཏུ་བསྒྲིམས་ཏེ་གཅད་པར་བྱ།\"},{\"label\":\"QUOTE\",\"head\":\"དམྱལ་བ་བྲིས་པ་མཐོང་དང་ཐོས་པ་དང༌།\",\"tail\":\"རྣམ་སྨིན་ཉམས་སུ་མྱོང་ན་སྨོས་ཅི་འཚལ།\"},{\"label\":\"QUOTE\",\"head\":\"འདི་ན་ཉིན་གཅིག་མདུང་ཐུང་སུམ་བརྒྱ་ཡིས།\",\"tail\":\"ཆར་ཡང་མི་ཕོད་དོ།\"},{\"label\":\"QUOTE\",\"head\":\"ཡི་དྭགས་ན་ཡང་འདོད་པས་ཕོངས་པ་ཡིས།\",\"tail\":\"བསྐྱེད་པ་ཤིན་ཏུ་མི་བཟད་བསྟེན་འཚལ་ལོ།\"},{\"label\":\"QUOTE\",\"head\":\"དུད་འགྲོའི་སྐྱེ་གནས་ན་ཡང་གསོད་པ་དང༌།\",\"tail\":\"གཅིག་ལ་གཅིག་ཟ་ཤིན་ཏུ་མི་བཟད་པ།\"},{\"label\":\"QUOTE\",\"frame\":\"རིན་ཆེན་ཕྲེང་བ་ལས།\",\"head\":\"མི་དགེ་བ་ལས་སྡུག་བསྔལ་ཀུན།\",\"tail\":\"སྐྱེ་བ་ཀུན་ཏུ་བདེ་བ་དག\"},{\"label\":\"QUOTE\",\"frame\":\"ཚོམས་ལས།\",\"head\":\"སྡིག་པ་ཆུང་ངུ་བྱས་པས་ཀྱང༌།\",\"tail\":\"འབྲུ་རྣམས་ཕུན་ཚོགས་སྨིན་པ་བཞིན།\"},{\"label\":\"QUOTE\",\"frame\":\"ལུང་ལས།\",\"head\":\"ལས་རྣམས་བསྐལ་པ་བརྒྱར་ཡང་ནི།\",\"tail\":\"འབྲས་བུ་དག་ཏུ་འགྱུར་བ་ཉིད།\"},{\"label\":\"QUOTE\",\"frame\":\"མཛོད་ལས།\",\"head\":\"དེ་ལས་ཆེ་ལོང་བསྡུས་ནས་ནི།\",\"tail\":\"ལས་ཀྱི་ལམ་ནི་བཅུར་གསུངས་སོ།\"},{\"label\":\"QUOTE\",\"frame\":\"ལུང་རྣམ་འབྱེད་ལས།\",\"head\":\"ངག་རྣམས་བསྲུངས་ཤིང་ཡིད་ཀྱིས་རབ་བསྡམས་ཏེ།\",\"tail\":\"དྲང་སྲོང་གསུངས་པའི་ལམ་ནི་འཐོབ་པར་འགྱུར།\"},{\"label\":\"QUOTE\",\"frame\":\"བཤེས་སྤྲིངས་ལས།\",\"head\":\"རྟག་དང་མངོན་པར་ཞེན་དང་གཉེན་པོ་མེད།\",\"tail\":\"དེ་ལས་དགེ་བ་སྤྱོད་ལ་བརྩོན་པར་གྱིས