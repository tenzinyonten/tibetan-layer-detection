  "raw_text": "{\"spans\":[{\"label\":\"QUOTE\",\"frame\":\"དབུས་མཐའ་རྣམ་འབྱེད་དུ།\",\"head\":\"ལེ་ལོ་དང་ནི་གདམས་ངག་རྣམས།\",\"tail\":\"\"},{\"label\":\"QUOTE\",\"head\":\"དགེ་དང་མི་དགེ་རྣམ་རྟོག་གི། །\",\"tail\":\"གཞན་ནི་དེ་ལྟར་མི་འདོད་དོ། །\"},{\"label\":\"QUOTE\",\"head\":\"འདི་ལྟར་ཚོན་རྐྱེན་སྣ་ཚོགས་ཀྱིས། །\",\"tail\":\"ཁྱབ་བདག་དེ་དངོས་མིན་པར་སྣང༌། །\"},{\"label\":\"QUOTE\",\"head\":\"བརྒྱ་བྱིན་འཇིག་རྟེན་མཆོད་འོས་གྱུར་ན་ཡང༌། །\",\"tail\":\"འཇིག་རྟེན་དག་ན་ཡང་བྲན་ཉིད་དུ་འགྱུར། །\"},{\"label\":\"QUOTE\",\"head\":\"དམྱལ་བར་འགྲོ་བ་སངས་རྒྱས་ལ། །\",\"tail\":\"ས་གཉིས་དག་ནི་གཏན་གྱི་གེགས། །\"},{\"label\":\"QUOTE\",\"frame\":\"ལྷའི་བུས་ཞུས་པའི་མདོ་ལས།\",\"head\":\"ཆོས་རྣམས་ཐམས་ཅད་བཀའ་དང་བསྟན་བཅོས་གཉིས་སུ་འདུས། །\",\"tail\":\"དེ་ཡི་དགོངས་འགྲེལ་བ། །\"},{\"label\":\"QUOTE\",\"head\":\"སྒྲུབ་པ་བྱས་པའི་འབྲས་བུ་དེས། །\",\"tail\":\"སེམས་ཅན་རྣམས་ལ་སྨིན་པར་ཤོག །\"},{\"label\":\"QUOTE\",\"head\":\"ཐོག་མ་བར་དང་མཐར་དགེ་བ། །\",\"tail\":\"ཡང་དང་ཡང་དུ་གསུངས།\"},{\"label\":\"QUOTE\",\"head\":\"འདོད་ཆགས་ཞེ་སྡང་གཏི་མུག་གསུམ། །\",\"tail\":\"དེས་བསྐྱེད་ལས་ནི་མི་དགེ་བ། །\"},{\"label\":\"QUOTE\",\"head\":\"རང་ཡུལ་ལྕགས་སྲེག་མེ་ལྟར་འབར་གྱུར་ཅིང༌། །\",\"tail\":\"རང་ལ་སྙིང་བརྩེ་ཡོད་པ་ནགས་སུ་སོང༌། །\"},{\"label\":\"QUOTE\",\"frame\":\"རྗེ་གོང་མའི་ཞལ་ནས།\",\"head\":\"ཤི་ས་བརླ་གང་འདྲ་བ་ལ། །\",\"tail\":\"ཡུལ་ཕྱོགས་ལ་དམིགས་པ་ག་ལ་ཡོད།\"},{\"label\":\"QUOTE\",\"head\":\"ཐབས་ལམ་མཆོག་རྣམས་ཉམས་སུ་བླངས་གྱུར་ཀྱང༌། །\",\"tail\":\"རྒྱུ་མཆོག་ལམ་མཆོག་འབྲས་བུ་ནམ་མཁའ་བཞིན། །\"},{\"label\":\"QUOTE\",\"frame\":\"དཔལ་ལྡན་ཕག་མོ་གྲུ་པས།\",\"head\":\"བར་དོ་གསུམ་དང་ལུས་གསུམ་དང༌། །\",\"tail\":\"མངོན་དུ་བྱ་བ་རྣམ་གསུམ་མོ། །\"},{\"label\":\"QUOTE\",\"head\":\"ཚུལ་ཁྲིམས་འཆལ་ལ་སྔགས་འགྲུབ་པར། །\",\"tail\":\"ཡུལ་དང་ཕྱོགས་ཀྱང་མ་ཡིན་ནོ། །\"},{\"label\":\"QUOTE\",\"head\":\"དེ་མ་ནུས་ན་མི་གནང་སྟེ། །\",\"tail\":\"སྡིག་ཅན་དམྱལ་བར་འཚེད་པར་འགྱུར། །\"},{\"label\":\"QUOTE\",\"head\":\"ཁྱོད་ནི་མཐོང་དང་དྲན་པ་ཙམ་གྱིས་ཀྱང༌། །\",\"tail\":\"སྡུག་བསྔལ་ཟུག་རྔུ་མ་ལུས་གཅོད་པར་བྱེད། །\"},{\"label\":\"QUOTE\",\"frame\":\"དཔལ་ལྡན་ཕག་མོ་གྲུ་པའི་ཞལ་ནས་ཀྱང༌།\",\"head\":\"སྙིང་ནས་རྩ་བ་ཆོད་གྱུར་ཅིང༌། །\",\"tail\":\"དེ་དབང་མེད་ཀྱི་རྒྱུ་འབྲས་མ་ལགས་སམ།\"},{\"label\":\"QUOTE\",\"head\":\"གང་གིས་རྟེན་ཅིང་འབྲེལ་པར་འབྱུང༌། །\",\"tail\":\"དམ་པ་དེ་ལ་ཕྱག་འཚལ་ལོ། །\"},{\"label\":\"QUOTE\",\"head\":\"ཡོན་ཏན་དྲུག་ཅུ་རྩ་བཞི་པོ། །\",\"tail\":\"མདོ་ཡི་རྗེས་འབྲང་ཤེས་པར་བྱ། །\"},{\"label\":\"QUOTE\",\"head\":\"གཞན་ཡང་ང་ལ་འོད་ཟེར་ཡང་ཡོད་དེ། །\",\"tail\":\"དེ་ཕྱིར་དེ་ལས་སྐྱེས་པ་ཡིན། །\"},{\"label\":\"QUOTE\",\"head\":\"རྫོགས་སངས་སྐུ་ནི་འཕྲོ་ཕྱིར་དང༌། །\",\"tail\":\"རྟག་ཏུ་སངས་རྒྱས་སྙིང་པོ་ཅན། །\"},{\"label\":\"QUOTE\",\"head\":\"རྟེན་ཅིང་འབྲེལ་འབྱུང་མ་གཏོགས་པ། །\",\"tail\":\"ཆོས་འགའ་ཡོད་པ་མ་ཡིན་ནོ། །\"},{\"label\":\"QUOTE\",\"frame\":\"པཎ་ཆེན་པདྨ་དབང་རྒྱལ་གྱིས།\",\"head\":\"སྡིག་ཏོ་མི་དགེའི་ཕྱོགས་དང་ཚོགས་པའི་གསེབ། །\",\"tail\":\"ཞེས་མཁས་རྣམས་བཞེད། །\"},{\"label\":\"QUOTE\",\"head\":\"ཇི་ལྟར་སྒྲོན་གློག་ནོར་བུ་ཉི་ཟླ་ལ། །\",\"tail\":\"ཐུབ་ལ་བརྟེན་ནས་འདི་ནི་ཡང་དག་བཤད། །\"},{\"label\":\"QUOTE\",\"head\":\"སློང་བའི་ཟས་ལ་རབ་ཏུ་ཞུགས་པ་ནི། །\",\"tail\":\"བདེ་བ་རྒྱ་ཆེ་གཞིར་གྱུར་སྦྱིན་ལ་སྦྱོར། །\"},{\"label\":\"QUOTE\",\"frame\":\"དཔལ་ལྡན་ཕག་མོ་གྲུ་པའི་ཞལ་ནས་ཀྱང༌།\",\"head\":\"ཇི་སྙེད་ཀྱི་གྲོང་ཁྱེར་མ་ཟད་ན། །\",\"tail\":\"ལྟོགས་ཀྱི་དོགས་པ་ག་ལ་ཡོད། །\"},{\"label\":\"QUOTE\",\"head\":\"རྒྱལ་བས་ལྭ་དཀར་གསེར་གྱི་ངང་རིས་ཅན། །\",\"tail\":\"ལེགས་པའི་རྟེན་དུ་གྱུར་པས་དགའ་མི་བྱེད། །\"},{\"label\":\"QUOTE\",\"head\":\"གང་ཞིག་ཤིང་དྲུང་ཇི་ལྟར་འོས་པ་ཡི། །\",\"tail\":\"མི་རྟག་འདུ་ཤེས་ལྟ་བུ་སྟོན་པར་བྱེད། །\"},{\"label\":\"QUOTE\",\"head\":\"དུར་ཁྲོད་པ་དག་འཆི་བ་དྲན་བསྒོམས་ནས། །\",\"tail\":\"དེ་ཡི་ལུས་ལ་ཆགས་པ་སྲབ་མོར་འགྱུར། །\"},{\"label\":\"QUOTE\",\"head\":\"གང་ལ་སྟོང་པ་ཉིད་རུང་བ། །\",\"tail\":\"དེ་ལ་ཐམས་ཅད་རུང་མི་འགྱུར། །\"},{\"label\":\"QUOTE\",\"head\":\"རྫོགས་སངས་སྐུ་ནི་འཕྲོ་ཕྱིར་དང༌། །\",\"tail\":\"རྟག་ཏུ་སངས་རྒྱས་སྙིང་པོ་ཅན། །\"},{\"label\":\"QUOTE\",\"head\":\"ཆོས་ཀུན་དོན་གཅིག་ཏུ་ནི་རབ་བཤད་དེ། །\",\"tail\":\"དེ་དག་ལ་ནི་ཐ་དད་གྱུར་པ་མེད། །\"},{\"label\":\"QUOTE\",\"head\":\"འཇིག་རྟེན་ཁམས་ནི་སྟོང་དག་ཏུ། །\",\"tail\":\"དེ་དག་ཐམས་ཅད་བསྒོམ་པར་འགྱུར། །\"},{\"label\":\"QUOTE\",\"head\":\"ལོ་སྟོང་ལོན་པའི་མུན་པ་མཐུག་པོ་ཡང༌། །\",\"tail\":\"རང་སེམས་རྟོགས་པས་སྐད་ཅིག་གཅིག་གིས་སེལ། །\"},{\"label\":\"QUOTE\",\"head\":\"མ་རྟོགས་དུས་ན་མ་རིག་པ། །\",\"tail\":\"དཀར་པོའི་ཡོན་ཏན་རྫོགས་པར་འབྱུང༌། །\"},{\"label\":\"QUOTE\",\"head\":\"རྟོགས་དང་མ་རྟོགས་མ་གཏོགས་པ། །\",\"tail\":\"འབྲས་བུ་ཐོབ་དང་མ་ཐོབ་མེད། །\"},{\"label\":\"QUOTE\",\"head\":\"སེམས་ཉིད་ངོ་བོ་ཉིད་ཀྱི་སྐུ། །\",\"tail\":\"རིན་པོ་ཆེ་ལ་ཕྱག་འཚལ་ལོ། །\"},{\"label\":\"QUOTE\",\"head\":\"དུས་གསུམ་བདག་ཉིད་བདེ་ཆེན་བླ་མ་ནི། །\",\"tail\":\"མི་འགྱུར་རྡོ་རྗེའི་སྐུ་ལ་ཕྱག་འཚལ་ལོ། །\"},{\"label\":\"QUOTE\",\"head\":\"ཇི་ལྟར་ནམ་མཁའ་མེ་རྣམས་ཀྱིས། །\",\"tail\":\"རྒ་དང་ན་བའི་མེས་མི་འཚིག །\"},{\"label\":\"QUOTE\",\"head\":\"བྱས་པ་ཤེས་ཤིང་བྱས་པ་གཟོ། །\",\"tail\":\"དེ་ལ་དཔལ་མགོན་ཉེ་བར་གནས། །\"},{\"label\":\"QUOTE\",\"head\":\"བྱང་ཆུབ་སེམས་དཔའ་གང་ཞིག་རྗེས་སུ་བསྟན་དང་མཐུན་བྱེད་ཅིང༌། །\",\"tail\":\"མཐུན་པའི་སངས་རྒྱས་ཡེ་ཤེས་བྱང་ཆུབ་དྲུང་དུ་འཚང་ཀྱང་རྒྱ། །\"},{\"label\":\"QUOTE\",\"head\":\"ཐོག་མ་བར་དང་མཐར་དགེ་བ། །\",\"tail\":\"ཡང་དང་ཡང་དུ་གསུང་བ་གང༌། །\"},{\"label\":\"QUOTE\",\"head\":\"གང་གིས་རྟེན་ཅིང་འབྲེལ་བར་འབྱུང༌། །\",\"tail\":\"དམ་པ་དེ་ལ་ཕྱག་འཚལ་ལོ། །\"},{\"label\":\"QUOTE\",\"head\":\"ཇི་ལྟར་འཇིག་རྟེན་ཐམས་ཅད་དུ། །\",\"tail\":\"དབང་པོ་རྣམས་ནི་སྐྱེ་ཞིང་འཇིག །\"},{\"label\":\"QUOTE\",\"head\":\"ཡན་ལག་བཅུ་གཉིས་བྱེ་བྲག་གང༌། །\",\"tail\":\"གསུམ་པོ་དག་ཏུ་ཟད་པར་འདུས། །\"},{\"label\":\"QUOTE\",\"head\":\"ཁ་ཏོན་མར་མེ་མེ་ལོང་རྒྱ། །\",\"tail\":\"མི་འཕོ་བར་ཡང་མཁས་རྟོགས་བྱ། །\"},{\"label\":\"QUOTE\",\"head\":\"ཤིན་ཏུ་ཕྲ་བའི་དངོས་ལ་ཡང༌། །\",\"tail\":\"རྣམ་པར་མི་མཁས་དེ་ཡིས་ནི། །\"},{\"label\":\"QUOTE\",\"head\":\"ཇི་ལྟར་ནམ་མཁའ་ཀུན་སོང་བ། །\",\"tail\":\"གནས་འདི་ཉེ་བར་གོས་པ་མེད། །\"},{\"label\":\"QUOTE\",\"head\":\"སེམས་ཙམ་སྤྱོད་པའི་དབུ་མ་པས། །\",\"tail\":\"བློ་དེ་ཀུན་རྫོབ་ཡིན་པས་གསལ་བ་དེ་ཉིད་ཀྱང་སྟོང་པར་འདོད་པ་དང༌།\"},{\"label\":\"QUOTE\",\"head\":\"སྤྲོས་པ་རབ་ཞི་དོན་དམ་བྱང་ཆུབ་སེམས། །\",\"tail\":\"ཏིལ་དང་ཏིལ་མར་བཞིན་དུ་རོ་གཅིག་པ། །\"},{\"label\":\"QUOTE\",\"head\":\"ཐོགས་མེད་བློ་ལྡན་དེ་ཡིས་ནི། །\",\"tail\":\"འཇིག་རྟེན་ན་ནི་མཉམ་པ་ཉིད། །\"},{\"label\":\"QUOTE\",\"head\":\"དེ་ལྟ་མོད་ཀྱི་ས་རྡུལ་དང༌། །\",\"tail\":\"བྱང་ཆུབ་སེམས་དཔའི་ཁྱད་པར་ཡིན། །\"},{\"label\":\"QUOTE\",\"head\":\"ཀུན་དགའ་བོ་དེ་བཞིན་གཤེགས་པ་དགྲ་བཅོམ་པ་ཡང་དག་པར་རྫོགས་པའི་སངས་རྒྱས་ནི།\",\"tail\":\"ཡོན་ཏན་དཔག་ཏུ་མེད་པ་དང་ལྡན་པའི་ཕྱིར་རོ། །\"},{\"label\":\"QUOTE\",\"head\":\"གང་གིས་གངྒཱའི་བྱེ་སྙེད་འཇིག་རྟེན་ཁམས། །\",\"tail\":\"ལན་གཉིས་ལན་གསུམ་སེམས་པ་སྨོས་ཅི་དགོས། །\"},{\"label\":\"QUOTE\",\"head\":\"སངས་རྒྱས་ཡོན་ཏན་བསམ་མི་ཁྱབ། །\",\"tail\":\"རྣམ་པར་སྨིན་པའང་བསམ་མི་ཁྱབ། །\"},{\"label\":\"QUOTE\",\"head\":\"བཤེས་གཉེན་ཞི་བ་དུལ་བ་ཉེར་ཞི་བ། །\",\"tail\":\"\"},{\"label\":\"QUOTE\",\"head\":\"སེམས་ཉིད་གདོད་ནས་སྤྲོས་དང་བྲལ་ཞིང་མ་སྐྱེས་པ། །\",\"tail\":\"ལྟ་བའི་མུན་སེལ་སྐྱོབ་པའི་ཉི་མ་ཁྱོད་ཕྱག་འཚལ། །\"},{\"label\":\"QUOTE\",\"head\":\"གྲོལ་ནས་གྲོལ་བའི་ལམ་ཡང་སྟོན། །\",\"tail\":\"དགེ་འདུན་ལ་ཡང་ཕྱག་འཚལ། །\"},{\"label\":\"QUOTE\",\"head\":\"ཇི་ལྟ་ཇི་སྙེད་ནང་གི་ནི། །\",\"tail\":\"ལུས་ཅན་ཀུན་གྱི་སྐྱབས་ཡིན་ནོ། །\"},{\"label\":\"QUOTE\",\"head\":\"རྟག་པར་ཚུལ་ཁྲིམས་ལྡན་པ་ལ། །\",\"tail\":\"རྗེས་སུ་འབྲང་ཞིང་དབྲོག་ཏུ་མེད། །\"},{\"label\":\"QUOTE\",\"head\":\"སྦྱིན་པ་སྦྱིན་པའི་སྔོན་དུ་འགྲོ་བ་ཤེས་རབ་སྟེ། །\",\"tail\":\"\"},{\"label\":\"QUOTE\",\"head\":\"ཨཾ་གཏོང་དང་ཡོངས་སུ་གཏོང་དང་གཏོང་བ་ཆེ། །\",\"tail\":\"སངས་རྒྱས་རྣམས་ཀྱི་དགོངས་པ་རྫོགས་པར་ཤོག །\"}]}",
