  "raw_text": "{\"spans\": [{\"label\": \"QUOTE\", \"frame\": \"རྒྱལ་བ་རང་ཉིད་ཀྱི་ཞལ་ནས།\", \"head\": \"ངས་ནི་ཁྱོད་ལ་ཐར་པའི་ལམ་བསྟན་གྱི། །\", \"tail\": \"ཐར་པ་རང་ལ་རག་ལས་ཤེས་པར་བྱ། །\"}, {\"label\": \"QUOTE\", \"head\": \"ཐུབ་རྣམས་སྡིག་པ་ཆུ་ཡིས་མི་བཀྲུ་ཞིང༌། །\", \"tail\": \"ཆོས་ཉིད་བདེན་པ་བསྟན་པས་གྲོལ་བར་མཛད། །\"}, {\"label\": \"QUOTE\", \"frame\": \"རྗེ་རིན་པོ་ཆེས་མཛད་པའི་རྟེན་འབྲེལ་བསྟོད་པ་ལས།\", \"head\": \"མཛད་པ་ཀུན་ལས་གསུང་གི་ནི། །\", \"tail\": \"འདི་ལས་སངས་རྒྱས་རྗེས་དྲན་བྱོས། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཇི་སྐད་དུ།\", \"head\": \"སྐྱབས་དངོས་ནི་ཆོས་དཀོན་མཆོག་ཡིན་ཏེ\", \"tail\": \"འཇིགས་པ་ལས་གྲོལ་བའི་ཕྱིར།\"}, {\"label\": \"QUOTE\", \"frame\": \"དཔལ་སྤྲུལ་རིན་པོ་ཆེས།\", \"head\": \"བྱང་ཆུབ་ཐོབ་པ་ལ་སྒྲུབ་པ་ཉམས་ལེན་\", \"tail\": \"ཤེས་པ་གལ་ཆེ།\"}, {\"label\": \"QUOTE\", \"frame\": \"ཆོས་རྒྱལ་དྭགས་པོ་ལྷ་རྗེས\", \"head\": \"ཆོས་ཆོས་བཞིན་མ་སྤྱད་ན་ཆོས་ཀྱིས་\", \"tail\": \"ངན་སོང་དུ་འགྲོ་བའི་རྒྱུ་བྱེད།\"}, {\"label\": \"QUOTE\", \"head\": \"མི་གཏི་མུག་ཅན་གྱིས་ཆོས་བཤད་པ། །\", \"tail\": \"ཁམས་གསུམ་སེམས་ཅན་བསད་ལས་སྡིག་པ་ཆེ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཀུན་མཁྱེན་དྲི་མེད་འོད་ཟེར་གྱི་ཞལ་ནས།\", \"head\": \"བསྟན་པ་ལ་ཞུགས་པའི་ཐོག་མར་ཉན་དགོས་ཏེ\", \"tail\": \"རང་གི་ཉམས་རྟོགས་གོང་དུ་བྱར་ཡོད་པའི་ཕྱིར་རོ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"སྡོང་པོ་བཀོད་པ་ལས།\", \"head\": \"རིགས་ཀྱི་བུ་མྱུར་དུ་མངོན་པར་རྫོགས་པར་\", \"tail\": \"ཡོངས་སུ་འཚོལ་བ་ལ་བསླབ་པར་བྱའོ།\"}, {\"label\": \"QUOTE\", \"frame\": \"བློ་གྲོས་རྒྱ་མཚོས་ཞུས་པའི་མདོ་ལས།\", \"head\": \"ཆོས་སྨྲ་བ་གཙང་སྦྲ་དང་བཅས་ནས་\", \"tail\": \"ལེགས་པར་གོས་བགོ་བར་བྱའོ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"འོད་སྲུངས་ཀྱིས་ཞུས་པའི་མདོ་ལས།\", \"head\": \"དག་ཅིང་ཟང་ཟིང་མེད་པའི་སེམས་ཀྱིས་སུ། །\", \"tail\": \"འགྲོ་ལ་ཆོས་སྟོན་པ་ལ་རྒྱལ་རྣམས་དགྱེས། །\"}, {\"label\": \"QUOTE\", \"frame\": \"དཀོན་མཆོག་བརྩེགས་པ་ལས།\", \"head\": \"དམ་ཆོས་འཆད་པ་རབ་ཏུ་ཕེབས་པ་དེར། །\", \"tail\": \"དེ་ལུས་སུམ་ཅུ་རྩ་གཉིས་མཚན་དང་ལྡན། །\"}, {\"label\": \"QUOTE\", \"frame\": \"བྱང་ཆུབ་སེམས་དཔའི་སྡེ་སྣོད་ལས།\", \"head\": \"ཐོས་པས་ཆོས་རྣམས་ཤེས་པར་འགྱུར། །\", \"tail\": \"ཐོས་པས་མྱ་ངན་འདས་པ་ཐོབ། །\"}, {\"label\": \"QUOTE\", \"head\": \"བཅོམ་ལྡན་འདས་ཀྱིས་ཆོས་མཉན་པ་ལ་ཕན་ཡོན་ལྔ་གསུངས་ཏེ\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"head\": \"མ་ཐོས་པ་ཐོས་པར་གྱུར་བ་དང༌། ཐོས་པ་ཡོངས་སུ་བྱང་བར་འགྱུར་བ་དང༌།\", \"tail\": \"ཤེས་རབ་ཀྱིས་ཚིག་དང་དོན་ཟབ་མོར་རྟོགས་པར་འགྱུར་བའོ། །\"}, {\"label\": \"QUOTE\", \"head\": \"རྣམ་པར་མི་ཤེས་པ་རྣམ་པར་ཤེས་པར་བྱེད་པ་དང༌།\", \"tail\": \"འཕགས་པའི་ཤེས་རབ་ཀྱི་མིག་སྦྱོང་བར་བྱེད་པའོ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཇི་སྐད་དུ།\", \"head\": \"གང་ལ་ཕན་ཕྱིར་ང་ཡི་ཆོས། །\", \"tail\": \"རྒྱལ་བ་ཡང་དག་མཆོད་མ་ཡིན། །\"}, {\"label\": \"QUOTE\", \"frame\": \"བྱམས་པ་སེང་གེ་སྒྲའི་མདོ་ལས།\", \"head\": \"གང་གིས་གངྒཱའི་བྱེ་སྙེད་སངས་རྒྱས་ཞིང༌། །\", \"tail\": \"གཉིས་དང་གསུམ་ལ་བསམ་དུ་ག་ལ་ཡོད། །\"}, {\"label\": \"QUOTE\", \"head\": \"གངྒཱའི་བྱེ་སྙེད་རིན་ཆེན་གསེར་དག་གིས། །\", \"tail\": \"དེ་ཡི་ཕན་ཐོགས་ཇི་འདྲ་དེ་ལ་མེད། །\"}, {\"label\": \"QUOTE\", \"frame\": \"རྗེ་བཙུན་བྱམས་པ་མགོན་པོའི་མདོ་རྒྱན་ལས།\", \"head\": \"བཤེས་གཉེན་དུལ་བ་ཞི་བ་ཉེར་ཞི་བ། །\", \"tail\": \"བརྩེ་བའི་བདག་ཉིད་སྐྱོ་ངལ་སྤངས་ལ་བསྟེན། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཡོན་ཏན་རིན་ཆེན་སྡུད་པའི་མདོ་ལས་ཀྱང༌།\", \"head\": \"སངས་རྒྱས་ཆོས་རྣམས་བླ་མ་ལ་ལྟོས་ཞེས།\", \"tail\": \"ཡོན་ཏན་མཆོག་མངའ་རྒྱལ་བས་དེ་སྐད་གསུངས། །\"}, {\"label\": \"QUOTE\", \"frame\": \"མེ་ཏོག་ཕྲེང་རྒྱུད་ལས།\", \"head\": \"ཚུལ་ཁྲིམས་དག་ཅིང་འདུལ་བའི་ཆོ་ག་ཤེས། །\", \"tail\": \"དུས་སུ་འདོམས་པ་གང་ཡིན་བླ་མར་བསྔགས། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ལམ་སྒྲོན་ལས།\", \"head\": \"སྡོམ་པའི་ཆོ་ག་ལ་མཁས་དང༌། །\", \"tail\": \"བླ་མ་བཟང་པོ་ཤེས་པར་བྱ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"སྤྱོད་འཇུག་ལས།\", \"head\": \"རྟག་པར་དགེ་བའི་བཤེས་གཉེན་ནི། །\", \"tail\": \"སྲོག་གི་ཕྱིར་ཡང་མི་གཏོང་ངོ༌། །\"}, {\"label\": \"QUOTE\", \"frame\": \"མདོ་སྡེ་རྒྱན་ལས།\", \"head\": \"བཤེས་གཉེན་དུལ་བ་ཞི་བ་ཉེར་ཞི་བ། །\", \"tail\": \"བརྩེ་བའི་བདག་ཉིད་སྐྱོ་ངལ་སྤང་ལ་བསྟེན། །\"}, {\"label\": \"QUOTE\", \"frame\": \"བརྟག་གཉིས་ལས།\", \"head\": \"རང་འདོད་ལྷ་མཉམ་རྣལ་འབྱོར་པ། །\", \"tail\": \"རབ་མཐོང་སྔགས་ཀྱི་ཕ་རོལ་སོན། །\"}, {\"label\": \"QUOTE\", \"frame\": \"བླ་མ་ལྔ་བཅུ་པ་ལས།\", \"head\": \"བརྟན་ཞིང་དུལ་བ་བློ་གྲོས་ལྡན། །\", \"tail\": \"སྙིང་བརྩེ་ལྡན་ཞིང་བསྟན་བཅོས་མཁས། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཆོས་རྗེ་གཙང་པས།\", \"head\": \"རྟོགས་པས་བདག་རྒྱུད་གྲོལ་བ།\", \"tail\": \"འབྲེལ་ཚད་དོན་དང་ལྡན་པ།\"}, {\"label\": \"QUOTE\", \"frame\": \"མཉམ་མེད་དྭགས་པོ་རིན་པོ་ཆེའི་ཞལ་སྔ་ནས།\", \"head\": \"རྟོགས་པ་ཐུགས་རྗེ་ལྡན་པའི་བླ་མ་བསྟེན། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"བླ་མ་ལྔ་བཅུ་པ་ལས།\", \"head\": \"བླ་མ་དང་ནི་སློབ་མ་དག །\", \"tail\": \"སློབ་མའི་འབྲེལ་པ་བརྟག་པར་བྱ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"དོན་དམ་བསྙེན་པ་ལས།\", \"head\": \"དེ་ཕྱིར་སློབ་མས་འདོད་པའི་བླ་མ་གསེར་བཞིན་དུ། །\", \"tail\": \"ལེགས་པར་བརྟགས་ན་སྡིག་པ་ཅུང་ཟད་ཡོད་མ་ཡིན། །\"}, {\"label\": \"QUOTE\", \"frame\": \"མདོ་ལས།\", \"head\": \"བསྲེགས་བཅད་བརྡར་བའི་གསེར་བཞིན་དུ། །\", \"tail\": \"བླང་བར་བྱ་ཡིས་གུས་ཕྱིར་མིན། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཡང་མདོ་ལས།\", \"head\": \"དེ་ལྟའི་ཡོན་ཏན་མ་ལུས་ལྡན་པ་དག །\", \"tail\": \"དེ་ལྟ་བུ་ནི་བསྔགས་པའི་གྲོགས་སུ་བརྟག །\"}, {\"label\": \"QUOTE\", \"frame\": \"དོན་དམ་བསྙེན་པ་ལས།\", \"head\": \"རྩོད་དུས་དབང་གིས་བླ་མ་སྐྱོན་ཡོན་འདྲེས། །\", \"tail\": \"བུ་རྣམས་ཀྱིས་ནི་དེ་ལ་བསྟེན་པར་བྱ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཡོན་ཏན་མཛོད་ལས།\", \"head\": \"དེ་ཕྱིར་དམ་པ་ལེགས་པར་མ་བརྟགས་ན། །\", \"tail\": \"ཤིང་གི་གྲིབ་མ་ནོར་བཞིན་བསླུ་བར་འགྱུར། །\"}, {\"label\": \"QUOTE\", \"frame\": \"སྡུད་པ་ལས།\", \"head\": \"སློབ་མ་བཟང་པོ་བླ་མར་གུས་ལྡན་དེ་དག་གིས། །\", \"tail\": \"ཡོན་ཏན་ཀུན་གྱི་མཆོག་མངའ་རྒྱལ་བས་དེ་སྐད་གསུངས། །\"}, {\"label\": \"QUOTE\", \"frame\": \"བཤེས་སྤྲིང་ལས།\", \"head\": \"དགེ་བའི་བཤེས་གཉེན་བསྟེན་པར་ཚངས་པ་སྤྱོད། །\", \"tail\": \"བརྟེན་ནས་རབ་ཏུ་མང་པོས་ཞི་བ་ཐོབ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཡེ་ཤེས་གྲུབ་པ་ལས།\", \"head\": \"སྐྱ་བ་འཛིན་པ་མེད་པ་ནི། །\", \"tail\": \"བླ་མ་མེད་ན་སྲིད་ཐར་མིན། །\"}, {\"label\": \"QUOTE\", \"frame\": \"རྒྱ་ཆེར་རོལ་པ་ལས།\", \"head\": \"སྲིད་པའི་གནས་བཅས་དད་པ་ཆུང་བ་ཡིས། །\", \"tail\": \"སངས་རྒྱས་ཡོན་ཏན་ཤེས་པར་མི་ནུས་སོ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཆོས་བཅུ་པའི་མདོ་ལས།\", \"head\": \"དད་པ་མེད་པའི་མི་རྣམས་ལ། །\", \"tail\": \"མྱུ་གུ་སྔོན་པོ་ཇི་བཞིན་ནོ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"དཀོན་མཆོག་སྒྲོན་མེའི་མདོ་ལས།\", \"head\": \"དད་པ་སྔོན་འགྲོ་མ་ལྟར་བསྐྱེད་པ་སྟེ། །\", \"tail\": \"ལག་པ་བཞིན་དུ་དགེ་རྩ་ཐམས་ཅད་སྡུད། །\"}, {\"label\": \"QUOTE\", \"frame\": \"དམ་ཆོས་པདྨ་དཀར་པོ་ལས།\", \"head\": \"གཙང་ཞིང་ཡིད་དུ་འོང་བའི་ས་ཕྱོགས་སུ། །\", \"tail\": \"བྱམས་པའི་སེམས་ཀྱིས་ལེ་ལོ་མེད་པར་སྟོན། །\"}, {\"label\": \"QUOTE\", \"frame\": \"སྡུད་པ་ལས།\", \"head\": \"དགའ་དང་གུས་དང་དད་པའི་མཆོག་ནི་ཉེར་བཞག་སྟེ། །\", \"tail\": \"གང་ལ་དཔའ་རྣམས་སྤྱོད་པ་དེ་ནི་ཉན་པར་གྱིས། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ས་ཡི་སྙིང་པོའི་མདོ་ལས།\", \"head\": \"གཅིག་ཏུ་དད་ཅིང་གུས་པས་ཆོས་ཉན་གྱིས། །\", \"tail\": \"སངས་རྒྱས་འདྲ་བ་དེ་ལ་འདུ་ཤེས་བསྐྱེད། །\"}, {\"label\": \"QUOTE\", \"frame\": \"མདོ་ལས།\", \"head\": \"ཇི་ལྟར་ཁྱིམ་ནི་ལེགས་གཡོགས་པ། །\", \"tail\": \"མ་ཐོས་བར་དུ་ཤེས་མི་འགྱུར། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཆེད་དུ་བརྗོད་པའི་ཚོམས་ལས།\", \"head\": \"ཐོས་པས་ཆོས་རྣམས་ཤེས་པར་འགྱུར། །\", \"tail\": \"ཐོས་པས་མྱ་ངན་འདས་པ་ཐོབ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཆོས་ཀྱི་དབང་པོའི་ཞལ་སྔ་ནས།\", \"head\": \"ཐར་པ་མཐུན་པའི་ཚོགས་ཀྱི་ལམ་མཆོག་ཏུ། །\", \"tail\": \"ཤེས་རབ་གསུམ་ལས་དང་པོ་ཐོས་པ་མཆོག །\"}]}",
