  "raw_text": "{\"spans\":[{\"label\":\"QUOTE\",\"frame\":\"མ་དྲོས་པའི་ཞུས་པའི་མདོ་ལས།\",\"head\":\"གང་ཞིག་རྐྱེན་ལས་སྐྱེས་པ་དེ་མ་སྐྱེས།\",\"tail\":\"སྟོང་ཉིད་གང་ཤེས་དེ་ནི་བག་ཡོད་པའོ།\"},{\"label\":\"QUOTE\",\"frame\":\"སློབ་དཔོན་ཀླུ་སྒྲུབ་ཀྱིས།\",\"head\":\"རྟེན་ཅིང་འབྲེལ་འབྱུང་མ་གཏོགས་པ།\",\"tail\":\"ཆོས་འགའ་ཡོད་པ་མ་ཡིན་ནོ།\"},{\"label\":\"QUOTE\",\"head\":\"གང་ལ་སྟོང་པ་ཉིད་རུང་བ།\",\"tail\":\"དེ་ལ་ཐམས་ཅད་རུང་མི་འགྱུར།\"},{\"label\":\"QUOTE\",\"frame\":\"བཤེས་སྤྲིང་ལས།\",\"head\":\"རྟེན་ཅིང་འབྲེལ་བར་འབྱུང་འདི་རྒྱལ་བ་ཡི།\",\"tail\":\"སངས་རྒྱས་དེ་ཉིད་རིག་པ་རྣམ་མཆོག་མཐོང༌།\"},{\"label\":\"QUOTE\",\"frame\":\"མདོ་ལས།\",\"head\":\"བརྡ་སྤྲོད་རིག་པ་ཇི་ལྟ་བུ།\",\"tail\":\"དགོས་པའི་དབང་གིས་རིམ་བསྟན་ཏོ།\"},{\"label\":\"QUOTE\",\"frame\":\"མཉམ་མེད་ཇོ་བོས།\",\"head\":\"ཆོས་ཀྱི་ཕུང་པོ་བརྒྱད་ཁྲི་དང༌།\",\"tail\":\"ཆོས་ཉིད་འདི་ལ་གཞོལ་ཞིང་འབབ།\"},{\"label\":\"QUOTE\",\"frame\":\"བརྟག་གཉིས་ལས།\",\"head\":\"དང་པོ་གསོ་སྦྱོང་སྦྱིན་པར་བྱ།\",\"tail\":\"དེ་རྗེས་ཀྱཻ་ཡི་རྡོ་རྗེ་བསྟན།\"},{\"label\":\"QUOTE\",\"frame\":\"ཏིང་འཛིན་རྒྱལ་པོ་ལས།\",\"head\":\"འཇིག་རྟེན་ཁམས་ནི་སྟོང་དག་ཏུ།\",\"tail\":\"ཡོངས་སུ་བསྒྲག་པར་ནུས་མ་ཡིན།\"},{\"label\":\"QUOTE\",\"frame\":\"ཀླུ་སྒྲུབ་ཀྱི་ཞལ་སྔ་ནས།\",\"head\":\"འདོད་ཆགས་ཞེ་སྡང་གཏི་མུག་གསུམ།\",\"tail\":\"དེས་བསྐྱེད་ལས་ནི་དགེ་བའོ།\"},{\"label\":\"QUOTE\",\"head\":\"རྟོག་གཉིས་གཅིག་ཆར་འབྱུང་བ་མེད།\",\"tail\":\"\"},{\"label\":\"QUOTE\",\"frame\":\"མདོ་སྡུད་པ་ལས།\",\"head\":\"སེམས་ཅན་ཐ་མའི་འབྲིང་དང་མཆོག་གྱུར་ཇི་སྙེད་པ།\",\"tail\":\"དེ་ཀུན་ཤེས་རབ་ཕ་རོལ་ཕྱིན་པ་མཆོག་ལས་བྱུང༌།\"},{\"label\":\"QUOTE\",\"frame\":\"སློབ་དཔོན་འཕགས་པས།\",\"head\":\"མི་ཡི་ཆོས་ལུགས་ལེགས་སྤྱད་ན།\",\"tail\":\"འཛེག་ན་ཐར་པ་གམ་ན་འདུག\"},{\"label\":\"QUOTE\",\"frame\":\"ལུང་རྣམ་འབྱེད་ལས།\",\"head\":\"ཅི་སྟེ་འདི་ན་ཤིང་རྩ་གཙོ་བོ་སྟེ།\",\"tail\":\"གཞི་དང་རྩབ་འདུལ་བ་ཡིན་པར་གསུངས།\"},{\"label\":\"QUOTE\",\"head\":\"སངས་རྒྱས་རྣམས་དང་རང་རྒྱལ་རྣམས་ཀྱིས་ཀྱང༌།\",\"tail\":\"དེའི་རྒྱུ་ནི་འདུལ་བ་ཡིན་པར་གསུངས།\"},{\"label\":\"QUOTE\",\"frame\":\"མདོ་སྡེ་རྒྱན་ལས།\",\"head\":\"རབ་ཏུ་བྱུང་བའི་ཕྱོགས་དག་ནི།\",\"tail\":\"ཡོན་ཏན་ཚད་མེད་རྣམས་དང་ལྡན།\"},{\"label\":\"QUOTE\",\"frame\":\"དུས་འཁོར་ལས།\",\"head\":\"དེ་ཉིད་བཅུ་ནི་ཡོངས་ཤེས་པ།\",\"tail\":\"ཁྱིམ་ན་གནས་པ་ཐ་མའོ།\"},{\"label\":\"QUOTE\",\"frame\":\"སོ་སོར་ཐར་པ་ལས།\",\"head\":\"ང་ནི་མྱ་ངན་འདས་འགྱུར་ན།\",\"tail\":\"ནན་ཏན་དགེ་སློང་ཚོགས་མདུན་བསྟོད།\"},{\"label\":\"QUOTE\",\"frame\":\"མངོན་པ་མཛོད་ལས།\",\"head\":\"རྣམ་རིག་བྱེད་མིན་གསུམ་ཞེས་བྱ།\",\"tail\":\"དེ་བཞིན་བསམ་གཏན་ཟག་མེད་སྐྱེས།\"},{\"label\":\"QUOTE\",\"frame\":\"སོར་མདོ་ལས།\",\"head\":\"སེམས་རྟ་ཁ་ཀླན་དཀའ་བ་ལ།\",\"tail\":\"སྲབ་ནི་སོ་སོར་ཐར་པ་ཡིན།\"},{\"label\":\"QUOTE\",\"frame\":\"མངོན་པ་མཛོད་ལས།\",\"head\":\"བསླབ་པ་ཕུལ་དང་ཤི་འཕོས་དང༌།\",\"tail\":\"སོ་སོར་ཐར་པའི་སྡོམ་པ་གཏོང༌།\"},{\"label\":\"QUOTE\",\"frame\":\"མཛོད་ལས།\",\"head\":\"ཁ་ཆེ་རྣམས་ནི་བྱུང་བ་ལ།\",\"tail\":\"བུ་ལོན་ནོར་ཅན་བཞིན་དུ་འདོད།\"},{\"label\":\"QUOTE\",\"frame\":\"སོར་ཕྲེང་གི་མདོ་ལས།\",\"head\":\"སྡིག་པ་ཅི་ཡང་མི་བྱ་ཞིང༌།\",\"tail\":\"འདི་ནི་སངས་རྒྱས་བསྟན་པ་ཡིན།\"},{\"label\":\"QUOTE\",\"frame\":\"ཉེ་བ་འཁོར་གྱི་ཞུས་པའི་མདོ་ལས།\",\"head\":\"འདོད་ཆགས་ནི་ཉེས་པ་ཆུང་ལ་འབྲལ་དཀའ།\",\"tail\":\"གཏི་མུག་ནི་ཉེས་པ་ཆེ་ལ་འབྲལ་ཡང་དཀའ་འོ།\"},{\"label\":\"QUOTE\",\"frame\":\"རྒྱན་ལས(མདོ་དྲན་ཉེ་ལས)།\",\"head\":\"སེམས་ཅན་དམྱལ་བར་སྐྱེས་པ་ནི་བླའི།\",\"tail\":\"དུད་འགྲོའི་སྐྱེ་གནས་སུ་སྐྱེས་པ་ནི་དེ་ལྟ་མ་ཡིན་ནོ།\"},{\"label\":\"QUOTE\",\"frame\":\"སྙིང་རྗེ་པད་དཀར་ལས།\",\"head\":\"ཀུན་དགའ་བོ་ཕྱི་མའི་དུས་དམ་པའི་ཆོས་འཇིག་པར་གྱུར་བའི་དུས་ན།\",\"tail\":\"སྐལ་བཟང་འདི་ལ་མྱ་ངན་ལས་འདའ་བར་འགྱུར་རོ།\"},{\"label\":\"QUOTE\",\"frame\":\"ས་སྙིང་འཁོར་ལོ་བཅུ་པ་ལས།\",\"head\":\"མེ་ཏོག་ཙམ་པ་ཀ་ནི་རྙིང་གྱུར་ཀྱང༌།\",\"tail\":\"མུ་སྟེགས་བྱེད་དག་གཞན་གྱི་དོ་ཟླ་མིན།\"},{\"label\":\"QUOTE\",\"head\":\"སངས་རྒྱས་སྤྱན་གྱིས་ཞིང་གང་ངས་མཐོང་བ།\",\"tail\":\"དེ་ནི་བསོད་ནམས་ཆུང་ཞེས་ང་སྨྲའོ།\"},{\"label\":\"QUOTE\",\"frame\":\"དབྱིག་གཉེན་གྱིས།\",\"head\":\"མི་མཁས་པས་ནི་སྡིག་པ་ཆུང་ངུས་བྱས་ནའང་འོག་ཏུ་འགྲོ།\",\"tail\":\"དེ་ཉིད་སྣོད་དུ་བྱས་ན་ཆེ་ཡང་སྟེང་ན་འཕྱོ་བར་འགྱུར།\"},{\"label\":\"QUOTE\",\"frame\":\"རབ་ཏུ་བྱུང་བའི་གཞི་ལས།\",\"head\":\"གང་ཞིག་སྔ་མ་བག་མེད་པ།\",\"tail\":\"འཇིག་རྟེན་འདི་ནི་སྣང་བར་འགྱུར།\"},{\"label\":\"QUOTE\",\"frame\":\"དཔལ་ལྡན་ཟླ་བས།\",\"head\":\"ཉན་ཐོས་སངས་རྒྱས་འབྲིང་རྣམས་ཐུབ་དབང་སྐྱེས།\",\"tail\":\"བྱང་ཆུབ་སེམས་ནི་རྒྱལ་སྲས་རྣམས་ཀྱི་རྒྱུ།\"},{\"label\":\"QUOTE\",\"frame\":\"མཉམ་མེད་ཇོ་བོས།\",\"head\":\"སོ་སོར་ཐར་པའི་རིགས་བདུན་གྱིས།\",\"tail\":\"སྐལ་བ་ཡོད་ཀྱི་གཞན་དུ་མིན།\"},{\"label\":\"QUOTE\",\"frame\":\"འཕྲུལ་ངག་བདེན་པའི་མདོ་ལས།\",\"head\":\"དབང་མེད་ལས་ཀྱི་རྣམ་སྨིན་འབྱུང་བ་ལ།\",\"tail\":\"སངས་རྒྱས་བཅོམ་ལྡན་འདས་ནི་མངའ་མི་མཛད།\"},{\"label\":\"QUOTE\",\"frame\":\"ནམ་མཁའ་མཛོད་ཀྱིས་ཞུས་པའི་མདོ་ལས།\",\"head\":\"ཇི་ལྟར་སྨན་ཤིང་ལྗོན་པ་ལྟ་སྡུག་ལ།\",\"tail\":\"རྫོགས་པའི་སངས་རྒྱས་སྨན་ཤིང་དེ་བཞིན་ནོ།\"},{\"label\":\"QUOTE\",\"frame\":\"ཞི་བ་ལྷས།\",\"head\":\"ཆོས་གོས་གསུམ་མ་གཏོགས་པ་སྦྱིན།\",\"tail\":\"དོན་ཆེན་སྒྲུབ་པའི་རྒྱུར་བཏང་ངོ༌།\"},{\"label\":\"QUOTE\",\"frame\":\"ཞི་བ་ལྷས།\",\"head\":\"གང་ཞིག་དེ་འདྲའི་རྒྱལ་སྲས་སྦྱིན་བདག་ལ།\",\"tail\":\"དམྱལ་བར་གནས་པར་འགྱུར་ཞེས་ཐུབ་པས་གསུངས།\"},{\"label\":\"QUOTE\",\"frame\":\"བསོད་ནམས་ཐམས་ཅད་བསྡུས་པ་ཏིང་ངེ་འཛིན་གྱི་མདོ་ལས།\",\"head\":\"བྱང་ཆུབ་སེམས་དཔའ་ནག་པོའི་ཆོས་བཞི་དང་ལྡན་ན་བྱང་ཆུབ་ཀྱི་སེམས་བརྗེད་པར་འགྱུར།\",\"tail\":\"\"},{\"label\":\"QUOTE\",\"frame\":\"རྒྱ་ཆེར་རོལ་པ་ལས།\",\"head\":\"ཉོན་མོངས་རྩ་བ་བག་ཉལ་བཅས།\",\"tail\":\"ཐོང་ལྕགས་ཀྱིས་ནི་མ་ལུས་བཏོན།\"},{\"label\":\"QUOTE\",\"frame\":\"ཏིང་འཛིན་རྒྱལ་པོ་ལས།\",\"head\":\"རྟག་དང་ཆད་པ་འདི་ཡང་མཐའ་ཡིན་ཏེ།\",\"tail\":\"མཁས་པས་དབུས་ལའང་གནས་པར་མི་བྱེད་དོ།\"},{\"label\":\"QUOTE\",\"frame\":\"འཕགས་པ་སྒྲ་ཅན་འཛིན་གྱིས།\",\"head\":\"སྨྲ་བསམ་བརྗོད་མེད་ཤེས་རབ་ཕ་རོལ་ཕྱིན།\",\"tail\":\"དུས་གསུམ་རྒྱལ་བའི་ཡུལ་ལ་ཕྱག་འཚལ་ལོ།\"},{\"label\":\"QUOTE\",\"frame\":\"ཀླུ་སྒྲུབ་ཀྱིས།\",\"head\":\"གཞན་ལས་ཤེས་མིན་ཞི་བ་དང༌།\",\"tail\":\"དེ་ནི་དེ་ཡི་མཚན་ཉིད་དོ།\"},{\"label\":\"QUOTE\",\"head\":\"སྤྲིན་མཐོང་མཁའ་ལ་ཉི་བཞིན་འདིར་ཁྱོད་ཕྱོགས་གཅིག་བློ་གྲོས་ཅན།\",\"tail\":\"ཤེས་བྱ་མཐའ་མེད་མཁའ་དབྱིངས་ཁྱབ་པ་དེ་དག་གིས་ཀུན་མཐོང༌།\"},{\"label\":\"QUOTE\",\"head\":\"ཉན་ཐོས་རྣམས་ཀྱི་ཆོས་དབྱིངས་དང༌།\",\"tail\":\"ང་ཡི་རྣམ་པར་གྲོལ་བའང་གཅིག\"},{\"label\":\"QUOTE\",\"frame\":\"དབུ་མ་རྩ་བར།\",\"head\":\"བཅོམ་ལྡན་འདས་ཀྱི་ཆོས་གང་ཞིག\",\"tail\":\"སྟོང་ཉིད་ཡོངས་སུ་བསྟན་པ་ཡིན།\"},{\"label\":\"QUOTE\",\"frame\":\"ཡེ་ཤེས་རྒྱས་པ་ལས།\",\"head\":\"ཇི་ལྟར་སྒྱུ་མའི་མཁན་པོ་དག\",\"tail\":\"ཐབས་ལ་མཁས་པ་རྣམ་པར་སྤྱོད།\"},{\"label\":\"QUOTE\",\"frame\":\"ལང་ཀར་གཤེགས་པའི་མདོའི་...ལེའུ་ལྔ་པ་ལས།\",\"head\":\"སེམས་ཙམ་ས་ནི་བདུན་པ་སྟེ།\",\"tail\":\"དེ་ནི་ང་ཡི་ས་ཡིན་ནོ།\"},{\"label\":\"QUOTE\",\"frame\":\"ཕལ་ཆེན་ལས།\",\"head\":\"ཀྱེ་རྒྱལ་བའི་སྲས་དག་ཁམས་གསུམ་པོ་འདི་ནི་སེམས་ཙམ་མོ།\",\"tail\":\"\"},{\"label\":\"QUOTE\",\"frame\":\"རྒྱ་ཆེར་རོལ་པ་ལས།\",\"head\":\"གང་ཚེ་འདི་ན་སྐྱེ་འཆི་གང་མེད་པ།\",\"tail\":\"སངས་རྒྱས་མར་མེ་མཛད་ཀྱིས་བདག་ལུང་བསྟན།\"},{\"label\":\"QUOTE\",\"frame\":\"རྒྱུད་བླ་མ་ལས།\",\"head\":\"མ་དག་མ་དག་དག་པ་དང༌།\",\"tail\":\"དེ་བཞིན་གཤེགས་པ་ཞེས་བརྗོད་དོ།\"},{\"label\":\"QUOTE\",\"frame\":\"ས་བཅུའི་མདོ་ལས།\",\"head\":\"ས་དང་པོ་དེ་ལ་གནས་པའི་བྱང་ཆུབ་སེམས་དཔའ་ནི།\",\"tail\":\"དབང་ཕྱུག་ཆེན་པོ་ལ་དབང་དུ་ཐོབ་ལ།\"},{\"label\":\"QUOTE\",\"frame\":\"སྙིང་པོ་མདོར་བསགས་ལས།\",\"head\":\"སངས་རྒྱས་ལ་སོགས་ཞིང་རྣམས་ལ།\",\"tail\":\"ཞིང་བཟང་པོ་ལ་ས་བོན་གདབ།\"},{\"label\":\"QUOTE\",\"frame\":\"ཞི་བ་ལྷས།\",\"head\":\"ཡོངས་སུ་བཟུང་བ་མེད་པ་དེ་དག་ཀུན།\",\"tail\":\"བདག་ལ་བརྩེར་དགོངས་བདག་གི་འདི་དག་བཞེས།\"},{\"label\":\"QUOTE\",\"frame\":\"ཡུམ་རྒྱས་པ་ལས།\",\"head\":\"ཤཱ་རིའི་བུས་ཀཱཽ་ཤི་ཀ་བཅོམ་ལྡན་འདས་ཀྱི་དང་པོ་ཐུགས་བསྐྱེད་པ་ནས།\",\"tail\":\"ཐམས་ཅད་མཁྱེན་པ་ཉིད་དུ་བསྔོ་བར་བདག་གི་ཞུ་བ་སྐྱེས་སོ།\"},{\"label\":\"QUOTE\",\"frame\":\"མི་གཡོ་བའི་རྒྱུད་ལས།\",\"head\":\"བཅོམ་ལྡན་འདས་ཀྱིས་བསགས་པ་ཡི།\",\"tail\":\"བླ་མེད་གོ་འཕང་ཐོབ་པར་ཤོག\"},{\"label\":\"QUOTE\",\"frame\":\"ཤེས་མདོར།\",\"head\":\"རབ་འབྱོར་ཡོངས་སུ་བསྔོ་བ་གང་ཡིན་པ་དེ་ནི།\",\"tail\":\"ཆོས་ཀྱི་དབྱིངས་ཡོངས་སུ་བསྔོ་བ་སྟེ།\"},{\"label\":\"QUOTE\",\"frame\":\"རྒྱན་སྟུག་པོ་བཀོད་པ་ལས།\",\"head\":\"དེས་ན་ཤེལ་དང་མེ་ཤེལ་དག\",\"tail\":\"བསྔོས་ན་འབྲས་བུ་སྨིན་པར་འགྱུར།\"},{\"label\":\"QUOTE\",\"frame\":\"ཞི་བ་ལྷས།\",\"head\":\"བྱང་ཆུབ་སེམས་དཔའ་རྣམས་ཀྱིས་ནི།\",\"tail\":\"འགྲོ་དོན་ཐུགས་ལ་དགོངས་འགྲུབ་ཤོག\"},{\"label\":\"QUOTE\",\"frame\":\"འཇམ་དཔལ་མཚན་བརྗོད་ལས།\",\"head\":\"འདས་པའི་སངས་རྒྱས་རྣམས་ཀྱིས་གསུང༌།\",\"tail\":\"ཡང་དང་ཡང་དུ་གསུང་བ་གང༌།\"},{\"label\":\"QUOTE\",\"frame\":\"འདུས་པ་ལས།\",\"head\":\"མདོར་ན་ཕུང་པོ་ལྔ་རྒྱལ་བ།\",\"tail\":\"མེ་དང་རླུང་དུ་རབ་ཏུ་གྲགས།\"},{\"label\":\"QUOTE\",\"frame\":\"ཡེ་ཤེས་གྲུབ་པ་ལས།\",\"head\":\"དབང་པོ་གཉིས་སྦྱོར་བདེ་བ་ནི།\",\"tail\":\"ཅི་ཡི་ཕྱིར་ན་བདེ་ཆེན་ཡིན།\"},{\"label\":\"QUOTE\",\"frame\":\"ཀྱེ་རྡོར་ལས།\",\"head\":\"འདི་དག་དབང་གིས་སེམས་ཅན་རྣམས།\",\"tail\":\"སེམས་ཅན་ས་བཅུའི་དབང་ཕྱུག་གོ\"},{\"label\":\"QUOTE\",\"frame\":\"བྲམ་ཟེ་ཆེན་པོས།\",\"head\":\"ཐེག་པ་ཆེན་པོ་བླ་མེད་སྙིང་པོའི་ལམ་འདི་ནི།\",\"tail\":\"སྦྱངས་པའི་གཙོ་བོར་གྱུར་པ་བསགས་པ་ལས་ནི་འབྱུང༌།\"},{\"label\":\"QUOTE\",\"frame\":\"འཇམ་དཔལ་རྩ་རྒྱུད་ལས།\",\"head\":\"གང་ཞིག་དཀྱིལ་འཁོར་མ་མཐོང་བར།\",\"tail\":\"རྨིག་རྒྱུའི་ཆུ་ནི་འཐུང་དང་མཚུངས།\"},{\"label\":\"QUOTE\",\"frame\":\"རྣམ་སྣང་མངོན་བྱང་ལས།\",\"head\":\"མི་དགེ་བ་བཅུ་སྤོང་བའོ་ཞེས་གསུངས་པ་ལས་མི་དགེ་བ་བཅུ་ནི་མཚན་ཉིད་མེད་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ།\",\"tail\":\"དམ་ཚིག་དང་སྡོམ་པ་ཐ་དད་པར་འགྱུར་ཞེས་སོ།\"},{\"label\":\"QUOTE\",\"frame\":\"རྒྱུད་བླ་མ་ལས།\",\"head\":\"རྫོགས་སངས་སྐུ་ནི་འཕྲོ་ཕྱིར་དང༌།\",\"tail\":\"དེ་བསལ་ན་ནི་སངས་རྒྱས་ཉིད།\"},{\"label\":\"QUOTE\",\"frame\":\"གསང་བ་རྒྱ་མཚོ་ལས།\",\"head\":\"ཤེས་བྱའི་དཀྱིལ་འཁོར་མ་ལུས་འདི་དག་ཐམས་ཅད་ནི།\",\"tail\":\"སྐུ་གསུམ་འདུ་བྲལ་མེད་པ་རྡོ་རྗེའི་ཐེག་པའོ།\"},{\"label\":\"QUOTE\",\"frame\":\"ཡེ་ཤེས་གྲུབ་པ་ལས།\",\"head\":\"ལུས་ཀྱིས་སྤུད་པ་གང་ཡིན་དང༌།\",\"tail\":\"སྦུད་པ་ཡིས་ནི་བྱ་བ་ནོན།\"},{\"label\":\"QUOTE\",\"frame\":\"ཀྱེ་རྡོ་རྗེ་ལས།\",\"head\":\"ཁུ་བ་མེད་ན་བདེ་མེད་འགྱུར།\",\"tail\":\"བདེ་བ་མེད་ན་དེ་མེད་འགྱུར།\"},{\"label\":\"QUOTE\",\"frame\":\"རིག་འཛིན་ཆོས་གྲགས་ཀྱིས་ཀྱང༌།\",\"head\":\"ཇི་ལྟར་ཞེ་ན་ད་ལྟའི་རྟོགས་ལྡན་པ།\",\"tail\":\"འབད་པས་ཉོ་བ་འདི་རྣམས་མ་མཐོང་ངམ།\"},{\"label\":\"QUOTE\",\"frame\":\"དུས་ཀྱི་འཕེལ་འགྲིབ་...སྙིང་རྗེ་པད་དཀར་ལས།\",\"head\":\"སྔོན་བསྐལ་པ་གྲངས་མེད་འདས་པའི་ཕ་རོལ་ཡང་དག་འདྲེན་ཞེས་བྱ་བའི།\",\"tail\":\"ཚེ་ལོ་ལྔ་བརྒྱའི་བར་དུ་ཡར་འཕེལ་བར་གསུང་བ་བཞིན་ནོ།\"},{\"label\":\"QUOTE\",\"frame\":\"རིག་འཛིན་ཆོས་གྲགས་ཀྱིས།\",\"head\":\"དེང་སང་ཕྱོགས་རིས་ངན་སྔགས་གྱི་ན་བས།\",\"tail\":\"བཞུགས་གནས་རྡོ་རྗེའི་ཁབ་རྩེའི་ཞིང་ཁམས་བཟང༌།\"},{\"label\":\"QUOTE\",\"frame\":\"གཤིན་རྗེ་མི་རུ་ཙེའི་རྒྱུད་ལས།\",\"head\":\"རང་རིག་གསལ་བའི་ཐུགས་རྗེ་ཡིས།\",\"tail\":\"དམྱལ་བའི་སྐྱེ་བ་མནར་མེད་ལེན།\"},{\"label\":\"QUOTE\",\"frame\":\"འཇམ་དཔལ་རྩ་རྒྱུད་ལས།\",\"head\":\"སྙིང་རྗེ་མཆོག་ལྡན་སངས་རྒྱས་དང༌།\",\"tail\":\"ལས་རྣམས་ཐམས་ཅད་བསྟན་པ་ཡིན།\"},{\"label\":\"QUOTE\",\"frame\":\"སྙིང་པོ་རྒྱན་གྱི་རྒྱུད་ལས།\",\"head\":\"མདོ་སོགས་བསྟན་པའི་དམྱལ་བ་རུ།\",\"tail\":\"གནས་པར་འགྱུར་བ་ང་ཡི་བསྟན།\"},{\"label\":\"QUOTE\",\"frame\":\"ཏིང་འཛིན་རྒྱལ་པོ་ལས།\",\"head\":\"འཇིག་རྟེན་པ་དག་སྟོང་ཉིད་བསྒོམ་ན་ཡང༌།\",\"tail\":\"ལྷག་སྤྱོད་ཀྱིས་ནི་ཏིང་འཛིན་འདིར་བསྒོམ་བཞིན།\"},{\"label\":\"QUOTE\",\"frame\":\"སློབ་དཔོན་ཡེ་ཤེས་སྙིང་པོས།\",\"head\":\"སྐྱེ་མེད་ཅེས་དང་སྟོང་ཞེས་དང༌།\",\"tail\":\"དེ་ནི་འདི་ལ་བདག་བསྒོམ་མོ།\"},{\"label\":\"QUOTE\",\"frame\":\"ཀུན་མཁྱེན་ཀློང་ཆེན་པས།\",\"head\":\"ཚུལ་འདི་མི་ཤེས་སྟོང་པ་ཕྱང་ཆད་པ།\",\"tail\":\"ནམ་མཁའ་ཡིད་ཅན་ཐལ་བས་བྱུགས་བར་རུང༌།\"},{\"label\":\"QUOTE\",\"frame\":\"འཇིག་རྟེན་མགོན་པོས།\",\"head\":\"རང་སེམས་མི་སྒོམ་སེམས་ཀྱི་ཡུལ་མི་བསྒོམ།\",\"tail\":\"རེ་བ་དེ་ཡང་སྒོམ་པར་མི་བྱའོ།\"},{\"label\":\"QUOTE\",\"frame\":\"རིག་འཛིན་ཆོས་གྲགས་ཀྱིས།\",\"head\":\"རང་ཉིད་ལོག་འཁྲུལ་ལམ་དུ་ཞུགས་ཟིན་ནས།\",\"tail\":\"གཞན་ཡང་ལམ་དེར་འཁྲིད་པ་དེང་སང་མང༌།\"},{\"label\":\"QUOTE\",\"frame\":\"རྒྱལ་བའི་དབང་པོ་ཀློང་ཆེན་པས།\",\"head\":\"ལྟ་བ་ཟོལ་ལ་གདེང་དུ་མ་ཆུད་པའི།\",\"tail\":\"བསླུ་བྲིད་དབང་དུ་མ་སོང་ཤིན་ཏུ་གཅེས།\"},{\"label\":\"QUOTE\",\"frame\":\"ཏིང་འཛིན་རྒྱལ་པོ་ལས།\",\"head\":\"ཏིང་འཛིན་རྒྱལ་པོ་སྟོང་པ་འདི་བསྒོམ་པས།\",\"tail\":\"བྱིས་པ་མི་རིག་བརྩོན་པ་མི་ཤེས་སོ།\"},{\"label\":\"QUOTE\",\"frame\":\"འཇིག་རྟེན་མགོན་པོའི་ཞལ་སྔ་ནས་ཀྱང༌།\",\"head\":\"བུ་དང་འདྲ་བའི་སློབ་མ་རྣམས།\",\"tail\":\"སྙིང་གཏམ་ཁ་ཆེམས་འདི་ལས་མེད།\"},{\"label\":\"QUOTE\",\"head\":\"ཚུལ་ཁྲིམས་ཉིད་ལས་གཞན་པའི་སྟོང་པ་ཉིད།\",\"tail\":\"འཇིག་རྟེན་མགོན་པོས་གསུངས་ཏེ་ང་འདིར་ཤི།\"},{\"label\":\"QUOTE\",\"head\":\"ཕྱག་རྒྱ་ཆེན་པོ་ནམ་མཁའ་ཡངས་པ་ལ།\",\"tail\":\"མཐོང་དང་བསྒོམ་པས་སྤོང་བར་མི་འགྱུར་ཞེས།\"},{\"label\":\"QUOTE\",\"frame\":\"སློབ་དཔོན་ཏོག་ཙེ་པས།\",\"head\":\"དུབ་པ་སེམས་ཉིད་མགྲོན་པོ་དག\",\"tail\":\"བློ་འདས་ཕྱག་རྒྱ་ཆེན་པོའོ།\"},{\"label\":\"QUOTE\",\"frame\":\"ཞི་བ་ལྷས།\",\"head\":\"ཞི་གནས་རབ་ཏུ་ལྡན་པའི་ལྷག་མཐོང་གིས།\",\"tail\":\"འཇིག་རྟེན་ཆགས་པ་མེད་ལ་མངོན་དགས་འགྲུབ།\"},{\"label\":\"QUOTE\",\"frame\":\"ཀླུ་སྒྲུབ་ཀྱིས།\",\"head\":\"ཤེས་རབ་མེད་པར་བསམ་གཏན་ཡོད་མིན་ཏེ།\",\"tail\":\"རྒྱ་མཚོ་གནག་རྗེས་ལྟ་བུ་བཙལ་བར་བགྱི།\"},{\"label\":\"QUOTE\",\"frame\":\"ལྗོན་པས་ཞུས་པའི་མདོ་ལས།\",\"head\":\"རྒྱུ་ལ་བརྟེན་པའི་མཁས་པ་བཅོམ་ལྡན་འདས།\",\"tail\":\"ལྟ་བའི་མུན་བྲལ་ཁྱོད་ལ་ཕྱག་འཚལ་ལོ།\"},{\"label\":\"QUOTE\",\"frame\":\"ཏིང་འཛིན་རྒྱལ་པོ་ལས།\",\"head\":\"ཆོས་ཉིད་ལས་ཀྱི་རྣམ་སྨིན་མེད་ཤེས་ཀྱང༌།\",\"tail\":\"དགེ་དང་མི་དགེ་ལས་ནི་ཆུད་མི་ཟ།\"},{\"label\":\"QUOTE\",\"frame\":\"བྱང་ཆུབ་སེམས་འགྲེལ་ལས།\",\"head\":\"ཆོས་རྣམས་སྟོང་པ་ཉིད་ཤེས་ནས།\",\"tail\":\"རྨད་བྱུང་བས་ཀྱང་འདི་རྨད་བྱུང༌།\"},{\"label\":\"QUOTE\",\"frame\":\"ཨོ་རྒྱན་རྡོ་རྗེ་འཆང་གིས།\",\"head\":\"ང་ལྟ་བ་ནམ་མཁའ་བས་ཀྱང་མཐོ།\",\"tail\":\"ལས་རྒྱུ་འབྲས་བག་ཕྱེ་བས་ཀྱང་ཞིབ།\"},{\"label\":\"QUOTE\",\"frame\":\"རྒྱལ་བའི་དབང་པོ་ཀློང་ཆེན་པས།\",\"head\":\"སངས་རྒྱས་འདོད་ལ་གཅེས་པ་རྣམ་དྲུག་ནི།\",\"tail\":\"མཐོན་པོར་ཕྱིན་ཡང་འདི་དྲུག་མ་འབྲལ་གཅེས།\"},{\"label\":\"QUOTE\",\"frame\":\"མགོན་པོ་བྱམས་པས།\",\"head\":\"མགོ་ལ་སེམས་ཅན་ཁུར་ཆེན་ཁུར་བ་ཡིས།\",\"tail\":\"བརྩོན་པ་བརྒྱ་འགྱུར་དུ་ནི་བྱ་བ་རིགས།\"},{\"label\":\"QUOTE\",\"frame\":\"ཀླུ་སྒྲུབ་ཀྱིས།\",\"head\":\"དེ་ལྟར་རྣལ་འབྱོར་པ་རྣམས་ཀྱིས།\",\"tail\":\"འགྱུར་བ་ཉིད་དུ་ཐེ་ཚོམ་མེད།\"},{\"label\":\"QUOTE\",\"frame\":\"ཏིང་འཛིན་རྒྱལ་པོ་ལས།\",\"head\":\"གླང་ཆེན་བཞུགས་ཀྱང་མཉམ་པར་བཞག\",\"tail\":\"གླང་ཆེན་གཤེགས་ཀྱང་མཉམ་པར་བཞག\"},{\"label\":\"QUOTE\",\"frame\":\"སྒྱུ་འཕྲུལ་དྲྭ་བ་ཆེན་པོ་ལས།\",\"head\":\"ཀུན་ཤེས་ཀུན་རིག་དམ་པ་པོ།\",\"tail\":\"རྣམ་པར་རྟོག་མེད་ལྷུན་གྱིས་གྲུབ།\"},{\"label\":\"QUOTE\",\"frame\":\"ཡེ་ཤེས་སྣང་བ་རྒྱན་གྱི་མདོ་ལས།\",\"head\":\"ཆོས་ཀུན་སྒྱུ་མ་ཐུགས་སུ་ཆུད།\",\"tail\":\"མི་བརྟེན་ཁྱོད་ལ་ཕྱག་འཚལ་ལོ།\"},{\"label\":\"QUOTE\",\"frame\":\"རྒྱུད་བླ་མ་ལས།\",\"head\":\"ཇི་ལྟར་སྤྲིན་མེད་མཁའ་ཡི་ཟླ་བའི་གཟུགས།\",\"tail\":\"རྫོགས་སངས་དཀྱིལ་འཁོར་ནང་དུ་མཐོང་བར་འགྱུར།\"},{\"label\":\"QUOTE\",\"frame\":\"ཀླུ་སྒྲུབ་ཀྱིས།\",\"head\":\"བྱང་ཆུབ་སེམས་ཀྱི་རང་བཞིན་སྐུ།\",\"tail\":\"དཔལ་ལྡན་རྡོ་རྗེ་འཆང་ལ་འདུད།\"},{\"label\":\"QUOTE\",\"frame\":\"ཡབ་སྲས་མཇལ་བའི་མདོ་ལས།\",\"head\":\"དཔའ་བོ་ཆེན་པོ་ཐབས་མཁས་ཏེ།\",\"tail\":\"སངས་རྒྱས་མང་པོ་སྟོན་པར་མཛད།\"},{\"label\":\"QUOTE\",\"frame\":\"མྱང་འདས་ལས།\",\"head\":\"ལོང་བ་མ་ལགས་ལོང་བ་ལྟར།\",\"tail\":\"འཇིག་རྟེན་རྣམས་ཀྱིས་རྟོགས་མི་ནུས།\"},{\"label\":\"QUOTE\",\"frame\":\"འཕགས་པ་སྡུད་པ་ལས།\",\"head\":\"རྒྱལ་བའི་ཉན་ཐོས་པ་དག་ཇི་སྙེད་ཆོས་སྟོན་དང༌།\",\"tail\":\"དེ་དག་ཀུན་ཀྱང་དེ་བཞིན་གཤེགས་པའི་སྐྱེས་བུའི་མཐུ།\"},{\"label\":\"QUOTE\",\"frame\":\"རིག་འཛིན་ཆོས་གྲགས་ཀྱིས། རྒྱུད་གསང་བའི་སྙིང་པོ་ལས།\",\"head\":\"སྲིད་གསུམ་ཡེ་ནས་སངས་རྒྱས་ཞིང༌།\",\"tail\":\"སངས་རྒྱས་ཉིད་ཀྱིས་མི་བརྙེས་སོ།\"},{\"label\":\"QUOTE\",\"frame\":\"བཟང་པོ་སྤྱོད་པ་ལས།\",\"head\":\"ནམ་མཁའི་མཐར་ཐུག་གྱུར་པ་ཇི་ཙམ་པར།\",\"tail\":\"བདག་གི་སྨོན་ལམ་མཐའ་ཡང་དེ་ཙམ་མོ།\"},{\"label\":\"QUOTE\",\"frame\":\"བྱམས་པས།\",\"head\":\"སྐུ་གསུམ་དག་གི་སངས་རྒྱས་ཀྱི།\",\"tail\":\"སྐུ་བསྡུས་པར་ནི་ཤེས་པར་བྱ།\"}]}",
