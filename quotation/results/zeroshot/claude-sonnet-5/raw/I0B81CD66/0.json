  "raw_text": "{\"spans\":[{\"label\":\"QUOTE\",\"frame\":\"དེ་ཡང་སམྦུ་ཊི་ལས།\",\"head\":\"ཐིག་ལེའི་གཟུགས་ཅན་མི་ཤིགས་པ།\",\"tail\":\"ས་བོན་གཟུགས་ཀྱིས་ཡང་དག་གནས།\"},{\"label\":\"QUOTE\",\"frame\":\"ཧེ་བཛྲ་ལས།\",\"head\":\"ཀུན་རྫོབ་ཀུནྡ་ལྟ་བུ་ཉིད།\",\"tail\":\"དོན་དམ་བདེ་བའི་གཟུགས་ཅན་ནོ།\"},{\"label\":\"QUOTE\",\"frame\":\"ནམ་མཁའ་དང་མཉམ་པའི་རྒྱུད་ལས།\",\"head\":\"མི་ཤིགས་ཧཾ་གི་དབྱིབས་འདྲ་སྟེ།\",\"tail\":\"དཀར་ལ་འཚེར་དང་གཟི་མདངས་སྣུམ།\"},{\"label\":\"QUOTE\",\"frame\":\"སམྦུ་ཊི་ལས།\",\"head\":\"རྒོད་མའི་མེ་ཡི་གཟུགས་ཀྱིས་ནི།\",\"tail\":\"\"},{\"label\":\"QUOTE\",\"frame\":\"སྡོམ་འབྱུང་ལས།\",\"head\":\"རྒོད་མའི་མེ་འདྲའི་ངོ་བོ་ཉིད།\",\"tail\":\"\"},{\"label\":\"QUOTE\",\"frame\":\"ནམ་མཁའ་དང་མཉམ་པ་ལས།\",\"head\":\"དམར་ལ་དྭངས་པའི་རང་བཞིན་ལས།\",\"tail\":\"འདི་ནི་ཤེས་རབ་བྱང་ཆུབ་སེམས།\"},{\"label\":\"QUOTE\",\"frame\":\"སྡོམ་འབྱུང་ལས།\",\"head\":\"ཤེས་རབ་གཟུགས་ཀྱིས་ལ་ལཱ་ན།\",\"tail\":\"སྣ་ཚོགས་གཟུགས་ཅན་ནོར་བུ་བཞིན།\"},{\"label\":\"QUOTE\",\"frame\":\"སྡོམ་བྱུང་རྡོ་རྗེ་མཁའ་འགྲོར་གསུངས།\",\"head\":\"དཔྱིད་དང་ཐིག་ལེ་ཞེས་ཀྱང་བཤད།\",\"tail\":\"སྡོམ་བྱུང་རྡོ་རྗེ་མཁའ་འགྲོར་གསུངས།\"},{\"label\":\"QUOTE\",\"frame\":\"ནག་པོ་པའི་སྒྲུབ་ཐབས་ཀྱི་གཞུང་ལས།\",\"head\":\"གཞོམ་མེད་ཧཾ་སྟེ་ས་བོན་ནི།\",\"tail\":\"དཔྱིད་ཀྱི་ཐིག་ལེར་བརྗོད་པ་སྟེ།\"},{\"label\":\"QUOTE\",\"frame\":\"སྡོམ་པ་འབྱུང་བ་ལས།\",\"head\":\"སྤྱི་བོ་བདེ་ཆེན་འཁོར་ལོ་སྟེ།\",\"tail\":\"བྱང་ཆུབ་སྙིང་པོའི་ངོ་བོ་ཉིད།\"},{\"label\":\"QUOTE\",\"frame\":\"ཧེ་བཛྲ་ལས།\",\"head\":\"ཁུ་བའི་རྣམ་པ་བཅོམ་ལྡན་ཡིན།\",\"tail\":\"དེ་ཡི་བདེ་བ་འདོད་མར་བརྗོད།\"},{\"label\":\"QUOTE\",\"frame\":\"སྡོམ་འབྱུང་ལས།\",\"head\":\"ལྟེ་བའི་དཀྱིལ་འཁོར་ཉིད་དུ་གནས།\",\"tail\":\"རྒོད་མའི་མེ་འདྲའི་ངོ་བོ་ཉིད།\"},{\"label\":\"QUOTE\",\"head\":\"ཚངས་པའི་གནས་སུ་ཡང་དག་གནས།\",\"tail\":\"དཔྱིད་ཅེས་བྱ་བར་ཡང་དག་བཤད།\"},{\"label\":\"QUOTE\",\"frame\":\"སམྦུ་ཊི་ལས།\",\"head\":\"ཤེས་རབ་མེ་ནི་ཆེར་འབར་བས།\",\"tail\":\"སྒོམ་པ་མཚུངས་པར་སྣང་བ་ཉིད།\"},{\"label\":\"QUOTE\",\"frame\":\"ཡན་ལག་བརྒྱད་པ་ལས།\",\"head\":\"ལུས་ཟུངས་དྭངས་མ་ཁྲག་དང་ཤ།\",\"tail\":\"གནོད་བྱ་བདུན་ཡིན།\"},{\"label\":\"QUOTE\",\"head\":\"དྭངས་མ་ལས་ཁྲག་དེ་ལས་ཤ།\",\"tail\":\"རུས་རྐང་དེ་ལས་ཁུ་བ་ཡིན།\"},{\"label\":\"QUOTE\",\"frame\":\"རྩ་རྒྱུད་ལས།\",\"head\":\"དྭངས་མ་ཁྲག་ཤ་ཚིལ་རུས་རྐང་ཁུ་བ།\",\"tail\":\"ལུས་ཟུངས་བདུན་ཡིན།\"},{\"label\":\"QUOTE\",\"frame\":\"ཡན་ལག་བརྒྱད་པ་ལས།\",\"head\":\"ཕལ་ཆེར་སྨན་ཞག་ཉིན་ཞག་ནི།\",\"tail\":\"གཅིག་གིས་ལས་རྣམས་བྱེད་ཡིན་ཏེ།\"},{\"label\":\"QUOTE\",\"frame\":\"བཤད་རྒྱུད་ལས།\",\"head\":\"སྨན་རྣམས་ཕལ་ཆེར་ཞག་གཅིག་ལས་བྱེད་འགྱུར།\",\"tail\":\"\"},{\"label\":\"QUOTE\",\"frame\":\"ནམ་མཁའ་དང་མཉམ་པ་ལས།\",\"head\":\"དམར་ལ་དྭངས་པའི་རང་བཞིན་ལས།\",\"tail\":\"འདི་ནི་ཤེས་རབ་བྱང་ཆུབ་སེམས།\"},{\"label\":\"QUOTE\",\"frame\":\"སྡོམ་འབྱུང་ལས།\",\"head\":\"ཤེས་རབ་གཟུགས་ཀྱིས་ལ་ལཱ་ན།\",\"tail\":\"སྣ་ཚོགས་གཟུགས་ཅན་ནོར་བུ་བཞིན།\"},{\"label\":\"QUOTE\",\"frame\":\"ཡན་ལག་བརྒྱད་པ་ལས།\",\"head\":\"དེ་ལ་འདོད་ཆགས་ཞེ་སྡང་གཏི་མུག་གསུམ།\",\"tail\":\"རླུང་མཁྲིས་བད་ཀན་རིམ་པས་བསྐྱེད་པའི་རྒྱུ།\"},{\"label\":\"QUOTE\",\"frame\":\"བཤད་རྒྱུད་ལས།\",\"head\":\"ནད་རྣམས་ཀུན་གྱི་རྒྱུ་ནི་གཅིག་པུ་སྟེ།\",\"tail\":\"བདག་མེད་དོན་མ་རྟོགས་པས་མ་རིག་ཅེས།\"},{\"label\":\"QUOTE\",\"frame\":\"མཛོད་ལས།\",\"head\":\"མེ་དང་ཆུ་དང་རླུང་དག་གིས།\",\"tail\":\"དེ་ཡི་སྐྱོན་དང་ཆོས་མཐུན་ཕྱིར།\"},{\"label\":\"QUOTE\",\"head\":\"བཞི་པ་ན་མེད་མི་གཡོ་ཕྱིར།\",\"tail\":\"སེམས་ཅན་བཅས་ཏེ་འབྱུང་འཇིག་ཕྱིར།\"},{\"label\":\"QUOTE\",\"head\":\"མེ་ཡིས་བདུན་ནོ་ཆུ་ཡིས་གཅིག\",\"tail\":\"མཇུག་ཏུ་རླུང་གིས་འཇིག་པ་ཡིན།\"},{\"label\":\"QUOTE\",\"frame\":\"དུས་འཁོར་རྩ་རྒྱུད་ལས།\",\"head\":\"དབྱུང་བ་ཡིས་ནི་མཁྲིས་པའི་གཤེད་ཡིན\",\"tail\":\"རླུང་ནད་མ་ལུས་པ་ལ་ཐུར་དུ་སེལ་བ་བསྡམས་པ་ཡིས་ནི་སེལ་བར་འགྱུར།\"},{\"label\":\"QUOTE\",\"frame\":\"ཤོང་འགྱུར་ལས།\",\"head\":\"ཐུར་སེལ་བསྐུམ་ན་འདོད་པར་འགྱུར་ཏེ\",\"tail\":\"ལྟེ་བའི་རྩ་བར་གཞན་པ་དག་ཀྱང་ངོ་།\"},{\"label\":\"QUOTE\",\"frame\":\"བརྟག་གཉིས་ལས།\",\"head\":\"སྐྱེ་བོ་མི་ཟད་པ་ཡི་ལས།\",\"tail\":\"སྲིད་པའི་འཆིང་བ་ལས་གྲོལ་འགྱུར།\"},{\"label\":\"QUOTE\",\"frame\":\"རྒྱུད་བླ་ལས།\",\"head\":\"དེས་ན་སངས་རྒྱས་མ་ཐོབ་པར།\",\"tail\":\"\"},{\"label\":\"QUOTE\",\"frame\":\"རྒྱུད་བླ་ལས།\",\"head\":\"སྐྱེ་འཆི་ན་དང་རྒ་བ་ལས་གྲོལ་ཞིང་།\",\"tail\":\"བློ་ལྡན་འགྲོ་ལ་སྙིང་རྗེ་བསྐྱེད་ཕྱིར་འཇུག\"},{\"label\":\"QUOTE\",\"head\":\"དེ་ནི་འཇིག་རྟེན་ཐམས་ཅད་ལས།\",\"tail\":\"སྐྱེས་ཀྱང་འཇིག་རྟེན་ཆོས་མ་གོས།\"},{\"label\":\"QUOTE\",\"frame\":\"དུས་འཁོར་ལས།\",\"head\":\"དེ་ལྟར་སེམས་ནི་རྣམ་བཞི་སྲིད་པ་གསུམ་ལ་གནས་པའི་སྲོག་ཆགས་རྣམས་ཀྱི་ཐིག་ལེའི་དབུས་སུ་སྟེ།\",\"tail\":\"ཐར་པ་གང་། །དེ་ཕྱིར་འཁོར་བའི་བདེ་བ་སྐད་ཅིག་འདི་ནི་སྡོམ་བརྩོན་རྣམས་ཀྱིས་ཐམས་ཅད་དུས་སུ་སྤང་བར་བྱ།\"},{\"label\":\"QUOTE\",\"head\":\"དང་པོ་དགའ་ལྡན་འདོད་ཆགས་ཡིན།\",\"tail\":\"རྗེས་ལ་ཆགས་བྲལ་ཞེ་སྡང་སེམས།\"},{\"label\":\"QUOTE\",\"frame\":\"རྩ་རྒྱུད་ལས།\",\"head\":\"མཆོག་ཏུ་མི་འགྱུར་ཉི་ཁྲི་དང་།\",\"tail\":\"རང་ཉིད་རྡོ་རྗེ་སེམས་པར་འགྱུར།\"},{\"label\":\"QUOTE\",\"frame\":\"རྒྱུད་ལས།\",\"head\":\"གཟུགས་བརྙན་མཐོང་བར་རབ་ཏུ་བྱས་ལ་ཉི་མ་སོ་སོའི་དུས་སུ་སྲོག་གི་རླུང་ནི་དགག་པར་བྱ།\",\"tail\":\"\"},{\"label\":\"QUOTE\",\"frame\":\"རྒྱུད་ལས།\",\"head\":\"ཇི་སྲིད་འོད་ཀྱི་འཁོར་ལོ་འཁོར་བས་རང་གི་ལུས་ལ་ཡོངས་སུ་བསྐོར་བ་ངེས་པར་མཐོང་བ་ན།\",\"tail\":\"\"},{\"label\":\"QUOTE\",\"frame\":\"རྒྱུད་ལས།\",\"head\":\"ཟླ་བ་དྲུག་གིས་རེག་པ་དམན་པ་ཉམས་པའི་བདེ་བ་དཀའ་ཐུབ་པ་ཡི་ལམ་གྱི་སེམས་ལས་འགྱུར།\",\"tail\":\"\"},{\"label\":\"QUOTE\",\"frame\":\"རྒྱུད་ལས།\",\"head\":\"ཆགས་དང་ཆགས་བྲལ་མཐའ་དང་ཐོག་མར་སྐད་ཅིག་མ་ལས་ཁྱབ་བདག་དབུགས་ཀྱི་གྲངས་ལ་འཕེལ་བར་འགྱུར།\",\"tail\":\"\"},{\"label\":\"QUOTE\",\"head\":\".. .དགའ་བ་བཅུ་དྲུག་ནི།\",\"tail\":\"མཐར་སོན་རྟེན་འབྲེལ་བཅུ་གཉིས་དག\"},{\"label\":\"QUOTE\",\"frame\":\"མཚན་ཡང་དག་པར་བརྗོད་པ་ལས།\",\"head\":\"མཆོད་པ་ཆེན་པོ་འདོད་ཆགས་ཆེ།\",\"tail\":\"ཆགས་པ་ཐམས་ཅད་སེལ་བར་བྱེད།\"},{\"label\":\"QUOTE\",\"head\":\"ལུས་ཀུན་མཚན་དཔེའི་མེ་ཏོག་རྒྱས།\",\"tail\":\"བཅོམ་ལྡན་དེ་ཉིད་གཟིགས་པས་གསུངས།\"},{\"label\":\"QUOTE\",\"frame\":\"བརྟག་གཉིས་ལས།\",\"head\":\"སྟོན་པ་སུམ་ཅུ་རྩ་གཉིས་མཚན།\",\"tail\":\"\"},{\"label\":\"QUOTE\",\"frame\":\"དྲི་མ་མེད་པའི་འོད་ལས།\",\"head\":\"གཟུགས་ཀྱི་རང་བཞིན་སངས་རྒྱས་ཀྱི་སྐུ་གཟུགས་སྤྲུལ་པའི་སྐུ་སྟེ།\",\"tail\":\"ལྟེ་བ་དང་བཅས་པ་དང་།\"},{\"label\":\"QUOTE\",\"frame\":\"ཡན་ལག་བརྒྱད་པ་ལས།\",\"head\":\"ཕལ་ཆེར་སྨན་ཞག་ཉིན་ཞག་ནི།\",\"tail\":\"གཅིག་གིས་ལས་རྣམས་བྱེད་ཡིན་ཏེ།\"},{\"label\":\"QUOTE\",\"frame\":\"དུས་འཁོར་ལས།\",\"head\":\"སད་དང་རྨི་ལམ་གཉིད་མཐུག་དང་།\",\"tail\":\"བཞི་པ་དབང་པོ་གཉིས་སྐྱེ་བདེ།\"},{\"label\":\"QUOTE\",\"frame\":\"ཀྱཻ་རྡོ་རྗེ་ལས།\",\"head\":\"དགའ་བས་དགའ་བ་ཙམ་ཉིད་དེ།\",\"tail\":\"ལྷག་མ་ལྷན་ཅིག་སྐྱེས་དགའ་ཉིད།\"},{\"label\":\"QUOTE\",\"frame\":\"དུས་འཁོར་ལས།\",\"head\":\"དེ་ལྟར་སེམས་ནི་རྣམ་བཞི་སྲིད་པ་གསུམ་ལ་གནས་པའི་སྲོག་ཆགས་རྣམས་ཀྱི་ཐིག་ལེའི་དབུས་སུ་སྟེ།\",\"tail\":\"ཐར་པ་གང་། །དེ་ཕྱིར་འཁོར་བའི་བདེ་བ་སྐད་ཅིག་འདི་ནི་སྡོམ་བརྩོན་རྣམས་ཀྱིས་ཐམས་ཅད་དུས་སུ་སྤང་བར་བྱ།\"},{\"label\":\"QUOTE\",\"frame\":\"རྒྱུད་བླ་ལས།\",\"head\":\"འཕགས་པས་ན་དང་འཆི་བ་དང་།\",\"tail\":\"དེ་ལ་དེ་མེད་ཕྱིར་དེ་མེད།\"},{\"label\":\"QUOTE\",\"frame\":\"རྒྱུད་བླ་ལས།\",\"head\":\"སྐྱེ་འཆི་ན་དང་རྒ་བ་ལས་གྲོལ་ཞིང་།\",\"tail\":\"བློ་ལྡན་འགྲོ་ལ་སྙིང་རྗེ་བསྐྱེད་ཕྱིར་འཇུག\"},{\"label\":\"QUOTE\",\"head\":\"དེ་ནི་འཇིག་རྟེན་ཐམས་ཅད་ལས།\",\"tail\":\"སྐྱེས་ཀྱང་འཇིག་རྟེན་ཆོས་མ་གོས།\"},{\"label\":\"QUOTE\",\"frame\":\"ཀྱཻ་རྡོར་ལས།\",\"head\":\"དགའ་བས་དགའ་བ་ཙམ་ཉིད་དེ།\",\"tail\":\"ལྷག་མ་ལྷན་ཅིག་སྐྱེས་དགའ་ཉིད།\"},{\"label\":\"QUOTE\",\"frame\":\"རྒྱུད་ཀྱི་རྒྱལ་པོ་ལས།\",\"head\":\"དངུལ་ཆུའི་དགྲ་ནི་མེ་ཉིད་ཡིན་ལ་མེ་དང་རྣམ་པར་བྲལ་ན་ནམ་ཡང་དངུལ་ཆུ་འཆིང་བ་མིན།\",\"tail\":\"འདིར་ནི་ལུས་ཕུག་པ་ཡིས་མཆོག་གི་བདེ་བ་སྟེར།\"},{\"label\":\"QUOTE\",\"frame\":\"རྒྱུད་ཀྱི་རྒྱལ་པོ་ལས།\",\"head\":\"རྒྱལ་བའི་ལྷན་སྐྱེས་བདེ་བ་འཕེལ་བའི་དོན་གྱི་རྒྱུར་ནི་ཐོག་མར་ལས་ཀྱི་ཕྱག་རྒྱ་བསྟེན་པར་བྱ།\",\"tail\":\"ལུས་སྟོབས་བདེ་སྟེར་བཟའ་བ་བཏུང་བ་ལ་སོགས་ལོངས་སྤྱོད་དང་ལྡན་རྣལ་འབྱོར་རྣམས་ཀྱིས་བསྒོམ་པར་བྱ།\"},{\"label\":\"QUOTE\",\"frame\":\"མཛོད་ལས།\",\"head\":\"སྤྱི་བོར་རྩ་འདབ་བཞི་པའི་འཁོར་ལོ།\",\"tail\":\"\"},{\"label\":\"QUOTE\",\"frame\":\"ཨང་མེད\",\"head\":\"ཇི་ལྟར་སྔར་བཞིན་ཕྱིས་དེ་བཞིན།\",\"tail\":\"འགྱུར་བ་མེད་པའི་ཆོས་ཉིད་དོ།\"},{\"label\":\"QUOTE\",\"head\":\"ཇི་ལྟར་གྲོང་ཁྱེར་སྐྱེ་བོའི་མི་གཙང་ལུད།\",\"tail\":\"དེ་ནི་སངས་རྒྱས་ཆོས་རྣམས་བསྐྱེད་ལ་ཕན།\"},{\"label\":\"QUOTE\",\"head\":\"ཐེག་མཆོག་ལ་མོས་ས་བོན་ཤེས་རབ་ནི།\",\"tail\":\"གང་ཡིན་དེ་དག་ཐུབ་པའི་རྗེས་སྐྱེས་སྲས།\"},{\"label\":\"QUOT