  "raw_text": "{\"spans\": [{\"label\": \"QUOTE\", \"frame\": \"ཟླ་བ་སྒྲོན་མེའི་མདོ་ལས།\", \"head\": \"སངས་རྒྱས་དག་ནི་བྱེ་བ་ཁྲག་ཁྲིག་དང་།\", \"tail\": \"མི་དབང་དེ་ཀུན་ང་ཡིས་བསྙེན་བཀུར་བྱས།\"}, {\"label\": \"QUOTE\", \"frame\": \"སྨན་གྱི་རྒྱུད་ཕྱི་མ་ལས།\", \"head\": \"འཕགས་པའི་ཐུགས་རྗེ་ཕྱོགས་རིས་མེད་ན་ཡང་།\", \"tail\": \"གཅིག་ཏུ་གསུངས་ཀྱང་སོ་སོས་དུ་མར་གོ\"}, {\"label\": \"QUOTE\", \"frame\": \"ཀུན་མཁྱེན་པདྨ་དཀར་པོས།\", \"head\": \"སྙིང་པོའི་ཆོས་ཕུང་སྐལ་བ་བཞིན།\", \"tail\": \"རང་རང་སོ་སོའི་སྐད་དུ་གྲགས།\"}, {\"label\": \"QUOTE\", \"frame\": \"ཀློང་ཆེན་རབ་འབྱམས་ཀྱིས།\", \"head\": \"མཐའ་ཡས་པ་མཐའ་ཡས་པའི་གསུང་གིས།\", \"tail\": \"སྟོན་པ་ཐམས་ཅད་མཁྱེན་པ་ཞེས་གསུངས།\"}, {\"label\": \"QUOTE\", \"frame\": \"མདོ་ལས།\", \"head\": \"དེ་ཡི་མངོན་མཐའ་བསྐལ་པའམ།\", \"tail\": \"ཚིག་གིས་ལེགས་པར་བརྗོད་མི་ནུས།\"}, {\"label\": \"QUOTE\", \"frame\": \"དགེ་བཤེས་སོག་བཟློག་པས།\", \"head\": \"མགོན་དེའི་སྲས་དང་འཁོར་དང་དེའི་རྗེས་འཇུག\", \"tail\": \"མཐའ་ཡས་ཕྱིར་ན་སུ་ཞིག་ལོག་པར་བལྟ།\"}, {\"label\": \"QUOTE\", \"frame\": \"བདེ་མཆོག་ཉུང་ངུའི་རྒྱུད་ལས།\", \"head\": \"མོས་པ་དུ་མའི་སེམས་ཅན་ལ།\", \"tail\": \"ཆོས་ཉིད་བསམ་མི་ཁྱབ་དྲན་བྱ།\"}, {\"label\": \"QUOTE\", \"frame\": \"བདེ་མཆོག་རྩ་རྒྱུད་ལས།\", \"head\": \"སེམས་ཅན་མོས་པ་བསམ་མི་ཁྱབ།\", \"tail\": \"ནམ་ཞིག་གོ་བའི་སྨོན་ལམ་ཐོབ།\"}, {\"label\": \"QUOTE\", \"frame\": \"རྗེ་བློ་བཟང་བསྟན་པའི་མགོན་པོས།\", \"head\": \"ཆོས་དང་གང་ཟག་སྣང་ཚུལ་ཅི་འདྲ་ཡང་།\", \"tail\": \"ཕྱོགས་ལྷུང་སྡང་ཞུགས་མི་བྱ་དག་སྣང་སྦྱོངས།\"}, {\"label\": \"QUOTE\", \"frame\": \"འབྲུག་པ་ཀུན་ལེགས་ཀྱིས།\", \"head\": \"ཕྱག་ཆེན་དང་རྫོགས་ཆེན་དབུ་མ་གསུམ།\", \"tail\": \"ཕོ་དག་སྣང་ཅན་འཚོགས་པའི་རྩེ་མོར་ཕྱིན།\"}, {\"label\": \"QUOTE\", \"frame\": \"བཟང་སྤྱོད་སྨོན་ལམ་ལས།\", \"head\": \"རྒྱལ་བ་རྣམས་ཀྱི་དམ་པའི་ཆོས་འཛིན་ཅིང་།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"head\": \"རྒྱལ་བའི་དམ་ཆོས་མ་ལུས་འཛིན་པ་དང་།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"པདྨ་བཀའ་ཐང་ལས།\", \"head\": \"ཉོན་མོངས་འདོད་ཆགས་འདུལ་བའི་གཉེན་པོ་རུ།\", \"tail\": \"གསང་སྔགས་སྡེ་སྣོད་ཉི་ཁྲི་ཆིག་སྟོང་གསུངས།\"}, {\"label\": \"QUOTE\", \"head\": \"ཐུབ་དབང་ཡོངས་སུ་འདས་ནས་ད་བར་དུ།\", \"tail\": \"གནས་ལ་མ་འཆམ་ལྷ་ཀླུས་ཐོབ་ཤ་བྱས།\"}, {\"label\": \"QUOTE\", \"frame\": \"བདེ་མཆོག་སྡོམ་འབྱུང་ལས།\", \"head\": \"རྣལ་འབྱོར་རྒྱུད་རྣམས་ཀྱི་ནི་ཚད།\", \"tail\": \"ས་ཡ་དང་ནི་དུང་ཕྱུར་ལྔ།\"}, {\"label\": \"QUOTE\", \"frame\": \"དེ་ཉིད་ལས།\", \"head\": \"ལྷ་དང་ལྷ་མིན་རྣམས་ལ་ཕན་གདགས་ཕྱིར།\", \"tail\": \"རིག་འཛིན་སྡེ་སྣོད་དུ་ནི་རྒྱལ་བས་གསུངས།\"}, {\"label\": \"QUOTE\", \"frame\": \"ཡེ་ཤེས་རྡོ་རྗེ་ཀུན་ལས་བཏུས་ལས།\", \"head\": \"བྱ་བའི་རྒྱུད་སྟོང་ཕྲག་བཞི།\", \"tail\": \"རྒྱས་པར་ཕྱེ་ན་གྲངས་མེད་དོ།\"}, {\"label\": \"QUOTE\", \"frame\": \"མདོ་སྡེ་ལངྐར་གཤེགས་པ་ལས།\", \"head\": \"ལྷ་ཡི་ཐེག་དང་ཚངས་པའི་ཐེག\", \"tail\": \"ཐེག་པ་རྣམས་ལ་ཐུག་པ་མེད།\"}, {\"label\": \"QUOTE\", \"frame\": \"འཁོར་ལོ་སྡོམ་པའི་རྒྱུད་...བསམ་གྱིས་མི་ཁྱབ་པ་ལས།\", \"head\": \"ཐེག་པ་གསུམ་དང་བཅོ་བརྒྱད་ཏེ།\", \"tail\": \"ཐེག་པའི་མཐའ་ལ་ཐུག་པ་མེད།\"}, {\"label\": \"QUOTE\", \"frame\": \"རྒྱ་ཆེར་རོལ་པ་ལས།\", \"head\": \"སངས་རྒྱས་ཀྱི་ཆོས་ཚད་མ་མཆིས་བ་ངེས་པར་བསྟན་པ།\", \"tail\": \"ཀྱང་སྔོན་ཆད་གསུངས་པ་ལགས། ཞེས་གསུངས།\"}, {\"label\": \"QUOTE\", \"frame\": \"སློབ་སྤྲིངས་ལས།\", \"head\": \"བསྟན་པ་རིན་ཆེན་མཆོག་ལྟར་བཟང་ལ་འཕན་མེད་པ།\", \"tail\": \"ས་ཡི་གཏིང་ན་གནས་པས་རབ་རིབ་སེལ་བར་བྱེད།\"}, {\"label\": \"QUOTE\", \"frame\": \"ངེས་དོན་འབྲུག་སྒྲ་ལས།\", \"head\": \"རང་གི་ལུགས་ལ་མ་གྲགས་པས།\", \"tail\": \"མཐོང་རྒྱ་ཆུང་འདི་བཤོལ་བར་རིགས།\"}, {\"label\": \"QUOTE\", \"frame\": \"རིན་ཆེན་ཕྲེང་བ་ལས།\", \"head\": \"བརྡ་སྤྲོད་པ་དག་ཇི་ལྟ་བུར།\", \"tail\": \"ལྷག་པར་རབ་ཏུ་དད་བར་བྱ།\"}, {\"label\": \"QUOTE\", \"frame\": \"སྤྱོད་འཇུག་ལས།\", \"head\": \"འགྲོ་བའི་སྡུག་བསྔལ་སྨན་གཅིག་པུ།\", \"tail\": \"བཅས་ཏེ་ཡུན་རིང་གནས་གྱུར་ཅིག\"}, {\"label\": \"QUOTE\", \"frame\": \"རྒྱུད་བླ་མ་ལས།\", \"head\": \"གང་ཞིག་རྒྱལ་བའི་བསྟན་པ་འབའ་ཞིག་གི\", \"tail\": \"དེ་ཡང་དྲང་སྲོང་བཀའ་བཞིན་སྤྱི་བོར་བླང་།\"}, {\"label\": \"QUOTE\", \"frame\": \"རྗེ་རིན་པོ་ཆེས།\", \"head\": \"བསོད་ནམས་ཚོགས་རབ་རབ་འབྱམས་རྒྱུ་ལས་འཁྲུངས་པའི་སྐུ་མཆོག་མཆོག་སྟེ་མཛེས་པ་ཁྱོད་ཀྱི་སྐུ།\", \"tail\": \"ཞིང་མཆོག་ཀུན་དུ་དུ་མའི་འགྲོ་ལ་མིག་འཕྲུལ་བཞིན།\"}, {\"label\": \"QUOTE\", \"frame\": \"གསང་བ་བསམ་གྱིས་མི་ཁྱབ་པའི་མདོ་ལས།\", \"head\": \"ནམ་མཁས་ཇི་སྲིད་ཁྱབ་གྱུར་པ།\", \"tail\": \"སྐུ་ཡིས་ཀྱང་ནི་དེ་སྙེད་ཁྱབ།\"}, {\"label\": \"QUOTE\", \"frame\": \"དཔལ་ཨ་ར་ལིའི་རྒྱུད་ཆེན་པོ་ལས།\", \"head\": \"སྤྲུལ་པའི་སྐུ་སྟེ་སྐུ་ཡི་མཆོག\", \"tail\": \"ཕྱོགས་བཅུར་སྤྲུལ་པ་སྣ་ཚོགས་འགྱེད།\"}, {\"label\": \"QUOTE\", \"frame\": \"རྔ་བོ་ཆེའི་མདོ་ལས།\", \"head\": \"མྱ་ངན་མ་བྱེད་ཀུན་དགའ་བོ།\", \"tail\": \"ཁྱོད་ལ་སོགས་པའི་དོན་བྱེད་འགྱུར།\"}, {\"label\": \"QUOTE\", \"frame\": \"ཡབ་སྲས་མཇལ་བའི་མདོ་ལས།\", \"head\": \"བརྒྱ་བྱིན་ཚངས་པའི་ཆ་བྱད་དང་།\", \"tail\": \"སེམས་ཅན་རྣམས་ནི་འདུལ་བར་མཛད།\"}, {\"label\": \"QUOTE\", \"frame\": \"སམ་བུ་ཊ་ལས།\", \"head\": \"སངས་རྒྱས་གར་མཁན་བསམ་མི་ཁྱབ།\", \"tail\": \"བདག་གིས་བརྗོད་པར་ག་ལ་ནུས།\"}, {\"label\": \"QUOTE\", \"frame\": \"རྡོ་རྗེ་དྲྭ་བའི་རྒྱུད་ལས།\", \"head\": \"གང་དང་གང་གི་གཟུགས་ཀྱིས་ནི།\", \"tail\": \"ཆོས་རྣམས་སྟོན་པར་མཛད་པ་ཡིན།\"}, {\"label\": \"QUOTE\", \"frame\": \"མདོ་ལས།\", \"head\": \"བདུད་ཀྱི་ལས་རྣམས་ཐུགས་ཆུད་ཀྱང་།\", \"tail\": \"སེམས་ཅན་ཐམས་ཅད་གྲོལ་མཛད་པའོ།\"}, {\"label\": \"QUOTE\", \"frame\": \"ངེས་དོན་འབྲུག་སྒྲ་ལས།\", \"head\": \"གཅེར་བུ་པ་རྣམས་འདུལ་བའི་ཕྱིར།\", \"tail\": \"མཚན་བརྗོད་འགྲེལ་པ་ཉིད་ལས་གསུངས།\"}, {\"label\": \"QUOTE\", \"frame\": \"མྱང་འདས་བམ་པོ་གཅིག་པ་ལས།\", \"head\": \"རིགས་ཀྱི་བུ་ང་བསྐལ་པ་བཟང་པོ་འདིར་མུ་སྟེགས་གཅེར་བུ་པ་ལ་ཡིད་ཆེས་ཏེ\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"དུས་འཁོར་ལས།\", \"head\": \"ཡོན་ཏན་གྱི་ཆོས་དང་ལྡན་པ་ཕྱི་རོལ་པའི་ནང་ན་སྣང་ན་ཡང་།\", \"tail\": \"བདག་ཅག་གིས་བསྙེན་བཀུར་བྱའོ\"}, {\"label\": \"QUOTE\", \"frame\": \"མདོར་བསྡུས་བཞི་པ་ལས།\", \"head\": \"ཁྱབ་འཇུག་དང་དྲག་པོ་ལ་སོགས་པ་རྣམས་ཀྱི་ནང་ན་ཡོན་ཏན་འདི་དག་རྫོགས་པ་འབའ་ཞིག་ཡོད་ན།\", \"tail\": \"བཀུར་བར་བྱ་བ་ཡིན་ནོ\"}, {\"label\": \"QUOTE\", \"frame\": \"རྣམ་སྣང་མངོན་བྱང་ལས།\", \"head\": \"མུ་སྟེགས་ཅན་ལ་སྨད་མི་བྱ།\", \"tail\": \"རྣམ་པར་སྣང་མཛད་རིང་བའི་རྒྱུ།\"}, {\"label\": \"QUOTE\", \"frame\": \"འབྲུག་པ་ཀུན་ལེགས་ཀྱིས།\", \"head\": \"གཤེན་ལྷ་འོད་དཀར་སྤྱན་རས་གཟིགས་དབང་ཡིན།\", \"tail\": \"གཙང་མའི་བོན་དང་ཆོས་ལ་ཁྱད་པར་མེད།\"}, {\"label\": \"QUOTE\", \"frame\": \"ཀུན་མཁྱེན་ཐུ་བཀྭན་རིན་པོ་ཆེས།\", \"head\": \"བོན་དང་ཆོས་ཞེས་འགལ་བའི་ཚད་བྱེད་ཀྱང་།\", \"tail\": \"ཆོས་བོན་རྣམ་དབྱེ་འབྱེད་ལ་སྒྱིད་ལུག་གྱུར།\"}, {\"label\": \"QUOTE\", \"frame\": \"བསྔགས་འོས་བ་སྔགས་བསྟོད་ལས།\", \"head\": \"ཁྱོད་ཀྱི་གང་ལས་འགྲོ་བ་དག\", \"tail\": \"ཕུན་ཚོགས་དེ་ཡང་གང་ཞིག་མཆིས།\"}, {\"label\": \"QUOTE\", \"frame\": \"བཞི་བརྒྱ་བ་ལས།\", \"head\": \"ཐུབ་པ་མ་གཏོགས་ཇི་ལྟའི་དངོས།\", \"tail\": \"དེ་བཞིན་གཤེགས་ལས་གཞན་ཡོད་མིན།\"}, {\"label\": \"QUOTE\", \"frame\": \"བླ་མ་ཞང་གིས།\", \"head\": \"འོ་སྐོལ་རང་ཅག་ཆོས་དང་ཆོས་མིན་ཞེས།\", \"tail\": \"ཤེས་པར་བྱ་ཞིང་མི་སྤང་འཁུར་བགྱིའོ།\"}, {\"label\": \"QUOTE\", \"frame\": \"སངས་རྒྱས་ཕལ་པོ་ཆེའི་མདོ་ལས།\", \"head\": \"གླིང་བཞི་འདི་ན་བཅོམ་ལྡན་འདས་དོན་གྲུབ་པ་དང་།\", \"tail\": \"ཕྱོགས་བཅུ་ཀུན་ཏུ་དེ་ལྟ་བུ་སྣང་བར་གསུངས་སོ།\"}, {\"label\": \"QUOTE\", \"frame\": \"རྒྱུད་བླ་མ་ལས།\", \"head\": \"རྡོ་རྗེ་ཅན་ནི་ཐམས་ཅད་དུ།\", \"tail\": \"བསྟན་ནས་འགྲོ་བ་འདུལ་པར་མཛད།\"}, {\"label\": \"QUOTE\", \"frame\": \"དཀོན་མཆོག་བརྩེགས་པ་དང་ཡབ་སྲས་མཇལ་བའི་མདོ་ལས།\", \"head\": \"ལ་ལར་བལྟམས་པ་ཡོངས་སུ་བསྟན།\", \"tail\": \"སེམས་ཅན་རྣམས་ནི་འདུལ་བར་མཛད།\"}, {\"label\": \"QUOTE\", \"frame\": \"ལྷ་མོ་དྲི་མ་མེད་པའི་འོད་ཀྱིས་ཞུས་པའི་མདོ་ལས།\", \"head\": \"བསྐལ་པ་བཟང་པོའི་རྒྱལ་སྲས་རྣམས།\", \"tail\": \"མི་དང་འདྲ་བ་སྣང་བར་འགྱུར།\"}, {\"label\": \"QUOTE\", \"frame\": \"མདོ་གཞན་ལས།\", \"head\": \"ང་ཡང་མྱ་ངན་ལས་འདས་ནས་སེམས་ཅན་རྣམས་ལ་ཕན་ཞིང་སྙིང་བརྩེ་བའི་ཕྱིར་དུ་མིར་སྐྱེ་བར་རིགས་པར་བྱའོ།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"བཀའ་གདམས་གླེགས་བམ་ལས།\", \"head\": \"སངས་རྒྱས་དག་ནི་སྤྲུལ་པ་ཅིར་ཡང་སྟོན།\", \"tail\": \"མེད་ཀྱང་སྨོན་ལམ་དབང་གིས་དགོས་འདོད་འབྱུང་།\"}, {\"label\": \"QUOTE\", \"frame\": \"རྒྱལ་བུ་དཀོན་མཆོག་འབངས་ཀྱི་ཞལ་ནས།\", \"head\": \"ང་སྣ་ཚོགས་སྤྲུལ་པར་སྟོན་ན་ཡང་།\", \"tail\": \"མི་ང་ཡི་སྤྲུལ་པ་ཕྱོགས་རིས་མེད།\"}, {\"label\": \"QUOTE\", \"frame\": \"མཛོད་ལས།\", \"head\": \"སྟོན་པའི་དམ་ཆོས་རྣམ་གཉིས་ཏེ།\", \"tail\": \"ལུང་དང་རྟོགས་པའི་བདག་ཉིད་དོ།\"}, {\"label\": \"QUOTE\", \"frame\": \"སྒོམ་པའི་རིམ་པ་ཐ་མ་ལས།\", \"head\": \"ཡང་ཐོས་པ་དང་བསམ་པ་ལས་བྱུང་བའི་ཤེས་རབ་ཀྱིས་རྟོགས་པ་གང་ཡིན་པ་དེ་ཉིད་བསྒོམས་པ་ལས་བྱུང་བའི་ཤེས་རབ་ཀྱིས་བསྒོམ་པར་བྱའི་གཞན་དུ་མ་ཡིན་ཏེ\", \"tail\": \"རྟ་དཀྱུ་ས་བསྟན་ནས་རྒྱུག་པ་བཞིན་ནོ།\"}, {\"label\": \"QUOTE\", \"frame\": \"རྣམ་པར་འཐག་པ་ཐམས་ཅད་བསྡུས་པའི་མདོ་ལས།\", \"head\": \"འཇམ་དཔལ་དམ་པའི་ཆོས་སྤོང་བའི་ལས་ཀྱི་སྒྲིབ་པ་ནི་ཕྲའོ།\", \"tail\": \"འདི་ནི་བྱང་ཆུབ་སེམས་དཔའ་རྣམས་ཀྱི་བསླབ་པ་མ་ཡིན་ནོ་ཞེས་ཟེར་ན་ཆོས་སྤོང་བ་ཡིན་ནོ།\"}, {\"label\": \"QUOTE\", \"frame\": \"ཏིང་ངེ་འཛིན་རྒྱལ་པོ་ལས།\", \"head\": \"གང་གིས་འཛམ་བུའི་གླིང་འདིར་ནི།\", \"tail\": \"སྡིག་པ་དེ་ནི་ཆེས་ཁྱད་འཕགས།\"}]}",
