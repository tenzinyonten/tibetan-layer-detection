el\":\"QUOTE\",\"frame\":\"རྗེ་བཙུན་གྱིས།\",\"head\":\"འདྲེར་སྣང་འདྲེར་རྟོག་འདྲེར་འཛིན་གསུམ། །\",\"tail\":\"འདྲེ་རང་རྒྱུད་འཛིན་པ་རྣལ་འབྱོར་འཁྲུལ། །\"},{\"label\":\"QUOTE\",\"frame\":\"མདོ་དྲན་པ་ཉེར་གཞག་ལས།\",\"head\":\"མེ་ནི་གྲང་བར་འགྱུར་ཡང་སྲིད། །\",\"tail\":\"ལས་ཀྱི་རྣམ་སྨིན་བསླུ་མི་སྲིད། །\"},{\"label\":\"QUOTE\",\"head\":\"ལུས་ཅན་རྣམས་ཀྱི་ལས་རྣམས་ནི། །\",\"tail\":\"འབྲས་བུ་ཉིད་དུ་སོ་སོར་སྨིན། །\"},{\"label\":\"QUOTE\",\"frame\":\"རྗེ་ཕག་མོ་གྲུབ་པས།\",\"head\":\"སྙིང་ནས་ཆོས་ཤིག་གོ་གྱུར་ན། །\",\"tail\":\"སྡུག་བསྔལ་ཐམས་ཅད་བདེ་ཆེན་ཡིན། །\"},{\"label\":\"QUOTE\",\"frame\":\"མགུར་ལས།\",\"head\":\"སྟོང་ཉིད་སྙིང་རྗེ་དབྱེར་མེད་པ། །\",\"tail\":\"དགེ་འདུན་གྱི་ནི་བསྟན་པ་ཡིན། །\"},{\"label\":\"QUOTE\",\"frame\":\"ཨོ་རྒྱན་རིན་པོ་ཆེས།\",\"head\":\"རྣལ་འབྱོར་པ་རབ་ཆོས་སྐུའི་འཕོ་བ་ནི།\",\"tail\":\"ཡིན་ནི་འཕོ་བའི་མཐར་ཐུག་གོ\"},{\"label\":\"QUOTE\",\"frame\":\"རྒྱུད་ལས།\",\"head\":\"འཆི་བ་ཞེས་བྱ་རྣམ་རྟོག་སྟེ། །\",\"tail\":\"སྐད་ཅིག་གཅིག་གིས་རྫོགས་སངས་རྒྱས། །\"},{\"label\":\"QUOTE\",\"frame\":\"རྗེ་སྒམ་པོ་པས།\",\"head\":\"རྣམ་རྟོག་གཅིག་ནས་གཅིག་འགྲོ་བ། །\",\"tail\":\"དེ་ལ་འཆི་རྒྱུ་ག་ལ་ཡོད། །\"}]}",
