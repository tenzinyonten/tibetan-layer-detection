  "raw_text": "{\"spans\":[{\"label\":\"QUOTE\",\"frame\":\"སློབ་དཔོན་གྱིས།\",\"head\":\"ད་ལྟའི་ཤེས་པ་སོ་མ་ལ། །\",\"tail\":\"སངས་རྒྱས་གཞན་དུ་བཙལ་དུ་མེད། །\"},{\"label\":\"QUOTE\",\"frame\":\"བདེན་གཉིས་སྣང་བ་ལས།\",\"head\":\"ཇི་ལྟར་སྣང་བའི་དངོས་པོ་རྣམས། །\",\"tail\":\"མ་རྙེད་པ་དེ་དོན་དམ་མོ། །\"},{\"label\":\"QUOTE\",\"frame\":\"ཟླ་བ་སྒྲོན་མེའི་མདོ་ལས།\",\"head\":\"ཞི་གནས་སྟོབས་ཀྱིས་གཡེང་བ་མེད་པར་འགྱུར། །\",\"tail\":\"ལྷག་མཐོང་གིས་ནི་རི་དང་འདྲ་བར་འགྱུར། །\"},{\"label\":\"QUOTE\",\"frame\":\"སློབ་དཔོན་གྱིས།\",\"head\":\"ད་ལྟའི་ཤེས་པ་སོ་མ་ལ། །\",\"tail\":\"སངས་རྒྱས་གཞན་དུ་བཙལ་དུ་མེད། །\"},{\"label\":\"QUOTE\",\"frame\":\"རྗེ་རང་བྱུང་རྡོ་རྗེས།\",\"head\":\"ཞེ་སྡང་གོམས་པའི་རྣལ་འབྱོར་པ། །\",\"tail\":\"ནང་གི་ཡོན་ཏན་ཕྱི་རུ་ཤར། །\"},{\"label\":\"QUOTE\",\"frame\":\"ཇི་སྐད་དུ།\",\"head\":\"ཁྲེགས་ཆོད་ཟབ་མོ་འཁོར་འདས་སྣང་བ་རྣམས། །\",\"tail\":\"སེམས་ཀྱི་རྩལ་སྣང་ཙམ་དུ་ངོ་སྤྲོད་ཅིང༌། །\"},{\"label\":\"QUOTE\",\"frame\":\"རྩ་བའི་རྒྱུད་ལེའུ་དྲུག་པ་ལས།\",\"head\":\"སངས་རྒྱས་སྐུ་དང་ཡེ་ཤེས་ཡོན་ཏན་དང༌། །\",\"tail\":\"བྱང་ཆུབ་སེམས་ཀྱི་ངོ་བོ་ཡེ་ནས་ཡིན། །\"},{\"label\":\"QUOTE\",\"frame\":\"ཇི་སྐད་དུ།\",\"head\":\"སེམས་སྣང་སྣ་ཚོགས་ཇི་ལྟར་ཤར་བ་རྣམས། །\",\"tail\":\"རང་ངོ་སྤྲོས་བྲལ་སྟོང་པ་ཉིད་ཀྱི་ངང༌། །\"},{\"label\":\"QUOTE\",\"frame\":\"ཇི་སྐད་དུ།\",\"head\":\"སྣང་སྟོང་གཉིས་ལ་བཟང་ངན་སྔ་ཕྱི་སོགས། །\",\"tail\":\"ཐ་དད་མེད་ཕྱིར་ཟུང་འཇུག་དབྱེར་མེད་ངང༌། །\"},{\"label\":\"QUOTE\",\"frame\":\"ཇི་སྐད་དུ།\",\"head\":\"ཟུང་འཇུག་ཙམ་དུ་འཛིན་པ་རང་དག་ནས། །\",\"tail\":\"སེམས་ལས་ཀ་དག་རིག་པ་ཆོས་ཀྱི་སྐུ། །\"},{\"label\":\"QUOTE\",\"frame\":\"ཏེལླི་པས།\",\"head\":\"ཡིད་ལ་ཅི་ཡང་མི་བྱེད་ལ་བཟླའི་ཆོས་ལ་ལྟོས། །\",\"tail\":\"\"},{\"label\":\"QUOTE\",\"frame\":\"སློབ་དཔོན་གྱིས།\",\"head\":\"ད་ལྟ་ཤེས་པ་སོ་མ་ལ། །\",\"tail\":\"བདེ་གསལ་མི་རྟོག་ལྷུན་གྱིས་གྲུབ། །\"},{\"label\":\"QUOTE\",\"frame\":\"རྫོགས་ཆེན་ཀུན་སྤྱོད་ལས།\",\"head\":\"ངག་གིས་ཛབ་དང་སྙིང་པོ་བཟླ་མི་དགོས། །\",\"tail\":\"ངང་གིས་གནས་པའི་གཡོ་མེད་ལྷུན་གྱིས་གྲུབ། །\"},{\"label\":\"QUOTE\",\"frame\":\"མི་ནུབ་རྒྱལ་མཚན་གྱི་ལེའུ་ལས།\",\"head\":\"འདོད་ཆགས་ཞེ་སྡང་གཏི་མུག་ཀྱང༌། །\",\"tail\":\"ཆོས་ཉིད་དབྱིངས་ཀྱི་རྒྱན་ཞེས་གསུངས། །\"},{\"label\":\"QUOTE\",\"frame\":\"བྱར་མེད་རྫོགས་པ་བསྒོམ་དུ་མེད་པ་ལས།\",\"head\":\"ཀུན་དང་མི་མཐུན་འཇིག་རྟེན་ཡོངས་ཀྱིས་སྤང་བའི་ཆོས། །\",\"tail\":\"བུད་མེད་ལ་སོགས་ཀུན་ཀྱང་སྤང་མི་བྱེད། །\"},{\"label\":\"QUOTE\",\"frame\":\"སྙིང་པོའི་དོན་ལ་གནས་པའི་ལེའུ་ལས།\",\"head\":\"ཀྱེ་སྟོན་པའི་སྟོན་པ་ཀུན་བྱེད་རྒྱལ་པོ་ཡིས། །\",\"tail\":\"ལྷུན་གྲུབ་སྙིང་པོའི་དོན་ལ་འཇུག་པར་བྱེད། །\"},{\"label\":\"QUOTE\",\"frame\":\"མ་གཡོས་འདོད་པ་མེད་པའི་ལེའུ་ལས།\",\"head\":\"ཀྱེ་སེམས་དཔའ་ཆེན་པོ་གཅིག་ལ་གཉིས་སུ་མ་བྱེད་ཅིག །\",\"tail\":\"དེ་ནི་རང་བྱུང་ཡེ་ཤེས་ཡིན། །\"},{\"label\":\"QUOTE\",\"frame\":\"མདོ་ལས།\",\"head\":\"སེམས་རྟོགས་ན་སངས་རྒྱས་ཡིན་པས། སངས་རྒྱས་གཞན་ནས་མི་འཚོལ་བའི་འདུ་ཤེས་བསྒོམ་པར་བྱའོ། །\",\"tail\":\"\"},{\"label\":\"QUOTE\",\"frame\":\"བཅོས་སུ་མེད་པའི་ལེའུ་ལས།\",\"head\":\"ཀྱེ་ཆོས་ཀྱི་སྐུ་ནི་བྱང་ཆུབ་སེམས། །\",\"tail\":\"མ་བཅོས་ལམ་དུ་ཞུགས་ནས་བྱོན། །\"},{\"label\":\"QUOTE\",\"frame\":\"ཕྱག་ཆེན་ཐིག་ལེའི་རྒྱུད་ལས།\",\"head\":\"རིན་ཆེན་སེམས་ལས་ཕྱིར་ཕྱོགས་པའི། །\",\"tail\":\"སངས་རྒྱས་མེད་ཅིང་སེམས་ཅན་མེད། །\"},{\"label\":\"QUOTE\",\"frame\":\"རྙིང་རྒྱུད་ཀུན་བྱེད་རྒྱལ་པོ་ལས།\",\"head\":\"ཉིད་ཀྱི་རང་འབྱུང་གི་ཡེ་ཤེས་ཆེན་པོ་གཅིག་ལ་\",\"tail\":\"རྒྱུ་ཆེན་པོ་ལྔ་ནི་ཕྱུང༌། །\"},{\"label\":\"QUOTE\",\"frame\":\"དེ་ཉིད་ལས།\",\"head\":\"ཡེ་ཤེས་ལྔའི་རིགས་སོ་སོར་ཕྱེ་སྟེ།\",\"tail\":\"ཆོས་ཉིད་བཀོད་དོ། །\"},{\"label\":\"QUOTE\",\"head\":\"སྣང་སྲིད་འཁོར་འདས་ཐམས་ཅད་ཀུན༔\",\"tail\":\"རིག་དང་མ་རིག་ཆོས་འཕྲུལ་ལས༔\"},{\"label\":\"QUOTE\",\"frame\":\"བྲམ་ཟེ་ཆེན་པོ་ས་ར་ཧས།\",\"head\":\"ཕྱག་རྒྱ་ཆེན་པོར་རྐྱེན་གསུམ་དང་བྲལ་བ། །\",\"tail\":\"འོད་གསལ་ལས་ཁྱད་པར་དུ་གྱུར་པའོ། །\"},{\"label\":\"QUOTE\",\"frame\":\"ཕྱག་ཆེན་ཐིག་ལེའི་རྒྱུད་ལས།\",\"head\":\"ཕྱག་ནི་སྟོང་པའི་ཡེ་ཤེས་ཏེ། །\",\"tail\":\"ཆེན་པོ་ཟུང་དུ་འཇུག་པའོ། །\"},{\"label\":\"QUOTE\",\"frame\":\"བྱམས་པས།\",\"head\":\"ཆོས་ཉིད་སེམས་ལས་གཞན་པའི་སེམས་གཞན་ནི། །\",\"tail\":\"འོད་གསལ་མ་ཡིན་རང་བཞིན་ལ་བརྗོད་དོ། །\"},{\"label\":\"QUOTE\",\"frame\":\"མདོ་ལས།\",\"head\":\"སེམས་ནི་སེམས་མ་མཆིས་ཏེ། །\",\"tail\":\"སེམས་ཀྱི་རང་བཞིན་འོད་གསལ་ལོ། །\"},{\"label\":\"QUOTE\",\"frame\":\"དེ་ཁོ་ན་ཉིད་རབ་ཏུ་མི་གནས་པའི་མདོ་ལས།\",\"head\":\"ཐ་མལ་ཤེས་པའི་རང་བཞིན་འབྲས་བུ་མཆོག །\",\"tail\":\"དེ་ནི་དུས་གསུམ་སངས་རྒྱས་ཀུན་གྱི་ཡུམ། །\"},{\"label\":\"QUOTE\",\"frame\":\"རྒྱུད་བླ་ལས།\",\"head\":\"གཙང་བདག་བདེ་བ་རྟག་ཉིད་ཕྱིར། །\",\"tail\":\"ཡོན་ཏན་ཕ་རོལ་ཕྱིན་པའི་འབྲས། །\"},{\"label\":\"QUOTE\",\"frame\":\"མི་ལས།\",\"head\":\"ལྟ་བ་སྟོང་པའི་ཡེ་ཤེས་ཡིན། །\",\"tail\":\"\"},{\"label\":\"QUOTE\",\"frame\":\"རྗེ་བཙུན་གྱིས།\",\"head\":\"སེམས་སྐྱེ་མེད་ཀྱི་ངང་ནས་འགགས་མེད་འཕྱོ། །\",\"tail\":\"ལྟ་བའི་ཐག་ཆོད་བློ་རེ་བདེ། །\"},{\"label\":\"QUOTE\",\"frame\":\"རྗེ་བཙུན་གྱིས།\",\"head\":\"སྒོམ་པ་འོད་གསལ་འཛིན་མེད་ཡིན། །\",\"tail\":\"\"},{\"label\":\"QUOTE\",\"frame\":\"རྗེ་བཙུན་གྱིས།\",\"head\":\"སེམས་བསྒོམ་མེད་ཀྱི་ངང་ནས་ཡེངས་མེད་འཕྱོ། །\",\"tail\":\"སྒོམ་པའི་ཐག་ཆོད་བློ་རེ་བདེ། །\"},{\"label\":\"QUOTE\",\"frame\":\"རྗེ་བཙུན་གྱིས།\",\"head\":\"སྤྱོད་པ་ཆགས་མེད་རྒྱུན་ཞིག་ཡིན། །\",\"tail\":\"\"},{\"label\":\"QUOTE\",\"frame\":\"རྗེ་བཙུན་གྱིས།\",\"head\":\"ཤུགས་བྱུང་གི་ངང་ནས་འགགས་མེད་འཕྱོ། །\",\"tail\":\"སྤྱོད་པའི་ཐག་ཆོད་བློ་རེ་བདེ། །\"},{\"label\":\"QUOTE\",\"frame\":\"རྗེ་བཙུན་གྱིས།\",\"head\":\"བསྲུང་མེད་ཀྱི་ངང་ལ་ཡེངས་མེད་འཕྱོ། །\",\"tail\":\"དམ་ཚིག་གི་ཐག་ཆོད་བློ་རེ་བདེ། །\"},{\"label\":\"QUOTE\",\"frame\":\"མདོ་ལས།\",\"head\":\"སེམས་རྟོགས་ན་སངས་རྒྱས་ཡིན་ཏེ། སངས་རྒྱས་གཞན་ནས་མི་འཚོལ་བའི་དུས་ཤེས་རབ་ཏུ་བསྒོམ་པར་བྱའོ། །\",\"tail\":\"\"},{\"label\":\"QUOTE\",\"frame\":\"ཕྱག་ཆེན་ཐིག་ལེའི་རྒྱུད་ལས།\",\"head\":\"རིན་ཆེན་སེམས་ལས་ཕྱིར་ཕྱོགས་པའི། །\",\"tail\":\"སངས་རྒྱས་མེད་ཅིང་སེམས་ཅན་མེད། །\"},{\"label\":\"QUOTE\",\"frame\":\"རྗེ་བཙུན་གྱིས།\",\"head\":\"ཐོབ་མེད་ཀྱི་ངང་ནས་བསྒྲུབ་མེད་འཕྱོ། །\",\"tail\":\"འབྲས་བུའི་ཐག་ཆོད་བློ་རེ་བདེ། །\"},{\"label\":\"QUOTE\",\"frame\":\"བརྟག་གཉིས་ལས།\",\"head\":\"ཅུང་ཟད་དྲོད་ནི་ཐོབ་པ་ན། །\",\"tail\":\"འདིས་ནི་སྤྱོད་པ་སྤྱད་པ་ཉིད། །\"},{\"label\":\"QUOTE\",\"frame\":\"བརྟག་གཉིས་ལས།\",\"head\":\"གོང་བཤད་འཇིགས་པའི་གཟུགས་ཅན་གྱིས། །\",\"tail\":\"རང་གི་སེམས་ནི་སོ་སོར་བརྟགས། །\"},{\"label\":\"QUOTE\",\"frame\":\"རྗེ