  "raw_text": "{\"spans\":[{\"label\":\"QUOTE\",\"frame\":\"ལང་གཤེགས་ལས།\",\"head\":\"ཡང་དག་སངས་རྒྱས་དེར་སངས་རྒྱས།\",\"tail\":\"སྤྲུལ་པ་པོ་གཅིག་འདིར་འཚང་རྒྱ།\"},{\"label\":\"QUOTE\",\"frame\":\"རྒྱུད་བླར།\",\"head\":\"ཆོས་ཀྱི་སྐུ་ལས་མ་གཡོས་པར།\",\"tail\":\"དགའ་ལྡན་གནས་ནས་འཕོ་བ་དང་། །\"},{\"label\":\"QUOTE\",\"frame\":\"སྤྱོད་འཇུག་ལས།\",\"head\":\"བྱང་ཆུབ་སེམས་བསྐྱེད་གྱུར་ན་སྐད་ཅིག་གིས། །\",\"tail\":\"འཇིག་རྟེན་ལྷ་མིར་བཅས་པས་ཕྱག་བྱར་འགྱུར། །\"},{\"label\":\"QUOTE\",\"frame\":\"མདོ་ལས།\",\"head\":\"འཕགས་པའི་གང་ཟག་ཐམས་ཅད་ནི་འདུས་མ་བྱས་ཀྱི་རབ་ཏུ་ཕྱེ་བའོ།\",\"tail\":\"\"},{\"label\":\"QUOTE\",\"frame\":\"རྒྱུད་བླར།\",\"head\":\"ཐེག་མཆོག་ལ་མོས་ས་བོན་ཤེས་རབ་ནི། །\",\"tail\":\"གང་ཡིན་དེ་དག་ཐུབ་པའི་རྗེས་སྐྱེས་སྲས། །\"},{\"label\":\"QUOTE\",\"frame\":\"སྡུད་པ་ལས།\",\"head\":\"རྒྱལ་བ་འདས་དང་མ་བྱོན་ཕྱོགས་བཅུ་གང་བཞུགས་པ། །\",\"tail\":\"ཀུན་ལམ་ཕ་རོལ་ཕྱིན་པ་འདི་ཡིན་གཞན་མ་ཡིན། །\"},{\"label\":\"QUOTE\",\"frame\":\"ཉིར་སྣང་ལས།\",\"head\":\"འཕགས་པའི་གང་ཟག་ཐམས་ཅད་ཀྱི་དབང་དུ་མཛད་ནས།\",\"tail\":\"རྣམས་བསྡུས་པར་འགྱུར་བ་ཡིན་ཏེ།\"},{\"label\":\"QUOTE\",\"frame\":\"སྡུད་པ་ལས།\",\"head\":\"གང་དག་འདས་དང་ཕྱོགས་བཅུའི་འཇིག་རྟེན་མགོན་གང་དང་། །\",\"tail\":\"མ་འོངས་དུས་ན་འབྱུང་འགྱུར་དེ་དག་འདི་ལས་འབྱུང་། །\"},{\"label\":\"QUOTE\",\"frame\":\"\",\"head\":\"བདེ་གཤེགས་གང་དུ་བཞུགས་པ་དང་། །\",\"tail\":\"གནས་དེ་ལ་ཡང་ཕྱག་འཚལ་ལོ། །\"},{\"label\":\"QUOTE\",\"frame\":\"ཆོས་དབྱིངས་བསྟོད་པར།\",\"head\":\"གང་ཞིག་ཡོངས་སུ་མ་ཤེས་པས། །\",\"tail\":\"ཆོས་ཀྱི་དབྱིངས་ལ་ཕྱག་འཚལ་ལོ། །\"},{\"label\":\"QUOTE\",\"frame\":\"རྗེས་དྲན་ལས།\",\"head\":\"བྱང་ཆུབ་སེམས་དཔའ་རྣམས་ཀྱི་ཡབ།\",\"tail\":\"\"},{\"label\":\"QUOTE\",\"frame\":\"ཨར་ ...\",\"head\":\"འདུན་སོགས་གསུམ་གྱི་དབྱེ་བ་ཡིས། །\",\"tail\":\"བཅུ་དགུ་དག་ཏུ་བཞེད་པ་ཡིན། །\"},{\"label\":\"QUOTE\",\"frame\":\"ཏིང་ངེ་འཛིན་གྱི་ལུས་ཐོབ་ནས་...\",\"head\":\"ཏིང་ངེ་འཛིན་གྱི་ལུས་ཐོབ་ནས། །\",\"tail\":\"སངས་རྒྱས་ཆོས་ཤེས་བྱ་བ་ཐོབ། །\"},{\"label\":\"QUOTE\",\"frame\":\"རྣམ་འགྲེལ་ལས།\",\"head\":\"འདོད་ཆགས་བྲལ་བའི་གནས་པ་ནི། །\",\"tail\":\"གང་ལ་དེ་སྐད་བརྗོད་ཕལ་པ། །\"},{\"label\":\"QUOTE\",\"frame\":\"སྤྱོད་འཇུག་ལས།\",\"head\":\"ཉོན་མོངས་མེད་ཀྱང་དེ་དག་ལ། །\",\"tail\":\"ལས་ཀྱི་ནུས་པ་མཐོང་བ་ཡིན། །\"},{\"label\":\"QUOTE\",\"frame\":\"དམ་ཆོས་པད་དཀར་ལས།\",\"head\":\"འཁོར་བའི་སྡུག་བསྔལ་དག་ལས་ཁྱོད་ཐར་ཡང་། །\",\"tail\":\"སངས་རྒྱས་ཐེག་པ་འདི་དག་བཙལ་བར་བྱ། །\"},{\"label\":\"QUOTE\",\"frame\":\"རྒྱུད་བླར།\",\"head\":\"དེས་ན་སངས་རྒྱས་མ་ཐོབ་བར། །\",\"tail\":\"མྱ་ངན་འདས་པ་མི་ཐོབ་སྟེ། །\"},{\"label\":\"QUOTE\",\"frame\":\"དཔལ་ཕྲེང་གིས་ཞུས་པའི་མདོ་ལས།\",\"head\":\"དགྲ་བཅོམ་པ་རྣམས་ལ་འཇིགས་པ་མཆིས་ཏེ།\",\"tail\":\"དེ་རྣམས་ཀྱང་བཅོམ་ལྡན་འདས་ཉིད་ལ་སྐྱབས་སུ་མཆིའོ། །\"},{\"label\":\"QUOTE\",\"frame\":\"སྐྱབས་གསུམ་བདུན་ཅུ་པ་ལས།\",\"head\":\"ཤཱ་རིའི་ལུང་ལས་དགྲ་བཅོམ་གྱིས། །\",\"tail\":\"བྱང་ཆུབ་སེམས་དཔར་ཕྱག་བྱས་ཕྱིར། །\"},{\"label\":\"QUOTE\",\"frame\":\"རྒྱན་ལས།\",\"head\":\"སྔར་ལུང་མ་བསྟན་ལྷན་ཅིག་འབྱུང། །\",\"tail\":\"\"},{\"label\":\"QUOTE\",\"frame\":\"རྣམ་འགྲེལ་ལས།\",\"head\":\"ཇི་ལྟར་གྲགས་ལས་གྲུབ་གང་ཡིན། །\",\"tail\":\"གང་ལ་དེ་སྐད་བརྗོད་ཕལ་པ། །\"},{\"label\":\"QUOTE\",\"frame\":\"བཤད་སྦྱར་ལས།\",\"head\":\"བསེ་རུ་ལྟ་བུ་རྣམས་ལ་ནི། །\",\"tail\":\"དྲུག་གི་སྤྱི་ལ་བཞུགས་པ་ལགས། །\"},{\"label\":\"QUOTE\",\"frame\":\"སྡུད་པ་ལས།\",\"head\":\"ཤེས་རབ་མེད་ན་མིག་མེད་ཕ་རོལ་ཕྱིན་ལྔ་ནི། །\",\"tail\":\"དེ་ཚེ་མིག་རྙེད་འགྱུར་ཞིང་འདི་ཡི་མིང་འཐོབ་བོ། །\"},{\"label\":\"QUOTE\",\"frame\":\"རྣམ་འགྲེལ་ལས།\",\"head\":\"བློ་གྲོས་ཆེན་པོས་མཐོང་ཉིད་ལས། །\",\"tail\":\"རྣམ་པ་ཐམས་ཅད་ངེས་པར་བྱེད། །\"},{\"label\":\"QUOTE\",\"frame\":\"རྣམ་འགྲེལ་ལས།\",\"head\":\"དོན་གྱི་རང་བཞིན་ངོ་བོ་གཅིག །\",\"tail\":\"ཚད་མ་གཞན་གྱི་བརྟག་བྱ་གང། །\"},{\"label\":\"QUOTE\",\"frame\":\"ཤཱཀྱ་ཐུབ་པའི་བརྒལ་ལན་ལས།\",\"head\":\"ཐུབ་རྣམས་སྡིག་པ་ཆུ་ཡིས་མི་བཀྲུ་ཞིང། །\",\"tail\":\"ཆོས་ཉིད་བདེན་པ་བསྟན་པས་གྲོལ་བར་འགྱུར། །\"},{\"label\":\"QUOTE\",\"frame\":\"རྒྱན་ལས།\",\"head\":\"གཞན་ལ་སྦྱིན་དུ་མེད་པ་དང། །\",\"tail\":\"\"},{\"label\":\"QUOTE\",\"frame\":\"རྣམ་འགྲེལ་ལས།\",\"head\":\"ལུས་ཅན་ཡིན་ཡང་ཕྲ་བའི་ཕྱིར། །\",\"tail\":\"འགའ་ཞིག་ལ་ལར་ཐོགས་མེད་དེ། །\"},{\"label\":\"QUOTE\",\"frame\":\"དམ་ཆོས་པད་དཀར་ལས།\",\"head\":\"འཁོར་བའི་སྡུག་བསྔལ་དག་ལས་ཁྱོད་ཐར་ཡང། །\",\"tail\":\"སངས་རྒྱས་ཐེག་པ་འདི་དག་བཙལ་བར་བྱ། །\"},{\"label\":\"QUOTE\",\"frame\":\"རྣམ་འགྲེལ་ལས།\",\"head\":\"དེ་ལྟར་ཇི་ལྟར་ཤེས་ཞེ་ན།\",\"tail\":\"\"},{\"label\":\"QUOTE\",\"frame\":\"ཟླ་བ་གྲགས་པའི་བཞེད་པར་འཇུག་པར།\",\"head\":\"དངོས་ཀུན་ཡང་དག་རྫུན་པ་མཐོང་བ་ཡིས། །\",\"tail\":\"མཐོང་བ་རྫུན་པ་ཀུན་རྫོབ་བདེན་ཞེས་ཐུབ་པ་དེས་གསུང་སྟེ། །\"},{\"label\":\"QUOTE\",\"frame\":\"ཡེ་ཤེས་སྙིང་པོའི་གསུངས་ལས།\",\"head\":\"སྣང་དུ་འདྲ་ཡང་དོན་བྱེད་དག །\",\"tail\":\"ཀུན་རྫོབ་ཀྱི་ནི་དབྱེ་བ་བྱས། །\"},{\"label\":\"QUOTE\",\"frame\":\"\",\"head\":\"གཏི་མུག་རང་བཞིན་སྒྲིབ་ཕྱིར་ཀུན་རྫོབ་ནི། །\",\"tail\":\"\"},{\"label\":\"QUOTE\",\"frame\":\"\",\"head\":\"དེས་གང་བཅོས་མ་བདེན་པར་སྣང་དེ་ནི། །\",\"tail\":\"ཀུན་རྫོབ་བདེན་ཞེས་ཐུབ་པ་དེས་གསུང་སྟེ། །\"},{\"label\":\"QUOTE\",\"frame\":\"མདོ་ལས།\",\"head\":\"བདེན་པ་དམ་པ་ནི་གཅིག་ཁོ་ན་སྟེ།\",\"tail\":\"མི་སླུ་བའི་ཆོས་ཅན་གྱི་མྱ་ངན་ལས་འདས་པ་སྟེ།\"},{\"label\":\"QUOTE\",\"frame\":\"ཀུན་བཏུས་ལས།\",\"head\":\"སྡུག་བསྔལ་གྱི་བདེན་པ་གང་ཞེ་ན།\",\"tail\":\"སེམས་ཅན་སྐྱེ་བ་དང་སྐྱེ་བའི་གནས་ཀྱི་ཀྱང་རིགས་པར་བྱའོ།\"},{\"label\":\"QUOTE\",\"frame\":\"རྣམ་འགྲེལ་ལས།\",\"head\":\"སྡུག་བསྔལ་འཁོར་བ་ཅན་ཕུང་པོ། །\",\"tail\":\"\"},{\"label\":\"QUOTE\",\"frame\":\"ཀུན་བཏུས་ལས།\",\"head\":\"ཀུན་འབྱུང་གི་བདེན་པ་གང་ཞེ་ན།\",\"tail\":\"ཉོན་མོངས་པའི་དབང་གིས་བྱུང་བའི་ལས་སོ།\"},{\"label\":\"QUOTE\",\"frame\":\"མཛོད་ལས།\",\"head\":\"སོ་སོར་བརྟགས་པའི་འགོག་པ་གང། །\",\"tail\":\"བྲལ་བའོ་སོ་སོ་ཡིན། །\"},{\"label\":\"QUOTE\",\"frame\":\"ཀུན་བཏུས་ལས།\",\"head\":\"ལམ་གྱི་བདེན་པ་གང་ཞེ་ན།\",\"tail\":\"ལམ་བསྒོམ་པ་དེ་ནི་ལམ་གྱི་མཚན་གཞི་མདོར་བསྡུས་པའོ།\"},{\"label\":\"QUOTE\",\"frame\":\"མཛོད་ལས།\",\"head\":\"གང་ཞིག་གསུམ་ལ་སྐྱབས་འགྲོ་སྟེ། །\",\"tail\":\"མྱ་ངན་འདས་ལ་སྐྱབས་སུ་འགྲོ། །\"},{\"label\":\"QUOTE\",\"frame\":\"སྐྱབས་གསུམ་བདུན་ཅུ་པ་ལས།\",\"head\":\"ཐུབ་དབང་དག་གི་སྐུ་གསུམ་དང། །\",\"tail\":\"མྱ་ངན་འདས་དང་གང་ཟག་བརྒྱད། །\"},{\"label\":\"QUOTE\",\"frame\":\"\",\"head\":\"ཤཱ་རིའི་ལུང་ལས་དགྲ་བཅོམ་གྱིས། །\",\"tail\":\"སངས་རྒྱས་ཁོངས་སུ་གཏོགས་པར་འདོད། །\"},{\"label\":\"QUOTE\",\"frame\":\"རྒྱུད་བླ