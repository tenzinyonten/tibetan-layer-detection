  "raw_text": "{\"spans\":[{\"label\":\"QUOTE\",\"frame\":\"ཕྱག་ཆེན་ཐིག་ལེ་ལས།\",\"head\":\"འདི་ནི་ཕྱག་རྒྱ་ཆེན་པོ་སྟེ།\",\"tail\":\"ཆེན་པོ་ཟུང་དུ་འཇུག་པའོ། །\"},{\"label\":\"QUOTE\",\"frame\":\"སྙན་རྒྱུད་རྡོ་རྗེའི་ཚིག་རྐང་ལས།\",\"head\":\"ཕྱག་ནི་གཉིས་མེད་ཡེ་ཤེས་ངོ་ཡིས་ཟིན།\",\"tail\":\"གཞན་གྱིས་མ་ཡིན་རང་གྲོལ་ཆོས་སྐུའོ།\"},{\"label\":\"QUOTE\",\"frame\":\"གསང་བ་གྲུབ་པ་ལས།\",\"head\":\"ཕྱག་རྒྱ་ཆེན་པོ་རྣམ་སྒོམ་པ།\",\"tail\":\"དེ་ཡི་གོང་ན་གཞན་མེད་པའོ།\"},{\"label\":\"QUOTE\",\"frame\":\"དུས་འཁོར་བཀའ་འགྲེལ་པདྨ་ཅན་ལས།\",\"head\":\"ཕྱག་རྒྱ་ཞེས་པ་ནི་འདས་པ་དང་།\",\"tail\":\"འཁོར་བའི་བག་ཆགས་དང་བྲལ་བར་གྱུར་པས་ན་ཆེན་པོའོ།\"},{\"label\":\"QUOTE\",\"frame\":\"གསེར་སྡིངས་པའི་ཐེག་སྒྲོན་ལས་ནི།\",\"head\":\"ཕྱག་རྒྱ་ཆེན་པོའི་ངེས་ཚིག་ནི།\",\"tail\":\"ཆེན་པོ་ཞེས་ནི་བརྗོད་པ་ཡིན།\"},{\"label\":\"QUOTE\",\"frame\":\"རྗེ་སྒམ་པོ་པས།\",\"head\":\"སྣང་སྲིད་འཁོར་འདས་རྣམས་ཆོས་ཉིད་སྐྱེ་བ་མེད་པའི་ངང་ལས་མི་འདའ་བར་རྟོགས་པ་ནི་ཕྱག་གོ\",\"tail\":\"ཆོས་ཉིད་རང་གྲོལ་དུ་རྟོགས་པས་ན་ཆེན་པོའོ།\"},{\"label\":\"QUOTE\",\"frame\":\"མཻ་ཏྲི་པའི་དེ་ཉིད་བཅུ་པ་ལས།\",\"head\":\"ཐབས་དང་ཤེས་རབ་མཉམ་སྦྱོར་བ༑\",\"tail\":\"ཕྱག་རྒྱ་ཆེན་པོ་མཉམ་སྦྱོར་བ།\"},{\"label\":\"QUOTE\",\"frame\":\"བརྟག་གཉིས་ལས།\",\"head\":\"ལྷན་ཅིག་སྐྱེས་པས་གང་སྐྱེས་པ།\",\"tail\":\"ལྷན་ཅིག་སྐྱེས་པར་དེ་བརྗོད་བྱ༑\"},{\"label\":\"QUOTE\",\"frame\":\"ཌོམ་བྷི་པའི་ལྷན་ཅིག་སྐྱེས་གྲུབ་ལས།\",\"head\":\"ལྷན་ཅིག་སྐྱེས་གྱུར་དེ་ཡི་ཕྱིར།\",\"tail\":\"བརྗོད་བྲལ་ལྷན་ཅིག་སྐྱེས་པར་བཤད།\"},{\"label\":\"QUOTE\",\"frame\":\"རྗེ་དྭགས་པོས།\",\"head\":\"སེམས་ཉིད་ལྷན་ཅིག་སྐྱེས་པ་ཆོས་ཀྱི་སྐུ།\",\"tail\":\"དེ་ཕྱིར་སྣང་སེམས་དབྱེར་མེད་ལྷན་ཅིག་སྐྱེས།\"},{\"label\":\"QUOTE\",\"frame\":\"རྗེ་སྒོམ་ཆུང་གིས༑\",\"head\":\"སེམས་ཉིད་ལྷན་ཅིག་སྐྱེས་པ་ཆོས་སྐུའི་དངོས།\",\"tail\":\"དབྱེར་མེད་ལྷན་ཅིག་སྐྱེས་པ་ཆོས་སྐུའི་དོན།\"},{\"label\":\"QUOTE\",\"frame\":\"དཔལ་ཟླ་འོད་གཞོན་ནུས།\",\"head\":\"སེམས་དང་རྣམ་རྟོག་ཆོས་སྐུ་གསུམ།\",\"tail\":\"ལྷན་ཅིག་སྐྱེས་སྦྱོར་མི་ཟེར་རམ།\"},{\"label\":\"QUOTE\",\"frame\":\"རྗེ་ཕག་གྲུས།\",\"head\":\"སེམས་དང་རྣམ་རྟོག་ཆོས་སྐུ་གསུམ། དང་པོར་ལྷན་ཅིག་སྐྱེས་པ་དེ།\",\"tail\":\"ལྷན་ཅིག་སྐྱེས་སྦྱོར་ཞེས་སུ་བཤད།\"},{\"label\":\"QUOTE\",\"frame\":\"རྣམ་སྣང་མངོན་བྱང་ལས།\",\"head\":\"ལུས་བསྲངས་རྡོ་རྗེའི་སྐྱིལ་ཀྲུང་བྱ།\",\"tail\":\"ཡིད་ནི་རྩེ་གཅིག་ཕྱག་རྒྱ་ཆེ།\"},{\"label\":\"QUOTE\",\"frame\":\"རྨད་བྱུང་རྒྱུད་ལས༑\",\"head\":\"ལུས་ནི་རྡོ་རྗེའི་སྐྱིལ་མོ་ཀྲུང་།\",\"tail\":\"མཉམ་བཞག་ཕྱག་རྒྱ་ལྟེ་འོག་བཙིར།\"},{\"label\":\"QUOTE\",\"frame\":\"རྒྱུད་རྡོ་རྗེའི་ཕྲེང་བ་ལས༑\",\"head\":\"འབྱུང་བཞིའི་ལུས་ཀྱི་འདུག་ཚུལ་ནི།\",\"tail\":\"བདེ་དང་ཡངས་དང་ལྷོད་དང་གསུམ།\"},{\"label\":\"QUOTE\",\"head\":\"རྟེན་འབྲེལ་ལུས་ལ་བསྒྲིགས་པས་རྟོགས་པ་སེམས་ལ་འཆར།\",\"tail\":\"\"},{\"label\":\"QUOTE\",\"head\":\"ལུས་དྲང་བས་རྩ་དྲང་། རྩ་དྲང་བས་རླུང་དྲང་། རླུང་དྲང་བས་ཐིག་ལེ་དྲང་། ཐིག་ལེ་དྲང་བས་སེམས་ཟིན།\",\"tail\":\"\"},{\"label\":\"QUOTE\",\"head\":\"ལུས་དྲང་བས་རྩ་དྲང་། རྩ་དྲང་བས་རླུང་དྲང་༑ རྩ་རླུང་གནད་དུ་ཚུད་པས་སེམས་ཟིན།\",\"tail\":\"\"},{\"label\":\"QUOTE\",\"head\":\"རྡོ་རྗེ་སྐྱིལ་ཀྲུང་རྫོགས་སངས་རྒྱས།\",\"tail\":\"\"},{\"label\":\"QUOTE\",\"frame\":\"གདན་བཞི་ལས།\",\"head\":\"རླུང་དང་ངག་ནི་གཡོ་མེད་པ།\",\"tail\":\"དེ་ཡིས་བསམ་གཏན་འབྲས་བུ་འགྲུབ།\"},{\"label\":\"QUOTE\",\"frame\":\"ཀླུ་སྒྲུབ་ཀྱིས།\",\"head\":\"ཁྱོད་ཀྱིས་ཐུགས་དུལ་མཛོད་ཅིག་བཅོམ་ལྡན་གྱིས།\",\"tail\":\"སེམས་ནི་ཆོས་ཀྱི་རྩ་བ་ལགས་པར་གསུངས།\"},{\"label\":\"QUOTE\",\"frame\":\"ཞི་བ་ལྷས།\",\"head\":\"སེམས་ཀྱི་གསང་འདི་མ་ཤེས་ན།\",\"tail\":\"དེ་དག་དོན་མེད་གྱི་ནར་འཁྱམས།\"},{\"label\":\"QUOTE\",\"frame\":\"རྗེ་དྭགས་པོས།\",\"head\":\"འདས་པའི་རྗེས་མི་དཔྱོད། མ་འོངས་པའི་སྔོན་མི་བསུ།\",\"tail\":\"མ་བཅོས་པའི་ངང་ལ་རང་གར་ཙན་གྱིས་ཞོག\"},{\"label\":\"QUOTE\",\"frame\":\"ས་ར་ཧའི་ཞབས་ཀྱིས།\",\"head\":\"བསམ་དང་བསམ་བྱ་ཐམས་ཅད་ཡོངས་སུ་དོར་ནས་སུ།\",\"tail\":\"ལྷན་ཅིག་སྐྱེས་པ་འབྱུང་བར་ཐེ་ཚོམ་མེད།\"},{\"label\":\"QUOTE\",\"frame\":\"ཏིལླི་པས།\",\"head\":\"མི་མནོ་མི་བསམ་མི་དཔྱད་ཅིང་།\",\"tail\":\"མི་བསྒོམ་མི་སེམས་རབ་བབས་བཞག\"},{\"label\":\"QUOTE\",\"frame\":\"ཆོས་ཀྱི་རྒྱལ་པོ་ཟླ་འོད་གཞོན་ནུས༑\",\"head\":\"མ་ཡེངས་པ་ནི་སངས་རྒྱས་ཀུན་གྱི་ལམ།\",\"tail\":\"མ་ཡེངས་པ་ནི་གདམས་པ་ཀུན་གྱི་གཙོ།\"},{\"label\":\"QUOTE\",\"head\":\"མ་ཡེངས་རྒྱུན་གྱི་དྲན་པ་འདི། དུས་གསུམ་སངས་རྒྱས་གཞུང་ལམ་ཡིན།\",\"tail\":\"\"},{\"label\":\"QUOTE\",\"frame\":\"ཏེ་ལོ་པས།\",\"head\":\"ལུས་ཀྱི་བྱ་བ་ཡོངས་ཐོང་རྣལ་མར་ཞོག །\",\"tail\":\"ཡིད་ལ་མི་བསམ་ལ་བཟླའི་ཆོས་ལ་ལྟོས།\"},{\"label\":\"QUOTE\",\"frame\":\"མགོན་པོ་ཀླུ་སྒྲུབ་ཀྱིས།\",\"head\":\"དབང་ཕྱུག་ལུས་གཏོགས་དྲན་པ་བདེ་གཤེགས་ཀྱིས།\",\"tail\":\"དྲན་པ་ཉམས་པས་ཆོས་ཀུན་འཇིག་པར་འགྱུར།\"},{\"label\":\"QUOTE\",\"frame\":\"མངོན་པ་ཀུན་བཏུས་ལས།\",\"head\":\"དྲན་པ་གང་ཞེ་ན། འདྲིས་པའི་དངོས་པོ་ལ་སེམས་བརྗེད་པ་མེད་པ་སྟེ།\",\"tail\":\"སེམས་རྣམ་པར་མི་གཡེང་བའི་ལས་ཅན་ནོ།\"},{\"label\":\"QUOTE\",\"frame\":\"ས་སྙིང་འཁོར་ལོ་བཅུ་པའི་མདོ་ལས།\",\"head\":\"ཇི་ལྟར་ན་དྲན་པའི་དབང་གིས་ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་དུ་དབུགས་ཕྱི་ནང་དུ་རྒྱུ་བ་ལ་རྟོག་པ་སྐྱེ་ན།\",\"tail\":\"ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་དུ་བགྲང་བ་དང་།\"},{\"label\":\"QUOTE\",\"frame\":\"སྡོམ་འབྱུང་ལས།\",\"head\":\"རྣལ་འབྱོར་པས་ནི་མཉམ་བཞག་པས།\",\"tail\":\"སྒྲ་དང་བྲལ་བར་རྟག་ཏུ་བཟླ།\"},{\"label\":\"QUOTE\",\"frame\":\"རྒྱུད་རྡོ་རྗེ་ཕྲེང་བ་ལས༑\",\"head\":\"སྐུ་གསུང་ཐུགས་ཀྱི་རྡོ་རྗེ་རྣམས།\",\"tail\":\"དེ་ཡིས་དངོས་གྲུབ་མྱུར་འགྲུབ་འགྱུར༑\"},{\"label\":\"QUOTE\",\"frame\":\"རྡོ་རྗེ་མཁའ་འགྲོའི་རྒྱུད་ལས།\",\"head\":\"དགང་བ་ཡིས་ནི་ལུས་དག་ནས།\",\"tail\":\"སྒོ་ཡི་བུ་ག་འགག་པར་འགྱུར།\"},{\"label\":\"QUOTE\",\"frame\":\"སྡོམ་འབྱུང་ལས།\",\"head\":\"སྟེང་དང་འོག་ཏུ་འགྲོ་བའི་རླུང་༑\",\"tail\":\"དེ་ཡིས་བརྟན་པའི་གོ་འཕང་ཐོབ།\"},{\"label\":\"QUOTE\",\"frame\":\"དཔལ་ནཱ་རོ་པས།\",\"head\":\"རྔུབ་དང་དགང་དང་གཞིལ་བ་དང་།\",\"tail\":\"ཡོན་ཏན་སྐྱོན་དུ་འགྱུར་བའི་ཉེན།\"},{\"label\":\"QUOTE\",\"frame\":\"འཇམ་དབྱངས་བུདྡྷས།\",\"head\":\"རླུང་སེམས་དབྱེར་མེད་མི་སྐྱོང་བའི།\",\"tail\":\"ལུས་ཀྱི་འཁྲུལ་འཁོར་གར་མཁན་འདྲ།\"},{\"label\":\"QUOTE\",\"frame\":\"རྗེ་སྒོམ་ཚུལ་གྱིས།\",\"head\":\"རླུང་སེམས་དབྱེར་མེད་མན་ངག་འདི།\",\"tail\":\"སྒོམ་ཆེན་རབ་ཀྱི་ཉམས་ལེན་ཡིན།\"},{\"label\":\"QUOTE\",\"frame\":\"དབུ་མ་སྙིང་པོ་ལས།\",\"head\":\"ཡིད་ཀྱི་གླང་པོ་ལོག་འགྲོ་བ།\",\"tail\":\"ཤེས་རབ་ལྕགས་ཀྱུས་རིམ་དབང་བྱ།\"},{\"label\":\"QUOTE\",\"frame\":\"སྒོམ་རིམ་བར་པ་ལས།\",\"head\":\"དེ་ལ་ཉེ་བར་བཞག་ནས་སེམས་ལ་འདི་ལྟར་དཔྱད་པར་བྱ་སྟེ།\",\"tail\":\"རྣམ་པར་ཡེངས་སམ་སྙམ་དུ་བརྟག་པར་བྱའོ།\"},{\"label\":\"QUOTE\",\"frame\":\"གསང་འདུས་ལས།\",\"head\":\"སེམས་ནི་སེམས་མིན་བྱས་ནས་སུ།\",\"tail\":\"ཅི་ཡང་བསམ་པར་མི་བྱའོ།\"},{\"label\":\"QUOTE\",\"head\":\"རྟེན་མེད་མ་བཅོས་པ་ལ་བཞག\",\"tail\":\"\"},{\"label\":\"QUOTE\",\"frame\":\"རྗེ་མི་ལས།\",\"head\":\"ལུས་གནད་མཉམ་པར་བཞག་དུས་སུ།\",\"tail\":\"ཞིག་གནས་ལྟེངས་པོ་བྱ་བ་ཡིན།\"},{\"label\":\"QUOTE\",\"frame\":\"རྗེ་དྭགས་པོས།\",\"head\":\"མི་རྟོག་ལྟེངས་པོ་སྒོམ་གྱི་བདུད།\",\"tail\":\"\"},{\"label\":\"QUOTE\",\"frame\":\"རིན་ཆེན་ཕྲེང་བ་ལས།\",\"head\":\"རྨོངས་པས་ཕལ་ཆེར་དུད་འགྲོར་འགྱུར།\",\"tail\":\"\"},{\"label\":\"QUOTE\",\"frame\":\"ས་པཎ་གྱིས།\",\"head\":\"བླུན་པོས་ཕྱག་རྒྱ་ཆེ་སྒོམ་པ།\",\"tail\":\"ཕལ་ཆེར་དུད་འགྲོའི་རྒྱུ་རུ་འགྱུར།\"},{\"label\":\"QUOTE\",\"frame\":\"ཏིལླི་པས༑\",\"head\":\"ལས་ནི་དང་པོ་གཅོང་རོང་འབབ་ཆུ་འདྲ།\",\"tail\":\"\"},{\"label\":\"QUOTE\",\"frame\":\"རྗེ་ཞང་གིས།\",\"head\":\"གནས་པ་དང་པོ་བྱུང་དུས་སུ།\",\"tail\":\"རྟག་པར་འགྱུས་ཀྱང་ངོ་མ་ཤེས།\"},{\"label\":\"QUOTE\",\"frame\":\"དོ་ཧ་ལས།\",\"head\":\"འཇུར་བུས་བཅིངས་པའི་སེམས་ཉིད་ནི།\",\"tail\":\"གློད་ན་གྲོལ་བ་ཐེ་ཚོམ་མེད།\"},{\"label\":\"QUOTE\",\"frame\":\"ཏིལླི་པས།\",\"head\":\"བར་དུ་ཆུ་བོ་གདྒཱ་དལ་བཞིན་གཡོ།\",\"tail\":\"\"},{\"label\":\"QUOTE\",\"frame\":\"རྗེ་ཞང་གིས།\",\"head\":\"དེ་ནས་དལ་འབབ་ཆུ་བོ་བཞིན།\",\"tail\":\"ཤེས་པ་དལ་ཞིང་རྣམ་རྟོག་ཉུང་།\"},{\"label\":\"QUOTE\",\"frame\":\"ཆོས་རྗེ་དྭགས་པོས།\",\"head\":\"སེམས་མ་བཅོས་ན་བདེ། ཆུ་མ་རྙོགས་ན་དྭངས།\",\"tail\":\"\"},{\"label\":\"QUOTE\",\"frame\":\"གླིང་རས་ཀྱིས།\",\"head\":\"མ་བཅོས་སོ་མར་བཞག་ན་རྟོགས་པ་འཆར།\",\"tail\":\"རྟག་ཏུ་མཉམ་པར་ཞོག་དང་རྣལ་འབྱོར་པ།\"},{\"label\":\"QUOTE\",\"frame\":\"ས་ར་ཧའི་ཞབས་ཀྱིས།\",\"head\":\"བཅིངས་པར་གྱུར་ན་ཕྱོགས་བཅུར་འགྲོ་བར་རྩོམ།\",\"tail\":\"གོ་ལྡོག་རྔ་མོང་ལྟ་བུར་བདག་གིས་རྟོགས།\"},{\"label\":\"QUOTE\",\"frame\":\"ས་ར་ཧ་ཞབས་ཀྱིས།\",\"head\":\"བྲམ་ཟེས་སྐུད་པ་འཁལ་བ་བཞིན།\",\"tail\":\"སེམས་གྲིམས་ལྷོད་སྙོམས་པའི་རྣལ་འབྱོར་བདེ།\"},{\"label\":\"QUOTE\",\"frame\":\"རྗེ་ཕག་གྲུས།\",\"head\":\"གཉུག་མ་ཆོས་སྐུ་བསྒོམ་པ་ནི།\",\"tail\":\"སོ་མ་མ་བཅོས་ལྷུག་པར་བཞག\"},{\"label\":\"QUOTE\",\"frame\":\"ཁ་སྦྱོར་ལས།\",\"head\":\"གཉིས་ཀྱིས་བཟུང་བ་ཡོངས་སྤངས་ལ།\",\"tail\":\"དེ་ཉིད་ཕྱིར་ན་ཡོངས་སུ་སྤངས།\"},{\"label\":\"QUOTE\",\"frame\":\"དཔལ་ཤ་བ་རིས།\",\"head\":\"རྟགས་བཅུ་རྟོགས་པར་གྱུར་པས་ན།\",\"tail\":\"སྣ་ཚོགས་གཟུགས་ཅན་འོད་གསལ་བའོ།\"},{\"label\":\"QUOTE\",\"frame\":\"ཉམས་སྒྲོན་ལས།\",\"head\":\"གཞན་ཡང་རླུང་ཟིན་བག་ཆགས་དང་།\",\"tail\":\"ཉམས་ཀྱི་སྣང་བ་ཅི་ཡང་འཆར།\"},{\"label\":\"QUOTE\",\"frame\":\"རྗེ་མི་ལས།\",\"head\":\"རྣལ་འབྱོར་པའི་ཉམས་ལ་ཅི་ཡང་འཆར།\",\"tail\":\"དབྱར་ཀའི་སྤང་ལ་ཅི་ཡང་སྐྱེ།\"},{\"label\":\"QUOTE\",\"frame\":\"རྗེ་མི་ལས།\",\"head\":\"བདེ་དང་གསལ་དང་མི་རྟོག་གསུམ།\",\"tail\":\"འདི་གསུམ་སྒོམ་གྱི་གོལ་ས་ཡིན།\"},{\"label\":\"QUOTE\",\"frame\":\"རྗེ་ཕག་གྲུས།\",\"head\":\"བླ་མ་དམ་པའི་རྩར་ཕྱིན་ཏེ།\",\"tail\":\"གཟུགས་མེད་ཁམས་སུ་གོལ་བར་འགྱུར།\"},{\"label\":\"QUOTE\",\"frame\":\"གླིང་རས་ཀྱིས།\",\"head\":\"ཉམས་མྱོང་འཇའ་ཚོན་དང་འདྲ་བའི་གསལ་སྣང་ལ།\",\"tail\":\"བསླུ་བྲིད་གོལ་ས་ཞིག་ཡིན་ཏེ་ངོ་མ་ཤེས།\"},{\"label\":\"QUOTE\",\"frame\":\"བྲམ་ཟེ་ཆེན་པོས།\",\"head\":\"བསམ་དང་བསམ་བྱ་རབ་ཏུ་སྤངས་ནས་སུ།\",\"tail\":\"ཇི་ལྟར་བུ་ཆུང་ཚུལ་དུ་གནས་པར་བྱ།\"},{\"label\":\"QUOTE\",\"head\":\"བསམ་དང་བསམ་བྱ་ཐམས་ཅད་ཡོངས་སུ་དོར་ནས་སུ། ཇི་ལྟར་བུ་ཆུང་ལྷུག་པར་གནས་པ་བཞིན།\",\"tail\":\"ལྷན་ཅིག་སྐྱེས་པ་འབྱུང་བར་ཐེ་ཚོམ་མེད།\"},{\"label\":\"QUOTE\",\"frame\":\"རྫོགས་ཆེན་བི་མ་སྙིང་ཐིག\",\"head\":\"དང་པོ་རྣམ་རྟོག་ངོ་ཤེས་པས་གྲོལ་བ་སྔར་འདྲིས་ཀྱི་མི་དང་འཕྲད་པ་ལྟ་བུ\",\"tail\":\"\"},{\"label\":\"QUOTE\",\"frame\":\"རྗེ་ཞང་གིས།\",\"head\":\"དེ་ནས་རྒྱ་མཚོའི་གཏིང་བཞིན་དུ།\",\"tail\":\"ཤེས་པ་མི་གཡོ་བརྟན་པར་གནས།\"},{\"label\":\"QUOTE\",\"frame\":\"པྲ་ཁྲིད་ལས།\",\"head\":\"མི་རྟོག་ཐིག་ལེའི་ངང་ལ་གནས་པ་ནི།\",\"tail\":\"མི་གཡོ་གསལ་བ་ཏིལ་གྱི་མར་མེ་འདྲ༑\"},{\"label\":\"QUOTE\",\"frame\":\"སློབ་དཔོན་དཔའ་བོས།\",\"head\":\"ཁྱོད་ཀྱི་ཆོས་ལ་མི་ཕྱོགས་པའི།\",\"tail\":\"སྲིད་པ་དག་ནི་བཟློག་པར་བྱེད༑\"},{\"label\":\"QUOTE\",\"frame\":\"མདོ་སྡེ་རྒྱན་ལས།\",\"head\":\"དེས་ན་དེ་ཡི་ལུས་དང་སེམས།\",\"tail\":\"ཡིད་ལ་བྱེད་རང་བཅས་ཤེས་བྱ།\"},{\"label\":\"QUOTE\",\"frame\":\"གུ་རུ་རིན་པོ་ཆེས།\",\"head\":\"ཕུ་ཆུ་དྲག་པོ་བརྡབ་ཀྱིན་བཟང་།\",\"tail\":\"རྣལ་འབྱོར་སྒོམ་པ་བཤིག་གིན་བཟང་།\"},{\"label\":\"QUOTE\",\"frame\":\"རྗེ་འབྲུག་པས།\",\"head\":\"སྒོམ་ཤེས་མང་སྟེ་བཤིག་ཤེས་ཉུང་།\",\"tail\":\"\"},{\"label\":\"QUOTE\",\"frame\":\"རྗེ་རྒོད་ཚང་པས༑\",\"head\":\"མཐའི་སྐྱེལ་སོ་ལ་ཁྱད་པར་མེད་ཀྱང་།\",\"tail\":\"ལམ་ནི་ཀུ་སུ་ལུའི་འདི་མྱུར་བ་ཡིན།\"},{\"label\":\"QUOTE\",\"frame\":\"སློབ་དཔོན་ཞི་བ་ལྷས།\",\"head\":\"ཅི་ནས་ཏིང་འཛིན་བརྩོན་པ་ནི།\",\"tail\":\"དེ་ལྟར་ཡིད་ལ་སོ་སོར་བརྟག\"},{\"label\":\"QUOTE\",\"frame\":\"འོད་སྲུང་གིས་ཞུས་པའི་མདོར།\",\"head\":\"ཤིང་གཉིས་དྲུད་པ་ལས་ནི་མེ་འབྱུང་སྟེ།\",\"tail\":\"སྐྱེས་པ་དེ་ཡིས་དེ་གཉིས་སྲེག་པར་བྱེད།\"},{\"label\":\"QUOTE\",\"frame\":\"ཏིལླི་པས།\",\"head\":\"ལྟ་སྟངས་སེམས་འཛིན་ཡན་ལག་དུ་མ་ཡིས།\",\"tail\":\"རིག་པ་ངང་ལ་མི་གནས་བར་དུ་གཅུན།\"},{\"label\":\"QUOTE\",\"frame\":\"ཆོས་རྗེ་རས་པས།\",\"head\":\"རྟེན་ནི་རྡེའུ་ཤིང་བུ་དང་།\",\"tail\":\"མར་མེ་བླ་མ་དག་ལ་གཏད།\"},{\"label\":\"QUOTE\",\"frame\":\"ལྗོན་པས་ཞུས་པའི་མདོ་ལས།\",\"head\":\"ཞི་གནས་ནི་རྩེ་གཅིག་པའོ། །ལྷག་མཐོང་ནི་རིག་པའོ།\",\"tail\":\"\"},{\"label\":\"QUOTE\",\"frame\":\"ཀུན་མཁྱེན་པདྨ་དཀར་པོས\",\"head\":\"སྤྲོས་པ་ཉེ་བར་ཞི་བའི་དབྱིངས་སུ་གནས་པ་ལ་ཞི་གནས་དང་། དེའི་རྩལ་གསལ་རིག་གི་ཆ་ལ་ལྷག་མཐོང་དུ་བཞག\",\"tail\":\"\"},{\"label\":\"QUOTE\",\"frame\":\"རྗེ་སྒོམ་ཚུལ་གྱིས།\",\"head\":\"སེམས་ཉིད་ལྷན་ཅིག་སྐྱེས་པ་ཆོས་ཀྱི་སྐུ། །རྣམ་རྟོག་ལྷན་ཅིག་སྐྱེས་པ་ཆོས་སྐུའི་རླབས།\",\"tail\":\"དེ་ཕྱིར་གཤིས་གདངས་དབྱེར་མེད་ལྷན་ཅིག་སྐྱེས།\"},{\"label\":\"QUOTE\",\"frame\":\"རྫོགས་ཆེན་བི་མ་སྙིང་ཐིག\",\"head\":\"བར་དུ་རྣམ་རྟོག་ཁོ་རང་གིས་ངོ་ཤེས་ནས་གྲོལ་བ་སྦྲུལ་གྱི་མདུད་པ་ཞིག་པ་ལྟ་བུ\",\"tail\":\"\"},{\"label\":\"QUOTE\",\"frame\":\"ཆོས་རྫེ་རས་པས།\",\"head\":\"རྟོག་པའི་གཉེན་པོར་རྟོག་པ་ཐོང་།\",\"tail\":\"བཟློག་བསྒོམ་རྟོག་པའི་སྐོར་འདེད་ཡིན།\"},{\"label\":\"QUOTE\",\"frame\":\"རྗེ་སྒོམ་ཚུལ་གྱིས།\",\"head\":\"སེམས་ཉིད་ལྷན་ཅིག་སྐྱེས་པ་ཆོས་སྐུ་དངོས།\",\"tail\":\"དབྱེར་མེད་ལྷན་ཅིག་སྐྱེས་པ་ཆོས་སྐུའི་དོན།\"},{\"label\":\"QUOTE\",\"frame\":\"རྗེ་དྭགས་པོས\",\"head\":\"སེམས་ཉིད་ལྷན་ཅིག་སྐྱེས་པ་ཆོས་ཀྱི་སྐུ།\",\"tail\":\"དེ་ཕྱིར་སྣང་སེམས་དབྱེར་མེད་ལྷན་ཅིག་སྐྱེས།\"},{\"label\":\"QUOTE\",\"frame\":\"རྒྱལ་བའི་དབང་པོས\",\"head\":\"བློས་བྱས་ཀྱི་ལྟ་བ་བཟང་ཡང་འཇིག\",\"tail\":\"ངེས་པ་དེ་བླ་མའི་དྲིན་ལས་རྙེད།\"},{\"label\":\"QUOTE\",\"frame\":\"སློབ་དཔོན་ཞི་བ་ལྷས།\",\"head\":\"ཅི་ནས་ཏིང་འཛིན་བརྩོན་པ་ནི།\",\"tail\":\"དེ་ལྟར་ཡིད་ལ་སོ་སོར་བརྟག\"},{\"label\":\"QUOTE\",\"frame\":\"གོང་མའི་གསུང་ལས།\",\"head\":\"རྟེན་མེད་མ་བཅོས་པ་ལ་བཞག\",\"tail\":\"\"},{\"label\":\"QUOTE\",\"frame\":\"རྣལ་འབྱོར་གྱི་དབང་ཕྱུག་གླིང་གིས༑\",\"head\":\"གཞི་རྩ་བྲལ་བའི་སེམས་ཉིད་ལ།\",\"tail\":\"སློབ་དཔོན་གཅིག་ལགས་ཏེ་གོ་ལགས་སམ།\"},{\"label\":\"QUOTE\",\"frame\":\"གྲུབ་ཐོབ་ཨོ་རྒྱན་པས\",\"head\":\"སེམས་དང་སྣང་བ་གཉིས་པོ་མེ་དང་ཚ་བ་བཞིན་དུ་གནས་པ་ཡིན་མོད།\",\"tail\":\"\"},{\"label\":\"QUOTE\",\"frame\":\"དོ་ཧ་ལས།\",\"head\":\"ཁམས་གསུམ་མ་ལུས་འདི་དག་ཐམས་ཅད་ནི།\",\"tail\":\"འདོད་ཆགས་ཆེན་པོ་གཅིག་ཏུ་ཁ་དོག་སྒྱུར་ཅིག་དང་།\"},{\"label\":\"QUOTE\",\"frame\":\"རི་ཁྲོད་ཞབས་ཀྱིས།\",\"head\":\"གངྒཱ་ལ་སོགས་ཆུ་ཀླུང་སྣ་ཚོགས་པ།\",\"tail\":\"ཆོས་ཀྱི་དབྱིངས་སུ་རོ་གཅིག་ཤེས་པར་གྱིས།\"},{\"label\":\"QUOTE\",\"frame\":\"བྲམ་ཟེ་ཆེན་པོས\",\"head\":\"རྟོག་པར་གྱུར་ན་ཐམས་ཅད་དེ་ཡིན་ཏེ།\",\"tail\":\"བསྟན་བཅོས་སྙིང་ལ་འཆང་བའང་དེ་ཡིན་ནོ།\"},{\"label\":\"QUOTE\",\"frame\":\"ས་ར་ཧས།\",\"head\":\"ཇི་སྲིད་སེམས་ལས་རྣམས་འཕྲོས་པ།\",\"tail\":\"ཆུ་དང་རླབས་དག་གཞན་ཡིན་ནམ།\"},{\"label\":\"QUOTE\",\"head\":\"རྦ་རླབས་ཇི་ལྟར་ཆེ་ཡང་རྒྱ་མཚོའི་ངང་།\",\"tail\":\"\"},{\"label\":\"QUOTE\",\"frame\":\"ཀུན་སྤྱོད་ལས།\",\"head\":\"གང་དུ་བདེ་ཆེན་ཞེས་བྱ་གཅིག་པུ་ཉིད།\",\"tail\":\"གཅིག་པུའི་ཉམས་ཀྱིས་དུ་མའི་གར་མཛད་དོ།\"},{\"label\":\"QUOTE\",\"frame\":\"ཏིལླི་ངས\",\"head\":\"ཀྱེ་ཧོ། འདི་ནི་རང་རིག་ཡེ་ཤེས་ཏེ།\",\"tail\":\"རང་གིས་རང་ཉིད་འཚོལ་ཏེ་ཤེས་པར་བྱོས།\"},{\"label\":\"QUOTE\",\"head\":\"མི་མནོ་མི་བསམ་མི་དཔྱད་ཅིང་། །མི་བསྒོམ་མི་སེམས་རང་བབས་བཞག\",\"tail\":\"\"},{\"label\":\"QUOTE\",\"frame\":\"ཀུན་མཁྱེན་པདྨ་དཀར་པོས\",\"head\":\"གཞི་དང་ཉམས་ལེན་ཉམས་མྱོང་དང་།\",\"tail\":\"ལམ་ནི་ངེས་པའི་མདོར་བསྡུས་སོ།\"},{\"label\":\"QUOTE\",\"frame\":\"ཡང་དགོན་པས\",\"head\":\"ཕྱག་རྒྱ་ཆེན་པོ་ནི། བྲམ་ཟེ་ཆེན་པོ་ས་ར་ཧའི་བཞེད་ཀྱིས།\",\"tail\":\"ཐ་མལ་ཤེས་པ་སྒོང་དུ་ངོ་སྤྲོད་པའི་བླ་མ་ནི་ཉིན་མོའི་སྐར་མ་བས་ཀྱང་དཀོན་པ་ཡིན་ནོ།\"},{\"label\":\"QUOTE\",\"frame\":\"ཤ་ཝ་རིས\",\"head\":\"ཐ་མལ་ཤེས་པ་རང་ལུགས་གཉུག་མ་ལ།\",\"tail\":\"མ་བཟུང་མ་བཏང་རང་ག་ཉིད་དུ་ཞོག\"},{\"label\":\"QUOTE\",\"frame\":\"རྗེ་མི་ལས\",\"head\":\"ཐ་མལ་ཤེས་པ་སྐྱོང་སྐྱོང་ནས།\",\"tail\":\"མ་རིག་འཁྲུལ་པ་བརྗེད་དེ་ཐལ།\"},{\"label\":\"QUOTE\",\"frame\":\"རྗེ་དྭགས་པོས\",\"head\":\"ཐ་མལ་ཤེས་པས་ཆོག་པའི་ཉམས་ལེན་འདི༑\",\"tail\":\"སངས་རྒྱས་མི་གཟུགས་ཅན་གྱི་དྲིན་ལས་རྙེད།\"},{\"label\":\"QUOTE\",\"frame\":\"ཕ་དམ་པས\",\"head\":\"སྣང་བ་དགྲར་ལངས་ཁང་སྟོང་རྐུན་མ་འདྲ།\",\"tail\":\"དོན་ལ་ཐོབ་ཤོར་མེད་དོ་དིང་རི་བ།\"},{\"label\":\"QUOTE\",\"frame\":\"ཤ་ཝ་རིས\",\"head\":\"རང་གི་སེམས་ཉིད་རྟོགས་ན་ཕྱག་རྒྱ་ཆེན་པོ་སྟེ།\",\"tail\":\"ཇི་ལྟར་སྣང་བ་འདི་ཡང་རང་གི་སེམས་ལས་ལོགས་ན་མེད།\"},{\"label\":\"QUOTE\",\"frame\":\"མདོ་སྡེ་རྒྱན་ལས\",\"head\":\"སེམས་ལས་གཞན་མེད་པར་ནི་བློས་རིག་ནས།\",\"tail\":\"དེ་ནས་སེམས་ཀྱང་མེད་པ་ཉིད་དུ་རྟོགས།\"},{\"label\":\"QUOTE\",\"frame\":\"ཕ་དམ་པས\",\"head\":\"རྣམ་རྟོག་ངན་པ་སྤང་ལ་ཆུ་རྡོལ་འདྲ།\",\"tail\":\"བཀག་བས་ཁེགས་པ་མེད་དོ་དིང་རི་བ༑\"},{\"label\":\"QUOTE\",\"frame\":\"ས་ར་ཧས\",\"head\":\"རྣམ་རྟོག་ཡེ་ཤེས་ཆེན་པོ་སྟེ།\",\"tail\":\"འཁོར་བའི་རྒྱ་མཚོ་སྐེམ་བྱེད་ཡིན༑\"},{\"label\":\"QUOTE\",\"frame\":\"ས་ར་ཧས\",\"head\":\"སྙིང་རྗེ་དང་བྲལ་སྟོང་པ་ཉིད་ཞུགས་གང་།\",\"tail\":\"དེས་ནི་ལམ་མཆོག་རྙེད་པར་མི་འགྱུར་རོ།\"},{\"label\":\"QUOTE\",\"frame\":\"ནཱ་རོ་པས\",\"head\":\"སྣང་ཞིང་སྟོང་ལ་སྟོང་ཞིང་སྣང་།\",\"tail\":\"དེ་ཕྱིར་སྣང་སྟོང་དབྱེར་མེད་དོ།\"},{\"label\":\"QUOTE\",\"frame\":\"འབའ་ར་བས\",\"head\":\"སྣང་བ་རྟེན་ཅིང་འབྲེལ་འབྱུང་འདི།\",\"tail\":\"མེ་ལོང་ནང་གི་བྱད་དང་འདྲ༑\"},{\"label\":\"QUOTE\",\"frame\":\"རྩ་ཤེས་ལས\",\"head\":\"གང་ཞིག་རྟེན་འབྱུང་མ་ཡིན་པའི།\",\"tail\":\"ཆོས་འགའ་ཡོད་པ་མ་ཡིན་ནོ།\"},{\"label\":\"QUOTE\",\"frame\":\"བྱང་ཆུབ་སེམས་འགྲེལ་དུ\",\"head\":\"ཀུན་རྫོབ་སྟོང་པ་ཉིད་དུ་བཤད།\",\"tail\":\"སྟོང་ཉིད་ཁོ་ན་ཀུན་རྫོབ་ཡིན།\"},{\"label\":\"QUOTE\",\"frame\":\"མདོ་ལས\",\"head\":\"བདེན་དང་རྫུན་པ་འདི་ཡང་མཐའ་ཡིན་ལ།\",\"tail\":\"མཁས་པས་དབུས་ལ་ཡང་ནི་གནས་མི་བྱེད།\"},{\"label\":\"QUOTE\",\"frame\":\"དོ་ཧ་མཛོད་ལས\",\"head\":\"བླ་མས་སྨྲས་པ་གང་གི་སྙིང་ཞུགས་པ།\",\"tail\":\"ལག་པའི་མཐིལ་དུ་གནས་པའི་གཏེར་མཐོང་འདྲ།\"},{\"label\":\"QUOTE\",\"frame\":\"ཕྱག་རྒྱ་ཆེན་པོ་སྤྲོས་བྲལ་རབ་ཏུ་མི་གནས་པའི་རྒྱུད་ལས\",\"head\":\"འདི་ནི་ཕྱག་རྒྱ་ཆེན་པོ་སྟེ།\",\"tail\":\"ལམ་དང་གཉེན་པོས་རྙེད་པ་མིན།\"},{\"label\":\"QUOTE\",\"frame\":\"ས་ར་ཧས\",\"head\":\"མདུན་དང་རྒྱབ་དང་ཕྱོགས་བཅུ་རུ།\",\"tail\":\"ད་ནི་སུ་ལའང་དྲི་བར་མི་བྱའོ༑\"},{\"label\":\"QUOTE\",\"frame\":\"རྣལ་འབྱོར་གྱི་དབང་ཕྱུག་ཆེན་པོ་གླིང་རས་ཀྱིས\",\"head\":\"མ་བཅོས་སོ་མར་བཞག་ན་རྟོགས་པ་འཆར།\",\"tail\":\"རྟག་ཏུ་མཉམ་པར་ཞོག་དང་རྣལ་འབྱོར་པ།\"},{\"label\":\"QUOTE\",\"frame\":\"རྣལ་འབྱོར་གྱི་དབང་ཕྱུག་གླིང་གིས\",\"head\":\"གཞི་རྩ་བྲལ་བའི་སེམས་ཉིད་ལ།\",\"tail\":\"སློབ་དཔོན་གཅིག་ལགས་ཏེ་གོ་ལགས་སམ།\"},{\"label\":\"QUOTE\",\"frame\":\"དོ་ཧ་ལས\",\"head\":\"ཁམས་གསུམ་མ་ལུས་འདི་དག་ཐམས་ཅད་ནི།\",\"tail\":\"འདོད་ཆགས་ཆེན་པོ་གཅིག་ཏུ་ཁ་དོག་སྒྱུར་ཅིག་དང་།\"},{\"label\":\"QUOTE\",\"frame\":\"རི་ཁྲོད་ཞབས་ཀྱིས\",\"head\":\"གངྒཱ་ལ་སོགས་ཆུ་ཀླུང་སྣ་ཚོགས་པ།\",\"tail\":\"ཆོས་ཀྱི་དབྱིངས་སུ་རོ་གཅིག་ཤེས་པར་གྱིས།\"},{\"label\":\"QUOTE\",\"frame\":\"བྲམ་ཟེ་ཆེན་པོས\",\"head\":\"རྟོག་པར་གྱུར་ན་ཐམས་ཅད་དེ་ཡིན་ཏེ།\",\"tail\":\"བསྟན་བཅོས་སྙིང་ལ་འཆང་བའང་དེ་ཡིན་ནོ།\"},{\"label\":\"QUOTE\",\"frame\":\"ས་ར་ཧས\",\"head\":\"ཇི་སྲིད་སེམས་ལས་རྣམས་འཕྲོས་པ།\",\"tail\":\"ཆུ་དང་རླབས་དག་གཞན་ཡིན་ནམ།\"},{\"label\":\"QUOTE\",\"frame\":\"ཀུན་སྤྱོད་ལས\",\"head\":\"གང་དུ་བདེ་ཆེན་ཞེས་བྱ་གཅིག་པུ་ཉིད།\",\"tail\":\"གཅིག་པུའི་ཉམས་ཀྱིས་དུ་མའི་གར་མཛད་དོ།\"},{\"label\":\"QUOTE\",\"frame\":\"བསྲེ་སྐོར་གྱི་གཞུང་ལས\",\"head\":\"ཀྱེ་ཧོ། འདི་ནི་རང་རིག་ཡེ་ཤེས་ཏེ།\",\"tail\":\"རང་གིས་རང་ཉིད་འཚོལ་ཏེ་ཤེས་པར་བྱོས།\"},{\"label\":\"QUOTE\",\"frame\":\"ཏིལླི་པའི་ཆོས་དྲུག་ཏུ\",\"head\":\"མི་མནོ་མི་བསམ་མི་དཔྱད་ཅིང་། །མི་བསྒོམ་མི་སེམས་རང་བབས་བཞག\",\"tail\":\"\"}]}",
