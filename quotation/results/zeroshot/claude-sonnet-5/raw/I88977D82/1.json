  "raw_text": "{\"spans\":[{\"label\":\"QUOTE\",\"frame\":\"ཡང་གནད་ཡིག་ལས།\",\"head\":\"རེ་འགའ་སྔགས་ཀྱི་འབྲུ་དོན་བསམ༔\",\"tail\":\"བླ་མ་དྷཱ་ཀིའི་སྲོག་ཐོབ་འགྱུར༔\"},{\"label\":\"QUOTE\",\"frame\":\"གནད་ཡིག་ལས།\",\"head\":\"ཡིད་ལ་བྱེད་དང་མི་འབྲལ་ཞིང༔\",\"tail\":\"མཆོག་དང་ཐུན་མོང་དངོས་གྲུབ་སྟེར༔\"},{\"label\":\"QUOTE\",\"frame\":\"འདི་ཉིད་ཀྱི་གཞུང་ལས།\",\"head\":\"ཡིད་ཆེས་བརྩོན་འགྲུས་དང་ལྡན་པས་བསྒྲུབས་ན\",\"tail\":\"ཟག་མེད་འོད་ཕུང་དུ་གྲོལ་བར་ངེས་སོ\"},{\"label\":\"QUOTE\",\"frame\":\"གནད་ཐེམས་ལས།\",\"head\":\"དུས་ཀྱི་བསྙེན་པ་ཟླ་བ་གསུམ༔\",\"tail\":\"དེ་བར་མཚམས་ནི་དམ་པར་གཅེས༔\"},{\"label\":\"QUOTE\",\"frame\":\"གུ་རུ་ཉིད་ཀྱི་ཞལ་ནས།\",\"head\":\"སིདྷི་བྱེ་བས་རིག་འཛིན་གནས་སུ་སྐྱེ༔\",\"tail\":\"\"},{\"label\":\"QUOTE\",\"frame\":\"རང་གཞུང་ལས།\",\"head\":\"མི་ཚིག་གིས་བར་མ་ཆོད་པར་བཟླས་པས\",\"tail\":\"ཐམས་ཅད་ཡིག་འབྲུ་འདི་རྣམས་ལ་བསྟིམས་ཡོད་པའི་ཕྱིར་རོ།\"},{\"label\":\"QUOTE\",\"frame\":\"མཚོ་རྒྱལ་གྱི་ཞལ་ནས།\",\"head\":\"པདྨ་འབྱུང་གནས་ཡང་སྙིང་འབྲུ་བཅུ་གཉིས༔\",\"tail\":\"ཅི་འདོད་དངོས་གྲུབ་ཐོབ་པར་གདོན་མི་ཟ༔\"},{\"label\":\"QUOTE\",\"frame\":\"གསང་ཐེམས་ལས།\",\"head\":\"དེ་སྒྲུབ་རྟགས་ཀྱི་རིམ་པ་ཡང༔\",\"tail\":\"དེ་ནི་གནས་སྐབས་འབྲས་བུའོ༔\"},{\"label\":\"QUOTE\",\"frame\":\"བྱང་གཏེར་ཐུགས་སྒྲུབ་ལས།\",\"head\":\"རང་གི་བླ་མ་སློབ་དཔོན་དང༔\",\"tail\":\"ལས་ཀྱི་སྒྲིབ་པ་དག་པའི་རྟགས༔\"},{\"label\":\"QUOTE\",\"head\":\"ངན་པའི་རྟགས་ནི་མུན་ནག་དང༔\",\"tail\":\"ངན་པའི་རྟགས་ཡིན་བཟློག་པ་བྱ༔\"},{\"label\":\"QUOTE\",\"frame\":\"འདི་ཉིད་ཀྱི་རང་གཞུང་ལས།\",\"head\":\"བརྩོན་འགྲུས་ཤེས་རབ་སྙིང་རྗེ་ལྡན༔\",\"tail\":\"སྤོས་དྲི་ངད་ལྡན་ཐོ་ལེ་བ༔\"},{\"label\":\"QUOTE\",\"frame\":\"རང་གཞུང་ལས།\",\"head\":\"འཕྲོ་འདུའི་དམིགས་པ་མ་ཤེས་ན༔\",\"tail\":\"དཔེར་ན་ཡིད་བཞིན་ནོར་བུ་འདྲ༔\"},{\"label\":\"QUOTE\",\"head\":\"ཞག་རེར་ཚར་ནི་བདུན་རེ་བཟླས༔\",\"tail\":\"ནམ་མཁའ་བཞིན་དུ་གནོད་མི་སྲིད༔\"},{\"label\":\"QUOTE\",\"frame\":\"རང་གཞུང་ལས།\",\"head\":\"དེ་ལྟར་བདག་མདུན་བུམ་པ་གཏོར་མ་དང༔\",\"tail\":\"ཀུན་དྲིལ་རང་ལུས་ལྕགས་ཀྱི་ཕོ་བྲང་ཆེ༔\"},{\"label\":\"QUOTE\",\"frame\":\"གཞུང་ལས།\",\"head\":\"དེ་ལྟར་བསྒྲུབས་པའི་ཡོན་ཏན་ནི༔\",\"tail\":\"ཚེ་ཡི་རིག་འཛིན་ཨེ་མ་ཧོ༔\"},{\"label\":\"QUOTE\",\"frame\":\"འདི་ཉིད་ལས།\",\"head\":\"གཞན་ཡང་བླ་མ་ཡི་དམ་མཁའ་འགྲོའི་རིགས་གང་དང་གང་བསྒྲུབ་ཀྱང༔\",\"tail\":\"རིན་ཆེན་གཏེར་གྱི་བང་མཛོད་ཁ་ཕྱེ་བ་ལྟར་འགྱུར་རོ༔\"},{\"label\":\"QUOTE\",\"frame\":\"ཐུགས་གཏེར་ཆེན་པོ་གྲོལ་བའི་ཐིག་ལེ་ལས།\",\"head\":\"བསྐྱེད་རིམ་ཉམས་གྲིབ་སེལ་བྱེད་འདི་མེད་ན༔\",\"tail\":\"ཚེ་སྲོག་ཉམ་ང་ས་ལམ་ཀུན་ལ་སྒྲིབ༔\"},{\"label\":\"QUOTE\",\"frame\":\"འཇམ་དཔལ་རྩ་རྒྱུད་ལས།\",\"head\":\"ཚུལ་ཁྲིམས་འཆལ་བས་སྔགས་འགྲུབ་པ། །\",\"tail\":\"ཡུལ་དང་ཕྱོགས་ཀྱང་མ་ཡིན་ནོ། །\"},{\"label\":\"QUOTE\",\"frame\":\"གྲོལ་ཐིག་ལས།\",\"head\":\"ངག་བཅད་གཞན་གྱི་ངོ་སྲུང་སྤང༔\",\"tail\":\"ཡི་གེའི་བརྡ་ལ་བརྟེན་པར་བྱ༔\"},{\"label\":\"QUOTE\",\"head\":\"སྨྲ་བཅད་མ་བྱས་ལོ་བདུན་བཟླས་པ་བས༔\",\"tail\":\"སྨྲ་བཅད་ལྡན་པས་ཞག་བདུན་བཟླས་པ་མཆོག༔\"},{\"label\":\"QUOTE\",\"head\":\"དག་དང་མ་དག་སྟོང་འགྱུར་ལ༔\",\"tail\":\"ཏིང་འཛིན་ཡོད་མེད་འབུམ་དུ་གྱུར༔\"},{\"label\":\"QUOTE\",\"head\":\"ཡེ་ཤེས་ལྷ་ལ་རང་རྒྱུད་ཀྱི། །\",\"tail\":\"གང་ལ་མོས་པ་དེ་ལྟར་སྣང་། །\"},{\"label\":\"QUOTE\",\"frame\":\"ཇི་སྐད་དུ།\",\"head\":\"དྲན་དང་ཤེས་བཞིན་མི་ལྡན་པ། །\",\"tail\":\"ཐེག་ཆེན་སྔགས་པར་ཅི་ཡིས་ཚུད། །\"},{\"label\":\"QUOTE\",\"frame\":\"གནད་ཐེམས་ལས།\",\"head\":\"མི་ཚེ་བླ་མ་བསྒྲུབ་པ་ལ༔\",\"tail\":\"བདག་གི་ཕྲིན་ལས་དེ་ཙམ་གྱུར༔\"},{\"label\":\"QUOTE\",\"head\":\"བློ་སྙིང་བྲང་གསུམ་པད་འབྱུང་ང་ལ་ཐོད༔\",\"tail\":\"བསྡུས་ན་པད་འབྱུང་ཞན་ནོ་རྗེ་འབངས་རྣམས༔\"},{\"label\":\"QUOTE\",\"frame\":\"འདི་ཉིད་ལས།\",\"head\":\"ཁྱད་པར་ངའི་གཏེར་ཆོས་ཟབ་མོ་དང༔\",\"tail\":\"ཉམས་སུ་སུས་བླངས་ཚེ་གཅིག་མི་གྲོལ་རེ༔\"},{\"label\":\"QUOTE\",\"frame\":\"ཇི་སྐད་དུ།\",\"head\":\"ཨེ་མ་ཧོཿ དམ་ཆོས་ཀུན་གྱི་སྙིང་པོ་ནི༔\",\"tail\":\"སྐལ་ལྡན་མྱུར་གྲོལ་གདམས་པ་བཤད༔\"},{\"label\":\"QUOTE\",\"frame\":\"སྐྱེས་རབས་ལས།\",\"head\":\"རབ་ཏུ་དམའ་བའི་སྟན་ལ་འདུག །\",\"tail\":\"རིམ་གྲོ་བསྐྱེད་ལ་ཆོས་ཉོན་ཅིག །\"},{\"label\":\"QUOTE\",\"head\":\"རྟོག་པ་ཐམས་ཅད་ལེགས་པར་བསྡུས་ནས་ནི། །\",\"tail\":\"བདེ་བར་གཤེགས་པ་རྣམས་ཀྱིས་བྱིན་མི་རློབས། །\"},{\"label\":\"QUOTE\",\"frame\":\"རྡོ་རྗེ་འབར་བའི་རྒྱུད་ལས།\",\"head\":\"ཕུན་སུམ་ཚོགས་པ་ལྔ་ལྡན་པས། །\",\"tail\":\"དེ་མ་ཡིན་པས་རྒྱུད་མི་འབྱུང་། །\"},{\"label\":\"QUOTE\",\"head\":\"ཕུན་སུམ་ཚོགས་པ་ལྔ་ལྡན་གྱིས། །དགོས་འདོད་འབྱུང་ཞིང་རྒྱུ་དང་ལྡན། །ཆོས་རྣམས་གཏན་ལ་འབེབས་པའོ། །\",\"tail\":\"\"},{\"label\":\"QUOTE\",\"frame\":\"མདོ་སྡེ་རྒྱན་ལས།\",\"head\":\"བཤེས་གཉེན་དུལ་བ་ཞི་བ་ཉེར་ཞི་བ། །\",\"tail\":\"ཡོན་ཏན་ལྷག་པར་བརྩོན་བཅས་ངང་གིས་ཆུབ། །\"},{\"label\":\"QUOTE\",\"frame\":\"ཨ་ཏིའི་བཀོད་པ་ཆེན་པོ་ལས།\",\"head\":\"མཁས་ཤིང་བྱ་བ་བྲལ་བ་དང་། །\",\"tail\":\"གསང་སྔགས་བླ་མའི་མཚན་ཉིད་དོ། །\"},{\"label\":\"QUOTE\",\"frame\":\"རང་ཤར་ལས།\",\"head\":\"དད་པའི་སྟོབས་དང་བརྩོན་འགྲུས་ཆེ། །\",\"tail\":\"དམ་ཚིག་ལྡན་ཞིང་སྒྲུབ་ལ་བརྩོན། །\"},{\"label\":\"QUOTE\",\"frame\":\"ཀློང་གསལ་ལས།\",\"head\":\"གངས་ཁྲོད་ལུང་སྟོང་རི་རྩེ་དུར་ཁྲོད་དམ། །\",\"tail\":\"སྐལ་ལྡན་སྐྱེས་བུ་ཉམས་ལེན་བྱ་བའི་གནས། །\"},{\"label\":\"QUOTE\",\"frame\":\"དེ་ཉིད་ལས།\",\"head\":\"དབྱར་མ་སྟོན་དང་དགུན་ཆུང་དཔྱིད་ཀྱི་དུས། །\",\"tail\":\"ཟེར་གཉིས་དུས་ནི་མཆོག་ཏུ་བཤད་པ་ཡིན། །\"},{\"label\":\"QUOTE\",\"frame\":\"ཉི་ཟླ་ཁ་སྦྱོར་ལས།\",\"head\":\"ལོ་རྒྱུས་དོན་གྱིས་མ་བཤད་ན། །\",\"tail\":\"ཡིད་མི་ཆེས་པའི་སྐྱོན་དུ་འགྱུར། །\"},{\"label\":\"QUOTE\",\"frame\":\"ཀློང་གསལ་ལས།\",\"head\":\"སྐལ་ལྡན་ངེས་ཤེས་བསྐྱེད་པའི་ཕྱིར། །\",\"tail\":\"ཀུན་ཏུ་བཟང་ནས་རིམ་པར་བཤད། །\"},{\"label\":\"QUOTE\",\"frame\":\"སྤྱོད་འཇུག་ལས།\",\"head\":\"དལ་འབྱོར་འདི་ནི་ཤིན་ཏུ་རྙེད་པར་དཀའ། །\",\"tail\":\"ཕྱིས་ནས་ཡང་དག་འབྱོར་བར་ག་ལ་འགྱུར། །\"},{\"label\":\"QUOTE\",\"frame\":\"སློབ་དཔོན་རྟ་དབྱངས་ཀྱིས།\",\"head\":\"ས་འམ་འོན་ཏེ་མཐོ་རིས་ན། །\",\"tail\":\"གལ་ཏེ་ཁྱོད་ཀྱིས་མཐོང་བ་འམ། །ཐོས་སམ་འོན་ཏེ་ཐེ་ཚོམ་ཟ། །\"},{\"label\":\"QUOTE\",\"frame\":\"ཀུན་མཁྱེན་ཆོས་རྗེས།\",\"head\":\"ཚེ་འདི་མི་རྟག་འཇིམ་པའི་བུམ་པ་འདྲ། །\",\"tail\":\"དེ་རིང་ཉིད་ནས་དམ་པའི་ཆོས་མཛོད་ཅིག །\"},{\"label\":\"QUOTE\",\"frame\":\"སྤྱོད་འཇུག་ལས།\",\"head\":\"དེ་རིང་ཁོ་ན་མི་འཆི་ཞེས། །\",\"tail\":\"བདེ་བར་འདུག་པ་རིགས་མ་ཡིན། །\"},{\"label\":\"QUOTE\",\"frame\":\"རྒྱལ་པོ་ལ་གདམས་པའི་མདོ་ལས།\",\"head\":\"དུས་ཀྱིས་ཉེན་ཏེ་རྒྱལ་པོ་འགྲོ་གྱུར་ན། །\",\"tail\":\"ལས་ནི་གྲིབ་མ་བཞིན་དུ་རྗེས་སུ་འབྲང་། །\"},{\"label\":\"QUOTE\",\"frame\":\"སློབ་དཔོན་ཆེན་པོས།\",\"head\":\"མདོར་ན་སྐྱེས་པའི་ཐ་མ་འཆི་བ་སྟེ། །\",\"tail\":\"བསགས་པ་འཛད་ཅིང་འབྱོར་བ་རྒུད་པའི་རྒྱུ། །\"},{\"label\":\"QUOTE\",\"frame\":\"མདོ་ལས།\",\"head\":\"ལུས་ཅན་རྣམས་ཀྱི་ལས་དག་ནི། །\",\"tail\":\"འབྲས་བུ་ཉིད་དུ་སོ་སོར་སྨིན། །\"},{\"label\":\"QUOTE\",\"frame\":\"སྡུད་པ་ལས།\",\"head\":\"ཆུ་ཡི་ཐིགས་པས་བུམ་པ་དང་པོ་ཐ་མའི་བར། །\",\"tail\":\"རིམ་གྱིས་དཀར་པོའི་ཡོན་ཏན་རྫོགས་པའི་སངས་རྒྱས་འགྱུར། །\"},{\"label\":\"QUOTE\",\"frame\":\"སྤྱོད་འཇུག་ལས།\",\"head\":\"བསྐལ་པ་སྟོང་དུ་བསགས་པ་ཡི། །\",\"tail\":\"ཁོང་ཁྲོ་གཅིག་གིས་འཇོམས་པར་བྱེད། །\"},{\"label\":\"QUOTE\",\"frame\":\"བཤེས་སྤྲིངས་ལས།\",\"head\":\"བརྒྱ་བྱིན་འཇིག་རྟེན་མཆོད་འོས་གྱུར་ནས་ཀྱང་། །\",\"tail\":\"འཁོར་བ་དག་ཏུ་ཡང་བྲན་ཉིད་དུ་འགྱུར། །\"},{\"label\":\"QUOTE\",\"frame\":\"དེ་ཉིད་ལས།\",\"head\":\"ལྷ་ཡུལ་འདོད་བདེ་ཤིན་ཏུ་ཆེན་པོ་ཡང་། །\",\"tail\":\"སྡུག་བསྔལ་རྒྱུན་མི་ཆད་པ་བསྟེན་འཚལ་ལོ། །\"},{\"label\":\"QUOTE\",\"frame\":\"བཤེས་སྤྲིངས་ལས།\",\"head\":\"དམྱལ་བ་བྲིས་པ་མཐོང་དང་ཐོས་པ་དང་། །\",\"tail\":\"རྣམ་སྨིན་ཉམས་སུ་མྱོང་རྣམས་སྨོས་ཅི་དགོས། །\"},{\"label\":\"QUOTE\",\"frame\":\"རྒྱུད་བླ་མ་ལས།\",\"head\":\"མི་གཙང་བ་ལ་དྲི་ཞིམ་མེད་བཞིན་འགྲོ་ལྔ་དག་ན་བདེ་བ་མེད། །\",\"tail\":\"དེ་ཡིས་སྡུག་བསྔལ་རྟག་ཏུ་མི་མཚོན་རྒྱ་ཚྭ་ལ་སོགས་རེག་སྐྱེས་བཞིན། །\"},{\"label\":\"QUOTE\",\"frame\":\"མངོན་པ་མཛོད་ལས།\",\"head\":\"གང་ཞིག་གསུམ་ལ་སྐྱབས་འགྲོ་བ། །\",\"tail\":\"མྱ་ངན་འདས་ལ་སྐྱབས་སུ་འགྲོ། །\"},{\"label\":\"QUOTE\",\"frame\":\"མགོན་པོ་བྱམས་པས།\",\"head\":\"སྐྱབས་ནི་སངས་རྒྱས་ཉག་གཅིག་ཡིན། །\",\"tail\":\"ཐུབ་པ་ཆོས་ཀྱི་སྐུ་ཅན་ཕྱིར། །\"},{\"label\":\"QUOTE\",\"frame\":\"བརྟག་གཉིས་ལས།\",\"head\":\"དངོས་དང་དངོས་མེད་བདག་ཉིད་གཙོ། །\",\"tail\":\"བརྟན་དང་གཡོ་བར་ཁྱབ་ནས་གནས། །\"},{\"label\":\"QUOTE\",\"frame\":\"མགོན་པོ་བྱམས་པས།\",\"head\":\"རྫོགས་སངས་སྐུ་ནི་འཕྲོ་ཕྱིར་དང་། །\",\"tail\":\"རྟག་ཏུ་སངས་རྒྱས་སྙིང་པོ་ཅན། །\"},{\"label\":\"QUOTE\",\"frame\":\"ཇི་སྐད་དུ།\",\"head\":\"ང་ནི་ཕྱི་མའི་དོན་གྱི་ཚེ། །\",\"tail\":\"ཁྱོད་ལ་སོགས་པའི་དོན་བྱེད་འགྱུར། །\"},{\"label\":\"QUOTE\",\"frame\":\"ཇི་སྐད་དུ།\",\"head\":\"བླ་མ་བདེ་གཤེགས་འདུས་པའི་སྐུ། །\",\"tail\":\"བླ་མ་དག་ལ་བརྟེན་ནས་བྱུང་། །\"},{\"label\":\"QUOTE\",\"frame\":\"མགོན་པོ་བྱམས་པས།\",\"head\":\"སེམས་བསྐྱེད་པ་ནི་གཞན་དོན་ཕྱིར། །\",\"tail\":\"ཡང་དག་རྫོགས་པའི་བྱང་ཆུབ་འདོད། །\"},{\"label\":\"QUOTE\",\"frame\":\"མེ་ཏོག་བཀོད་པའི་རྒྱུད་ལས།\",\"head\":\"བླ་མ་རྡོ་རྗེ་སེམས་དཔའ་བསྒོམ། །\",\"tail\":\"སྡིག་པ་རྣམ་གཉིས་དག་པར་འགྱུར། །\"},{\"label\":\"QUOTE\",\"frame\":\"བཀོད་པ་ཆེན་པོ་ལས།\",\"head\":\"རྣམ་དག་སེམས་ལྡན་མཎྜལ་ནི། །\",\"tail\":\"ཕུལ་བས་བསོད་ནམས་གཞལ་དུ་མེད། །\"},{\"label\":\"QUOTE\",\"frame\":\"ལུང་བྱང་ལས།\",\"head\":\"བླ་མ་མེད་པའི་གོང་རོལ་ན། །\",\"tail\":\"བླ་མ་དག་ལ་བརྟེན་ནས་བྱུང་། །\"},{\"label\":\"QUOTE\",\"frame\":\"དགོངས་འདུས་ལས།\",\"head\":\"བསྐལ་པ་འབུམ་གྱི་སངས་རྒྱས་ལས། །\",\"tail\":\"བླ་མ་བསྙེན་པར་ཤེས་པར་བྱ། །\"},{\"label\":\"QUOTE\",\"frame\":\"བདུད་རྩི་འབྱུང་བའི་རྒྱུད་ལས།\",\"head\":\"ལྷ་སྐུ་འབུམ་ཕྲག་བསྒོམ་པ་ལས། །\",\"tail\":\"བླ་མ་གཅིག་པུ་སྒོམ་པ་མཆོག །\"},{\"label\":\"QUOTE\",\"frame\":\"སྒྱུ་འཕྲུལ་རྒྱས་པ་ལས།\",\"head\":\"འདི་ལྟར་སྣང་བའི་ཆོས་རྣམས་ཀུན། །\",\"tail\":\"ཤེས་པ་འབའ་ཞིག་ཁོ་ནའོ། །\"},{\"label\":\"QUOTE\",\"frame\":\"གུར་ལས།\",\"head\":\"རིན་ཆེན་སེམས་ལས་ཕྱིར་གྱུར་པའི། །\",\"tail\":\"སངས་རྒྱས་མེད་ཅིང་སེམས་ཅན་མེད། །\"},{\"label\":\"QUOTE\",\"frame\":\"ས་ར་ཧས།\",\"head\":\"སེམས་ཉིད་གཅིག་པུ་ཀུན་གྱི་ས་བོན་ཡིན། །\",\"tail\":\"\"},{\"label\":\"QUOTE\",\"frame\":\"སུམ་ཅུ་རྩ་གསུམ་པའི་མདོ་ལས།\",\"head\":\"ལྷའི་བུ་ཁམས་གསུམ་པོ་ནི་སེམས་ཙམ་དུ་ཟད་ལ།\",\"tail\":\"དེ་སེམས་མི་དམིགས་པས་ཆོས་ཐམས་ཅད་མི་དམིགས་སོ། །\"},{\"label\":\"QUOTE\",\"frame\":\"ཀུན་བྱེད་ལས།\",\"head\":\"སེམས་ཀྱིས་སེམས་ལ་བལྟ་རྒྱུ་མེད་པའི་ཕྱིར། །\",\"tail\":\"བལྟས་པས་མ་མཐོང་ཇི་བཞིན་ཉིད་དུ་ཞོག །\"},{\"label\":\"QUOTE\",\"frame\":\"གསང་སྙིང་ལས།\",\"head\":\"གཞི་རྩ་མེད་པའི་སེམས་ཉིད་ནི། །\",\"tail\":\"གནས་སུ་མ་ཡིན་གང་ཡང་མིན། །\"},{\"label\":\"QUOTE\",\"frame\":\"བདེ་བ་རབ་འབྱམས་ལས།\",\"head\":\"རྩ་བ་མེད་པའི་སེམས་ཉིད་ནི། །\",\"tail\":\"བརྗོད་བྲལ་རང་བྱུང་ཡེ་ཤེས་སོ། །\"},{\"label\":\"QUOTE\",\"frame\":\"སློབ་དཔོན་ཆེན་པོ་དགའ་རབ་རྡོ་རྗེས།\",\"head\":\"སེམས་ཀྱི་རང་བཞིན་ཡེ་ནས་བུདྡྷ་སྟེ། །\",\"tail\":\"སེམས་ལ་སྐྱེ་འགག་མ