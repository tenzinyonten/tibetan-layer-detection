  "raw_text": "{\"spans\": [{\"label\": \"QUOTE\", \"frame\": \"རྒྱུད་བླ་ལས། །\", \"head\": \"གང་ཞིག་དོན་ལྡན་ཆོས་དང་ཉེར་འབྲེལ་\", \"tail\": \"དྲང་སྲོང་བཀའ་ཡིན་བཟློག་པ་གཞན། །\"}, {\"label\": \"QUOTE\", \"frame\": \"དེ་ཉིད་ལས། །\", \"head\": \"གང་ཞིག་རྒྱལ་བའི་བསྟན་པ་འབའ་ཞིག་\", \"tail\": \"དྲང་སྲོང་བཀའ་བཞིན་སྤྱི་བོས་བླངས། །\"}, {\"label\": \"QUOTE\", \"frame\": \"མདོ་ལས་\", \"head\": \"ལྔ་བརྒྱ་ཐ་མར་གྱུར་པ་ན། །ང་ནི་ཡི་གེའི་གཟུགས་སུ་གནས་\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"དམ་ཆོས་པདྨ་དཀར་པོ་ལས། །\", \"head\": \"སྐུ་གཟུགས་རྣམ་པ་མང་པོ་དེར་སྤྲུལ་ནས། །འགྲོ་བ་དགེ་ལ་སྤྱོད་པའི་དོན་བྱེད་དོ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཀླུ་སྒྲུབ་ཞབས་ཀྱིས་ཀྱང༌། །\", \"head\": \"ཁྱོད་ཀྱི་ཐུགས་དུལ་མཛོད་ཅིག་བཅོམ་ལྡན་གྱིས། །སེམས་ནི་ཆོས་ཀྱི་རྩ་བ་ལེགས་པར་གསུངས། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཟླ་བས་\", \"head\": \"དགག་སྒྲུབ་གཉིས་ཀ་དགག་འབའ་ཞིག །དོན་ལ་དགག་སྒྲུབ་གང་ཡང་མེད་\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"མི་ལས་\", \"head\": \"དོན་དམ་བདེན་པའི་དབང་དུ་ན། །གེགས་པས་སངས་རྒྱས་ཉིད་ཀྱང་མེད་\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཆོས་རྗེས་\", \"head\": \"བླ་མ་རང་སེམས་དབྱེར་མ་ཕྱེད། །གཟུགས་སྐུར་འཛིན་པ་སྟོར་ནས་ཐལ་\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"མདའ་བསྣུན་ཆེན་པོའི་ཞབས་ཀྱིས་ཀྱང༌། །\", \"head\": \"ཁྱིམ་ནང་ཡོད་པ་ཕྱི་རོལ་སོང་ནས་འཚོལ། །ཁྱིམ་བདག་མཐོང་ནས་ཁྱིམ་མཚེས་དག་ལ་དྲིས། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"སྐྱེ་རབས་ལས་གསུངས་ཤིང༌། །\", \"head\": \"དམ་པའི་ཆོས་ཏེ་ཡོན་ནི་གང་གིས་ཀྱང༌། །གཞལ་ནུས་མེད་\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"སྡོང་པོ་བཀོད་པ་ལས།\", \"head\": \"རྣམ་པ་ཐམས་ཅད་མཁྱེན་པའི་གོ་འཕང་ནི་དགེ་བའི་བཤེས་གཉེན་གྱི་གདམས་པ་ལ་རག་ལས་སོ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཡུམ་བར་པ་ལས།\", \"head\": \"རྣམ་པ་ཐམས་ཅད་མཁྱེན་པའི་གོ་འཕང་\", \"tail\": \"དད་པར་བྱ། བསྙེན་བཀུར་བར་བྱའོ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"མེ་ཏོག་ཕྲེང་རྒྱུད་ལས།\", \"head\": \"ཚུལ་ཁྲིམས་དག་ཅིང་འདུལ་བའི་ཆོ་ག་\", \"tail\": \"དུས་སུ་འདོམས་པ་གང་ཡིན་བླ་མར་བསྔགས། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ལམ་སྒྲོན་ལས།\", \"head\": \"སྡོམ་པའི་ཆོ་ག་ལ་མཁས་དང༌། །\", \"tail\": \"བླ་མ་བཟང་པོ་ཤེས་པར་བྱ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"སྤྱོད་འཇུག་ལས།\", \"head\": \"རྟག་པར་དགེ་བའི་བཤེས་གཉེན་ནི། །\", \"tail\": \"སྲོག་གི་ཕྱིར་ཡང་མི་གཏོང་ངོ༌། །\"}, {\"label\": \"QUOTE\", \"frame\": \"མདོ་སྡེ་རྒྱན་ལས།\", \"head\": \"བཤེས་གཉེན་དུལ་བ་ཞི་བ་ཉེར་ཞི་བ། །\", \"tail\": \"བརྩེ་བའི་བདག་ཉིད་སྐྱོ་ངལ་སྤང་ལ་བསྟེན། །\"}, {\"label\": \"QUOTE\", \"frame\": \"བརྟག་གཉིས་ལས།\", \"head\": \"རང་འདོད་ལྷ་མཉམ་རྣལ་འབྱོར་པ། །རབ་མཐོང་སྔགས་ཀྱི་ཕ་རོལ་སོན། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"བླ་མ་ལྔ་བཅུ་པ་ལས།\", \"head\": \"བརྟན་ཞིང་དུལ་བ་བློ་གྲོས་ལྡན། །\", \"tail\": \"སྙིང་བརྩེ་ལྡན་ཞིང་བསྟན་བཅོས་མཁས། །\"}, {\"label\": \"QUOTE\", \"frame\": \"དྭགས་པོ་རིན་པོ་ཆེའི་ཞལ་སྔ་ནས།\", \"head\": \"རྟོགས་པ་ཐུགས་རྗེ་ལྡན་པའི་བླ་མ་བསྟེན། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"བླ་མ་ལྔ་བཅུ་པ་ལས།\", \"head\": \"བླ་མ་དང་ནི་སློབ་མ་དག །\", \"tail\": \"སློབ་མའི་འབྲེལ་པ་བརྟག་པར་བྱ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"དོན་དམ་བསྙེན་པ་ལས།\", \"head\": \"དེ་ཕྱིར་སློབ་མས་འདོད་པའི་བླ་མ་\", \"tail\": \"ལེགས་པར་བརྟགས་ན་སྡིག་པ་ཅུང་ཟད་ཡོད་མ་ཡིན། །\"}, {\"label\": \"QUOTE\", \"frame\": \"མདོ་ལས།\", \"head\": \"བསྲེགས་བཅད་བརྡར་བའི་གསེར་བཞིན་དུ། །ལེགས་པར་བརྟགས་ལ་ང་ཡི་བཀའ། །བླང་བར་བྱ་ཡིས་གུས་ཕྱིར་མིན། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཡང་མདོ་ལས།\", \"head\": \"དེ་ལྟའི་ཡོན་ཏན་མ་ལུས་ལྡན་པ་དག །\", \"tail\": \"དེ་ལྟ་བུ་ནི་བསྔགས་པའི་གྲོགས་སུ་བརྟག །\"}, {\"label\": \"QUOTE\", \"frame\": \"དོན་དམ་བསྙེན་པ་ལས།\", \"head\": \"རྩོད་དུས་དབང་གིས་བླ་མ་སྐྱོན་ཡོན་འདྲེས། །\", \"tail\": \"བུ་རྣམས་ཀྱིས་ནི་དེ་ལ་བསྟེན་པར་བྱ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཡོན་ཏན་མཛོད་ལས།\", \"head\": \"དེ་ཕྱིར་དམ་པ་ལེགས་པར་མ་བརྟགས་ན་\", \"tail\": \"ཤིང་གི་གྲིབ་མ་ནོར་བཞིན་བསླུ་བར་འགྱུར། །\"}, {\"label\": \"QUOTE\", \"frame\": \"བླ་མ་ལྔ་བཅུ་པ་ལས།\", \"head\": \"བློ་ལྡན་སློབ་མས་བླ་མ་ནི། །\", \"tail\": \"སྤྱོམས་དང་བཅས་ལ་མི་བསྟེན་ནོ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"སྡུད་པ་ལས།\", \"head\": \"སློབ་མ་བཟང་པོ་བླ་མར་གུས་ལྡན་དེ་\", \"tail\": \"ཡོན་ཏན་ཀུན་གྱི་མཆོག་མངའ་རྒྱལ་བས་དེ་སྐད་གསུངས། །\"}, {\"label\": \"QUOTE\", \"frame\": \"བཤེས་སྤྲིང་ལས།\", \"head\": \"དགེ་བའི་བཤེས་གཉེན་བསྟེན་པར་ཚངས་\", \"tail\": \"བརྟེན་ནས་རབ་ཏུ་མང་པོས་ཞི་བ་ཐོབ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"དོན་དམ་བསྙེན་པ་ལས།\", \"head\": \"འདོད་པའི་དངོས་གྲུབ་སློབ་དཔོན་\", \"tail\": \"མ་ལུས་རྡོ་རྗེ་ཐེག་པར་ཐམས་ཅད་མཁྱེན་པས་གསུངས། །\"}, {\"label\": \"QUOTE\", \"frame\": \"སྐྱེས་རབས་ལས།\", \"head\": \"དམ་པ་རྣམས་ནི་སུས་ཀྱང་མི་བསྲིང་སྟེ། །\", \"tail\": \"ཆེད་དུ་མ་བསྒོས་པ་ཡང་གོས་པར་འགྱུར། །\"}, {\"label\": \"QUOTE\", \"frame\": \"སྡུད་པ་ལས།\", \"head\": \"ནད་པའི་ཚོགས་ཀྱིས་ནད་རྣམས་གསོ་\", \"tail\": \"གཡོ་བ་མེད་པའི་སེམས་ཀྱིས་དགེ་བའི་བཤེས་གཉེན་བསྟེན་པར་བྱ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཡོན་ཏན་མཛོད་ལས།\", \"head\": \"ཇི་ལྟར་མ་ལ་ཡ་ཡི་ནགས་ཀླུང་དུ། །\", \"tail\": \"གང་ལ་བརྟེན་པ་དེ་ཡི་རྗེས་སུ་འགྲོ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཡེ་ཤེས་གྲུབ་པ་ལས།\", \"head\": \"སྐྱ་བ་འཛིན་པ་མེད་པ་ནི། །\", \"tail\": \"བླ་མ་མེད་ན་སྲིད་ཐར་མིན། །\"}, {\"label\": \"QUOTE\", \"frame\": \"མདོ་སྡེ་རྒྱན་ལས།\", \"head\": \"བཀུར་སྟི་རྙེད་པ་དག་དང་རིམ་འགྲོ་\", \"tail\": \"སྒྲུབ་པའི་སྒོ་ནས་བཤེས་གཉེན་བསྟེན་པར་བྱ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"བླ་མ་ལྔ་བཅུ་པ་ལས།\", \"head\": \"འདིར་མང་སྨོས་པས་ཅི་ཞིག་བྱ། །\", \"tail\": \"བླ་མ་ཡོངས་སུ་མཉེས་པར་བྱ། །\"}, {\"label\": \"QUOTE\", \"head\": \"དངོས་གྲུབ་སློབ་དཔོན་རྗེས་འབྲངས་ཞེས། །རྡོ་རྗེ་འཛིན་པ་ཉིད་ཀྱིས་གསུངས། །ཤེས་ནས་དངོས་པོ་ཐམས་ཅད་ཀྱིས། །བླ་མ་ཡོངས་སུ་མཉེས་པར་བྱ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཞི་བ་ལྷས།\", \"head\": \"དཔལ་འབྱུང་བ་ཡི་རྣམ་ཐརལས། །བླ་མ་བསྟེན་པའི་ཚུལ་ལྟར་བསླབ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"head\": \"བསླབ་པ་གང་ལ་དད་པ་ཡི། །གཞུང་ཉིད་བླ་མ་དག་ལས་ཉོན། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"རྒྱུད་ལས།\", \"head\": \"བླ་མའི་ཡོན་ཏན་ཐམས་ཅད་བཟུང༌། །\", \"tail\": \"སྐྱོན་གྱིས་དངོས་གྲུབ་ཉམས་པར་བྱེད། །\"}, {\"label\": \"QUOTE\", \"frame\": \"སྡོམ་འབྱུང་ལས།\", \"head\": \"མཆོད་པ་ཐམས་ཅད་ཡོངས་སྤངས་ཏེ། །\", \"tail\": \"ཡེ་ཤེས་མཆོག་ནི་ཐོབ་པར་འགྱུར། །\"}, {\"label\": \"QUOTE\", \"frame\": \"གལ་པོ་ལས།\", \"head\": \"གང་ཕྱིར་རྡོ་རྗེ་སེམས་དཔའ་ཉིད། །\", \"tail\": \"ཐ་མལ་པ་ཡི་གཟུགས་སུ་གནས། །\"}, {\"label\": \"QUOTE\", \"frame\": \"རྒྱུད་ལས།\", \"head\": \"བསྐལ་པ་བྱེ་བ་རྒྱལ་རྣམས་ལ། །\", \"tail\": \"ཐིགས་པས་མཆོད་པ་བསོད་ནམས་མཆོག །\"}, {\"label\": \"QUOTE\", \"head\": \"བླ་མེད་མཛད་པའི་སློབ་དཔོན་ནི། །\", \"tail\": \"དཀའ་ཐུབ་མ་བསྟེན་ཅི་ཞིག་ཡོད། །\"}, {\"label\": \"QUOTE\", \"frame\": \"རྒྱུད་ལས།\", \"head\": \"ཚིགས་བཅད་གཅིག་ཙམ་བསྟན་པ་ལའང༌། །\", \"tail\": \"རྨེ་ཤ་ཅན་དུ་སྐྱེ་བར་འགྱུར། །\"}, {\"label\": \"QUOTE\", \"head\": \"ནམ་ཡང་སློབ་དཔོན་དག་གི་ནི། །\", \"tail\": \"དམྱལ་བར་ངེས་པར་འཚེད་པར་འགྱུར། །\"}, {\"label\": \"QUOTE\", \"head\": \"བླ་མའི་གཟིམས་ཆ་སྟན་དང་ལྷམ། །\", \"tail\": \"མཆོད་རྟེན་ཤིག་དང་འདྲ་བར་གསུངས། །\"}, {\"label\": \"QUOTE\", \"head\": \"མནར་མེད་ལ་སོགས་འཇིགས་རུང་བའི། །\", \"tail\": \"དེར་ནི་གནས་པ་ཡང་དག་བཤད། །\"}, {\"label\": \"QUOTE\", \"head\": \"གང་གིས་བླ་མ་ལ་སྨོད་ན། །\", \"tail\": \"བསད་ནས་སེམས་ཅན་དམྱལ་བར་འཁྲིད། །\"}, {\"label\": \"QUOTE\", \"frame\": \"དགོངས་འདུས་ལས།\", \"head\": \"བསྐལ་པ་སྟོང་གི་སངས་རྒྱས་ལས། །\", \"tail\": \"བླ་མ་དག་ལ་བརྟེན་ནས་འབྱུང༌། །\"}, {\"label\": \"QUOTE\", \"frame\": \"རྒྱ་ཆེར་རོལ་པ་ལས།\", \"head\": \"སྲིད་པའི་གནས་བཅས་དད་པ་ཆུང་བ་ཡིས། །སངས་རྒྱས་ཡོན་ཏན་ཤེས་པར་མི་ནུས་སོ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཆོས་བཅུ་པའི་མདོ་ལས།\", \"head\": \"དད་པ་མེད་པའི་མི་རྣམས་ལ། །\", \"tail\": \"མྱུ་གུ་སྔོན་པོ་ཇི་བཞིན་ནོ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"དཀོན་མཆོག་སྒྲོན་མེའི་མདོ་ལས།\", \"head\": \"དད་པ་སྔོན་འགྲོ་མ་ལྟར་བསྐྱེད་པ་སྟེ། །\", \"tail\": \"ལག་པ་བཞིན་དུ་དགེ་རྩ་ཐམས་ཅད་སྡུད། །\"}, {\"label\": \"QUOTE\", \"frame\": \"རྒྱུད་བླ་མ་ལས། །\", \"head\": \"རང་བྱུང་རྣམས་ཀྱི་ཡེ་ཤེས་ནི། །དད་པ་ཉིད་ཀྱིས་རྟོགས་བྱ་ཡིན། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"མདོ་ལས།\", \"head\": \"དོན་དམ་པ་ནི་དད་པས་རྟོགས་པར་བྱ་བ་ཁོ་ནའོ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"རྒྱུད་ལས།\", \"head\": \"བླ་མ་ཉིད་ལས་མ་བྱུང་བའི། །\", \"tail\": \"བླ་མ་མཚན་ཉིད་ལྡན་པས་བསྒྱུར། །\"}, {\"label\": \"QUOTE\", \"head\": \"བླ་མ་ལ་གུས་ཡོད་གྱུར་ན། །\", \"tail\": \"བསྒྲུབས་ཀྱང་འགྲུབ་པར་མི་འགྱུར་རོ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཡང་རྒྱུད་ལས།\", \"head\": \"བློ་དང་ལྡན་པ་སུ་ཞིག་གིས། །\", \"tail\": \"ཕྱི་མ་འཁོར་ལོ་བསྒྱུར་རྒྱལ་ཐོབ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"དགོངས་འདུས་ལས།\", \"head\": \"ཆོས་ཀུན་མི་ཤེས་མ་རྟོགས་ཀྱང༌། །\", \"tail\": \"འཁོར་བའི་རྒྱ་མཚོ་བརྒལ་བར་འགྱུར། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཡང་རྒྱུད་ལས།\", \"head\": \"ཆོས་རྣམས་ཀུན་གྱི་རྩ་བ་ནི། །\", \"tail\": \"བླ་མ་བསྟེན་པ་ཉིད་ལས་བྱུང༌། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཡེ་ཤེས་དྲི་མེད་ལས།\", \"head\": \"མཛོད་ལྡན་བླ་མའི་ཕྱོགས་དག་ཏུ། །\", \"tail\": \"བྱས་ན་འབྲས་བུ་མེད་པར་གྱུར། །\"}, {\"label\": \"QUOTE\", \"frame\": \"སྐྱོབས་པ་རིན་པོ་ཆེའི་ཞལ་སྔ་ནས།\", \"head\": \"བླ་མའི་སྐུ་བཞི་གངས་རི་ལ། །\", \"tail\": \"སེམས་མོས་གུས་འདི་ལ་ནན་ཏན་མཛོད། །\"}, {\"label\": \"QUOTE\", \"head\": \"རྗེ་ལ་གསོལ་བ་མི་འདེབས་པར། །\", \"tail\": \"མོས་གུས་བྱ་བ་གནད་དུ་ཆེ།\"}]}",
