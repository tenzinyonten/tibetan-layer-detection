UOTE\", \"frame\": \"མཻ་ཏྲི་པས།\", \"head\": \"བླ་མ་རྗེ་བཙུན་མ་བསྟེན་ན། །\", \"tail\": \"དངོས་གྲུབ་རྣམ་གཉིས་ཐོབ་མི་སྲིད། །\"}, {\"label\": \"QUOTE\", \"head\": \"སྤྱི་བོའི་གཙུག་གམ་ལག་པའི་མཐིལ། །\", \"tail\": \"དེ་ཡིས་འཛིན་པར་འགྱུར། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཡེ་ཤེས་མཁའ་འགྲོ་མས།\", \"head\": \"མཆོག་དང་ཐུན་མོང་དངོས་གྲུབ་ཀུན། །\", \"tail\": \"རྣལ་དུ་ཕོབ་ལ་གསོལ་བ་ཐོབ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"པཎ་ཆེན་ནཱ་རོ་པས།\", \"head\": \"ཅི་དགུ་ཐམས་ཅད་བླ་མ་ལ། །\", \"tail\": \"བཏབ་ལས་འབྱུང་བར་འགྱུར། །\"}, {\"label\": \"QUOTE\", \"frame\": \"མཻཏྲི་པས།\", \"head\": \"བླ་མའི་བྱིན་རླབས་འཕོས་ཏེ་འཚང་རྒྱ་བ། །\", \"tail\": \"སངས་རྒྱས་སྤར་ནས་བཏོན་པ་འདྲ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཨ་ལི་ཀཱ་ལི་རྒྱུད་ལས།\", \"head\": \"བརྗོད་བྲལ་ལྷན་ཅིག་སྐྱེས་པའི་\", \"tail\": \"རྨོངས་པར་ཤེས་པར་བྱ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ས་ར་ཧ་པས།\", \"head\": \"བླ་མས་སྨྲས་པ་གང་གི་སྙིང་ཞུགས་པ། །\", \"tail\": \"གནས་པའི་གཏེར་མཐོང་འདྲ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"བརྟག་གཉིས་ལས།\", \"head\": \"གཞན་གྱིས་བརྗོད་མིན་ལྷན་ཅིག་\", \"tail\": \"བསོད་ནམས་ལས་ཤེས་བྱ། །\"}, {\"label\": \"QUOTE\", \"head\": \"རང་གི་རིག་པའི་ཡེ་ཤེས་ནི། །\", \"tail\": \"ཡེ་ཤེས་དེ་ལྟ་བུ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཆོས་རྗེ་གཙང་པས།\", \"head\": \"རྗེ་བླ་མའི་ངོ་བོ་ཆོས་ཀྱི་སྐུ། །\", \"tail\": \"ཉེ་རིང་བགྲང་མ་དགོས། །\"}, {\"label\": \"QUOTE\", \"head\": \"བླ་མ་རང་སེམས་དབྱེར་མ་མཆིས། །\", \"tail\": \"བྱ་བའི་ཡུལ་མ་རྙེད། །\"}, {\"label\": \"QUOTE\", \"frame\": \"རྒྱལ་དབང་རྗེས།\", \"head\": \"བླ་མ་རང་སེམས་འདྲེས་ཙ་ན། །\", \"tail\": \"འདེབས་པའི་ཡུལ་མ་རྙེད། །\"}, {\"label\": \"QUOTE\", \"head\": \"ད་ནི་མགོན་པོ་རང་གི་སེམས། །\", \"tail\": \"དངོས་གྲུབ་དེ་ཀ་ལགས། །\"}, {\"label\": \"QUOTE\", \"frame\": \"རྗེ་མི་ལས།\", \"head\": \"བླ་མར་ངེས་སོ་རང་གི་སེམས་ལ་\", \"tail\": \"མི་འགྱུར་ལྷ་རྗེ་སྟོན་པ་བ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"དཔལ་ས་ར་ཧ་པས།\", \"head\": \"བླ་མའི་ལུང་ལ་འགྲིམས་ཏེ་\", \"tail\": \"བྱུང་བ་ཐེ་ཚོམ་མེད། །\"}, {\"label\": \"QUOTE\", \"frame\": \"རིམ་ལྔ་ལས།\", \"head\": \"རི་དབང་རྩེ་ནས་འགའ་ཞིག་\", \"tail\": \"སྙམ་ཡང་གྲོལ་བར་གྱུར། །\"}, {\"label\": \"QUOTE\", \"frame\": \"སློབ་དཔོན་ཤཱཀྱ་འོད་ཀྱི་ཞལ་སྔ་ནས།\", \"head\": \"བླ་མ་ལ་གུས་ཚུལ་ཁྲིམས་ཡོངས་\", \"tail\": \"ཆོས་ལྡན་སློབ་མར་གསུངས། །\"}, {\"label\": \"QUOTE\", \"frame\": \"མཁན་པོས།\", \"head\": \"སློབ་དཔོན་དེ་ཉིད་དུ་འཛིན་ཅིང༌། །\", \"tail\": \"ཅིག་ཤོས་དེ་ལས་ལྡོག་པ་འོ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཡོན་ཏན་མཛོད་ལས།\", \"head\": \"གོ་ཆ་ཆེ་ལས་བློ་གྲོས་ཤིན་ཏུ་\", \"tail\": \"མོས་གུས་ཁོ་ནས་གྲོལ། །\"}, {\"label\": \"QUOTE\", \"head\": \"བླ་མ་ཤིན་ཏུ་སྲུང་བས་མཛངས་པ་དང༌། །\", \"tail\": \"སྡེ་སྣོད་དག་ལས་གསུངས། །\"}, {\"label\": \"QUOTE\", \"head\": \"བླ་མ་བཞེངས་ཚེ་སྟན་ལ་འདུག་པ་མིན། །\", \"tail\": \"ཞི་བས་བསྟེན། །\"}, {\"label\": \"QUOTE\", \"head\": \"རྫིང་བུ་མཆོག་ལ་བསྟེན་པའི་ངང་པ་དང༌། །\", \"tail\": \"ལེན་པའི་ཡོན་ཏན་མྱང༌། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཡིད་བཞིན་མཛོད་ལས།\", \"head\": \"དེ་ཡང་ཉོན་མོངས་ཤས་ཆེ་རང་\", \"tail\": \"དགེ་ཚོགས་རིང་དུ་བྱེད། །\"}, {\"label\": \"QUOTE\", \"head\": \"སྒོ་གསུམ་མ་དུལ་ཁེངས་དང་བཅོས་མའི་ཚུལ། །\", \"tail\": \"དགེ་ལེགས་འགྲིབ་པ་སྟེ། །\"}, {\"label\": \"QUOTE\", \"head\": \"རང་རྒྱུད་ངན་ཞིང་དག་སྣང་ཆུང་བ་དང༌། །\", \"tail\": \"བཤེས་ལ་བསྐུར་བ་འདེབས། །\"}, {\"label\": \"QUOTE\", \"head\": \"གཏི་མུག་ཅན་བསྟེན་ཐོས་བསམ་\", \"tail\": \"ཕྱོགས་རེས་གཉིས་འཛིན་འགོ །\"}, {\"label\": \"QUOTE\", \"head\": \"དེ་དག་དང་འགྲོགས་ཐར་ལམ་\", \"tail\": \"གྲོགས་པོ་སྤང་བར་བྱ། །\"}, {\"label\": \"QUOTE\", \"head\": \"ཇི་ལྟར་ལམ་འཕྲང་བགྲོད་པའི་\", \"tail\": \"འཕྲོག་པ་ཡོངས་མི་ནུས། །\"}, {\"label\": \"QUOTE\", \"head\": \"མདོར་ན་སྡིག་པའི་གྲོགས་པོ་\", \"tail\": \"ཡོན་ཏན་ཚོགས་རབ་འགྲུབ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"དམ་ཆོས་པདྨ་དཀར་པོ་ལས།\", \"head\": \"གཙང་ཞིང་ཡིད་དུ་འོང་བའི་\", \"tail\": \"བྱམས་པའི་སེམས་ཀྱིས་ལེ་ལོ་མེད་པར་སྟོན། །\"}, {\"label\": \"QUOTE\", \"head\": \"ཉན་པོ་རྣམ་གཡེངས་འདུ་འཛི་\", \"tail\": \"ཚུལ་གྱིས་མཉན་པར་བྱ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"སྡུད་པ་ལས།\", \"head\": \"དགའ་དང་གུས་དང་དད་པའི་མཆོག་\", \"tail\": \"དེ་ནི་ཉན་པར་གྱིས། །\"}, {\"label\": \"QUOTE\", \"frame\": \"རྩེ་མོའི་རྒྱུད་ལས།\", \"head\": \"རྟོག་པ་ཐམས་ཅད་ལེགས་པར་\", \"tail\": \"རྣམས་ཀྱིས་བྱིན་མི་རློབས། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ས་ཡི་སྙིང་པོའི་མདོ་ལས།\", \"head\": \"གཅིག་ཏུ་དད་ཅིང་གུས་པས་\", \"tail\": \"འདྲ་བ་དེ་ལ་འདུ་ཤེས་བསྐྱེད། །\"}, {\"label\": \"QUOTE\", \"frame\": \"སྐྱེ་རབས་ལས།\", \"head\": \"རབ་ཏུ་དམའ་བའི་སྟན་ལ་འདུག །\", \"tail\": \"རིམ་གྲོ་བསྐྱེད་དེ་ཆོས་ཉོན་ཅིག །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཡུམ་བར་མ་ལས།\", \"head\": \"ལེགས་པར་རབ་ཏུ་ཉོན་ལ་ཡིད་\", \"tail\": \"ངས་ཁྱོད་ལ་བཤད་པར་བྱའོ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"མན་ངག་རིན་པོ་ཆེའི་མཛོད་ལས།\", \"head\": \"རྣ་བ་མི་གཏོད་ཁ་སྦུབ་ལྟ་\", \"tail\": \"འདྲེས་དུག་ཅན་ལྟ་བུའི་སྐྱོན། །\"}, {\"label\": \"QUOTE\", \"frame\": \"རྣམ་བཤད་རིག་པ་ལས།\", \"head\": \"ང་རྒྱལ་དང་ནི་མ་དད་དང༌། །\", \"tail\": \"སྐྱོ་བས་ཉན་པ་དྲི་མ་ཡིན། །\"}, {\"label\": \"QUOTE\", \"frame\": \"སྡོང་པོ་བཀོད་པ་ལས།\", \"head\": \"རིགས་ཀྱི་བུ་ཁྱོད་ཀྱིས་བདག་\", \"tail\": \"འཚོ་བའི་འདུ་ཤེས་བསྐྱེད་པར་བྱའོ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཡོན་ཏན་མཛོད་ལས།\", \"head\": \"མི་གཞི་ངན་པའི་ཟོལ་སྦྱོར་\", \"tail\": \"སྤྲོ་བའི་དམ་ཚིག་འཕེན། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཆོས་སྤྱོད་ཀྱི་མན་ངག་ལས།\", \"head\": \"མེ་ཏོག་སྟན་སོགས་རབ་འབུལ་\", \"tail\": \"ཡན་ལག་དྲུག་དང་ལྡན། །\"}, {\"label\": \"QUOTE\", \"frame\": \"འདུལ་བ་ལུང་ལས།\", \"head\": \"མ་གུས་པ་ལ་ཆོས་མི་བཤད། །\", \"tail\": \"གཡོགས་པ་དག་ལ་མིན། །\"}, {\"label\": \"QUOTE\", \"head\": \"འགྲེང་ཉལ་དམའ་བར་འདུག་དང་\", \"tail\": \"གྱོན་པ་རྣམས་ལ་བཤད། །\"}, {\"label\": \"QUOTE\", \"frame\": \"མདོ་ལས།\", \"head\": \"ཇི་ལྟར་ཁྱིམ་ནི་ལེགས་གཡོགས་\", \"tail\": \"མ་ཐོས་བར་དུ་ཤེས་མི་འགྱུར། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཆེད་དུ་བརྗོད་པའི་ཚོམས་ལས།\", \"head\": \"ཐོས་པས་ཆོས་རྣམས་ཤེས་པར་\", \"tail\": \"ཐོས་པས་མྱ་ངན་འདས་པ་ཐོབ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"སྐྱེས་རབས་ལས།\", \"head\": \"ཐོས་པ་མ་རིག་མུན་སེལ་སྒྲོན་\", \"tail\": \"མཁས་རྣམས་མགུ་བར་འགྱུར། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཆོས་ཀྱི་དབང་པོའི་ཞལ་སྔ་ནས།\", \"head\": \"ཐར་པ་མཐུན་པའི་ཚོགས་