ail\": \"དབྱེ་བར་ནུས་པ་མ་ཡིན་ནོ། །\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"འཇམ་དཔལ་སྒྱུ་འཕྲུལ་དྲྭ་བའི་བཤད་རྒྱུད་ལས།\",\n      \"head\": \"ལུང་མ་གཏོགས་པར་རྟོག་གེ་ཡི\",\n      \"tail\": \"རྣམ་པར་ལྟུང་བ་དཀའ་མ་ཡིན། །\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"སློབ་དཔོན་འཕགས་པ་ལྷའི་མན་ངག་ལས།\",\n      \"head\": \"མ་འོངས་ཕྱི་མའི་དུས་སུ་ནི།\",\n      \"tail\": \"དེ་ནི་རང་ཉིད་གཞན་བརླག་འགྱུར\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"མགོན་པོ་བྱམས་པའི་རྒྱུད་བླ་མ་ལས།\",\n      \"head\": \"གང་ཕྱིར་རྒྱལ་ལས་ཆེས་མཁས་\",\n      \"tail\": \"གནོད་པ་བྱེད་པར་འགྱུར། །\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"འདུལ་བ་ལུང་ལས།\",\n      \"head\": \"བཅོམ་ལྡན་འདས་ཀྱིས་བཀའ་སྩལ་\",\n      \"tail\": \"སྐབས་སུ་གཏམ་རྒྱུད་དུ་བྱ་བ་དང་\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"གསེར་འོད་དམ་པའི་མདོ་ལས།\",\n      \"head\": \"རྫོགས་པའི་བྱང་ཆུབ་ཏུ་འཚང་\",\n      \"tail\": \"དགེ་བའི་རྩ་བ་དཔག་ཏུ་མེད་པ་\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"རྗེ་མི་ལས།\",\n      \"head\": \"ཡིད་མི་ཆེས་ན་རྒྱལ་བའི་བཀའ་\",\n      \"tail\": \"བཀའ་དྲི་མེད་ཚིག་གིས་ངེས་ཤེས་\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"ཚངས་པས་ཞུས་པའི་མདོ་ལས།\",\n      \"head\": \"བཅོམ་ལྡན་འདས་ཀྱིས་བཀའ་སྩལ་\",\n      \"tail\": \"མཐུན་པར་གཅོད་པར་གྱིས་ཤིག །\"\n    }\n  ]\n}",
