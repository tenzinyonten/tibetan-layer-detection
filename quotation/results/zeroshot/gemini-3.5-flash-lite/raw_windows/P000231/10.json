  "raw_text": "{\"spans\": [{\"label\": \"QUOTE\", \"head\": \"བླ་མའི་ཐུགས་ནི་ནམ་མཁའ་འདྲ། །བདེ་གསལ་མི་རྟོག་སྟོང་པའི་ངང་། །\", \"tail\": \"གསུངས་པ་དང་།\"}, {\"label\": \"QUOTE\", \"head\": \"དགོངས་པ་ཟབ་མོ་ནམ་མཁའི་མཐའ་དང་མཉམ། །ཅིར་ཡང་ས་ལེའི་ཐུགས་ལ་གསོལ་བ་འདེབས། །\", \"tail\": \"གསུངས་པའི་དོན་ལྟར།\"}, {\"label\": \"QUOTE\", \"head\": \"བླ་མའི་ཐུགས་ནི་ནམ་མཁའ་འདྲ། །བདེ་གསལ་མི་རྟོག་སྟོང་པའི་ངང་། །རྣམ་ཐར་གསུམ་ལ་ལེགས་གནས་པའི། །བླ་མའི་ཐུགས་ལ་གསོལ་བ་འདེབས། །ཐུགས་དགོངས་ནམ་མཁའི་མཐའ་དང་མཉམ། །འཁོར་འདས་ཀུན་ལ་ཁྱབ་ཅིང་བརྡལ། །དུས་གསུམ་བསྒྲིབ་མེད་ས་ལེར་མཁྱེན། །རྒྱལ་ཀུན་ཐུགས་ལ་གསོལ་བ་འདེབས། །སེམས་ཉིད་དག་པ་ཆོས་དབྱིངས་ཀྱི། །ཞིང་ཁམས་མཐའ་ཡས་མུ་མེད་ན། །བཞུགས་པའི་བླ་མ་རྒྱལ་ཀུན་དང་། །ཐུགས་ཡིད་འདྲེས་པར་བྱིན་གྱིས་རློབས། །མདོ་རྒྱུད་བསྟན་བཅོས་འོ་མའི་མཚོ། །བླ་མས་རྣམ་དཔྱོད་ཕྱག་གིས་བསྲུབས། །མན་ངག་མར་གྱི་ཉིང་ཁུ་བྱུང་། །བདག་ལ་བསྩལ་པ་བཀའ་དྲིན་ཆེ། །མཆོག་ཐུན་དངོས་གྲུབ་ཀུན་འབྱུང་བའི། །སེམས་ཉིད་ནོར་བུའི་གཏེར་མཛོད་སྒོ། །བླ་མའི་མན་ངག་ལྡེ་མིག་གིས། །ཕྱེས་པས་བདག་གཞན་དོན་གཉིས་འགྲུབ། །རང་སེམས་ཆོས་དབྱིངས་ཞིང་ཁམས་ན། །འཁོར་འདས་ལྟད་མོ་སྣ་ཚོགས་སྣང་། །སེམས་ལས་ལྟད་མོ་ཆེ་བ་ཞིག །འཇིག་རྟེན་ཁམས་ན་ཡོད་མ་མྱོང་། །འཁོར་འདས་ཆོས་ཀུན་འབྱུང་བའི་གནས། །སེམས་ཀྱི་གནས་ལུགས་ནམ་མཁའ་འདྲ། །ཕྱོགས་རིས་མེད་པའི་མཁའ་ཀློང་དུ། །རྩོལ་སྒྲུབ་མེད་པར་ལྷོད་ཀྱིས་ཞོག །སྣང་བ་བཟང་ངན་ཅིར་སྣང་ཡང་། །ཕྱི་ན་ཡོད་པ་མ་ཡིན་ཏེ། །མེ་ལོང་ནང་གི་གཟུགས་བརྙན་བཞིན། །སེམས་ཉིད་སྟོང་པའི་རང་གཟུགས་ཡིན། །ཆོས་ཀུན་གཞི་མ་སེམས་ཉིད་ཀྱང་། །ནང་ན་ཡོད་པ་མ་ཡིན་ཏེ། །ཕྱི་ཡི་ནམ་མཁའ་ཡངས་པ་བཞིན། །འཁོར་འདས་ཀུན་ལ་ཁྱབ་ཅིང་བརྡལ། །ཆོས་ཉིད་ཁྱབ་བརྡལ་ཆེན་པོ་ལ། །འདི་ཞེས་ཚད་བཟུང་མ་མཆིས་པའི། །ངང་ལ་མཐའ་དབུས་མེད་པར་གློད། །གློད་ན་མཁའ་ལྟར་འགྱུར་མེད་གསལ། །ནམ་མཁའ་འདོམ་གྱིས་འཇལ་བ་བཞིན། །ཆོས་དབྱིངས་ཁྱབ་བརྡལ་ཆེན་པོ་ལ། །ཕྱོགས་རིས་གོ་ལེར་མ་གཅོད་ཅིག །བཅད་ན་མཐོ་དམན་གསལ་འགྲིབ་ཡོང་། །མདོར་ན་གང་ཤར་སེམས་ཀྱི་རྩལ། །སེམས་ཉིད་སྟོང་གསལ་ངང་ལ་ཞོག །ནམ་ཡང་སྡུག་བཙིར་མ་བྱེད་པར། །གུ་ཡངས་ཡན་པ་བློ་བདེ་གྱིས། །ཕྱོགས་རིས་མེད་པར་ཀུན་ལ་ཁྱབ། །རྒྱ་ཆད་མེད་པར་བརྡལ་བ་ཡི། །གནས་ལུགས་ཁྱབ་བརྡལ་སྟོང་གསལ་གྱི། །ངང་ལ་དེ་ལྟར་མཉམ་གཞག་ན། །གློ་བུར་ཉོན་མོངས་རྣམ་རྟོག་སངས། །ཆོས་ཀུན་ཚིག་དོན་སེམས་ལ་འཆར། །འཁོར་འདས་ལྟད་མོ་ཐམས་ཅད་མཐོང་། །བདག་གཞན་དོན་གཉིས་འགྲུབ་པར་འགྱུར། །དོན་དམ་བྱང་ཆུབ་སེམས་མཆོག་ལ། །བརྟེན་ནས་ཆོས་སྐུ་མངོན་དུ་བྱས། །ཆོས་སྐུའི་དབྱིངས་ལས་མ་གཡོས་བཞིན། །གཟུགས་སྐུས་འགྲོ་དོན་བྱེད་པར་ཤོག\", \"tail\": \"ཅེས་སྨྲས་ཚེ།\"}, {\"label\": \"QUOTE\", \"frame\": \"དབུ་མ་རིན་ཆེན་འཕྲེང་བ་ལས།\", \"head\": \"བདག་ལ་དེ་དག་སྡིག་སྨིན་ཞིང་། །བདག་དགེ་མ་ལུས་དེར་སྨིན་ཤོག\", \"tail\": \"དེར་སྨིན་ཤོག\"}, {\"label\": \"QUOTE\", \"frame\": \"པཎ་ཆེན་ཤཱཀྱ་ཤྲཱིས།\", \"head\": \"སྐྱིད་ན་བེ་བ་ཚོགས་སུ་བསྔོ། །ཕན་བདེས་ནམ་མཁ་གང་བར་ཤོག །སྡུག་ན་ཀུན་གྱི་སྡུག་བསྔལ་ཁུར། །སྡུག་བསྔལ་རྒྱ་མཚོ་སྐེམ་པར་ཤོག\", \"tail\": \"སྐེམ་པར་ཤོག\"}, {\"label\": \"QUOTE\", \"frame\": \"རྗེ་མི་ལས།\", \"head\": \"ནད་དང་གདོན་དང་སྡིག་སྒྲིབ་རྣམས། །རྣལ་འབྱོར་པ་ཡི་རྒྱན་དུ་མཛེས། །\", \"tail\": \"རྒྱན་དུ་མཛེས།\"}, {\"label\": \"QUOTE\", \"head\": \"རྒྱན་དུ་ཆེ་བའི་ན་ཚ་འདི། །སྤོ་ཐབས་ཡོད་དེ་སྤོ་དོན་མེད། །\", \"tail\": \"སྤོ་དོན་མེད།\"}, {\"label\": \"QUOTE\", \"head\": \"ཁྱོད་ཀྱི་སྡུག་བསྔལ་ཐམས་ཅད་ཀྱང་། །བདག་གིས་བླངས་ནས་སྦྱོང་བར་ཤོག\", \"tail\": \"སྦྱོང་བར་ཤོག\"}, {\"label\": \"QUOTE\", \"frame\": \"རྗེ་བཙུན་མི་ལ་རས་པའི་ཞལ་ནས།\", \"head\": \"རྣལ་འབྱོར་མི་ལ་རས་པ་ངས། །ཅེར་གྱིས་བལྟས་པས་ངོ་བོ་མཐོང་། །སྤྲོས་བྲལ་ནམ་མཁའ་ལྟ་བུར་མཐོང་། །\", \"tail\": \"ལྟ་བུར་མཐོང་།\"}, {\"label\": \"QUOTE\", \"frame\": \"རྗེ་མི་ལས།\", \"head\": \"བདག་གིས་ཕྱག་རྒྱ་ཆེན་པོ་བསྒོམ་ཙ་ན། །དོན་ཡིན་ལུགས་ཀྱི་སྟེང་དུ་རྩོལ་མེད་བཞག །\", \"tail\": \"རྩོལ་མེད་བཞག\"}, {\"label\": \"QUOTE\", \"head\": \"ནམ་མཁའ་ལྟར་དཔངས་བསྟོད་ལ་བཞག །ས་གཞི་ལྟར་རྒྱ་བསྐྱེད་ལ་བཞག །\", \"tail\": \"རྒྱ་བསྐྱེད་ལ་བཞག\"}, {\"label\": \"QUOTE\", \"head\": \"ཁྱུང་ཆེན་ནམ་མཁའ་ལ་ལྡིང་བ་བཞིན་དུ་མ་བཅོས་གཉུག་མའི་ངང་ལ་རྩོལ་སྒྲུབ་མེད་པར་བཞག །ཉི་མ་སྤྲིན་དང་བྲལ་བ་བཞིན་དུ་ཀུན་གསལ་མདངས་དང་ལྡན་པར་བཞག །\", \"tail\": \"ལྡན་པར་བཞག\"}, {\"label\": \"QUOTE\", \"frame\": \"རྗེ་མི་ལས།\", \"head\": \"ཉ་མ་དཔལ་དར་འབུམ་ལ། ཁྱོད་ནམ་མཁའ་འདི་ལ་དཔེ་ལོངས་ལ། །མཐའ་དབུས་མེད་པའི་བསྒོམ་ཞིག་གྱིས། །\", \"tail\": \"བསྒོམ་ཞིག་གྱིས།\"}, {\"label\": \"QUOTE\", \"frame\": \"ཀུན་མཁྱེན་པདྨ་དཀར་པོས།\", \"head\": \"དཔེ་ཁྱུང་ཆེན་མཁའ་ལ་ལྡིང་བ་བཞིན། །ཡིད་གཞུངས་ནས་སྒོམས་ཤིག་པདྨ་དཀར། །\", \"tail\": \"པདྨ་དཀར།\"}, {\"label\": \"QUOTE\", \"head\": \"སྨྲ་བསམ་བརྗོད་མེད་ཤེས་རབ་ཕ་རོལ་ཕྱིན། །མ་སྐྱེས་མི་འགག་ནམ་མཁའི་ངོ་བོ་ཉིད།\", \"tail\": \"ངོ་བོ་ཉིད།\"}, {\"label\": \"QUOTE\", \"head\": \"ཟབ་ཞི་སྤྲོས་བྲལ་འོད་གསལ་འདུས་མ་བྱས། །བདུད་རྩི་ལྟ་བུའི་ཆོས་ཤིག་ཁོ་བོས་རྙེད། །སུ་ལ་བསྟན་ཀྱང་གོ་བར་མི་ནུས་པས། །མི་སྨྲ་ནགས་ཀྱི་ཚལ་དུ་གནས་པར་བྱ། །\", \"tail\": \"གནས་པར་བྱ།\"}]}",
