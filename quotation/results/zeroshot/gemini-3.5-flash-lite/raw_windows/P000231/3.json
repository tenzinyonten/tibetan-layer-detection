།བདག་གི་ཕ་མ་སྐམ་ལ་འདོན་དུ་གསོལ། །ཕལ་ཆེར་མུ་མཐའ་མེད་པའི་རྒྱ་མཚོར་ཤོར། །བླ་མ་ཀླུ་དབང་གཙུག་གི་ནོར་བུ་ཅན། །ང་ཡི་ཕ་མ་བེ་བའི་སྐམ་ལ་དྲོངས། །མཐུ་དཔལ་རྨད་མངའ་ཁྱེད་ཀྱིས་དྲང་དུ་གསོལ། །\",\n      \"tail\": \"\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"སྐུ་གསུམ་དོན་ཐུགས་ལས།\",\n      \"head\": \"འགྲོ་བ་དྲུག་གི་སེམས་ཅན་ཐམས་ཅད་ནི། །བདག་གི་ཕ་མར་མ་གྱུར་གཅིག་ཀྱང་མེད། །ཕ་མ་འདི་དག་འཁོར་འཁྱམས་སྙིང་རེ་རྗེ། །བརྩེ་སེམས་བུ་གཅིག་ཤི་བའི་མ་བཞིན་དུ། །འཁོར་བའི་མཚོ་ལས་སྒྲོལ་བར་དམ་བཅའ་ཞིང་། །ཇི་ལྟར་བྱ་མོས་སྒོང་གསོ་གབ་པ་ལྟར། །རྣམ་མཁྱེན་ས་ལ་འགོད་པའི་བྱམས་པ་དང་། །རྒྱལ་པོའི་གདུང་རྒྱུད་ཆད་ཁར་སྲས་འཁྲུངས་ལྟར། །བདེ་དགའ་རྒྱ་མཚོ་ཐོབ་པའི་དགའ་བ་དང་། །དྲང་སྲོང་རྒྱལ་པོས་གཏོར་མ་བསྔོ་བ་བཞིན། །ཉེ་རིང་དགྲ་གཉེན་མེད་པའི་བཏང་སྙོམས་དང་། །འགྲོ་རྣམས་བླ་མེད་ས་ལ་འགོད་པའི་ཕྱིར། །བདག་གིས་ཐེག་ཆེན་བླ་མེད་སྒྲུབ་པར་བགྱི། །གནོད་པའི་ལན་དུ་ཕན་པའི་གདུང་ཤུགས་བསྐྱེད། །\",\n      \"tail\": \"\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"བསྒོམ་རིམ་དང་པོ་ལས།\",\n      \"head\": \"གང་གི་ཚེ་ཡིད་དུ་འོང་བའི་བུ་མི་\",\n      \"tail\": \"སྙིང་རྗེ་ཆེན་པོའི་མིང་འཐོབ་སྟེ།\"\n    }\n  ]\n}",
