  "raw_text": "{\n  \"spans\": [\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"བློ་གྲོས་མི་ཟད་པས་བསྟན་པ་ལས།\",\n      \"head\": \"བཙུན་པ་ཤཱ་ར་དྭ་ཏིའི་བུ་གཞན་\",\n      \"tail\": \"གྲུབ་པའི་སྔོན་དུ་འགྲོ་བ་ཡིན་ནོ། །\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"གཱ་ཡ་གཽ་རི་ལས་ཀྱང་།\",\n      \"head\": \"འཇམ་དཔལ་བྱང་ཆུབ་སེམས་དཔའ་\",\n      \"tail\": \"གནས་ནི་སེམས་ཅན་ནོ། །\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"སྒོམ་རིམ་དང་པོ་ལས།\",\n      \"head\": \"དེ་ལྟར་སྙིང་རྗེ་ཆེན་པོས་བསྐྱོད་པའི་\",\n      \"tail\": \"ཡུན་རིང་ལ་དུབ་པར་འགྱུར་བ་ལ་འཇུག་གོ །\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"འཕགས་པ་དད་པའི་སྟོབས་བསྐྱེད་པ་ལས་གསུངས་པ་ལྟ་བུ་སྟེ།\",\n      \"head\": \"དེ་ལ་སྙིང་རྗེ་ཆེན་པོ་ནི་སེམས་ཅན་\",\n      \"tail\": \"དེས་བདེ་བའི་སྐྱེ་བ་མི་འདོར་བ་ཅི་ཡང་མེད་དོ་\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"བསྒོམ་རིམ་བར་པ་ལས།\",\n      \"head\": \"སྙིང་རྗེ་ཆེན་པོས་ཡོངས་སུ་ཟིན་པས་\",\n      \"tail\": \"བཞུགས་པར་མཛད་དོ། །\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"བཅོམ་ལྡན་འདས་རྣམས་ཀྱི་མི་གནས་པའི་མྱ་ངན་ལས་འདས་པའི་རྒྱུ་ནི་སྙིང་རྗེ་ཆེན་པོ་དེ་ཉིད་ཡིན་ནོ། །\",\n      \"head\": \"\",\n      \"tail\": \"\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"དཔལ་ལྡན་ཟླ་བ་གྲགས་པས་གསུངས་ཏེ།\",\n      \"head\": \"གང་ཕྱིར་བརྩེ་ཉིད་རྒྱལ་བའི་ལོ་ཏོག་ཕུན་ཚོགས་འདིའི། །ས་བོན་དང་ནི་སྤེལ་ལ་ཆུ་འདྲ་ཡུན་རིང་དུ། །ལོངས་སྤྱོད་གནས་ལ་སྨིན་པ་ལྟ་བུར་འདོད་གྱུར་པ། །དེ་ཕྱིར་བདག་གིས་ཐོག་མར་སྙིང་རྗེ་བསྟོད་པར་བགྱི། །\",\n      \"tail\": \"\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"ཆོས་ཡང་དག་པར་སྡུད་པ་ལས་ཀྱང་།\",\n      \"head\": \"བཅོམ་ལྡན་འདས་བྱང་ཆུབ་སེམས་དཔས་\",\n      \"tail\": \"བྱང་ཆུབ་སེམས་དཔའི་ཆོས་གཞན་རྣམས་ཀྱང་འབྱུང་བར་འགྱུར་རོ་\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"རྣམ་སྣང་མངོན་བྱང་ལས།\",\n      \"head\": \"གསང་བའི་བདག་པོ་ཐམས་ཅད་\",\n      \"tail\": \"སྙིང་རྗེའི་རྩ་བ་ལས་བྱུང་བ་ཡིན།\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"བྱང་ཆུབ་སེམས་དཔའི་སྡེ་སྣོད་ལས།\",\n      \"head\": \"འདི་ལ་བྱང་ཆུབ་སེམས་དཔའི་\",\n      \"tail\": \"སྙིང་རྗེ་ཆེན་པོ་ཡིན་ནོ་\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"ཕར་ཕྱིན་བསྡུས་པ་ལས།\",\n      \"head\": \"ཐུབ་རྒྱལ་ཐེག་པ་སྙིང་རྗེའི་བསྟན་པ་ལ། །གཞན་ཕན་རོ་གཅིག་རང་བཞིན་དེ་དག་འཇུག །\",\n      \"tail\": \"\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"སྡོང་པོ་བཀོད་པའི་མདོ་ལས།\",\n      \"head\": \"མཚན་གྱི་ལྷ་མོ་དཔྱིད་ལྡན་\",\n      \"tail\": \"དེས་ནི་འགྲོ་བའི་སྡུག་བསྔལ་སེལ་བར་བྱེད། །\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"རྒྱན་ལས།\",\n      \"head\": \"དང་པོ་རྩ་བ་ཐ་མར་འབྲས་མཆོག་ལྡན། །འདི་ནི་སྙིང་རྗེ་ལྗོན་ཤིང་ཆེན་པོ་ཡིན། །རྩ་བ་སྙིང་རྗེ་མེད་གྱུར་ན། །དཀའ་སྤྱད་བཟོད་པ་ཉིད་མི་འགྱུར། །\",\n      \"tail\": \"\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"སྙིང་རྗེ་ཆེན་པོ་ཡོན་ཏན་འབྱུང་གནས་ཀྱི།\",\n      \"head\": \"སེམས་ཅན་རྣམས་ལ་སྙིང་རྗེ་སུ་མི་བྱེད། །འདི་ལྟར་འདི་དག་ལ་ནི་སྡུག་བསྔལ་ཡང་། །བརྩེས་བསྐྱེད་བདེ་བ་གཞལ་དུ་མེད་པར་འགྱུར་བ། །\",\n      \"tail\": \"\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"བློ་གྲོས་རྒྱ་མཚོས་ཞུས་པའི་མདོ་ལས།\",\n      \"head\": \"སངས་རྒྱས་ཐོབ་པར་བྱེད་པའི་\",\n      \"tail\": \"བདག་གི་བདེ་བ་ལ་མ་ཆགས་པའི་སྙིང་རྗེ་ཆེན་པོའོ། །\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"བློ་སྦྱོང་སྙན་བརྒྱུད་དུ་ལུང་དུ་དྲངས་པ་ལས།\",\n      \"head\": \"མཆོད་པ་བླ་ན་མེད་པ་ནི་རྣམ་\",\n      \"tail\": \"སྙིང་རྗེ་བསྒོམ་པའོ། །\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"དགེ་སྡིག་རྣམ་པར་འབྱེད་པའི་མདོ་ལས།\",\n      \"head\": \"ཚེ་རིང་བ་ནི་སྙིང་རྗེ་ཆེ་བ་\",\n      \"tail\": \"ལས་འོངས་སོ། །\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"སངས་རྒྱས་ཀྱི་སྦྲིད་པ་སངས་པའི་སྒྲ་ལས།\",\n      \"head\": \"ཡོན་གྱི་མཆོག་ནི་སྙིང་རྗེ་སྟེ། །དེ་བས་སྙིང་རྗེ་ལྡན་པར་བྱོས། །\",\n      \"tail\": \"\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"ས་ར་ཧས།\",\n      \"head\": \"སྙིང་རྗེ་དང་བྲལ་སྟོང་པ་ཉིད