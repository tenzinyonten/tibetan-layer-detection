  "raw_text": "{\"spans\": [{\"label\": \"QUOTE\", \"frame\": \"རཏ་གླིང་མཛོད་ཁང་གཉིས་པ་ལས།\", \"head\": \"སེམས་ཞེ་སྡང་གི་ངོ་བོ་རིག་ལ་གསལ།\", \"tail\": \"ཞེས་གསུངས་པ་ལྟར་ཡིན།\"}, {\"label\": \"QUOTE\", \"frame\": \"མདོ་རྒྱུད་བསྟན་བཅོས་ཐམས་ཅད་ཞལ་མཐུན་ནོ། །\", \"head\": \"སྲས་བཅས་རྒྱལ་བ་ཡོངས་ཀྱི་དགོངས་པའི་མཐིལ།\", \"tail\": \"སརྦ་དཱ་ཀ་ལྱ་ན་བྷ་ཝནྟུ།\"}, {\"label\": \"QUOTE\", \"frame\": \"ལུས་ནི་དགེ་སྡིག་ཀུན་གྱི་གཡོག་པོ་ཡིན། །སེམས་ནི་ཀུན་ལ་དབང་སྒྱུར་རྒྱལ་པོ་འདྲ། །\", \"head\": \"ལུས་ནི་དགེ་སྡིག་ཀུན་གྱི་གཡོག་པོ་ཡིན། །སེམས་ནི་ཀུན་ལ་དབང་སྒྱུར་རྒྱལ་པོ་འདྲ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"དཔལ་རང་བྱུང་ཞབས་ཀྱིས།\", \"head\": \"ཡོད་པ་མ་ཡིན་རྒྱལ་བས་ཀྱང་མ་གཟིགས། །མེད་པ་མ་ཡིན་འཁོར་འདས་ཀུན་གྱི་གཞི། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"དཔལ་རང་བྱུང་ཞབས་ཀྱིས།\", \"head\": \"ཐམས་ཅད་བདེན་མིན་རྫུན་མིན་ཏེ། ཆུ་ཟླ་བཞིན་དུ་མཁས་རྣམས་འདོད། །ཐ་མལ་ཤེས་པ་འདི་ཉིད་ལ། །ཆོས་དབྱིངས་རྒྱལ་བའི་སྙིང་པོ་ཟེར། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"དཔལ་མདའ་བསྣུན་ཞབས་ཀྱིས།\", \"head\": \"སེམས་ཉིད་གཅིག་པུ་ཀུན་གྱི་ས་བོན་ཏེ། །གང་ལ་སྲིད་དང་མྱ་ངན་འདས་འཕྲོ་བ། །འདོད་པའི་འབྲས་བུ་སྟེར་བ་བྱེད་པ་ཡི། །ཡིད་བཞིན་ནོར་འདྲའི་སེམས་ལ་ཕྱག་འཚལ་ལོ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཡིད་བཞིན་རིན་པོ་ཆེའི་མཛོད་ལས།\", \"head\": \"འདི་དག་ཐམས་ཅད་དོན་ལ་མེད་ན་ཡང་། །གཟུང་འཛིན་དབང་གིས་རྟེན་འབྲེལ་སྣ་ཚོགས་སྣང་། །ཇི་སྲིད་གཟུང་འཛིན་དབྱིངས་སུ་མ་ནུབ་བར། །རྒྱུ་འབྲས་ལས་ཡོད་དེ་ཡིས་སྤྲུལ་པ་སྟེ། །སེམས་ཀྱི་ལས་ཡོད་སེམས་ཀྱིས་ལས་ཀུན་བྱེད། །སེམས་ལ་སྣང་ཞིང་སེམས་ཀྱིས་བརྟག་པས་ན། །འཁྲུལ་པའི་སེམས་འདུལ་སླད་དུ་འབད་པར་མཛོད། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"གནས་ལུགས་རིན་པོ་ཆེའི་མཛོད་ལས།\", \"head\": \"མ་བྱས་ལྷུན་གྱིས་གྲུབ་པའི་རིག་པ་ལ། །མི་རྩོལ་རང་བཞག་ཡངས་པའི་གདངས་ཤར་བས། །དགེ་སྡིག་རྒྱུ་འབྲས་འདས་པའི་བྱང་ཆུབ་སེམས་། །མི་འགྱུར་ཆོས་ཉིད་ངང་དུ་བསྡོམ་པ་ཡིན། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"head\": \"རྒྱུ་འབྲས་བྱིས་པ་དྲངས་པའི་ཆོས་རྣམས་ཀུན། །མས་འཛེགས་སྐལ་དམན་ལམ་དུ་ཐག་བཅད་དེ། །རང་ངོའི་དགོངས་པ་ཆོས་ལས་འདས་པའི་དོན། །བྱར་མེད་ནམ་མཁའི་ཁམས་སུ་བཅིང་བར་བྱ། །བ