  "raw_text": "{\"spans\": [{\"label\": \"QUOTE\", \"head\": \"བཞག་ཅིང་བླང་བར་ནུས་པ་མེད། །དེ་དོན་རྟོགས་པའི་རྣལ་འབྱོར་དེ། །མི་ཡི་ལུས་ལ་སངས་རྒྱས་ཐུགས། །རང་བྱུང་སྐུ་ལ་ཚངས་པའི་གསུང་། །དེ་མ་ཐག་ཏུ་ཀུན་བཟང་ཉིད། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"head\": \"དུས་གསུམ་སངས་རྒྱས་སེམས་དང་བྲལ། །ཚོགས་བརྒྱད་མེད་པས་སེམས་ཀྱང་མེད། །རང་བྱུང་སྙིང་པོ་ཆོས་ཀྱི་སྐུ། །སེམས་ལས་མ་བྱུང་ཡེ་ཤེས་ཡིན། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"རྫོགས་ཆེན་ལྟ་བ་ཡེ་ཤེས་གཏིང་རྫོགས་ཀྱི་རྒྱུད་ལས།\", \"head\": \"ཡེ་ནས་གནས་པའི་རང་བྱུང་སྙིང་པོ་འདི། །རྒྱུ་ལས་མ་བྱུང་རྐྱེན་གྱིས་མ་བསྐྱེད་པས། །རྩོལ་བ་གང་ཡང་མ་བྱས་ཆོས་སྐུ་རུ། །རང་བྱུང་ཡེ་ཤེས་ཡིན་པར་ཡིད་ཀྱང་ཆེས། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"རིག་པ་རང་ཤར་ཆེན་པོའི་རྒྱུད་ལས།\", \"head\": \"བརྗོད་པའི་མཐའ་དང་བྲལ་བའི་ཆོས་སྐུ་ཆེན་པོ་འདི། །ཀུན་ལ་གནས་ཏེ་ཀུན་གྱི་རྟོགས་པ་མེད། །ཡིད་མེད་སེམས་མེད་མ་རིག་འཁྲུལ་པ་མེད། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"head\": \"སེམས་དང་བྲལ་བའི་རིག་པ་ལ། །སྣ་ཚོགས་སྣང་བ་དུས་གཅིག་རྫོགས། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"head\": \"རིག་པ་འགྱུར་མེད་ཤེས་ན་ཆོས་རྣམས་ཀུན་གྱི་འབྲས་བུ་ཡིན། །རིག་པ་སེམས་མེད་ཤེས་ན་ཆོས་རྣམས་ཀུན་གྱི་དྲི་མེད་ཡིན། །རིག་པའི་གྲོགས་ཟླ་ཤེས་ན་ཆོས་རྣམས་ཀུན་གྱི་སྤང་བྱ་ཡིན། །རིག་པ་ཡེ་མེད་ཤེས་ན་ཆོས་རྣམས་ཀུན་གྱི་གཞི་མེད་ཡིན། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཀུན་བྱེད་ལས།\", \"head\": \"ང་ནི་ཡེ་ནས་བཟུང་འཛིན་བྲལ་བའི་ཕྱིར། །ཕྲ་བ་ཞེས་ནི་མིང་དུ་གདགས་སུ་མེད། །ང་ནི་ཡེ་ནས་རང་བྱུང་ཡེ་ཤེས་པས། །ང་ལ་གཞན་གྱིས་གཏན་ལ་དབབ་ཏུ་མེད། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"head\": \"སློབ་དཔོན་ཚད་མར་མ་གྱུར་སྤྲེའུ་འདྲ་ཡི། །ལུང་བསྟན་ལམ་ནོར་ལོག་པས་ཟིན་ཏ་རེ། །དེ་བས་གསེར་ལ་ནག་ཚུར་གཏོང་བ་ཡི། །སློབ་དཔོན་ཡང་དག་བསྟོད་པའི་རིན་ཆེན་མཛོད། །རིན་ཐང་དཔག་ཏུ་མེད་པས་བསླུ་བར་འོས། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"head\": \"ཡོ་ག་ཤིན་ཏུ་རྣལ་འབྱོར་རྫོགས་ཆེན་ལ། །རྒྱུ་དང་འབྲས་བུ་ཡོད་ཟེར་སྨྲ་བྱེད་པ། །དེ་ནི་རྫོགས་ཆེན་རྟོགས་པའི་དོན་མི་ལྡན། །ཀུན་རྫོབ་དོན་དམ་གཉིས་སུ་སྨྲ་བྱེད་ན། །སྒྲོ་དང་སྐུར་པ་འདེབས་པའི་ཚིག་ཡིན་ཏེ། །དེ་ཡིས་གཉིས་སུ་མེད་པར་རྟོགས་པ་མེད། །དུས་གསུམ་སངས་རྒྱས་རྣམས་ཀྱི་རྟོགས་པ་ཡང་། །གཉིས་ສུ་མ་མཐོང་རྣམ་བཞག་ཉིད་དུ་འདོད། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"གསུངས་པ།\", \"head\": \"ཕྲ་བའི་སྒོར་ཡོར་མིང་བཏགས་ཏེ། །སེམས་ཀྱི་དབེན་པའི་ལམ་འཚོལ་ཞིང་། །དགོན་པའི་རྒྱུད་དུ་དབེན་འཛིན་པ། །བརྟག་ན་རྣམ་པར་རྟོག་འགྱུར་བསྒོམ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"head\": \"བྱང་ཆུབ་སེམས་ནི་རྒྱུ་རྐྱེན་མེད་པའི་ཕྱིར། །འཇིག་རྟེན་སྐྱེ་འགགས་ཆོས་ལ་ཚོད་མི་བཟུང་། །བྱང་ཆུབ་སེམས་ནི་རྐྱེན་གྱིས་མ་བསྐྱེད་པས། །འཇིག་རྟེན་རྐྱེན་སྐྱེད་ཆོས་ལ་དཔེ་མ་ལེན། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཀུན་ཏུ་བཟང་པོའི་ཐུགས་ཀྱི་མེ་ལོང་གི་རྒྱུད་ལས།\", \"head\": \"ཀུན་གཞི་ཆོས་སྐུར་འདོད་ན་ང་ལས་གོལ་བ་ཡིན། །སེམས་ལས་སངས་རྒྱས་འདོད་ན་ང་ལས་གོལ་བ་ཡིན། །བསྒོམ་པ་ཡུལ་ཅན་འདོད་ན་ང་ལས་གོལ་བ་ཡིན། །སྟོང་པའི་ཡུལ་ལ་ཞེན་ན་ང་ལས་གོལ་བ་ཡིན། །མཚན་བཅས་གཞན་འབྱུང་བསྒོམ་ན་ང་ལས་གོལ་བ་ཡིན། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"གསང་བ་འདུས་པ་ལས་ཀྱང་།\", \"head\": \"བདག་དང་ཕུང་པོ་རྣམ་རིག་གི། །ཆོས་བདག་མེད་པ་མཉམ་ཉིད་པས། །རང་སེམས་གདོད་ནས་མ་སྐྱེས་པ། །སྟོང་པ་ཉིད་ཀྱི་མཚན་ཉིད་དོ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཀྱེ་རྡོ་རྗེ་ལས།\", \"head\": \"ཏིང་འཛིན་འདི་ནི་ཆེས་ཕྲ་ཞིང་། །རྡོ་རྗེ་ནམ་མཁའི་དཀྱིལ་ལྟ་བུ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"head\": \"འདིར་ནི་ཐོག་མ་དབུས་མཐའ་མེད། །སྲིད་མེད་མྱ་ངན་འདས་པ་མེད། །བདག་མེད་གཞན་ཡང་མེད་པ་སྟེ། །འདིར་ནི་མཆོག་ཏུ་བདེ་ཆེན་ཉིད། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"མདོ་དགོངས་པ་འདུས་པ་ལས།\", \"head\": \"ཅི་ཕྱིར་མ་འོངས་དུས་རྣམས་སུ། །གཡོན་ཅན་བཅོས་པའི་གསང་ཚིག་གིས། །དྲི་མེད་གསང་བའི་བསྟན་པ་རྣམས། །དཀྲུགས་འགྱུར་བཀའ་སླད་གཞུང་བོར་ནས། །དོན་མེད་ལོག་ཆོས་རྒྱས་པར་འགྱུར། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"head\": \"གོང་དུ་དམུས་ལོང་ལམ་ཞུགས་པ། །ཡིད་ཀྱིས་གོམས་པའི་ཚད་དཔག་ནས། །ཉམ་ངའི་ལམ་དུ་རྒྱུག་པ་ལྟར། །ཚོད་དཔག་ཙམ་ལ་ཚད་བཞིན་འབྱུང་། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"རྫོགས་པ་ཆེན་པོ་ལྟ་བའི་ཡང་སྙིང་ནམ་མཁའ་ཀློང་ཡངས་ཀྱི་རྒྱུད་ལས།\", \"head\": \"རྫོགས་ཆེན་སྐྱེ་མེད་དོན་ཟབ་ཀྱང་། །མ་རྟོགས་པ་ལ་སྡིག་མོར་ཆེ། །ནོར་བུ་རིན་ཆེན་རྙེད་དཀའ་བཞིན། །ཕྱི་མའི་དུས་ཀྱི་མི་ངན་རྣམས། །ངར་དྲག་ངང་ཐུང་ཚོར་རྐྱེན་ལ། །བཀའ་ཡི་དོན་ལ་ཡིད་མི་ཆེས། །གཞུང་མང་སྒྲིན་ཚིག་རྟོག་པ་ཟད། །བྱང་ཆུབ་བས་ཀྱང་ཁེ་གྲགས་བསྒྲུབ། །ལེ་ལོོ་ཆེ་བས་གྲུབ་རྟགས་རིང་། །འཇུག་ལ་བརྩོན་ནས་འདོར་བ་རྐྱེན། །ངེས་པའི་དོན་ལ་གལ་ཆེན་འཛུགས། །བདེན་པའི་ཚིག་ལ་སྒྲོ་སྐུར་འདེབས། །ཚིག་ཏུ་ཞིབ་ལ་དོན་དུ་རྩིང་། །ཐོས་བསམ་པས་ནི་ངོམ་པར་རིངས། །ཤེས་ནས་མི་སྒྲུབ་ཡལ་བར་འདོར། །གང་འོག་གཞུང་ནི་བསྲེས་ཏེ་སླད། །བཀའ་མིན་མི་ཆོས་དོན་དུ་བྱེད། །མན་ངག་ཟབ་མོ་ཟོང་དུ་འཚོང་། །ཚིག་ཉུང་ཟབ་མོ་གཏིང་ཕྱིན་ལ། །ཤ་ཐང་མི་བྱེད་སྦོམ་ཞེས་ཁྲོ། །གདམས་ངག་བློ་ཆུད་မི་ཟོན་པར། །དེ་ཉིད་རྟོགས་པར་བྱེད་པ་ལ། །ཡིད་མི་ཆེས་པས་རིག་པ་འཛུག །མང་པོར་བཤད་ཀྱང་དོན་མེད་ལ། །མཁས་པ་ཡིན་ཞེས་ཡོན་ཏན་བརྗོད། །བླ་མ་སྨོད་པའི་གང་ཟག་ལ། །ཁོ་བདེན་ཟེར་ཞིང་རྗེས་སུ་འཇུག །གསང་བའི་མན་ངག་མ་གོ་བར། །སློབ་བུའི་མ་བྱས་སློབ་དཔོན་འཁེངས། །ཁུངས་ནས་བརྒྱུད་པའི་མན་ངག་ལ། །མངོན་པར་ཡིན་པར་མི་བརྩི་བར། །རང་བཟོ་ཁ་ཚབ་བསྲེས་པ་ལ། །ཡིད་ཆེས་བྱེད་ཅིང་དམ་པར་འཛིན། །ལྟ་དམན་རྣམས་ཀྱིས་ངོ་བསྲུང་བྱེད། །དེ་ལྟ་བུའི་དུས་བྱུང་ཚེ། །དོན་བསྟན་སྐད་ཅིག་དེ་ཉིད་ལ། །རྒྱུད་ལུང་སངས་རྒྱས་སྐྲག་ཅིང་སྔངས། །ཉན་ཐོས་མདོ་སྡེ་བརྒྱལ་ཞིང་འབོགས། །ལྷ་དང་ལྷ་མིན་སྲིན་པོའི་ཚོགས། །སྒྲོ་སྐུར་འདོགས་པའི་གང་ཟག་རྣམས། །འདི་ལ་ཚེ་ཡི་བར་ཆད་དང་། །གཏན་དུ་དམྱལ་བ་ཆེན་པོར་ལྟུང་། །འཇིགས་པ་སྣ་ཚོགས་དེ་ལ་འོང་། །མགོ་ལུས་ཚལ་པ་སྟོང་དུ་འགས། །རིག་འཛིན་རྣམས་ཀྱིས་སྤོང་བར་འགྱུར། །དེ་ཕྱིར་ཤིན་ཏུ་གསང་བའི་དོན། །སྣོད་ལྡན་སློབ་བུ་མི་རྙེད་དཀོན། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"head\": \"ངེས་དོན་ལྟ་བ་འཆད་པ་ལ། །ལྟ་དམན་ཚུལ་འཆོས་སྡེ་པ་ནི། །སྔགས་པར་ཁས་ཆེའི་མུ་སྟེགས་དང་། །དྲང་དོན་ཐེག་པ་ལ་ཞེན་རྣམས། །ཞེ་སྡང་བྱེད་པའི་དུས་བྱུང་ཚེ། །ཁ་ཟེར་ཕྱར་ཁ་གཏོང་བ་དང་། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"རྫོགས་ཆེན་ནམ་མཁའ་དང་མཉམ་པའི་རྒྱུད་ལས།\", \"head\": \"རྣ་བརྒྱུད་མན་ངག་མི་ལྡན་ན། །རང་བརྟགས་བློ་ཡིས་ཅི་བརྟག་ཀྱང་། །ལུང་འདི་རྟོགས་པར་མི་འགྱུར་རོ། །ངེས་ལུང་གདམས་ངག་མེད་པ་ཡི། །རྣ་བརྒྱུད་མེད་པའི་སློབ་དཔོན་གྱིས། །རང་ལ་ངེས་པའི་དོན་མེད་པས། །གཞན་འབྲེལ་གཉིས་ཀ་ཕུང་པའི་རྒྱུ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"head\": \"གཞན་གྱིས་ནུབ་པར་མི་འགྱུར་ཏེ། །སེངྒེའི་ཁོག་པ་རང་འཇིག་ལྟར། །ང་ཡི་སྲས་སུ་ཁས་བླངས་པས། །གསང་བའི་ལུང་འདི་ནུབ་པར་བྱེད། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཡེ་ཤེས་གསང་བའི་སྒྲོན་མ་རིན་པོ་ཆེ་མན་ངག་གི་རྒྱུད་ལས།\", \"head\": \"གྲུབ་མཐའ་ལོག་པ་ཆོས་ཀྱི་བདུད། །ངོ་བོ་མེད་པ་དམིགས་འཛིན་བྱས། །རང་བྱུང་ཉིད་ལ་རྒྱུ་ཡི་རྩལ། །མ་བཅོས་ཅི་ཡང་མ་ཡིན་ལ། །ཅིར་ཡང་འཛིན་པའི་བསམ་པས་བརྟག །བགྲོད་མེད་འབྲས་བུ་ལྷུན་གྲུབ་ལ། །ལམ་བརྒྱད་བགྲོད་པས་བགྲོད་མེད་བསླད། །དེས་ན་མ་བཅོས་དངོས་པོ་ལ། །ལོག་རྟོག་འཛིན་པའི་བློ་ཡིས་ནི། །ཇི་ལྟར་དཔྱད་ཀྱང་མ་ཡིན་པས། །མ་དཔྱད་རང་བཞིན་བཞག་པས་གོ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"འཇམ་མགོན་མི་ཕམ་རིན་པོ་ཆེའི་ཟབ་ཁྲིད་དུ།\", \"head\": \"མདོ་རྒྱུད་བརྒྱ་ཕྲག་འཆད་པའི་སྟོན་ཆེན་དང་། །ཀུན་གྱི་བླ་མར་བསྐུར་བ་ཕལ་མོ་ཆེས། །རང་སེམས་གནད་དུ་བཀུག་ནས་མ་བསྒོམ་པས། །ཕལ་བ་ལས་ཀྱང་ཅུང་ཟད་འཕགས་པ་མེད། །ཀུན་རྟོག་མགོ་རྒོད་འདི་ཡང་དབང་ཆེ་ལ། །མཁྱེན་དང་ནུས་པའི་ཡོན་ཏན་ཀྱང་མ་ཐོབ། །དོན་མེད་ཆུ་རླབས་འཁྲུགས་འདིའི་རང་སེམས་ལ། །བལྟས་ཤིང་བལྟས་ནས་སྐྱོ་བ་ཆེར་བསྐྱེད་དེ། །དམ་པའི་མན་ངག་ཟབ་མོའི་རྗེས་ཞུགས་ནས། །རང་སེམས་ཁ་ལོ་དུལ་བའི་ཅང་ཤེས་ཀྱིས། །དོན་གཉིས་འབྲས་བུ་འབྱོར་ལྡན་ཡིད་འོང་གནས། །མྱུར་བ་ཉིད་དུ་མངོན་པར་ཐོབ་མཛོད་ཅིག །བརྩོན་པ་ཀུན་གྱི་ནང་ན་དོན་ཆེ་བ། །རང་སེམས་དུལ་བར་སྦྱོར་བ་དེ་ཁོ་ན། །བུམ་བཟང་དཔག་བསམ་ནོར་བུའི་གཏེར་གྱིས་ཀྱང་། །མཚོན་མིན་ཡོན་ཏན་ཆེན་པོའི་གནས་ཉིད་ཡིན། །དེ་ཕྱིར་འདི་དོན་ལེགས་རྟོགས་བསྐལ་བཟང་གིས། །སེམས་ཀྱི་རྣལ་འབྱོར་གནས་ལ་རབ་གུས་པས། །བྱ་བ་ཀུན་སྤངས་རྩེ་གཅིག་ཡིད་གྱུར་ཏེ། །དོན་བཟང་གཏན་གྱི་འདུན་མ་སྒྲུབས་འཚལ་ལོ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"head\": \"མི་ཚེ་ཟད་ཟད་དུ་ཐོས་བསམ་ལ་བརྩོན་ཀྱང་། །ཐ་སྙད་གོ་ཡུལ་གྱི་རྟོག་གེ་དེས་བསྒྲིབས་ནས། །གནས་ལུགས་ཐིག་པོ་ཞིག་རྟོགས་དུས་མི་གདའ། །བདག་འདྲའི་སྐལ་མཉམ་རྣམས་རྟོག་གེ་ལ་མ་ཞེན། །ས་དགེ་དཀར་རྙིང་གི་བཞེད་གཞུང་ནི་གང་ལ། །རྩོལ་མེད་བློ་འདས་ཀྱི་གསང་ལམ་ཞིག་གདའ་བས། །ཕྱོགས་འཛིན་ཆགས་སྡང་གི་གྲུབ་མཐའ་དེ་བོར་ནས། །ཡབ་མེས་གོང་མ་ཡི་གཤེགས་ཤུལ་དེར་བཞུད་མཛོད། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"མན་ངག་གསེར་ཞུན་ལས།\", \"head\": \"སྟོང་པས་ཅི་ཕན་སྣང་བས་ཅི། །གཉིས་མེད་སུ་ཡིན་བསྒོམ་རྒྱུ་ཅི། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཨོ་རྒྱན་ཆེན་པོས།\", \"head\": \"འདི་ཉིད་རྟོགས་ན་བ་གླང་རྫི་ཡང་གྲོལ། །ཐེག་དགུའི་བཤད་པ་ཀུན་ལ་མཁས་གྱུར་ཀྱང་། །འདི་ཉིད་མ་རྟོགས་པཎྜི་ཏ་ཡང་འཁྲུལ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"པཎ་ཆེན་བློ་བཟང་ཆོས་རྒྱན་གྱིས་ལྷན་ཅིག་སྐྱེས་སྦྱོར་གའུ་མར།\", \"head\": \"ལྔ་ལྡན་རོ་སྙོམས་ཡི་གེ་བཞི། །ཞི་བྱེད་གཅོད་ཡུལ་རྫོགས་ཆེན་དང་། །དབུ་མའི་ལྟ་ཁྲིད་ལ་སོགས་པ། །སོ་སོར་མིང་འདོགས་མང་ན་ཡང་། །ངེས་དོན་ལུང་རིགས་ལ་མཁས་ཤིང་། །ཉམས་མྱོང་ཅན་གྱི་རྣལ་འབྱོར་པས། །དཔྱད་ན་དགོངས་དོན་གཅིག་ཏུ་འབབ། །\", \"tail\": \"\"}]}",
