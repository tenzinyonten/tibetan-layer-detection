་ཚོམ་མེད། །\"}, {\"label\": \"QUOTE\", \"frame\": \"མཻ་ཏྲི་པས།\", \"head\": \"བླ་མ་རྗེ་བཙུན་མ་བསྟེན་\", \"tail\": \"དངོས་གྲུབ་རྣམ་གཉིས་ཐོབ་མི་སྲིད། །\"}, {\"label\": \"QUOTE\", \"head\": \"སྤྱི་བོའི་གཙུག་གམ་ལག་\", \"tail\": \"གང་ཟག་དེ་ཡིས་འཛིན་པར་འགྱུར། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཡེ་ཤེས་མཁའ་འགྲོ་མས།\", \"head\": \"མཆོག་དང་ཐུན་མོང་དངོས་\", \"tail\": \"རྣལ་དུ་ཕོབ་ལ་གསོལ་བ་ཐོབ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"པཎ་ཆེན་ནཱ་རོ་པས།\", \"head\": \"ཅི་དགུ་ཐམས་ཅད་བླ་མ་\", \"tail\": \"གསོལ་བ་བཏབ་ལས་འབྱུང་བར་འགྱུར། །\"}, {\"label\": \"QUOTE\", \"frame\": \"མཻཏྲི་པས།\", \"head\": \"བླ་མའི་བྱིན་རླབས་འཕོས་\", \"tail\": \"དུས་གསུམ་སངས་རྒྱས་སྤར་ནས་བཏོན་པ་འདྲ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཨ་ལི་ཀཱ་ལི་རྒྱུད་ལས།\", \"head\": \"བརྗོད་བྲལ་ལྷན་ཅིག་སྐྱེས་\", \"tail\": \"ཐབས་གཞན་བརྟེན་པ་རྨོངས་པར་ཤེས་པར་བྱ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ས་ར་ཧ་པས།\", \"head\": \"བླ་མས་སྨྲས་པ་གང་གི་\", \"tail\": \"ལག་པའི་མཐིལ་ན་གནས་པའི་གཏེར་མཐོང་འདྲ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"བརྟག་གཉིས་ལས།\", \"head\": \"གཞན་གྱིས་བརྗོད་མིན་\", \"tail\": \"རང་གི་བསོད་ནམས་ལས་ཤེས་བྱ། །\"}, {\"label\": \"QUOTE\", \"head\": \"རང་གི་རིག་པའི་ཡེ་ཤེས་\", \"tail\": \"ཀུན་མཁྱེན་ཡེ་ཤེས་དེ་ལྟาབུ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཆོས་རྗེ་གཙང་པས།\", \"head\": \"རྗེ་བླ་མའི་ངོ་བོ་ཆོས་\", \"tail\": \"བརྒྱུད་པ་ཉེ་རིང་བགྲང་མ་དགོས། །\"}, {\"label\": \"QUOTE\", \"head\": \"བླ་མ་རང་སེམས་དབྱེར་\", \"tail\": \"མོས་གུས་བྱ་བའི་ཡུལ་མ་རྙེད། །\"}, {\"label\": \"QUOTE\", \"frame\": \"རྒྱལ་དབང་རྗེས།\", \"head\": \"བླ་མ་རང་སེམས་འདྲེས་\", \"tail\": \"གསོལ་བ་འདེབས་པའི་ཡུལ་མ་རྙེད། །\"}, {\"label\": \"QUOTE\", \"head\": \"ད་ནི་མགོན་པོ་རང་གི་\", \"tail\": \"མཆོག་གི་དངོས་གྲུབ་དེ་ཀ་ལགས། །\"}, {\"label\": \"QUOTE\", \"frame\": \"རྗེ་མི་ལས།\", \"head\": \"བླ་མར་ངེས་སོ་རང་གི་\", \"tail\": \"རྙེད་པར་མི་འགྱུར་ལྷ་རྗེ་སྟོན་པ་བ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"དཔལ་ས་ར་ཧ་པས།\", \"head\": \"བླ་མའི་ལུང་ལ་འགྲིམས་\", \"tail\": \"ལྷན་ཅིག་སྐྱེས་པ་བྱུང་བ་ཐེ་ཚོམ་མེད། །\"}, {\"label\": \"QUOTE\", \"frame\": \"རིམ་ལྔ་ལས།\", \"head\": \"རི་དབང་རྩེ་ནས་འགའ་\", \"tail\": \"གྲོལ་བར་མི་འགྱུར་སྙམ་ཡང་གྲོལ་བར་གྱུར། །\"}, {\"label\": \"QUOTE\", \"frame\": \"སློབ་དཔོན་ཤཱཀྱ་འོད་ཀྱི་ཞལ་སྔ་ནས།\", \"head\": \"བླ་མ་ལ་གུས་ཚུལ་ཁྲིམས་\", \"tail\": \"སྡོམ་བརྩོན་གནས་པའི་ཆོས་ལྡན་སློབ་མར་གསུངས། །\"}, {\"label\": \"QUOTE\", \"frame\": \"མཁན་པོས།\", \"head\": \"སློབ་དཔོན་དེ་ཉིད་དུ་\", \"tail\": \"ཅིག་ཤོས་དེ་ལས་ལྡོག་པ་འོ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཡོན་ཏན་མཛོད་ལས།\", \"head\": \"གོ་ཆ་ཆེ་ལས་བློ་གྲོས་\", \"tail\": \"སྐྱེས་བུ་དེ་ནི་མོས་གུས་ཁོ་ནས་གྲོལ། །\"}, {\"label\": \"QUOTE\", \"head\": \"བླ་མ་ཤིན་ཏུ་སྲུང་བས་\", \"tail\": \"བླ་མ་བསྟེན་ཞེས་སྡེ་སྣོད་དག་ལས་གསུངས། །\"}, {\"label\": \"QUOTE\", \"head\": \"བླ་མ་བཞེངས་ཚེ་སྟན་ལ་\", \"tail\": \"སྤོངས་ལ་སྒོ་གསུམ་ཉེ་བར་ཞི་བས་བསྟེན། །\"}, {\"label\": \"QUOTE\", \"head\": \"རྫིང་བུ་མཆོག་ལ་བསྟེན་\", \"tail\": \"དད་པས་ཉེ་བར་ལེན་པའི་ཡོན་ཏན་མྱང༌། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཡིད་བཞིན་མཛོད་ལས།\", \"head\": \"དེ་ཡང་ཉོན་མོངས་ཤས་\", \"tail\": \"དད་བརྩོན་མི་ལྡན་དགེ་ཚོགས་རིང་དུ་བྱེད། །\"}, {\"label\": \"QUOTE\", \"head\": \"སྒོ་གསུམ་མ་དུལ་ཁེངས་\", \"tail\": \"མི་དགེ་འཕེལ་ཞིང་དགེ་ལེགས་འགྲིབ་པ་སྟེ། །\"}, {\"label\": \"QUOTE\", \"head\": \"རང་རྒྱུད་ངན་ཞིང་དག་\", \"tail\": \"ཐེག་ཆེན་དགེ་བའི་བཤེས་ལ་བསྐུར་བ་འདེབས། །\"}, {\"label\": \"QUOTE\", \"head\": \"གཏི་མུག་ཅན་བསྟེན་ཐོས་\", \"tail\": \"ང་རྒྱལ་ཅན་ལས་ཕྱོགས་རེས་གཉིས་འཛིན་འགོ །\"}, {\"label\": \"QUOTE\", \"head\": \"དེ་དག་དང་འགྲོགས་ཐར་\", \"tail\": \"དེས་ན་སྡིག་པའི་གྲོགས་པོ་སྤང་བར་བྱ། །\"}, {\"label\": \"QUOTE\", \"head\": \"ཇི་ལྟར་ལམ་འཕྲང་བགྲོད་\", \"tail\": \"གཏན་གྱི་བདེ་བ་འཕྲོག་པ་ཡོངས་མི་ནུས། །\"}, {\"label\": \"QUOTE\", \"head\": \"མདོར་ན་སྡིག་པའི་གྲོགས་\", \"tail\": \"དམ་པས་བསྟོད་ཅིང་ཡོན་ཏན་ཚོགས་རབ་འགྲུབ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"དམ་ཆོས་པདྨ་དཀར་པོ་ལས།\", \"head\": \"གཙང་ཞིང་ཡིད་དུ་འོང་\", \"tail\": \"བྱམས་པའི་སེམས་ཀྱིས་ལེ་ལོ་མེད་པར་སྟོན། །\"}, {\"label\": \"QUOTE\", \"head\": \"ཉན་པོ་རྣམས་གཡེངས་འདུ་\", \"tail\": \"མ་ཡེངས་གུས་པའི་ཚུལ་གྱིས་མཉན་པར་བྱ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"སྡུད་པ་ལས།\", \"head\": \"དགའ་དང་གུས་དང་དད་པའི་\", \"tail\": \"གང་ལ་དཔའ་རྣམས་སྤྱོད་པ་དེ་ནི་ཉན་པར་གྱིས། །\"}, {\"label\": \"QUOTE\", \"frame\": \"རྩེ་མོའི་རྒྱུད་ལས།\", \"head\": \"རྟོག་པ་ཐམས་ཅད་ལེགས་\", \"tail\": \"བདེ་བར་གཤེགས་པ་རྣམས་ཀྱིས་བྱིན་མི་རློབས། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ས་ཡི་སྙིང་པོའི་མདོ་ལས།\", \"head\": \"གཅིག་ཏུ་དད་ཅིང་གུས་\", \"tail\": \"སངས་རྒྱས་འདྲ་བ་དེ་ལ་འདུ་ཤེས་བསྐྱེད། །\"}, {\"label\": \"QUOTE\", \"frame\": \"སྐྱེ་རབས་ལས།\", \"head\": \"རབ་ཏུ་དམའ་བའི་སྟན་ལ་\", \"tail\": \"རིམ་གྲོ་བསྐྱེད་དེ་ཆོས་ཉོན་ཅིག །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཡུམ་བར་མ་ལས།\", \"head\": \"ལེགས་པར་རབ་ཏུ་ཉོན་ལ་\", \"tail\": \"ངས་ཁྱོད་ལ་བཤད་པར་བྱའོ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"མན་ངག་རིན་པོ་ཆེའི་མཛོད་ལས།\", \"head\": \"རྣ་བ་མི་གཏོད་ཁ་སྦུབ་\", \"tail\": \"ཉོན་མོངས་དང་འདྲེས་དུག་ཅན་ལྟ་བུའི་སྐྱོན། །\"}, {\"label\": \"QUOTE\", \"frame\": \"རྣམ་བཤད་རིག་པ་ལས།\", \"head\": \"ང་རྒྱལ་དང་ནི་མ་དད་\", \"tail\": \"སྐྱོ་བས་ཉན་པ་དྲི་མ་ཡིན། །\"}, {\"label\": \"QUOTE\", \"frame\": \"སྡོང་པོ་བཀོད་པ་ལས།\", \"head\": \"རིགས་ཀྱི་བུ་ཁྱོད་ཀྱིས་\", \"tail\": \"ནན་ཏན་ཉམས་སུ་ལེན་པ་ལ་ནད་ཉེ་བར་འཚོ་བའི་འདུ་ཤེས་བསྐྱེད་པར་བྱའོ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཡོན་ཏན་མཛོད་ལས།\", \"head\": \"མི་གཞི་ངན་པའི་ཟོལ་\", \"tail\": \"རྔོན་ལ་ཡང་དག་སྤྲོ་བའི་དམ་ཚིག་འཕེན། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཆོས་སྤྱོད་ཀྱི་མན་ངག་ལས།\", \"head\": \"མེ་ཏོག་སྟན་སོགས་རབ་\", \"tail\": \"ཉན་པོ་ཡན་ལག་དྲུག་དང་ལྡན། །\"}, {\"label\": \"QUOTE\", \"frame\": \"འདུལ་བ་ལུང་ལས།\", \"head\": \"མ་གུས་པ་ལ་ཆོས་མི་\", \"tail\": \"མགོ་བོ་གཡོགས་པ་དག་ལ་མིན། །\"}, {\"label\": \"QUOTE\", \"head\": \"འགྲེང་ཉལ་དམའ་བར་འདུག་\", \"tail\": \"དགྲ་ཆ་གོ་ཆ་གྱོན་པ་རྣམས་ལ་བཤད། །\"}, {\"label\": \"QUOTE\", \"frame\": \"མདོ་ལས།\", \"head\": \"ཇི་ལྟར་ཁྱིམ་ནི་ལེགས་\", \"tail\": \"མ་ཐོས་བར་དུ་ཤེས་མི་འགྱུར། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཆེད་དུ་བརྗོད་པའི་ཚོམས་ལས།\", \"head\": \"ཐོས་པས་ཆོས་རྣམས་ཤེས་\", \"tail\": \"ཐོས་པས་མྱ་ངན་འདས་པ་ཐོབ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"སྐྱེས་རབས་ལས།\", \"head\": \"ཐོས་པ་མ་རིག་མུན་སེལ་\", \"tail\": \"ཚོགས་ཀྱི་ནང་ན་མཁས་རྣམས་མགུ་བར་འགྱུར། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཆོས་ཀྱི་དབང་པོའི་ཞལ་སྔ་ནས།\", \"head\": \"ཐར་པ་མཐུན་པའི་ཚོགས་\", \"tail\": \"ཤེས་རབ་གསུམ་ལས་དང་པོ་ཐོས་པ་མཆོག །\"}, {\"label\": \"QUOTE\", \"frame\": \"མདོ་ལས།\", \"head\": \"དམ་ཆོས་ཉན་པའི་དུས་\", \"tail\": \"ཉན་རྣམས་ལྷག་པར་སྨོས་ཅི་དགོས། །\"}, {\"label\": \"QUOTE\", \"frame\": \"སོ་སོ་ཐར་པ་ལས།\", \"head\": \"མང་དུ་ཐོས་པ་ནགས་ཀྱི་\", \"tail\": \"ལང་ཚོ་ཡོལ་བ་རྣམས་ཀྱིས་གནས་པ་བདེ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"སྐྱེས་རབས་ལས།\", \"head\": \"ཐོས་པའི་རྗེས་སུ་སྒྲུབ་ལ་\", \"tail\": \"སྐྱེ་བའི་རྫོང་ལས་ཚེགས་ཆུང་ཐར་བར་འགྱུར། །\"}, {\"label\": \"QUOTE\", \"head\": \"ཀྱེ་ལགས་གསོན་དང་ཤེས་\", \"tail\": \"ཐར་པའི་ལམ་ལ་འདོད་དགུར་སྤྱོད་ཅིག་དགུ །\"}]}",
