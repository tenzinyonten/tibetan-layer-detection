  "raw_text": "{\"spans\": [{\"label\": \"QUOTE\", \"frame\": \"མདོ་ལས།\", \"head\": \"དད་པ་ནི་ཆོས་མཐའ་དག་\", \"tail\": \"སྒོར་འགྱུར་བར་གསུངས་པའི་ཕྱིར།\"}, {\"label\": \"QUOTE\", \"frame\": \"ཇི་སྐད་དུ།\", \"head\": \"རྡོ་རྗེ་འཆང་ཞེས་གསུངས་དེ་ཅི། །\", \"tail\": \"དེ་བཞིན་གཤེགས་པ་ཀུན་གྱི་བདག །\"}, {\"label\": \"QUOTE\", \"frame\": \"རྣམ་སྣང་མངོན་བང་ལས།\", \"head\": \"ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་འདི་ནི་སྙིང་རྗེ་ཆེན་པོའི་རྩ་བ་ཅན། བྱང་ཆུབ་ཀྱི་སེམས་ཀྱི་རྒྱུ་དང་ལྡན་པས་ཐབས་ཀྱི་མཐར་ཕྱིན་པའོ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"སངས་རྒྱས་ཕལ་པོ་ཆེ་ལས།\", \"head\": \"བྱང་ཆུབ་སེམས་ནི་སངས་རྒྱས་ཀྱི་ཆོས་ཐམས་ཅད་ཀྱི་ས་བོན་ལྟ་བུའོ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"མངོན་རྟོགས་རྒན་ལས།\", \"head\": \"སེམས་བསྐྱེད་པ་ནི་གཞན་དོན་ཕྱིར། །ཡང་དག་རྫོགས་པའི་བྱང་ཆུབ་འདོད། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"རྡོ་རྗེ་གཅོད་པ་ལས།\", \"head\": \"བསོད་ནམས་ཚོགས་ལྡན་གཟུགས་ཀྱི་སྐུ། །\", \"tail\": \"རྒྱུ་ཡི་དུས་སུ་འབྲས་བུའི་ཚོགས། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ལང་ཀའི་མདོ་ལས།\", \"head\": \"བྱང་ཆུབ་དང་ནི་མཚན་ཉིད་དང༌། །\", \"tail\": \"བཟློག་པས་མྱ་ངན་ང་མི་འདའ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"མཚན་བརྗོད་ལས།\", \"head\": \"སངས་རྒྱས་སྐུ་ལྔའི་བདག་ཉིད་ཅན། །ཁྱབ་བདག་ཡེ་ཤེས་ལྔ་ཡི་བདག །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"མངོན་རྟོགས་རྒྱན་ལས།\", \"head\": \"ངོ་བོ་ཉིད་ལོངས་རྫོགས་བཅས་དང༌། །\", \"tail\": \"རྣམ་པ་བཞིར་ནི་ཡང་དག་བརྗོད། །\"}, {\"label\": \"QUOTE\", \"frame\": \"གསང་འདུས་ལས།\", \"head\": \"རྫོགས་ལོངས་སྤྱོད་པའི་མཚན་ཉིད་ཅན། །\", \"tail\": \"སྐུ་གསུམ་ཐོབ་པར་གདོན་མི་ཟ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"རྒྱུད་བླ་མ་ལས།\", \"head\": \"འདུས་མ་བྱས་ཤིང་ལྷུན་གྱིས་གྲུབ། །\", \"tail\": \"དོན་གཉིས་ལྡན་པའི་སངས་རྒྱས་ཉིད། །\"}, {\"label\": \"QUOTE\", \"frame\": \"རྡོ་རྗེ་གཅོད་པ་ལས།\", \"head\": \"གང་དག་ང་ལ་གཟུགས་སུ་མཐོང༌། །\", \"tail\": \"ཆོས་ཉིད་དུ་ནི་ཡང་དག་ལྟོས། །\"}, {\"label\": \"QUOTE\", \"frame\": \"གསང་འདུས་ལས།\", \"head\": \"དངོས་པོ་ཐམས་ཅད་དང་བྲལ་བ། །\", \"tail\": \"སྟོང་པ་ཉིད་ཀྱི་རང་བཞིན་ནོ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"རྩ་རྒྱུད་ལེའུ་ལྔ་བཅུ་རྩ་གཅིག་པ་ལས།\", \"head\": \"མོས་པ་དུ་མའི་སེམས་ཅན་ལ། །\", \"tail\": \"ཐབས་ནི་སྣ་ཚོགས་སྟོན་པ་ཡིན། །\"}, {\"label\": \"QUOTE\", \"frame\": \"དུས་འཁོར་ལས།\", \"head\": \"དཔལ་ལྡན་དག་པ་ལས་ནི་ཆོས་ཀྱི་སྐུ། །\", \"tail\": \"སྐུ་ནི་ཡིན་ཏེ་སེམས་ཅན་རྣམས་ཀྱི་དོན་རྒྱུད་ལས། །\"}, {\"label\": \"QUOTE\", \"frame\": \"མདོ་སྡེ་རྒྱན་ལས།\", \"head\": \"སྐུ་གསུམ་དག་གི་སངས་རྒྱས་ཀྱིས། །\", \"tail\": \"དོན་འདི་རྟེན་དང་བཅས་པར་འདོད། །\"}, {\"label\": \"QUOTE\", \"frame\": \"གསང་འདུས་ལེའུ་བརྒྱད་པ་ལས།\", \"head\": \"མ་སྐྱེས་པ་ཡི་ཆོས་རྣམས་ནི། །\", \"tail\": \"ཡེ་ཤེས་འབྱུང་བར་རབ་ཏུ་བཤད། །\"}, {\"label\": \"QUOTE\", \"frame\": \"མདོ་སྡེ་རྒན་ལས།\", \"head\": \"སངས་རྒྱས་རྣམས་ཀྱི་སྐུ་དབྱེ་བ། །\", \"tail\": \"དང་པོ་གཉིས་པའི་རྟེན་ཡིན་ནོ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"མངོན་རྟོགས་རྒྱན་ལས།\", \"head\": \"མཚན་ནི་སུམ་ཅུ་རྩ་གཉིས་དང༌། །\", \"tail\": \"ཐུབ་པའི་ལོངས་སྤྱོད་རྫོགས་སྐུར་བཞེད། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཡང༌།\", \"head\": \"གང་གིས་སྲིད་པ་ཇི་སྲིད་བར། །\", \"tail\": \"ཐུབ་པའི་སྤྲུལ་སྐུ་རྒྱུན་མི་ཆད། །\"}, {\"label\": \"QUOTE\", \"frame\": \"མཚན་བརྗོད་ལས།\", \"head\": \"མཆོག་གི་དང་པོ་སྐུ་གསུམ་འཆང༌། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"གསང་འདུས་ལེའུ་བཅུ་པ་ལས།\", \"head\": \"ཁམས་གསུམ་སེམས་ཅན་སྒོ་གསུམ་རྡོ་རྗེ་འཆང༌། །\", \"tail\": \"སྐུ་གསུང་ཐུགས་འདུས་མཉམ་པ་ཉིད་དུ་བསྒོམ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ནམ་མཁའ་ཆེ་ལས།\", \"head\": \"འབྱུང་བ་ཆེན་པོ་བཅོམ་ལྡན་འདས། །\", \"tail\": \"འགྲོ་བ་ཀུན་ལ་རང་བཞིན་གནས། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ར་རྒྱུད་ལེའུ་བཅུ་པ་ལས།\", \"head\": \"ཆོས་ཀྱི་སྐུ་ཡི་ལུས་ཅན་ལས། །\", \"tail\": \"འགྲུབ་འགྱུར་འདི་ལ་ཐེ་ཚོམ་མེད། །\"}, {\"label\": \"QUOTE\", \"frame\": \"གསེར་འོད་དམ་པ་ལས།\", \"head\": \"བྱང་ཆུབ་སེམས་དཔའ་ནམ་མཁའི་སྙིང་པོས་གསོལ་པ། དེ་བཞིན་ཉིད་ཀྱི་ཡེ་ཤེས་ལ་རྣམ་པར་རྟོག་པ་མི་མངའ་བ་བཞིན་དུ་ཕྲིན་ལས་ལ་མངའ་བརྙེས་པ་ལགས་སམ། བཀའ་སྩལ་པ།དཔེར་ན་ཉི་ཟླ་དང་ཆུ་དང་མེ་ལོང་ལས་རྟོག་པ་མེད་བཞིན་དུ་གཟུགས་བརྙན་འབྱུང་བ་བཞིན་དུ། དེ་བཞིན་ཉིད་ཀྱི་ཡེ་ཤེས་ལ་རྟོག་པ་མེད་ཀྱང༌། སྨོན་ལམ་གྱི་དབང་གིས་སེམས་ཅན་སྐལ་བ་ཅན་དག་ལ་གཟུགས་ཀྱི་སྐུ་གཉིས་ཀྱིས་དོན་བྱེད་དོ། །སྤྲུལ་པའི་སྐུ་ནི་ཕུང་པོ་ལྷག་མར་བཅས་པའི་མྱ་ངན་ལས་འདའ་བའོ། །ཆོས་ཀྱི་སྐུ་ནི་མི་གནས་པའི་མྱ་ངན་ལས་འདས་པའོ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཕལ་པོ་ཆེ་ལས།\", \"head\": \"ཡིད་བཞིན་ནོར་བུའི་རྒྱལ་པོ་ནི། །\", \"tail\": \"ཕྱོགས་བཅུ་དེ་དག་རྒྱལ་བས་གང༌། །\"}, {\"label\": \"QUOTE\", \"frame\": \"གསང་འདུས་ལས།\", \"head\": \"ལོངས་སྤྱོད་རྫོགས་དང་ཁ་སྦྱོར་བདེ་ཆེན་རང་བཞིན་མེད། །སྙིང་རྗེ་ཆེན་པོས་ཡོངས་གང་རྒྱུན་མི་ཆད་དང་འགོག་པ་མེད། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"རྣམ་སྣང་མངོན་བང་ལས།\", \"head\": \"སངས་རྒྱས་ཀུན་གྱི་ཏིང་འཛིན་ནི། །\", \"tail\": \"ཐོབ་པར་འགྱུར་གྱི་གཞན་ལ་མིན། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ས་བཅུ་པའི་མདོ་ལས།\", \"head\": \"བསྐྱེད་པའི་རིམ་པ་ལྷ་གསལ་ན། །\", \"tail\": \"ཡེ་ཤེས་ཚོགས་ཀྱང་རྫོགས་པར་བཤད། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ལུང་ལས།\", \"head\": \"སངས་རྒྱས་རྣམས་ཀྱི་གཟུགས་ཀྱི་སྐུ། །\", \"tail\": \"དེ་ཡང་ཡང་དང་ཡང་དུ་བསག །\"}, {\"label\": \"QUOTE\", \"frame\": \"གསེར་འོད་དམ་པ་ལས།\", \"head\": \"རིགས་ཀྱི་བུ་སྤྲུལ་པའི་སྐུ་ནི་ལོངས་སྤྱོད་རྫོགས་པའི་སྐུ་ལ་བརྟེན་ཏེ་མངོན་པར་སྣང་ངོ༌། །ལོངས་སྤྱོད་རྫོགས་པའི་སྐུ་ནི་ཡང་དག་པ་སྟེ་ཅི་ལ་ཡང་མི་གནས་པའོ། །\", \"tail\": \"\"}, {\"label\": \"ཀླུ་སྒྲུབ་ཀྱི་ཞལ་ནས།\", \"head\": \"འཁོར་བ་དང་ནི་མྱ་ངན་འདས། །\", \"tail\": \"ཟུང་དུ་འཇུག་ཅེས་དེ་ལ་བཤད། །\"}, {\"label\": \"QUOTE\", \"frame\": \"པུཎྜ་རི་ཀའི་མདོ་ལས།\", \"head\": \"འཇིག་རྟེན་གྱི་ཁམས་གང་གཱའི་ཀླུང་གི་བྱེ་མ་སྙེད་ཕྲག་དགུའི་འཇིག་རྟེན་གྱི་ཁམས་རེ་རེ་ན་ཡང་ཐུགས་རྗེ་ཆེན་པོ་སྟོང་རྩ་གཉིས་སུ་སྤྲུལ་ནས་སེམས་ཅན་གྱི་དོན་མཛད་པར་བཤད་དོ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"མདོ་སྡེ་རྒྱན་ལས།\", \"head\": \"ཡོན་ཏན་མི་ཟད་མཉམ་མེད་ལྡན། །\", \"tail\": \"སྣང་བ་ཀུན་ཏུ་མི་མཐོང་ངོ༌། །\"}, {\"label\": \"QUOTE\", \"frame\": \"མངོན་རྟོགས་རྒྱན་ལས།\", \"head\": \"ལྷ་ཡི་རྒྱལ་པོས་ཆར་ཕབ་ཀྱང༌། །\", \"tail\": \"སྐལ་བ་མེད་པས་བཟང་མི་མྱོང༌། །\"}]}",
