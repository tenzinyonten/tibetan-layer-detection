  "raw_text": "{\"spans\": [{\"label\": \"QUOTE\", \"frame\": \"གསེར་འོད་དམ་པ་ལས།\", \"head\": \"རིགས་ཀྱི་བུ་སྤྲུལ་པའི་སྐུ་ནི་ལོངས་སྤྱོད་རྫོགས་པའི་སྐུ་ལ་བརྟེན་ཏེ་མངོན་པར་སྣང་ངོ༌། །ལོངས་སྤྱོད་རྫོགས་པའི་སྐུ་ནི་\", \"tail\": \"ཡང་དག་པ་སྟེ་ཅི་ལ་ཡང་མི་གནས་པའོ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"དེ་ཡང་སློབ་དཔོན་ཀླུ་སྒྲུབ་ཀྱི་ཞལ་ནས།\", \"head\": \"འཁོར་བ་དང་ནི་མྱ་ངན་འདས། ། རྟོག་པ་གཉིས་པོ་སྤངས་པར་ན། ། གང་དུ་དངོས་པོ་གཅིག་གྱུར་པས། ། ཟུང་དུ་འཇུག་ཅེས་དེ་ལ་བཤད། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"དེ་ཡང་པུཎྜ་རི་ཀའི་མདོ་ལས།\", \"head\": \"འཇིག་རྟེན་གྱི་ཁམས་གངྒཱའི་ཀླུང་གི་བྱེ་མ་སྙེད་ཕྲག་དགུའི་འཇིག་རྟེན་གྱི་ཁམས་རེ་རེ་ན་ཡང་ཐུགས་རྗེ་ཆེན་པོ་སྟོང་རྩ་གཉིས་སུ་སྤྲུལ་ནས་\", \"tail\": \"སེམས་ཅན་གྱི་དོན་མཛད་པར་བཤད་དོ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"མདོ་སྡེ་རྒྱན་ལས།\", \"head\": \"ཡོན་ཏན་མི་ཟད་མཉམ་མེད་ལྡན། །འཇིག་རྟེན་དག་དང་དཀྱིལ་འཁོར་དུ། །སྣང་བ་ལྷ་དང་མི་རྣམས་ཀྱང༌། །སྣང་བ་ཀུན་ཏུ་མི་མཐོང་ངོ༌། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"མངོན་རྟོགས་རྒྱན་ལས།\", \"head\": \"ལྷ་ཡི་རྒྱལ་པོས་ཆར་ཕབ་ཀྱང༌། །ས་བོན་མི་རུང་མི་འཁྲུངས་ལྟར། །སངས་རྒྱས་རྣམས་ནི་བྱོན་གྱུར་ཀྱང༌། །སྐལ་བ་མེད་པས་བཟང་མི་མྱོང༌། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ལང་ཀར་གཤེགས་པ་ལས།\", \"head\": \"རྫོགས་པའི་སངས་རྒྱས་དེར་སངས་རྒྱས། །སྤྲུལ་པ་གཅིག་པོ་འདིར་སངས་རྒྱས། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"དེ་ཉིད་བསྡུས་པ་ལས།\", \"head\": \"ཆུ་བོ་ནཻརཉྫནའི་འགྲམ་དུ་དཀའ་ཐུབ་མཛད་པའི་དུས་སུ་དེ་བཞིན་གཤེགས་པ་ཏིལ་གྱི་གོང་བུ་ཙམ་འཇིག་རྟེན་དུ་ལྷགས་ནས། རྡོ་རྗེ་དབྱིངས་ཞེས་བྱ་བའི་མིང་གི་དབང་བསྐུར་ནས། ལྷའི་གནས་སུ་\", \"tail\": \"སེང་གེའི་ཁྲི་ལ་ཞལ་ཀུན་ཏུ་བསྟན་ནས་བཞག་གོ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"དེ་ཡང་སམྦུ་ཊི་ལས།\", \"head\": \"སྟོང་པའི་རྡོ་རྗེ་ཅན་གཅིག་ནི། །རིགས་ནི་རྣམ་པ་ལ་རུ་འགྱུར། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"རྡོ་རྗེ་རྩེ་མོ་ལས།\", \"head\": \"རྡོ་རྗེ་འཆང་ཞེས་གསུངས་པ་ཅི། །སངས་རྒྱས་ཀུན་གྱི་ཡེ་ཤེས་དང༌། །བྱང་ཆུབ་སེམས་ལྡན་གང་ཡིན་པ། །དེ་ཉིད་རྒྱལ་བ་རྡོ་རྗེ་འཆང༌། །དེ་བཞིན་གཤེགས་པ་ཀུན་གྱི་བདག །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"དེ་ཉིད་ལས།\", \"head\": \"རྡོ་རྗེ་འཆང་བ་རྣམས་ཉིད་དུ། །ཕྱོགས་རྣམས་ཀུན་ཏུ་ཡོངས་ཁྱབ་པའི། །བྱང་ཆུབ་སེམས་དཔའ་མཁས་པ་ནི། །ཆོས་དབྱིངས་དང་མཉམ་ཐུག་པ་མེད། །རྡོ་རྗེ་འཆང་རྣམས་དེ་ཉིད་དོ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"གུར་ལས།\", \"head\": \"གང་ཕྱིར་རྡོ་རྗེ་སེམས་དཔའ་ཞེས། །དེ་ཉིད་སློབ་དཔོན་གཟུགས་བཟུང་སྟེ། །སེམས་ཅན་ཕན་བཏགས་དམིགས་ནས་ནི། །ཐ་མལ་པ་ཡི་གཟུགས་སུ་གནས། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"བརྟག་གཉིས་ལས།\", \"head\": \"འཆད་པ་པོ་ང་ཆོས་ཀྱང་ང༌། །རང་གི་ཚོགས་ལྡན་ཉན་པ་ང༌། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"མཚན་བརྗོད་ལས།\", \"head\": \"ཐེག་པ་གསུམ་གྱི་ངེས་འབྱུང་ལ། །ཐེག་པ་གཅིག་གི་འབྲས་བུར་གནས། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཡེ་ཤེས་གྲགས་པའི་དེ་ཁོ་ན་ཉིད་འཇུག་པ་ལས།\", \"head\": \"ཆོས་དབྱིངས་དབྱེ་བ་མ་མཆིས་པས། །གཙོ་བོ་ཐེག་དབྱེ་ཡོད་མིན་གྱི། །ཁྱེད་ཀྱིས་ཐེག་པ་གསུམ་གསུངས་པ། །སེམས་ཅན་རྣམས་ནི་འཇུག་ཕྱིར་རོ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"སངས་རྒྱས་མཉམ་སྦྱོར་ལས།\", \"head\": \"བསྐལ་པ་བྱེ་བར་རྙེད་དཀའ་བའི། །སངས་རྒྱས་ཉིད་ཀྱང་བརྩོན་ལྡན་ལ། །ཚེ་འདི་ཉིད་ལ་སྟེར་བས་ན། །འབྲས་བུ་ཅན་གྱི་མིང་ནས་བོས། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"མདོ་མྱ་ངན་འདས་པ་ལས།\", \"head\": \"སངས་རྒྱས་མྱ་ངན་མི་འདའ་ཞིང༌། །ཆོས་ཀྱང་ནུབ་པར་མི་འགྱུར་རོ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཕྲིན་ལས་རྫོགས་པའི་རྒྱུད་ལས།\", \"head\": \"སངས་རྒྱས་ནི་རྒྱུའི་མཚན་ཉིད་ཡིན་ཏེ། རྟེན་ཅིང་འབྲེལ་བར་འབྱུང་བ་ཡིན་པའི་ཕྱིར་རོ། །ས་བོན་ལས་མྱུ་གུ་སྐྱེ་བ་བཞིན་ནོ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"སྙིང་རྗེ་ཆེན་པོ་པདྨ་དཀར་པོ་ལས།\", \"head\": \"ཆུའི་ཕུང་པོའི་ནང་ནས་ཡར་ལ་པདྨའི་སྡོང་པོ་སྟོང་རྩ་གཉིས་འབྱུང་སྟེ། དེ་ལ་གཟུགས་ཁམས་ཀྱི་ལྷ་རྣམས་ཀྱིས་བསྐལ་པ་འདི་ནི་བཟང་པོའོ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"པུཎྜ་རི་ཀའི་མདོ་ལས།\", \"head\": \"འཇིག་རྟེན་གྱི་ཁམས་གངྒཱའི་ཀླུང་གི་བྱེ་མ་སྙེད་ཕྲག་དགུའི་འཇིག་རྟེན་གྱི་ཁམས་རེ་རེ་ན་ཡང༌། ཐུགས་རྗེ་ཆེན་པོ་སངས་རྒྱས་སྟོང་རྩ་གཉིས་སུ་སྤྲུལ་ནས་སེམས་ཅན་གྱི་དོན་མཛད་པར་བཤད་དོ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"སྙིང་རྗེ་རྣམ་པར་རོལ་པ་སངས་རྒྱས་པའི་མདོ་ལས།\", \"head\": \"སྟོང་གསུམ་མི་མཇེད་འཇིག་རྟེན་གྱི་ཁམས་འཛམ་བུ་གླིང་བྱེ་བ་ཕྲག་བརྒྱར། རྒྱལ་བ་ཤཱཀྱ་ཐུབ་པ་བྱེ་བ་ཕྲག་བརྒྱར་མངོན་པར་རྫོགས་པར་སངས་རྒྱས་བར་ནས་སེམས་ཅན་གྱི་དོན་མཛད་དོ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཡབ་སྲས་མཇལ་བ་ལས།\", \"head\": \"བརྒྱ་བྱིན་ཚངས་པའི་ཆ་བྱད་དང༌། །ལ་ལར་བདུད་ཀྱི་ཆ་བྱད་ཀྱིས། །སེམས་ཅན་རྣམས་ཀྱི་དོན་མཛད་དེ། །འཇིག་རྟེན་ཁམས་ཀྱིས་རྟོགས་མི་ནུས། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"མདོ་སྡེ་རྒྱན་ལས།\", \"head\": \"བཟོ་དང་སྐྱེ་དང་བྱང་ཆུབ་ཆེ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"མདོ་རྒྱ་ཆེར་རོལ་པ་ལས།\", \"head\": \"དགའ་ལྡན་གནས་ནས་འཕོ་བ་དང༌། །ལྷུམས་སུ་ཞུགས་ཏེ་བལྟམས་པ་དང༌། །བཟོ་ཡི་གནས་ལ་མཁས་པ་དང༌། །གཞོན་ནུ་རོལ་རྩེད་མཛད་པ་དང༌། །བཙུན་མོའི་འཁོར་གྱིས་བསྐོར་བ་དང༌། །ངེས་འབྱུང་དཀའ་བ་སྤྱད་པ་དང༌། །བྱང་ཆུབ་སྙིང་པོར་གཤེགས་པ་དང༌། །བདུད་སྡེ་འཇོམས་མཛད་སངས་རྒྱས་དང༌། །ཆོས་འཁོར་མྱ་ངན་འདའ་སྟོན་དང༌། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"སམྦུ་ཊི་ལས།\", \"head\": \"ཟླ་བ་བཅུ་ནི་ས་རྣམས་ཉིད། །སེམས་ཅན་ས་བཅུའི་དབང་ཕྱུག་གོ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཡབ་སྲས་མཇལ་བ་ལས།\", \"head\": \"བུད་མེད་ཆ་བྱད་སྤྱོད་པ་མཛད། །དུད་འགྲོའི་སྐྱེ་གནས་རྣམས་ནའང་གདའ། །འཇིག་རྟེན་ཆོས་ཀྱིས་མ་གོས་ཏེ། །པདྨོ་ཆུ་ཡིས་མ་ཆགས་བཞིན། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"སྡོམ་པ་འབྱུང་བ་ལས།\", \"head\": \"བླ་མ་སངས་རྒྱས་བླ་མ་ཆོས། །དེ་བཞིན་བླ་མ་དགེ་འདུན་ཏེ། །བླ་མ་དམ་པ་མཆོག་ཉིད་ལ། །བདག་ཉིད་གུས་པས་ཕྱག་འཚལ་ལོ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཨཱརྱ་དེ་ཝའི་སྤྱོད་བསྡུས་ལས།\", \"head\": \"ཇི་ལྟར་ཕྱོགས་བཅུར་བཞུགས་པའི་རྒྱལ་དབང་པོ། །དེ་ཡི་སྐུ་ལ་ཤ་རུས་རྐང་མེད་ཀྱང༌། །སེམས་ཅན་ཕན་ཕྱིར་ཁམས་ལ་འཇུག་མཛད་ཅིང༌། །སྤྲུལ་པའི་སྐུ་ཡི་བྱ་བ་མཛད་པ་ཡིན། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ལུང་ལས།\", \"head\": \"ཇི་སྲིད་ནམ་མཁའ་གནས་ཀྱི་བར། །གཞན་དོན་འཁོར་བར་འཁོར་བྱེད་ཀྱང༌། །སྙིང་རྗེ་ཅན་རྣམས་ཅི་སྟེ་སྐྱོ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"རྡོ་རྗེ་ཨ་རལླིའི་རྒྱུད་ལས།\", \"head\": \"རྒྱུ་དང་འབྲས་བུའི་ཁྱད་པར་གྱིས། །ཕ་རོལ་ཕྱིན་པའི་ཐེག་པ་དང༌། །སྔགས་ཀྱི་ཐེག་པ་གཉིས་སུ་གསུངས། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཕྱི་རྒྱུད་ས་གསུམ་ལས།\", \"head\": \"བདེ་གཤེགས་སློབ་མར་གྱུར་པའི་འགྲོ་དྲུག་དག །འཇིག་རྟེན་ཁམས་ན་གནས་པ་ཀུན་ཉོན་ཅིག །དེང་འདིར་སྟོན་པས་ཆོས་ཀྱི་ཆར་འབེབས་ཀྱིས། །གང་ཟག་མ་ལུས་པར་ནི་འདིར་གཤེགས་ཤིག །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"བཟང་སྤྱོད་ལས་ཀྱང༌།\", \"head\": \"ལྷ་ཡི་སྐད་དང་ཀླུ་དང་གནོད་སྦྱིན་སྐད། །གྲུལ་བུམ་དག་དང་མི་ཡི་སྐད་རྣམས་དང༌། །འགྲོ་བ་ཀུན་གྱི་སྒྲ་སྐད་ཇི་ཙམ་པར། །ཐམས་ཅད་སྐད་དུ་བདག་གིས་ཆོས་བསྟན་ཏོ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"གསེར་འོད་དམ་པ་ལས།\", \"head\": \"སངས་རྒྱས་མྱ་ངན་མི་འདའ་ཞིང༌། །ཆོས་ཀྱང་ནུབ་པར་མི་འགྱུར་ཏེ། །སེམས་ཅན་རྣམས་ལ་ཕན་གདགས་ཕྱིར། །རྒྱལ་བ་མྱ་ངན་འདའ་ཚུལ་བསྟན། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"བསིལ་བའི་ཚལ་གྱི་མདོ་ལས།\", \"head\": \"མང་དུ་ཐོས་ཤིང་གསང་སྔགས་འཆང༌། །ཀུན་དགའ་བོ་ལ་ཕྱག་འཚལ་ལོ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"མདོ་སྡེ་གསུང་བཀོད་པ་ལས་གསུངས་ཏེ།\", \"head\": \"ང་ནི་འདི་ནས་མི་སྣང་ནས། །ལོ་ནི་བརྒྱ་དང་བཅུ་གཉིས་ན། །ལྷོ་ཕྱོགས་དཔལ་གྱི་རི་བོ་ལ། །ས་ར་ཧ་ཞེས་བྱ་བ་ཡིས། །སྙིང་པོ་དོན་གྱི་བསྟན་པ་འཛིན། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"མདོ་སྡེ་ལང་ཀར་གཤེགས་པ་ལས།\", \"head\": \"ང་ནི་མྱ་ངན་འདས་འོག་ཏུ། །ལོ་ནི་བཞི་བརྒྱ་ལོན་པ་ན། །ལྷོ་ཕྱོགས་བྷ་ག་ལ་ཞེས་བྱར། །དགེ་སློང་ཀླུ་སྒྲུབ་ཅེས་བྱ་འབྱུང༌། །ཡོད་དང་མེད་པའི་ཕྱོགས་སྤངས་པའི། །དེ་ཡིས་ང་ཡི་བསྟན་པ་འཛིན། །\", \"tail\": \"\"}]}",
