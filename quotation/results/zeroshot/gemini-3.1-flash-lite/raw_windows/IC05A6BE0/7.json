  "raw_text": "{\"spans\": [{\"label\": \"QUOTE\", \"frame\": \"ཏིང་འཛིན་རྒྱལ་པོ་ལས།\", \"head\": \"ཏིང་འཛིན་རྒྱལ་པོ་སྟོང་པ་འདི་བསྒོམ་པས། །\", \"tail\": \"བྱིས་པ་མི་རིག་བརྩོན་པ་མི་ཤེས་སོ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"འཇིག་རྟེན་མགོན་པོའི་ཞལ་སྔ་ནས་ཀྱང༌།\", \"head\": \"བུ་དང་འདྲ་བའི་སློབ་མ་རྣམས། །\", \"tail\": \"སྙིང་གཏམ་ཁ་ཆེམས་འདི་ལས་མེད། །\"}, {\"label\": \"QUOTE\", \"head\": \"ཚུལ་ཁྲིམས་ཉིད་ལས་གཞན་པའི་སྟོང་པ་ཉིད། །\", \"tail\": \"འཇིག་རྟེན་མགོན་པོས་གསུངས་ཏེ་ང་འདིར་ཤི། །\"}, {\"label\": \"QUOTE\", \"head\": \"ཕྱག་རྒྱ་ཆེན་པོ་ནམ་མཁའ་ཡངས་པ་ལ། །\", \"tail\": \"མཐོང་དང་བསྒོམ་པས་སྤོང་བར་མི་འགྱུར་\"}, {\"label\": \"QUOTE\", \"frame\": \"དེ་ཡང༌།\", \"head\": \"ཕ་ཡུལ་རི་ཁྲོད་དབེན་གནས་ཡིན། །\", \"tail\": \"དགྲ་མགོ་ཡན་དུ་མི་གཏང་འཚལ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"རྒྱུད་ལས།\", \"head\": \"རིན་ཆེན་སེམས་ལས་ཕྱིར་གྱུར་པའི། །\", \"tail\": \"སངས་རྒྱས་མེད་ཅིང་སེམས་ཅན་མེད། །\"}, {\"label\": \"QUOTE\", \"frame\": \"སྡུད་པ་ལས།\", \"head\": \"ཕ་རོལ་ཕྱིན་ལྔ་བྱང་ཆུབ་ཡོན་ཏན་ཇི་སྙེད་པ། །\", \"tail\": \"དེ་དག་ཀུན་ཀྱང་ཤེས་རབ་ཕ་རོལ་ཕྱིན་ལས་སྐྱེས། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཞི་བ་ལྷས།\", \"head\": \"ཞི་གནས་རབ་ཏུ་ལྡན་པའི་ལྷག་མཐོང་གིས། །\", \"tail\": \"འཇིག་རྟེན་ཆགས་པ་མེད་ལ་མངོན་དགས་འགྲུབ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཀླུ་སྒྲུབ་ཀྱིས།\", \"head\": \"ཤེས་རབ་མེད་པར་བསམ་གཏན་ཡོད་མིན་ཏེ། །\", \"tail\": \"རྒྱ་མཚོ་གནག་རྗེས་ལྟ་བུ་བཙལ་བར་བགྱི། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཇི་སྐད་དུ།\", \"head\": \"ཇི་སྲིད་ཚོགས་གཉིས་དམ་པ་མ་བསགས་པར། །\", \"tail\": \"དེ་སྲིད་སྐུ་གཉིས་དམ་པ་ཐོབ་མི་འགྱུར། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ལྗོན་པས་ཞུས་པའི་མདོ་ལས།\", \"head\": \"རྒྱུ་ལ་བརྟེན་པའི་མཁས་པ་བཅོམ་ལྡན་འདས། །\", \"tail\": \"ལྟ་བའི་མུན་བྲལ་ཁྱོད་ལ་ཕྱག་འཚལ་ལོ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཏིང་འཛིན་རྒྱལ་པོ་ལས།\", \"head\": \"ཆོས་ཉིད་ལས་ཀྱི་རྣམ་སྨིན་མེད་ཤེས་ཀྱང༌། །\", \"tail\": \"དགེ་དང་མི་དགེ་ལས་ནི་ཆུད་མི་ཟ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"མདོ་ལས།\", \"head\": \"སྟོང་ཉིད་གང་ཤེས་དེ་ནི་བག་ཡོད་པའོ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"བྱང་ཆུབ་སེམས་འགྲེལ་ལས།\", \"head\": \"ཆོས་རྣམས་སྟོང་པ་ཉིད་ཤེས་ནས། །\", \"tail\": \"རྨད་བྱུང་བས་ཀྱང་འདི་རྨད་བྱུང༌། །\"}, {\"label\": \"QUOTE\", \"frame\": \"རྗེ་མི་ལས། རྗེ་སྒམ་པོ་པ་ལ།\", \"head\": \"ཡར་སངས་རྒྱས་ལ་རེ་བ་མེད་ཀྱང་དཀར་པོའི་ཆོས་སྤྱོད་རྒྱུན་མི་བཅད།\", \"tail\": \"མར་ངན་སོང་ལ་དོགས་པ་མེད་ཀྱང་སྡིག་པ་ཕྲ་བ་ནས་འཛེམ།\"}, {\"label\": \"QUOTE\", \"frame\": \"ཇོ་བོ་རྗེས།\", \"head\": \"སྟོང་ཉིད་རྟོགས་ན་ལས་རྒྱུ་འབྲས་ལ་འཛེམ་དུ་འགྲོ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"དྭགས་པོས།\", \"head\": \"ང་ལ་རྣལ་འབྱོར་བ་ཟེར་ཏེ། ང་ནི་ལས་རྒྱུ་འབྲས་ལ་ཤིན་ཏུ་འཛེམས་པ་ཡིན། ངའི་བླ་མ་རྣམས་ཀྱི་གདམ་ངག་ཡིན།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཕག་མོ་གྲུ་བས།\", \"head\": \"ཁ་ལྟ་རྐྱང་པ་མ་སོང་ཞིང༌། །\", \"tail\": \"བུ་རྒྱུ་འབྲས་མངོན་དུ་གྱུར་པ་ཡིན། །\"}, {\"label\": \"QUOTE\", \"frame\": \"འཇིག་རྟེན་མགོན་པོས།\", \"head\": \"སྟོང་ཉིད་རྟོགས་པའི་ཤེས་རབ་ལ། །\", \"tail\": \"རྒྱུ་འབྲས་མངོན་དུ་གྱུར་གསོལ་ལོ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཨོ་རྒྱན་རྡོ་རྗེ་འཆང་གིས།\", \"head\": \"ང་ལྟ་བ་ནམ་མཁའ་བས་ཀྱང་མཐོ། །\", \"tail\": \"ལས་རྒྱུ་འབྲས་བག་ཕྱེ་བས་ཀྱང་ཞིབ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"རྒྱལ་བའི་དབང་པོ་ཀློང་ཆེན་པས།\", \"head\": \"སངས་རྒྱས་འདོད་ལ་གཅེས་པ་རྣམ་དྲུག་ནི། །\", \"tail\": \"མཐོན་པོར་ཕྱིན་ཡང་འདི་དྲུག་མ་འབྲལ་གཅེས། །\"}, {\"label\": \"QUOTE\", \"frame\": \"མགོན་པོ་བྱམས་པས།\", \"head\": \"མགོ་ལ་སེམས་ཅན་ཁུར་ཆེན་ཁུར་བ་ཡིས། །\", \"tail\": \"བརྩོན་པ་བརྒྱ་འགྱུར་དུ་ནི་བྱ་བ་རིགས། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཀླུ་སྒྲུབ་ཀྱིས།\", \"head\": \"དེ་ལྟར་རྣལ་འབྱོར་པ་རྣམས་ཀྱིས། །\", \"tail\": \"འགྱུར་བ་ཉིད་དུ་ཐེ་ཚོམ་མེད། །\"}, {\"label\": \"QUOTE\", \"frame\": \"མདོ་ལས།\", \"head\": \"སྐྱེ་བ་མེད་པ་བདེན་པ་གཅིག་ཡིན་ན། །\", \"tail\": \"གྲུབ་པར་མ་མཐོང་བཞི་ལྟ་གང་ལ་ཞིག །\"}, {\"label\": \"QUOTE\", \"frame\": \"རྒྱུད་ལས།\", \"head\": \"ཀུན་རྫོབ་དང་ནི་དོན་དམ་དག །\", \"tail\": \"དེ་ནི་ཟུང་དུ་འཇུག་པར་བཤད། །\"}, {\"label\": \"QUOTE\", \"frame\": \"སྒྱུ་འཕྲུལ་དྲྭ་བ་ཆེན་པོ་ལས།\", \"head\": \"ཀུན་ཤེས་ཀུན་རིག་དམ་པ་པོ། །\", \"tail\": \"རྣམ་པར་རྟོག་མེད་ལྷུན་གྱིས་གྲུབ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཡེ་ཤེས་སྣང་བ་རྒྱན་གྱི་མདོ་ལས།\", \"head\": \"ཆོས་ཀུན་སྒྱུ་མ་ཐུགས་སུ་ཆུད། །\", \"tail\": \"མི་བརྟེན་ཁྱོད་ལ་ཕྱག་འཚལ་ལོ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"མདོ་ལས།\", \"head\": \"གླང་ཆེན་བཞུགས་ཀྱང་མཉམ་པར་བཞག །\", \"tail\": \"གླང་ཆེན་གཤེགས་ཀྱང་མཉམ་པར་བཞག །\"}, {\"label\": \"QUOTE\", \"frame\": \"རྒྱུད་ལས།\", \"head\": \"སངས་རྒྱས་ཀྱིས་གང་གསུང་པ་ནི་དེ་བཞིན་ཏེ།\", \"tail\": \"དེས་ན་མི་བསླུ་བའོ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"མདོ་ལས།\", \"head\": \"བཅོམ་ལྡན་འདས་སེམས་དང་ཡིད་དང་\", \"tail\": \"རྣམ་པར་ཤེས་པ་དང་བྲལ་ལ་ཏིང་ངེ་འཛིན་གྱི་གནས་ཀྱང་མི་འདོར་རོ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"བྱམས་པས།\", \"head\": \"མཁྱེན་པའི་ཡེ་ཤེས་སྐད་ཅིག་གིས། །\", \"tail\": \"ཤེས་བྱའི་དཀྱིལ་འཁོར་ཀུན་ཁྱབ་ཅན། །\"}, {\"label\": \"QUOTE\", \"frame\": \"སློབ་དཔོན་དཔའ་བོས།\", \"head\": \"རྣམ་རྟོག་མི་མངའ་ཅི་ཡང་ས་ལེར་མཁྱེན། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཇི་སྐད་དུ།\", \"head\": \"ནམ་མཁའ་ཇི་སྙེད་ཁྱབ་གྱུར་ཀྱང༌། །\", \"tail\": \"ཐུགས་ཀྱིས་ཀྱང་ནི་དེ་སྙེད་ཁྱབ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"རྒྱུད་བླ་མ་ལས།\", \"head\": \"ཇི་ལྟར་སྤྲིན་མེད་མཁའ་ཡི་ཟླ་བའི་གཟུགས། །\", \"tail\": \"རྫོགས་སངས་དཀྱིལ་འཁོར་ནང་དུ་མཐོང་བར་འགྱུར། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཀླུ་སྒྲུབ་ཀྱིས།\", \"head\": \"བྱང་ཆུབ་སེམས་ཀྱི་རང་བཞིན་སྐུ། །\", \"tail\": \"དཔལ་ལྡན་རྡོ་རྗེ་འཆང་ལ་འདུད། །\"}, {\"label\": \"QUOTE\", \"frame\": \"བྱམས་པས།\", \"head\": \"སེམས་བསྐྱེད་དེ་ནི་ས་རྣམས་ལ། །\", \"tail\": \"དེ་བཞིན་སྒྲིབ་པ་སྤང་པའོ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཡབ་སྲས་མཇལ་བའི་མདོ་ལས།\", \"head\": \"དཔའ་བོ་ཆེན་པོ་ཐབས་མཁས་ཏེ། །\", \"tail\": \"སངས་རྒྱས་མང་པོ་སྟོན་པར་མཛད། །\"}, {\"label\": \"QUOTE\", \"frame\": \"བཤད་རྒྱུད་གཉིས་མེད་རྣམ་རྒྱལ་ལས།\", \"head\": \"སྣ་ཚོགས་སེམས་ཅན་འདུལ་དོན་དུ། །\", \"tail\": \"དེ་ཕྱིར་ཕྲིན་ལས་རྒྱུན་མི་འཆད། །\"}, {\"label\": \"QUOTE\", \"frame\": \"མྱང་འདས་ལས།\", \"head\": \"ལོང་བ་མ་ལགས་ལོང་བ་ལྟར། །\", \"tail\": \"འཇིག་རྟེན་རྣམས་ཀྱིས་རྟོགས་མི་ནུས། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཇི་སྐད་དུ།\", \"head\": \"གང་གི་རང་བཞིན་ཆགས་སྡང་རྣམ་བྲལ་ཡང༌། །\", \"tail\": \"བྱང་ཆུབ་མཆོག་གནས་དེ་ལ་ཕྱག་འཚལ་ལོ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"མདོ་ལས།\", \"head\": \"འཇམ་དཔལ་སངས་རྒྱས་ཀྱི་ཞིང་འདི་ན་གཞན་མུ་སྟེགས་ཅན་དང༌། སྤྱོད་པ་དང༌།\", \"tail\": \"ཐབས་མཁས་ཀྱི་ཡུལ་བསམ་གྱིས་མི་ཁྱབ་པ་ཡིན་པར་རིག་པར་བྱའོ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"འཕགས་པ་སྡུད་པ་ལས།\", \"head\": \"རྒྱལ་བའི་ཉན་ཐོས་པ་དག་ཇི་སྙེད་ཆོས་སྟོན་དང༌། །\", \"tail\": \"དེ་དག་ཀུན་ཀྱང་དེ་བཞིན་གཤེགས་པའི་སྐྱེས་བུའི་མཐུ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"རྒྱུད་གསང་བའི་སྙིང་པོ་ལས།\", \"head\": \"སྲིད་གསུམ་ཡེ་ནས་སངས་རྒྱས་ཞིང༌། །\", \"tail\": \"སངས་རྒྱས་ཉིད་ལས་གཞན་པའི་ཆོས། །སངས་རྒྱས་ཉིད་ཀྱིས་མི་བརྙེས་སོ། །\"}]}",
