head\": \"ཇི་ལྟར་ཞེ་ན་ད་ལྟའི་རྟོགས་ལྡན་པ། །\", \"tail\": \"འབད་པས་ཉོ་བ་འདི་རྣམས་མ་མཐོང་ངམ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"སྒོང་(རྒོད་)་ཚང་སྣ་ཚོགས་རང་གྲོལ་གྱིས།\", \"head\": \"བདེ་གསལ་མི་རྟོག་ལ་སོགས་དང༌། །\", \"tail\": \"སྒོམ་ཆེན་བསླུས་པ་མང་བར་མཐོང༌། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཕག་མོ་གྲུ་བས།\", \"head\": \"ནུས་མཐུ་ཆེ་བའི་གང་ཟག་དེ། །\", \"tail\": \"འདྲེ་རྒྱལ་འགོང་གི་འགུགས་ཁྲིད་བྱེད་པ་ཡིན། །\"}, {\"label\": \"QUOTE\", \"frame\": \"རིག་འཛིན་ཆོས་གྲགས་ཀྱིས།\", \"head\": \"རང་ཉིད་ལོག་འཁྲུལ་ལམ་དུ་ཞུགས་ཟིན་ནས། །\", \"tail\": \"གཞན་ཡང་ལམ་དེར་འཁྲིད་པ་དེང་སང་མང༌། །\"}, {\"label\": \"QUOTE\", \"frame\": \"རྗེ་འགྲོ་བའི་མགོན་པོ་དཔལ་སྤྲུལ་རིན་པོ་ཆེས།\", \"head\": \"གཞུང་ལུགས་གདམས་པ་ཤར་བའི་ཉམས་ལེན་དགོས། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཇི་སྐད་དུ།\", \"head\": \"རྨོངས་པས་སྒོམ་པ་གང་ཡིན་པ། །\", \"tail\": \"རྨོངས་པས་རྨོངས་པ་ཐོབ་པར་འགྱུར། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཕག་མོ་གྲུ་པས།\", \"head\": \"འཛིན་མེད་འོད་གསལ་མ་ཤར་ནས། །\", \"tail\": \"གཟུགས་མེད་ལྷ་རུ་སྐྱེ་རྒྱུའོ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"སློབ་དཔོན་ཏོག་ཙེ་པས།\", \"head\": \"དུབ་པ་སེམས་ཉིད་མགྲོན་པོ་དག །\", \"tail\": \"བློ་འདས་ཕྱག་རྒྱ་ཆེན་པོའོ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"རྡོ་རྗེ་རྩེ་མོ་ལས།\", \"head\": \"སོ་སོར་ཐར་དང་བྱང་ཆུབ་སེམས། །\", \"tail\": \"རྣལ་འབྱོར་ཁྲུས་ཀྱི་དང་པོ་ཡིན། །\"}, {\"label\": \"QUOTE\", \"frame\": \"དཔུང་བཟང་གི་ཞུས་པ་ལས།\", \"head\": \"རྒྱལ་བ་ངས་གསུངས་སོ་སོར་ཐར་པ་ཡི། །\", \"tail\": \"ལྷག་མ་རྣམས་ནི་ཉམས་སུ་བླངས་བར་བྱ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"འཇམ་དཔལ་རྩ་རྒྱུད་ལས།\", \"head\": \"ཚུལ་ཁྲིམས་འཆལ་བ་ཐུབ་དབང་གིས། །\", \"tail\": \"ཡུལ་དང་ཕྱོགས་ཀྱང་མ་ཡིན་ནོ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཏིང་འཛིན་རྒྱལ་པོ་ལས།\", \"head\": \"ཚུལ་ཁྲིམས་འཆལ་བར་ངན་འགྲོ་དེར་འགྲོ་སྟེ། །\", \"tail\": \"དེ་ལ་ཐོས་པ་མང་པོས་སྐྱོབས་མི་ནུས། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཇི་སྐད་དུ།\", \"head\": \"གང་ཞིག་རབ་ཏུ་བྱུང་ཞིང་ཡོན་ཏན་སྣོད་མ་བྱུང༌། །\", \"tail\": \"ཆུ་མེད་ཁྲོན་པ་རི་མོའི་མར་མེ་བཞིན། །\"}]}",
