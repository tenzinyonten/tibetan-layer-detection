OTE\", \"head\": \"རིགས་དྲུག་མ་རྒན་ཡོངས་ཀྱི་དོན་སླད་དུ། །\", \"tail\": \"མི་རྟོག་ཆོས་སྐུའི་རང་ཞལ་མཐོང་བར་བྱ། །\"}, {\"label\": \"QUOTE\", \"head\": \"བར་དོ་དང་པོའི་འོད་གསལ་ལས་འདས་ཏེ། །\", \"tail\": \"ལྷག་པའི་ལྷ་ཡི་སྐུ་རུ་ལྡང་བར་བྱ། །\"}, {\"label\": \"QUOTE\", \"head\": \"གལ་ཏེ་བར་དོ་གཉིས་པར་ཟུང་འཇུག་སྐུ། །\", \"tail\": \"འགྲུབ་པར་མ་གྱུར་དེ་ཚེ་ཕྱི་མ་ཡི། །\"}]}",
