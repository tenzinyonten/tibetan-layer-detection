 \"མཚན་བརྗོད་ལས།\",\n      \"head\": \"སྙིང་རྗེ་ཆེ་དང་ཤེས་རབ་དང་། །\",\n      \"tail\": \"དགའ་མགུ་རངས་པའི་བསམ་པ་ཅན། །\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"ཧེ་བཛྲ་ལས།\",\n      \"head\": \"སྟོང་པ་སྙིང་རྗེ་དབྱེར་མེད་པ། །\",\n      \"tail\": \"བྱང་ཆུབ་སེམས་ཞེས་དེ་ལ་བྱ། །\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"བྲམ་ཟེ་ཆེན་པོའི་ཞལ་ནས།\",\n      \"head\": \"གཉིས་མེད་སེམས་ཀྱི་སྡོང་པོ་དམ་པ་ནི། །\",\n      \"tail\": \"མིང་ནི་མཆོག་ཏུ་གཞན་ལ་ཕན་པའོ། །\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"གཱ་ཡ་གོ་རིའི་མདོ་ལས།\",\n      \"head\": \"སྙིང་རྗེ་དང་ཐབས་དང་བྱང་ཆུབ་སེམས་ལ་གོམས་པར་བྱས་པས།\",\n      \"tail\": \"ཚེ་འདི་ཉིད་ལ་གདོན་མི་ཟ་བར་ཁྱད་པར་དུ་འགྱུར་\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"རབ་ཏུ་ཞི་བ་རྣམ་པར་ངེས་པ་ཆོ་འཕྲུལ་གྱི་མདོ་ལས།\",\n      \"head\": \"བཟང་སྐྱོང་། བྱང་ཆུབ་སེམས་དཔའ་ཆོས་བཞི་དང་ལྡན་ན།\",\n      \"tail\": \"སྟེ་བཞི་པོ་དག་གོ །\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"མདོ་སྡུད་པ་ལས།\",\n      \"head\": \"གང་ལ་ཕན་དང་སྙིང་བརྩེར་བཅས་པས་སྤྱད་སྤྱད་པ། །\",\n      \"tail\": \"བདེ་བ་དེ་ཀུན་འདི་ལས་འབྱུང་བར་རིགས་པར་བྱ། །\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"རྒྱལ་སྲས་ཞི་བ་ལྷའི་ཞལ་ནས།\",\n      \"head\": \"སྙིང་རྗེ་མདུན་དུ་བཞག་ནས་སུ། །\",\n      \"tail\": \"དགེ་བ་སྤེལ་ལ་ནན་ཏན་བྱ། །\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"ཇོ་བོའི་ཞལ་ནས།\",\n      \"head\": \"ཐེག་པ་ཆེན་པོ་ལྟ་བས་མ་ཕྱེ་སྙིང་རྗེས་ཕྱེ་\",\n      \"tail\": \"\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"དུས་འཁོར་རྩ་རྒྱུད་ལས།\",\n      \"head\": \"སྟོང་ཉིད་སྙིང་རྗེ་དབྱེར་མེད་པ། །\",\n      \"tail\": \"བྱང་ཆུབ་སེམས་སུ་དེ་བརྗོད་བྱ། །\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"བརྟག་གཉིས་ལས།\",\n      \"head\": \"གང་ཤེས་རབ་དང་སྙིང་རྗེ་ཆེ་བ་ནི་ཐེག་པ་ཆེན་པོ་ཡིན་ལ།\",\n      \"tail\": \"གང་ཆུང་བ་རྣམས་ནི་ཐེག་པ་ཆུང་ངུའོ། །\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"ཡུམ་ལས།\",\n      \"head\": \"བྱམས་པ་ཆེན་པོ་དང་སྙིང་རྗེ་ཆེན་པོ་དང་དགའ་བ་ཆེན་པོ་དང་བཏང་སྙོམས་ཆེན་པོའི་ཆོས་སྟོན་\",\n      \"tail\": \"\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"བྱང་ས་ལས།\",\n      \"head\": \"བྱང་ཆུབ་སེམས་དཔས་ནི་དབུལ་པོར་འགྱུར་དུ་དོགས་པའི་འཇིགས་པས་སྦྱིན་པ་སྦྱིན་པར་ཡང་མི་བྱེད་དེ།\",\n      \"tail\": \"སྙིང་རྗེའི་བསམ་པ་འབའ་ཞིག་གིས་བྱེད་དོ་\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"གྲུབ་ཐོབ་བིརཝ་པའི་ཞལ་ནས།\",\n      \"head\": \"ཐོགས་མེད་བརྩེ་བས་བསྐྱངས་པ་ཡི། །\",\n      \"tail\": \"སྙིང་རྗེ་མཐར་ཕྱིན་འགྱུར་བ་ཡིན་\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"སློབ་དཔོན་དཔའ་བོའི་ཞལ་ནས།\",\n      \"head\": \"ཡོན་ཏན་མ་ལུས་བྱང་ཆུབ་སེམས་ལ་བརྟེན། །\",\n      \"tail\": \"བྱང་ཆུབ་མཆོག་སེམས་སྙིང་རྗེའི་རྒྱུ་ལས་འབྱུང་། །\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"དེ་ཡིས་མཛད་པའི་ཕར་ཕྱིན་བསྡུས་པ་ལས།\",\n      \"head\": \"ཡེ་ཤེས་སྣང་བ་མཁའ་ལྟར་ཡངས་པ་ལ། །\",\n      \"tail\": \"སྙིང་རྗེ་ཆེན་པོ་འཇིག་རྟེན་ཀུན་ཏུ་འབྱུང་། །\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"རྗེ་མི་ལས།\",\n      \"head\": \"སྟོང་ཉིད་རྟོགས་ན་སྙིང་རྗེ་སྐྱེ། །\",\n      \"tail\": \"འགྲོ་དོན་འགྲུབ་ན་ང་དང་མཇལ། །\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"ལུང་གཞན་ལས་ཀྱང་།\",\n      \"head\": \"བྱང་ཆུབ་སེམས་དཔའ་མཉམ་བཞག་པས། །\",\n      \"tail\": \"ཁྱད་པར་དུ་ཡང་སྙིང་རྗེ་སྐྱེ། །\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"དབང་མདོར་བསྟན་ལས།\",\n      \"head\": \"སྟོང་ཉིད་དཔག་བསམ་ལྗོན་ཤིང་ལས། །\",\n      \"tail\": \"དམིགས་མེད་སྙིང་རྗེའི་འབྲས་བུ་འབྱུང་། །\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"སེམས་ཅན་མགུ་བར་བྱ་བའི་བསྟོད་པ་ལས།\",\n      \"head\": \"ང་ལ་གུས་པ་སེམས་ཅན་དོན་ཏེ་གུས་པ་གཞན་དག་མིན། །\",\n      \"tail\": \"བདེ་བར་གཤེགས་པ་མཆོད། །\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"དོན་གྱི་ལམ་རིམ་བེའུ་བུམ་སྔོན་པོ་ལས།\",\n      \"head\": \"ཐེག་པ་ཆེ་ལ་སྙིང་རྗེ་གལ་ཆེ།\",\n      \"tail\": \"ཞེས་པ་སྟེ་\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"དཔེ་ཡི་ལམ་རིམ་རིན་ཆེན་སྤུངས་པ་ལས།\",\n      \"head\": \"ཁམས་པ་འཇམ་དཔལ་བྱ་བའི་རྐང་པ་ན་བ་གཅིག་ལ།\",\n      \"tail\": \"ལིང་ངེ་ཆ་ངེས་གསུངས།\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"མདོ་ལས།\",\n      \"head\": \"གང་ལ་མགོ་མཆིས་པ་ལ་འཚོ་བ་མཆིས་སོ། །\",\n      \"tail\": \"སངས་རྒྱས་མཆིས་སོ། །\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"སྐྱེས་རབས་ལས།\",\n      \"head\": \"སྐྱེ་བོ་སྙིང་རྗེ་མེད་པས་ན། །\",\n      \"tail\": \"མི་རིགས་སྤྱོད་པ་མཆོག་ཏུ་འགྱུར། །\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"head\": \"དེ་བས་ཆོས་ལ་དད་པ་ཡིས། །\",\n      \"tail\": \"དེ་ལས་ཡོན་ཏན་འཕེལ་བར་འགྱུར། །\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"འཕགས་པ་ཐོགས་མེད་ཀྱིས།\",\n      \"head\": \"དེ་ལ་སྙིང་རྗེ་བསམ་པས་ཀྱང་ལས་དགེ་བ་ཚེ་འདི་ལ་མྱོང་བར་འགྱུར་ཏེ།\",\n      \"tail\": \"སྙིང་རྗེའི་བསམ་པ་དང་། ཕན་པའི་བསམ་པ་ཤས་ཆེར་མངོན་པར་འདུ་བྱེད་པ་ལྟ་བུའོ། །\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"ཉི་ཁྲི་སྣང་བ་ལས།\",\n      \"head\": \"བྱང་ཆུབ་སེམས་དཔའི་སྙིང་རྗེ་ནི། །\",\n      \"tail\": \"བརྐམ་པ་རྗེས་སུ་སེམས་མ་ཡིན། །\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"ཡེ་ཤེས་དམ་པས་ཞུས་པར།\",\n      \"head\": \"བྱང་ཆུབ་སེམས་དཔའ་སྙིང་རྗེ་དེ་ལྟ་བུ་དང་ལྡན་པ་ནི།\",\n      \"tail\": \"ཉེས་པ་ཐམས་ཅད་སྤོང་པར་བྱེད་དོ། །\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"དྲན་པ་ཉེར་བཞག་ལས།\",\n      \"head\": \"གང་གི་སེམས་ཀྱང་མྱོང་མིན་པའི། །\",\n      \"tail\": \"སྲིད་པའི་རྒྱ་མཚོ་ལས་སྒྲོལ་བྱེད། །\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"སློབ་དཔོན་ངག་དབང་གྲགས་པས་ཀྱང་།\",\n      \"head\": \"སྙིང་རྗེ་སྙིང་ནི་འཇག་གྱུར་པ། །\",\n      \"tail\": \"གྲུབ་པའི་མཐའ་ནི་ཀུན་ལས་འདོད། །\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"རྒྱ་གར་མཁས་པ་ཆེན་པོ་སངས་རྒྱས་གསང་བས་མཛད་པའི་མན་ངག་ལམ་རིམ་ལས།\",\n      \"head\": \"སེམས་ཅན་མ་ལུས་ཐམས་ཅད་ལ། །\",\n      \"tail\": \"སྙིང་རྗེ་ཆེན་པོར་སྐྱོ་མི་བྱེད། །\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"head\": \"སྙིང་རྗེ་ཆེན་པོ་གོམས་བྱས་ན། །\",\n      \"tail\": \"ཡོན་ཏན་ནམ་མཁའི་མཐའ་དང་མཉམ། །\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"རྗེ་དྭགས་པོ་རིན་པོ་ཆེས།\",\n      \"head\": \"གཞན་ཕན་ཞན་མེད་ཀྱི་སྙིང་རྗེ་འདི། །\",\n      \"tail\": \"ཐབས་ཀྱི་མཆོག་ཏུ་བཙིར་གྱིས་བཟུང་། །\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"head\": \"སྙིང་རྗེ་མེད་པའི་ཆོས་པ་དེ། །\",\n      \"tail\": \"འབད་རྩོལ་བྱས་ཀྱང་ཉན་ཐོས་ལམ། །\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"ཇོ་བོ་རྗེས།\",\n      \"head\": \"སེམས་ཅན་ལ་བཟོད་བླགས་མེད་པའི་སྙིང་རྗེ་ཡོད་ན།\",\n      \"tail\": \"སངས་རྒྱས་ལ་ཅི་འཁོད་བྱེད་པའོ། །\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"སྐྱོབ་པ་འཇིག་རྟེན་མགོན་པོས།\",\n      \"head\": \"ང་ཡི་བུ་སློབ་གང་ཡིན་པ། །\",\n      \"tail\": \"སྟོང་ཉིད་སྙིང་རྗེའི་བརྒྱུད་པ་བཟུང་། །\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"གྲུབ་ཐོབ་ཨོ་རྒྱན་པས།\",\n      \"head\": \"དཔལ་ནཱ་རོ་པའི་བརྒྱུད་པ་འཛིན་པ་རྣམས་ཀྱིས།\",\n      \"tail\": \"ཡོན་ཏན་དཔག་ཏུ་མེད་པའི་རྩལ་སྦྱོངས་\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"རྗེ་རྒོད་ཚང་བའི་ཞལ་ནས།\",\n      \"head\": \"རྟོགས་པ་ཉིན་མཚན་ཁོར་ཡུག་ཏུ་སོང་བ་ཞིག་པས།\",\n      \"tail\": \"ང་སྙིང་རྗེའི་ངོས་འདམས་པ་ཡིན་\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"ཆོས་ཡང་དག་པར་སྡུད་པའི་མདོ་ལས།\",\n      \"head\": \"བྱང་ཆུབ་སེམས་དཔའ་ནི་སྟོང་པ་ཉིད་ཀྱི་ངང་ཚུལ་ཅན་ཏེ་འཁོར་བ་ལ་མི་གནས་སོ། །\",\n      \"tail\": \"མྱ་ངན་ལས་འདས་པ་ལ་མི་གནས། །\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"རབ་ཏུ་ཞི་བ་ཆོ་འཕྲུལ་གྱི་མདོ་ལས་ཀྱང་།\",\n      \"head\": \"སེམས་ཅན་ཐམས་ཅད་ལ་བྱམས་པ་ཆེན་པོ་དང་། སྙིང་རྗེ་ཆེན་པོ་དང་ལྡན་ཞིང་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཀྱི་སེམས་ཡིད་ལ་བྱེད་པས་གནས་པ་འདི་ནི་བྱང་ཆུབ་སེམས་དཔའི་སེམས་ཀྱི་རྒྱན་ནོ། །\",\n      \"tail\": \"\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"ལུང་གཞན་ལས།\",\n      \"head\": \"སྨོན་པ་དང་ནི་འཇུག་པ་དང་། །\",\n      \"tail\": \"བརྟན་པ་རྣམས་ཀྱི་སྙིང་པོའོ། །\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"སློབ་དཔོན་རིན་ཆེན་འབྱུང་གནས་ཞི་བས་ཀྱང་།\",\n      \"head\": \"སྙིང་རྗེ་བརྟན་པས་བྱང་ཆུབ་ཀྱི་སེམས་བརྟན་པར་འགྱུར་ཏེ།\",\n      \"tail\": \"རྙེད་པར་དཀའ་གསུངས་སོ། །\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"ནམ་མཁའ་ཀློང་ཡངས་ལས།\",\n      \"head\": \"རྟོགས་པའི་རྟེན་འབྲེལ་སེམས་ལ་འཆར་བ་དང་། །\",\n      \"tail\": \"བླ་མའི་བྱིན་རླབས་སེམས་ལ་ཞུགས་པ་ཡིན། །\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"མདོ་སྡེ་རྒྱན་ལས།\",\n      \"head\": \"སྦྱོར་བའི་སྔོན་དུ་སྙིང་རྗེ་དང་། །\",\n      \"tail\": \"རིགས་ཀྱི་རྟགས་སུ་ངེས་པར་བཤད། །\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"མདོ་སྡེ་རྒྱན་ལས།\",\n      \"head\": \"སྙིང་རྗེས་ཟིན་པའི་བརྩེ་ལྡན་རྣམས། །\",\n      \"tail\": \"ཆགས་པར་འགྱུར་བ་སྨོས་ཅི་དགོས། །\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"ཨོ་རྒྱན་ཆེན་པོས།\",\n      \"head\": \"ཉོན་མོངས་ཟད་ན་ཆོས་ལ་བྱ་རྒྱུ་མེད། །\",\n      \"tail\": \"ཆོས་ལ་ཕྱི་བཤོལ་མ་མཛད་རྗེ་འབངས་རྣམས། །\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"དབུ་མ་རྒྱན་ལས།\",\n      \"head\": \"ཡང་དག་བཤེས་འཚོལ་སྔོན་བཏང་སྟེ། །\",\n      \"tail\": \"ཐུབ་པའི་བརྟུལ་ཞུགས་ཡང་དག་སྤྱོད། །\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"ཕ་དམ་པས།\",\n      \"head\": \"སྟོང་ཉིད་རྟོགས་པས་སྡིག་པ་བྱས་པས་སྟོ་འམ་མི་སྟོ་ཞུས་པས།\",\n      \"tail\": \"སྟོང་ཉིད་རྟོགས་པ་དང་སྙིང་རྗེ་སྐྱེ་བ་དུས་མཉམ་\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"གཙུག་ན་རིན་པོ་ཆེའི་མདོ་ལས།\",\n      \"head\": \"དེ་བྱམས་པའི་གོ་ཆ་བགོས་ཤིང་། སྙིང་རྗེ་ཆེན་པོའི་གནས་ལ་གནས་ནས་རྣམ་པ་ཐམས་ཅད་ཀྱི་མཆོག་དང་ལྡན་པའི་སྟོང་པ་ཉིད་མངོན་པར་བསྒྲུབ་པ་ལ་བསམ་གཏན་དུ་བྱེད་དོ་\",\n      \"tail\": \"\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"ཕལ་པོ་ཆེ་ལས།\",\n      \"head\": \"ཀྱེ་རིགས་ཀྱི་བུ། སེམས་ཅན་གྱི་ཁམས་ལ་དམིགས་ནས་ལུས་དང་ངག་དང་ཡིད་ཀྱི་རྩོམ་པ་ཐམས་ཅད་ནི་འཁོར་བ་ན་རྒྱུ་བ་རྣམས་ཡང་དག་པར་འདྲེན་པའི་ཕྱིར་ཚད་མེད་པའི་སྙིང་རྗེ་ཆེན་པོ་སྟེ།\",\n      \"tail\": \"རིན་པོ་ཆེའི་ཏོག་གོ །\"\n 