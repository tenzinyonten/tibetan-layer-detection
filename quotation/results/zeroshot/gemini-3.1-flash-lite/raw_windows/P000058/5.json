ead\": \"ལྷག་པར་བྱང་ཆུབ་སེམས་དཔའ་ཤ་ཡི་རོར། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"སོ་སོར་ཐར་པའི་མདོ་ལས།\", \"head\": \"སྡིག་པ་ཅི་ཡང་མི་བྱ་ཞིང་། །\", \"tail\": \"རང་གི་སེམས་ནི་ཡོངས་སུ་འདུལ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"སྤྱོད་འཇུག་ལས།\", \"head\": \"འགྲོ་བའི་སྡུག་བསྔལ་སྨན་གཅིག་པུ། །\", \"tail\": \"བསྟན་པ་རྙེད་དང་བཀུར་སྟི་དང་། །\"}, {\"label\": \"QUOTE\", \"frame\": \"འཇམ་དཔལ་རྩ་རྒྱུད་ལས།\", \"head\": \"སངས་རྒྱས་བསྟན་པ་རིན་ཆེན་སྣོད། །\", \"tail\": \"དགེ་སློང་རྣམས་ནི་ཡིན་ཕྱིར་རོ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"སངས་རྒྱས་ཀྱིས།\", \"head\": \"བློ་གྲོས་ཆེན་པོ། ངས་ཤའི་ཟས་ནི་སུ་ལའང་མ་གནང་།\", \"tail\": \"རབ་ཏུ་བྱུང་བ་རྣམས་ལ་ཤའི་ཟས་ནི་མི་རུང་བར་ངས་བཤད་དོ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ལེགས་གྲུབ་ཀྱི་རྒྱུད་ལས།\", \"head\": \"དེ་བཞིན་མ་ཤའི་སྲན་ཆན་དག །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"མཉམ་མེད་སྒམ་པོ་བའི་ཞལ་ནས།\", \"head\": \"སྡིག་ཟས་ཁྲ་བོའི་ཤ་དང་གཅིག །\", \"tail\": \"སྙིང་ནས་མཛད་ན་འདི་གསུམ་སྤོངས། །\"}]}",
