  "raw_text": "{\"spans\": [{\"label\": \"QUOTE\", \"frame\": \"སློབ་སྤྲིངས་ལས།\", \"head\": \"གང་གི་ནུ་ཞོ་བྱམས་པའི་ཤུགས་ཀྱིས་གཟག་འཐུང་བ། །ངལ་བ་མང་བསྟེན་བྱམས་པ་ལ་བསྟེན་དེ་དག་འདིར། །ཤིན་ཏུ་མ་རབས་ཤིག་ནའང་སྤང་བར་སུ་ཞིག་སྤྲོ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཕྱག་ན་པད་དཀར་འཛིན་དངོས་རྒྱལ་བ་སྐལ་བཟང་རྒྱ་མཚོའི་གསུང་མགུར་ལས།\", \"head\": \"ཚེ་འདིར་མངལ་དུ་བཟུང་བའི་མ་རྒན་ལ། །དྲིན་དུ་བརྩི་ན་སྐྱེ་བ་གྲངས་མེད་ཅིག །ཕན་པ་ཁོ་ནས་བསྐྱངས་པའི་སེམས་ཅན་རྣམས། །བློ་ཡིས་འདོར་བར་ནུས་སམ་སྙིང་གཏམ་ཡིན། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"པཎ་ཆེན་རིན་པོ་ཆེས་མཛད་པའི་བདེ་ལམ་ལས།\", \"head\": \"ཐོག་མར་ཤན་པས་གསོད་བཞིན་པའི་ལུག་ལྟ་བུའི་སྡུག་བསྔལ་གྱིས་ཉམ་ཐག་པའི་འགྲོ་བ་རྣམས་ལ་སྒོམས།\", \"tail\": \"སྡུག་བསྔལ་གྱི་རྒྱུ་ཐམས་ཅད་དང་བྲལ་བར་བྱའོ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཀུན་མཁྱེན་ཀློང་ཆེན་པས།\", \"head\": \"དེ་བས་བདག་གི་ལུས་དང་ལོངས་སྤྱོད་དང་། །དུས་གསུམ་དགེ་བ་འགྲོ་བའི་སྡུག་བསྔལ་དག །\", \"tail\": \"སྙིང་ཁོང་རུས་པའི་གཏིང་ནས་བསམ་པར་བྱ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཡུམ་བར་པ་ལས།\", \"head\": \"སེམས་ཅན་སྡུག་བསྔལ་བ་དག་མཐོང་བ་ན། འདི་སྙམ་དུ་སེམས་ཅན་འདི་དག་སྡུག་བསྔལ་དང་བྲལ་བར་ཤོག་ཅིག་ཅེས་སེམས་པ་ཡིན་ཏེ་\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཨོ་རྒྱན་རིན་པོ་ཆེའི་ཞལ་ནས།\", \"head\": \"ཁྱད་པར་སྙིང་རྗེ་བྱམས་པའི་གཙོ་བོ་ནི་ལུས་བསྐྱེད་པའི་མ་ཡིན་ལ། དེའི་དྲིན་ནི་འཁོར་བའི་ཚད་མེད་མུ་མེད་པས། འདི་ལ་བྱམས་སྙིང་རྗེ་ཚད་མེད་པ་བྷེཾ།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཡང་།\", \"head\": \"ཐར་མེད་ལས་ཀྱི་འཁོར་བའི་དོང་རིང་དུ། ལས་ཀྱིས་མནར་བའི་འགྲོ་རྣམས་སྙིང་རེ་རྗེ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"སྐུ་གསུམ་དོན་ཐིག་ལས།\", \"head\": \"འགྲོ་བ་དྲུག་གི་སེམས་ཅན་ཐམས་ཅད་ནི། །\", \"tail\": \"གནོད་པའི་ལན་དུ་ཕན་པའི་གདུང་ཤུགས་བསྐྱེད། །\"}, {\"label\": \"QUOTE\", \"frame\": \"རྒྱལ་བ་སྐལ་བཟང་རྒྱ་མཚོས། །\", \"head\": \"བདག་དྲིན་གྱིས་བསྐྱངས་པའི་མ་རྒན་རྣམས། །\", \"tail\": \"གཞན་ཕན་བདེའི་ཐབས་དགུ་སྙིང་ལ་བཅངས། །\"}, {\"label\": \"QUOTE\", \"frame\": \"བདེ་ལམ་ལས།\", \"head\": \"སེམས་ཅན་ཐམས་ཅད་སྦྱིན་པས་འཁོར་དུ་བསྡུས་ཏེ། ཚར་གཅོད་རྗེས་འཛིན་གྱི་སྒོ་ནས་ཆོས་སྟོན་པའི་སྙན་པར་སྨྲ་བ་དང་། ཆོས་བསྟན་པའི་དོན་ཉམས་སུ་ལེན་དུ་འཇུག་པའི་སྤྱོད་པ་དང་། གཞན་ལ་བསྟན་པ་ལྟར་རང་གིས་ཀྱང་ཉམས་སུ་ལེན་པའི་དོན་མཐུན་པ་སྟེ། གཞན་དོན་བྱེད་པའི་ཐབས་བཟང་པོ་འདི་རྣམས་ལ་བརྟེན་ནས་སེམས་ཅན་ཐམས་ཅད་སྨིན་གྲོལ་གྱི་ལམ་ལ་འགོད་པར་བྱའོ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"སངས་རྒྱས་ཀྱི་གསུང་ལངྐར་གཤེགས་པའི་མདོ་ལས།\", \"head\": \"ཁེ་ཡི་ཕྱིར་དུ་སེམས་ཅན་གསོད། །ཤ་ཡི་ཕྱིར་ནི་ནོར་སྦྱིན་བྱེད། །དེ་དག་གཉིས་ཀ་སྡིག་ལས་ཅན། །ངུ་འབོད་ལ་སོགས་རྣམས་སུ་འཚོད། །གང་གིས་ཐུབ་པའི་ཚིག་འདས་ཏེ། །བསམ་པ་ངན་པས་ཤ་ཟ་ན། །འཇིག་རྟེན་གཉིས་ནི་གཞིག་པའི་ཕྱིར། །ཤཱཀྱའི་བསྟན་ལ་བརྟུལ་ཞུགས་བླངས། །ཤིན་ཏུ་མི་བཟད་དམྱལ་བར་ཡང་། །སྡིག་པའི་ལས་ཅན་དེ་དག་འདོང་། །མ་རུངས་འོ་དོད་འབོད་སོགས་སུ། །ཤ་ཟ་དེ་དག་བཙོ་བར་འགྱུར། །\", \"tail\": \"སྲིན་དང་བྱི་ལའི་མངལ་དུ་སྐྱེ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཡང་།\", \"head\": \"དེ་ལྟར་ཤ་དང་ཆང་ལ་སོགས། །བར་ཆད་བྱེད་པར་འགྱུར་བ་འོ། །མ་འོངས་པ་ཡི་དུས་སུ་ནི། །ཤ་ཟན་གཏི་མུག་སྨྲ་བ་དག །ཤ་ནི་སྡིག་མེད་རུང་བ་ཞེས། །སངས་རྒྱས་ཀྱིས་ནི་བཤད་ཅེས་ཟེར། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"དུས་ཀྱི་འཁོར་ལོའི་རྒྱུད་ཕྱི་མ་ལས།\", \"head\": \"ཤ་ལ་སོགས་པ་ཟོས་པས་གདོན་མི་ཟ་བར་ས་ཡི་འོག་ཏུ་གང་གི་ལུས་ནི་ཆེས་ཆེ་བ། །སྲོག་ཆགས་ཡི་དྭགས་སོགས་སུ་ངེས་པར་སྐྱེ་བར་འགྱུར་ཏེ།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"དང་པོའི་སངས་རྒྱས་ཀྱི་རྒྱུད་དུ་ཡང་།\", \"head\": \"ཟ་བ་པོ་དང་གསོད་པ་པོ། །གཉིས་པོ་དག་ཀྱང་གསོད་པ་སྟེ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཀྱེ་རྡོ་རྗེར།\", \"head\": \"ཤ་ནི་མཁས་པས་བཟའ་བྱ་བ། །སེམས་ཅན་དེ་དེའི་དབང་དུ་འགྱུར། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"མཁའ་འགྲོ་རྒྱ་མཚོའི་འགྲེལ་པར་\", \"head\": \"ཡེ་ཤེས་ཀྱི་བདག་ཉིད་ཀྱིས་རྣམ་པར་རྟོག་པ་ཟ་བར་བྱེད་དོ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"འཕགས་པ་འཇམ་དཔལ་གྱིས།\", \"head\": \"ཞེ་སྡང་བསམ་པ་མེད་པའི་ཕྱིར། །གཞན་གྱི་ཤ་རྣམས་མ་འཕྲོག་ཤིང་། །ཐུབ་པས་རང་གི་ཤ་རྣམས་བྱིན། །སྐྱེ་བ་འདིར་ནི་ཁྱོད་སངས་རྒྱས།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ལང་ཀར་གཤེགས་པའི་མདོ་ཉིད་ལས།\", \"head\": \"ཐུབ་པས་ཤ་ནི་མ་གནང་ངོ་། །རྫས་ཐོབ་དོན་དུ་སྲོག་གཅོད་དང་། །བཟའ་བའི་དོན་དུ་རིན་འཇལ་བ། །གཉིས་པོ་དག་ཀྱང་གསོད་པ་སྟེ། །ངུ་འབོད་ལ་སོགས་རྣམས་སུ་འཚོད། །རྫས་ཀྱི་དོན་དུ་སེམས་ཅན་གསོད། །རྫས་སྟེར་མེད་ན་སུས་ཀྱང་མིན། །བྱ་དང་བྱེད་པོ་ཡང་དག་འབྲེལ། །རྟག་ཏུ་སྲོག་ཆགས་གསོད་པ་པོ། །གང་ཚེ་རྫས་ཀྱིས་ཉ་ཉོས་པས། །ཁྱིམ་གནས་རྣམས་ལ་སྡིག་མེད་ན། །དེ་བཞིན་སྐུ་གཟུགས་ལ་སོགས་པ། །བྱས་པའང་ཇི་ལྟར་བསོད་ནམས་འགྱུར། །མཆོད་རྟེན་རྩིག་མཁན་གྱིས་བྱས་དང་། །ཉ་ནི་ཉ་པས་བསད་པ་སྟེ། །མཆོད་རྟེན་ཕྱག་བྱེད་བྱེད་པོ་མིན། །ཉ་ཟོས་གསོད་པ་པོ་ལ་མིན། །གང་ཚེ་ཉ་དེ་ཟོས་པ་ཡིས། །སྡིག་པ་ཟ་བ་པོར་མེད་ན། །དེ་ཚེ་མཆོད་རྟེན་མཆོད་པ་ཡི། །བསོད་ནམས་མཆོད་བྱེད་པོ་ལ་མེད། །གསོད་པ་པོ་དང་ཟ་བ་པོ། །གཉིས་པོ་དག་ཀྱང་སོ་སོ་སྟེ། །གསོད་པ་པོ་ནི་ནོར་ལ་སྲེད། །ཟ་བ་པོ་ནི་ཟས་ཀྱི་དོན། །གསོད་པོ་ནོར་ལ་སྲེད་པ་དག །བསྐལ་པ་འབུམ་དུ་འཚོད་པ་འོ། །ཟ་བོ་ཤ་ལ་སྲེད་པ་དག །བསྐལ་པ་བྱེ་བར་འཚོད་པ་འོ། །ཉན་ཐོས་ཀྱིས་ནི་ཆེད་དག་ཏུ། །ཉ་པས་ཉ་ནི་བསད་པ་དང་། །བྲམ་ཟེ་ཡི་ནི་ཆེད་དག་ཏུ། །ཆང་མས་ཆང་ནི་བྱས་པ་དང་། །ཁ་ན་མ་ཐོ་མེད་གཞན་མིན། །ཤ་ཟ་བ་ཡི་མི་གང་ཞིག །དང་པོ་ཡི་དྭགས་འགྲོ་བ་སྟེ། །ཕྱི་ནས་ངུ་འབོད་འགྲོ་བ་འོ། །ཤ་ཟ་བ་ལ་སྙིང་རྗེ་དང་། །ཆང་འཐུང་བ་ལ་དགའាབ་དང་། །ཕ་རོལ་བུད་མེད་འཛིན་གསུངས་པ། །སྨད་པ་ལས་བྱེད་བཏང་སྙོམས་མེད། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"རྗེ་མི་ལས།\", \"head\": \"ཤ་ཁྲག་ཟས་སུ་ཟ་བྱེད་ཅིང་། །སྲོག་གཅོད་ལས་སུ་སོང་བ་རྣམས། །ཚ་དམྱལ་བརྒྱད་དུ་སྲེག་པར་བྱེད། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ས་པཎྚི་ཏས།\", \"head\": \"ཐེག་པ་ཆེ་ལས་ཤ་རྣམས་བཀག །ཟོས་ན་ངན་འགྲོའི་རྒྱུ་རུ་གསུངས། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"རྗེ་བཙུན་གྲགས་པ་རྒྱལ་མཚན་གྱིས།\", \"head\": \"དྲན་པ་ཉམས་པའི་ཆང་དང་གཅིག །སྙིང་རྗེ་ཉམས་པའི་ཤ་དང་གཉིས། །གྲགས་པ་ཉམས་པའི་བུད་མེད་གསུམ། །འདི་གསུམ་སྒོམ་ཆེན་གྱི་ཁོང་སྐྲན་ལགས། །ངེས་འབྱུང་གི་མེ་བཙའ་མྱུར་དུ་ཐོབ། །ཆོས་སྨྱོན་པའི་ཚུལ་དུ་ཉམས་སུ་ལོངས། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"མཁས་གྲུབ་རྗེས་མཛད་པའི་སྡོམ་གསུམ་རྣམ་བཤད་ལས།\", \"head\": \"ཤའི་རོ་ལ་ཆགས་པའི་དབང་གིས་ཤ་ཟ་བར་རུང་བར་འདུལ་བ་ལས་གནང་ངོ་ཞེས་ཁོ་བོ་ཅག་ནི་རྣམ་པ་ཐམས་ཅད་དུ་མི་སྨྲ་ལ། དེ་འདྲ་བར་སྐྱོན་མེད་པར་གཉིད་ཀྱི་རྨི་ལམ་དུ་ཡང་མི་སྨྲའོ་\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"རྗེ་བཙུན་གྱིས་...མགུར་འདི་གསུངས་སོ། །\", \"head\": \"ཨེ་མ་འཁོར་བའི་སེམས་ཅན་རྣམས། །ཐར་བའི་ལམ་ལ་ཕར་ལྟོས་དང་། །ཨ་ཙ་མ་སྡིག་ཅན་སྙིང་རེ་རྗེ། །ལས་རེ་རྨོངས་མི་ལུས་ཀྱི་ལོད་པ་ལ། །ཞེ་རེ་འཕངས་སེམས་ཅན་གྱི་གསོད་ལུགས་ལ། །གྱོང་རེ་ཆེ་མགོ་བོའི་བསྐོར་ལུགས་ལ། །ཙུག་རེ་དྲག་ཕ་མའི་འཆི་ལུགས་ལ། །ཇི་ལྟར་བྱེད་སྡིག་ཤའི་བརྩིགས་ལུགས་ལ། །ཅི་རེ་བྱེད་ཁྲག་གི་མང་ལུགས་ལ། །ཇི་ཙམ་ལྟོགས་ཤ་ཡི་ཟ་ལུགས་ལ། །གང་ནས་བསམ་སྣང་བའི་འཁྲུལ་ལུགས་ལ། །སྡིག་རེ་ཆེ་སྙིང་རྗེ་མེད་ལུགས་ལ། །ཇི་ཙམ་བསྒྲིབས་རྨོངས་པའི་གཏི་མུག་ལ། །ཅི་རེ་བྱེད་སྡིག་པའི་སོ་ནམས་ལ། །སུ་ཡིས་སྤྱོད་འདོད་པས་གདུང་ལུགས་ལ། །གང་གིས་བྱས་ཡུལ་ལུགས་ཀྱི་ངན་པ་ལ། །ཙུག་རེ་བྱེད་སྐྱོ་བ་སྐྱེ་ལུགས་ལ། །ཅི་རང་བྱེད་སྡིག་ཅན་གྱི་བྲེལ་ལུགས་ལ། །ཕྱི་མ་སྐད་ཅིག་མི་དྲན་པའི། །མི་འདི་འདྲ་མཐོང་ན་ང་རེ་འཇིགས། །སྡིག་སྤྱོད་རྣམས་དྲན་བཞིན་སྣང་བ་འཁྲུལ། །རས་ཆུང་པ་ལྷ་ཆོས་ཤིག་ཨེ་དྲན་ཨང་། །དྲན་ན་སྐྱོ་ཤས་སྙིང་རླུང་ལྡང་། །བསྒོམས་ན་རི་ཁྲོད་གནས་སུ་གཤེགས། །བསམས་ན་བླ་མའི་བཀའ་དྲིན་སོམས། །འབྲོས་ན་སྡིག་སྤྱོད་རྩ་ནས་བྲོས། །གཏོང་ན་འཇིག་རྟེན་གྱི་བྱ་བ་ཐོངས། །འཛིན་ན་སྒྲུབ་པའི་དམ་བཅའ་ཟུངས། །ཤེས་ན་མི་ཚེ་ཆོས་ལ་སྐྱོལ། །\", \"tail\": \"\"}]}",
