  "raw_text": "{\"spans\": [{\"label\": \"QUOTE\", \"head\": \"བླ་མ་གཉན་པ་ཤེས་པར་བྱ། །ཅི་ཕྱིར་བསྐལ་པའི་སངས་རྒྱས་རྣམས། །བླ་མ་དག་ལ་བརྟེན་ནས་འབྱུང༌།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"རྒྱ་ཆེར་རོལ་པ་ལས།\", \"head\": \"སྲིད་པའི་གནས་བཅས་དད་པ་ཆུང་བ་ཡིས། །སངས་རྒྱས་ཡོན་ཏན་ཤེས་པར་མི་ནུས་སོ།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཆོས་བཅུ་པའི་མདོ་ལས།\", \"head\": \"དད་པ་མེད་པའི་མི་རྣམས་ལ། །དཀར་པོའི་ཆོས་རྣམས་ག་ལ་སྐྱེ། །ས་བོན་མེ་ཡིས་ཚིག་པ་ལ། །མྱུ་གུ་སྔོན་པོ་ཇི་བཞིན་ནོ།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"དཀོན་མཆོག་སྒྲོན་མེའི་མདོ་ལས།\", \"head\": \"དད་པ་སྔོན་འགྲོ་མ་ལྟར་བསྐྱེད་པ་སྟེ། །ཡོན་ཏན་ཐམས་ཅད་འབྱུང་ཞིང་འཕེལ་བར་བྱེད། །དད་པ་གཏེར་དང་ནོར་དང་རྐང་པའི་མཆོག །ལག་པ་བཞིན་དུ་དགེ་རྩ་ཐམས་ཅད་སྡུད།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"རྒྱུད་བླ་མ་ལས།\", \"head\": \"རང་བྱུང་རྣམས་ཀྱི་ཡེ་ཤེས་ནི། །དད་པ་ཉིད་ཀྱིས་རྟོགས་བྱ་ཡིན།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"མདོ་ལས།\", \"head\": \"དོན་དམ་པ་ནི་དད་པས་རྟོགས་པར་བྱ་བ་ཁོ་ནའོ།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"རྒྱུད་ལས།\", \"head\": \"བླ་མ་ཉིད་ལས་མ་བྱུང་བའི། །སངས་རྒྱས་ཞེས་བྱ་འབྱུང་མི་སྲིད། །སྲིད་པའི་ཁ་ལོ་གྱེན་དུ་ནི། །བླ་མ་མཚན་ཉིད་ལྡན་པས་བསྒྱུར།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"head\": \"བླ་མ་ལ་གུས་ཡོད་གྱུར་ན། །ཆོས་འགྲུབ་འདི་ལ་ཐེ་ཚོམ་མེད། །བླ་མ་ལ་གུས་མེད་གྱུར་ན། །བསྒྲུབས་ཀྱང་འགྲུབ་པར་མི་འགྱུར་རོ།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཡང་རྒྱུད་ལས།\", \"head\": \"བློ་དང་ལྡན་པ་སུ་ཞིག་གིས། །བཟའ་བཏུང་ཕུད་ཀྱིས་བླ་མར་མཆོད། །འདིར་ཡང་བཟའ་བཏུང་འཕེལ་བ་དང༌། །ཕྱི་མ་འཁོར་ལོ་བསྒྱུར་རྒྱལ་ཐོབ།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"དགོངས་འདུས་ལས།\", \"head\": \"ཆོས་ཀུན་མི་ཤེས་མ་རྟོགས་ཀྱང༌། །མཚན་ཉིད་བཟང་ལྡན་བླ་མ་ལ། །བཀུར་བསྟི་རིམ་གྲོ་ཆེར་བྱས་པས། །འཁོར་བའི་རྒྱ་མཚོ་བརྒལ་བར་འགྱུར།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཡང་རྒྱུད་ལས།\", \"head\": \"ཆོས་རྣམས་ཀུན་གྱི་རྩ་བ་ནི། །བླ་མ་རྡོ་རྗེ་འཛིན་པར་བཤད། །བླ་མ་དག་ལ་མ་བསྟེན་པར། །དངོས་གྲུབ་རྙེད་པར་འགྱུར་མི་སྲིད། །དེ་ཕྱིར་འདོད་པའི་དངོས་གྲུབ་ནི། །བླ་མ་བསྟེན་པ་ཉིད་ལས་བྱུང༌།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཡེ་ཤེས་དྲི་མེད་ལས།\", \"head\": \"མཛོད་ལྡན་བླ་མའི་ཕྱོགས་དག་ཏུ། །བཀུར་བསྟི་རིམ་གྲོ་སུས་བྱས་པ། །ཡོངས་སུ་བགྲང་དང་སྤྱོམས་མི་བྱ། །བྱས་ན་འབྲས་བུ་མེད་པར་གྱུར།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"སྐྱོབས་པ་རིན་པོ་ཆེའི་ཞལ་སྔ་ནས།\", \"head\": \"བླ་མའི་སྐུ་བཞི་གངས་རི་ལ། །མོས་གུས་ཀྱི་ཉི་མ་མ་ཤར་ན། །བྱིན་རླབས་ཀྱི་ཆུ་རྒྱུན་མི་འབེབས་པས། །སེམས་མོས་གུས་འདི་ལ་ནན་ཏན་མཛོད།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"head\": \"རྗེ་ལ་གསོལ་བ་མི་འདེབས་པར། །མི་རྟོག་ཡེ་ཤེས་འདོད་པ་དེ། །བྱང་བསྟན་ཕུག་པ་ཉི་སྒུག་འདྲ། །སྣང་སེམས་འབྲེལ་དུས་དེ་ལ་མེད། །མོས་གུས་བྱ་བ་གནད་དུ་ཆེ།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"head\": \"སྒོམ་སྲན་གྱིས་གྲོལ་བ་ཐེ་ཚོམ་ཟ། །མོས་གུས་ཀྱིས་གྲོལ་བ་ཐེ་ཚོམ་མེད།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"མཻ་ཏྲི་པས།\", \"head\": \"བླ་མ་རྗེ་བཙུན་མ་བསྟེན་ན། །དངོས་གྲུབ་རྣམ་གཉིས་ཐོབ་མི་སྲིད།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"head\": \"སྤྱི་བོའི་གཙུག་གམ་ལག་པའི་མཐིལ། །སྙིང་གི་དཀྱིལ་དུ་སུས་བསྒོམ་པ། །སངས་རྒྱས་སྟོང་གི་ཡོན་ཏན་ཀྱང༌། །གང་ཟག་དེ་ཡིས་འཛིན་པར་འགྱུར།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཡེ་ཤེས་མཁའ་འགྲོ་མས།\", \"head\": \"མཆོག་དང་ཐུན་མོང་དངོས་གྲུབ་ཀུན། །རྩ་བའི་བླ་མ་མ་གཏོགས་པ། །གཞན་ལས་རྙེད་པ་ཅང་མི་སྲིད། །རྣལ་དུ་ཕོབ་ལ་གསོལ་བ་ཐོབ།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"པཎ་ཆེན་ནཱ་རོ་པས།\", \"head\": \"ཅི་དགུ་ཐམས་ཅད་བླ་མ་ལ། །གསོལ་བ་བཏབ་ལས་འབྱུང་བར་འགྱུར།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"མཻཏྲི་པས།\", \"head\": \"བླ་མའི་བྱིན་རླབས་འཕོས་ཏེ་འཚང་རྒྱ་བ། །དུས་གསུམ་སངས་རྒྱས་སྤར་ནས་བཏོན་པ་འདྲ།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཨ་ལི་ཀཱ་ལི་རྒྱུད་ལས།\", \"head\": \"བརྗོད་བྲལ་ལྷན་ཅིག་སྐྱེས་པའི་ཡེ་ཤེས་ནི། །ཚོགས་བསགས་སྒྲིབ་པ་དག་པའི་ལག་རྗེས་དང༌། །རྟོགས་ལྡན་བླ་མའི་བྱིན་རླབས་ཁོ་ན་ལས། །ཐབས་གཞན་བརྟེན་པ་རྨོངས་པར་ཤེས་པར་བྱ།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ས་ར་ཧ་པས།\", \"head\": \"བླ་མས་སྨྲས་པ་གང་གི་སྙིང་ཞུགས་པ། །ལག་པའི་མཐིལ་ན་གནས་པའི་གཏེར་མཐོང་འདྲ།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"བརྟག་གཉིས་ལས།\", \"head\": \"གཞན་གྱིས་བརྗོད་མིན་ལྷན་ཅིག་སྐྱེས། །གང་དུ་ཡང་ནི་མི་རྙེད་དེ། །བླ་མའི་དུས་ཐབས་བརྟེན་པ་དང༌། །རང་གི་བསོད་ནམས་ལས་ཤེས་བྱ།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"head\": \"རང་གི་རིག་པའི་ཡེ་ཤེས་ནི། །ངག་གི་ལམ་འདས་སྤྱོད་ཡུལ་ཏེ། །འདི་ནི་བྱིན་རླབས་རིམ་པའི་ཕྱིར། །ཀུན་མཁྱེན་ཡེ་ཤེས་དེ་ལྟ་བུ།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཆོས་རྗེ་གཙང་པས།\", \"head\": \"རྗེ་བླ་མའི་ངོ་བོ་ཆོས་ཀྱི་སྐུ། །རྡོ་རྗེ་འཆང་དང་ཞལ་མཇལ་བས། །བརྒྱུད་པ་ཉེ་རིང་བགྲང་མ་དགོས།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"head\": \"བླ་མ་རང་སེམས་དབྱེར་མ་མཆིས། །གཟུགས་སྐུ་འཛིན་པ་སྟོར་ནས་ཐལ། །མོས་གུས་བྱ་བའི་ཡུལ་མ་རྙེད།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"རྒྱལ་དབང་རྗེས།\", \"head\": \"བླ་མ་རང་སེམས་འདྲེས་ཙ་ན། །རང་དང་ལྷན་ཅིག་གཅིག་གྱུར་པས། །གསོལ་བ་འདེབས་པའི་ཡུལ་མ་རྙེད།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"head\": \"ད་ནི་མགོན་པོ་རང་གི་སེམས། །ཇི་བཞིན་རྟོགས་ནས་ཇི་སྙེད་པའི། །མཁྱེན་པ་བདག་ལ་མངོན་གྱུར་ན། །མཆོག་གི་དངོས་གྲུབ་དེ་ཀ་ལགས།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"རྗེ་མི་ལས།\", \"head\": \"བླ་མར་ངེས་སོ་རང་གི་སེམས་ལ་ལྟོས། །སེམས་ལས་གཞན་པའི་བླ་མ་བཙལ་ཀྱང་ནི། །རྙེད་པར་མི་འགྱུར་ལྷ་རྗེ་སྟོན་པ་བ།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"དཔལ་ས་ར་ཧ་པས།\", \"head\": \"བླ་མའི་ལུང་ལ་འགྲིམས་ཏེ་རབ་འབད་ན། །ལྷན་ཅིག་སྐྱེས་པ་བྱུང་བ་ཐེ་ཚོམ་མེད།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"རིམ་ལྔ་ལས།\", \"head\": \"རི་དབང་རྩེ་ནས་འགའ་ཞིག་ལྷུང་གྱུར་ན། །ལྷུང་བར་མི་འགྱུར་སྙམ་ཡང་ལྷུང་བར་འགྱུར། །བླ་མའི་དྲིན་གྱིས་ཕན་པའི་ལུང་ཐོབ་ན། །གྲོལ་བར་མི་འགྱུར་སྙམ་ཡང་གྲོལ་བར་གྱུར།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"སློབ་དཔོན་ཤཱཀྱ་འོད་ཀྱི་ཞལ་སྔ་ནས།\", \"head\": \"བླ་མ་ལ་གུས་ཚུལ་ཁྲིམས་ཡོངས་སུ་དག །བསམ་གཏན་དང་ནི་དོན་ལ་རྟག་བརྩོན་དང༌། །སྒྲིམས་ཤིང་དུལ་ལ་བཟོད་དང་ལྡན་པ་སྟེ། །སྡོམ་བརྩོན་གནས་པའི་ཆོས་ལྡན་སློབ་མར་གསུངས།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"མཁན་པོས།\", \"head\": \"སློབ་དཔོན་དེ་ཉིད་དུ་འཛིན་ཅིང༌། །ལེ་ལོ་གཡེང་བ་རྣམ་པར་སྤངས། །ཟོ་བཟང་དད་པ་ལ་བསྟེན་པའི། །སྐྱེས་བུ་དེ་ནི་མྱུར་རྟོགས་ཏེ། །ཅིག་ཤོས་དེ་ལས་ལྡོག་པ་འོ།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཡོན་ཏན་མཛོད་ལས།\", \"head\": \"གོ་ཆ་ཆེ་ལས་བློ་གྲོས་ཤིན་ཏུ་བརྟན། །ལུས་དང་སྲོག་ལ་མི་ལྟ་རིམ་གྲོ་བགྱིད། །ཅི་གསུང་བཀའ་དཀྲི་བདག་ཉིད་མི་སྲུང་བའི། །སྐྱེས་བུ་དེ་ནི་མོས་གུས་ཁོ་ནས་གྲོལ།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"head\": \"བླ་མ་ཤིན་ཏུ་སྲུང་བས་མཛངས་པ་དང༌། །བཀའ་བཀྱོན་དག་ལ་མི་ཁྲོ་རྟ་མཆོག་བཞིན། །གྲུ་ལྟ་འགྲོ་འོང་གནས་ལ་སྐྱོ་བ་སྤང༌། །ཟམ་པ་ལྟ་བུ་བཟང་ངན་ཐམས་ཅད་ཐེག །བཟོ་སྟེགས་བཞིན་དུ་ཚ་གྲང་གང་ཡང་བཟོད། །བཀའ་བཞིན་ཉན་པ་བྲན་ཁོལ་ལྟ་བུ་དང༌། །ང་རྒྱལ་སྤངས་པ་ཕྱག་དར་ལྟ་བུ་དང༌། །དྲེགས་པ་སྤངས་པ་ཁྱུ་མཆོག་རྭ་ཆད་ལྟས། །བླ་མ་བསྟེན་ཞེས་སྡེ་སྣོད་དག་ལས་གསུངས།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"head\": \"བླ་མ་བཞེངས་ཚེ་སྟན་ལ་འདུག་པ་མིན། །བཞུགས་པའི་དུས་ན་བསྙུན་འདྲི་ཉེར་སྤྱད་དབུལ། །གཤེགས་ན་ཞབས་འབྲིང་སྔོན་རྗེས་གཡས་ནས་མིན། །སྟན་དང་བཞོན་པ་འགོམས་སོགས་བསོད་ནམས་ཉམས། །སྒོ་འཕར་བརྡེག་དང་སྒེག་ཆོས་ངོ་འཛུམ་གནག །རྫུན་དང་བབ་ཅོལ་བཞད་གད་བྲེ་མོའི་གཏམ། །སྤོངས་ལ་སྒོ་གསུམ་ཉེ་བར་ཞི་བས་བསྟེན།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"head\": \"རྫིང་བུ་མཆོག་ལ་བསྟེན་པའི་ངང་པ་དང༌། །བུང་བས་མེ་ཏོག་བཅུད་ལ་རོ་མྱང་བཞིན། །རྟག་ཏུ་འགྲོགས་པའི་སྤྱོད་པ་ངོ་མཚར་ཅན། །སྐྱོ་ངལ་མེད་པར་བླ་མའི་ཐུགས་བཟུང་ནས། །དད་པས་ཉེ་བར་ལེན་པའི་ཡོན་ཏན་མྱང༌།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཡིད་བཞིན་མཛོད་ལས།\", \"head\": \"དེ་ཡང་ཉོན་མོངས་ཤས་ཆེ་རང་རྒྱུད་ངན། །ཚེ་འདི་དོན་གཉེར་སྲིད་ལས་ཡིད་མ་འབྱུང༌། །ཐོས་བསམ་ཆུང་ཞིང་ཤེས་བྱའི་གནས་ལ་རྨོངས། །དད་བརྩོན་མི་ལྡན་དགེ་ཚོགས་རིང་དུ་བྱེད།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"head\": \"སྒོ་གསུམ་མ་དུལ་ཁེངས་དང་བཅོས་མའི་ཚུལ། །གཞན་ལ་གཤེ་ཞིང་དག་སྣང་མོས་གུས་མེད། །ཟས་སྐོམ་ནོར་དང་ལོག་པའི་ཆོས་ལ་སྲེད། །མི་དགེ་འཕེལ་ཞིང་དགེ་ལེགས་འགྲིབ་པ་སྟེ།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"head\": \"རང་རྒྱུད་ངན་ཞིང་དག་སྣང་ཆུང་བ་དང༌། །ཕྱོགས་རིས་ཆེ་ཞིང་རང་ཕྱོགས་མཆོག་ཏུ་འཛིན། །བདག་བསྟོད་གཞན་སྨོད་ཡང་དག་ཆོས་སྤོང་ཞིང༌། །ཐེག་ཆེན་དགེ་བའི་བཤེས་ལ་བསྐུར་བ་འདེབས།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"head\": \"གཏི་མུག་ཅན་བསྟེན་ཐོས་བསམ་ཤེས་རབ་འགྲིབ། །ཞེ་སྡང་ཅན་ལས་མ་རུངས་རང་རྒྱུད་ངན། །འདོད་ཆགས་ཅན་ལས་ཡུལ་ལ་སྲེད་པ་འཕེལ། །ང་རྒྱལ་ཅན་ལས་ཕྱོགས་རེས་གཉིས་འཛིན་འགོ\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"head\": \"དེ་དག་དང་འགྲོགས་ཐར་ལམ་བར་དུ་གཅོད། །དགེ་འགྲིབ་བདེ་འགྲོའི་གནས་ཀྱང་མི་འགྲུབ་ན། །ཞི་བདེའི་བྱང་ཆུབ་འགྲུབ་པ་སྨོས་ཅི་དགོས། །དེས་ན་སྡིག་པའི་གྲོགས་པོ་སྤང་བར་བྱ།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"head\": \"ཇི་ལྟར་ལམ་འཕྲང་བགྲོད་པའི་མགྲོན་པོ་དག །ཆོམས་རྐུན་འཇིགས་པས་བཅོམ་ལའང་འཇིགས་ལྟ་ན། །དེ་ཡིས་ཚེ་འདིའི་ནོར་དང་སྲོག་འདོར་གྱིས། །གཏན་གྱི་བདེ་བ་འཕྲོག་པ་ཡོངས་མི་ནུས།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"head\": \"མདོར་ན་སྡིག་པའི་གྲོགས་པོ་བརྟགས་ཏེ་སྤང༌། །དེ་ཡི་ཕན་ཡོན་དམ་པ་ཚད་མེད་དེ། །ལོག་པར་མི་ལྟུང་རྟག་ཏུ་དགེ་བ་འཕེལ། །དམ་པས་བསྟོད་ཅིང་ཡོན་ཏན་ཚོགས་རབ་འགྲུབ།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"དམ་ཆོས་པདྨ་དཀར་པོ་ལས།\", \"head\": \"གཙང་ཞིང་ཡིད་དུ་འོང་བའི་ས་ཕྱོགས་སུ། །མཛེས་པའི་ཁྲི་སྟན་ལེགས་པར་བཤམས་ནས་ནི། །གོས་བཟང་ཡིད་འོང་གཙང་མ་རྣམས་བགོས་ཏེ། །བཅོས་མའི་རས་སོགས་རྣམ་པ་མང་བཏིང་ནས། །རྐང་རྟེན་བཅས་པའི་ཁྲི་ལ་འདུག་ནས་ནི། །རྩེ་གཅིག་ཉན་པའི་འཁོར་གྱི་ཚོགས་ནང་དུ། །ཟང་ཟིང་རྙེད་དང་གྲགས་ལ་མི་སེམས་པར། །བྱམས་པའི་སེམས་ཀྱིས་ལེ་ལོ་མེད་པར་སྟོན།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"head\": \"ཉན་པོ་རྣམ་གཡེངས་འདུ་འཛི་རྣམས་སྤངས་ཏེ། །ཆོས་ཀྱི་མཆོད་པ་རྣམ་མང་རབ་མཆོད་ནས། །ཕྱག་འཚལ་དྲང་པོར་འདུག་སྟེ་ཐལ་མོ་སྦྱར། །མ་ཡེངས་གུས་པའི་ཚུལ་གྱིས་མཉན་པར་བྱ།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"སྡུད་པ་ལས།\", \"head\": \"དགའ་དང་གུས་དང་དད་པའི་མཆོག་ནི་ཉེར་བཞག་སྟེ། །སྒྲིབ་པ་ཉོན་མོངས་བསལ་ནས་དྲི་མ་ལས་འདས་པ། །འགྲོ་དོན་མངོན་ཞུགས་ངེས་པའི་ཤེས་རབ་ཕ་རོལ་ཕྱིན། །གང་ལ་དཔའ་རྣམས་སྤྱོད་པ་དེ་ནི་ཉན་པར་གྱིས།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"རྩེ་མོའི་རྒྱུད་ལས།\", \"head\": \"རྟོག་པ་ཐམས་ཅད་ལེགས་པར་བསྡུས་ནས་ནི། །ཤིན་ཏུ་བསམ་པ་བཟང་པོའི་སེམས་ཀྱིས་ཉོན། །བརྗེད་ངེས་བློ་ལ་ཧེ་རུ་ཀ་སོགས་དང༌། །བདེ་བར་གཤེགས་པ་རྣམས་ཀྱིས་བྱིན་མི་རློབས།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ས་ཡི་སྙིང་པོའི་མདོ་ལས།\", \"head\": \"གཅིག་ཏུ་དད་ཅིང་གུས་པས་ཆོས་ཉན་གྱིས། །དེ་ལ་འཕྱ་ཞིང་སྐུར་བ་མི་བྱའོ། །ཆོས་སྨྲ་བ་ལ་མཆོད་པར་བྱ་བ་ནི། །སངས་རྒྱས་འདྲ་བ་དེ་ལ་འདུ་ཤེས་བསྐྱེད།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"སྐྱེ་རབས་ལས།\", \"head\": \"རབ་ཏུ་དམའ་བའི་སྟན་ལ་འདུག །དུལ་བའི་དཔལ་ནི་རྣམ་པ་བསྐྱེད། །དགའ་དང་ལྡན་པའི་མིག་གིས་བལྟ། །ཚིག་གི་བདུད་རྩི་འཐུང་བ་བཞིན། །རིམ་གྲོ་བསྐྱེད་དེ་ཆོས་ཉོན་ཅིག །ནད་པས་སྨན་པའི་ཚིག་བཞིན་དུ། །རིམ་གྲོ་བསྐྱེད་དེ་ཆོས་ཉོན་ཅིག\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཡུམ་བར་མ་ལས།\", \"head\": \"ལེགས་པར་རབ་ཏུ་ཉོན་ལ་ཡིད་ལ་ཟུངས་ཤིག་དང་ངས་ཁྱོད་ལ་བཤད་པར་བྱའོ།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"མན་ངག་རིན་པོ་ཆེའི་མཛོད་ལས།\", \"head\": \"རྣ་བ་མི་གཏོད་ཁ་སྦུབ་ལྟ་བུའི་སྐྱོན། །ཡིད་ལ་མི་འཛིན་ཞབས་རྡོལ་ལྟ་བུའི་སྐྱོན། །ཉོན་མོངས་དང་འདྲེས་དུག་ཅན་ལྟ་བུའི་སྐྱོན།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"རྣམ་བཤད་རིག་པ་ལས།\", \"head\": \"ང་རྒྱལ་དང་ནི་མ་དད་དང༌། །དོན་དུ་གཉེར་བ་མེད་ཉིད་དང༌། །ཕྱི་རོལ་རྣམ་གཡེང་ནང་དུ་སྡུད། །སྐྱོ་བས་ཉན་པ་དྲི་མ་ཡིན།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"སྡོང་པོ་བཀོད་པ་ལས།\", \"head\": \"རིགས་ཀྱི་བུ་ཁྱོད་ཀྱིས་བདག་ཉིད་ལ་ནད་པའི་འདུ་ཤེས་བསྐྱེད་པར་བྱའོ། །དམ་པའི་ཆོས་ལ་སྨན་གྱི་འདུ་ཤེས་བསྐྱེད་པར་བྱའོ། །དགེ་བའི་བཤེས་གཉེན་ལ་སྨན་པ་མཁས་པའི་འདུ་ཤེས་བསྐྱེད་པར་བྱའོ། །ནན་ཏན་ཉམས་སུ་ལེན་པ་ལ་ནད་ཉེ་བར་འཚོ་བའི་འདུ་ཤེས་བསྐྱེད་པར་བྱའོ།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཡོན་ཏན་མཛོད་ལས།\", \"head\": \"མི་གཞི་ངན་པའི་ཟོལ་སྦྱོར་ཐ་གུས་ལྕིས། །བླ་མ་སྤོས་ཀྱི་གླང་པོ་ལྟར་བསྟེན་ནས། །དམ་ཆོས་གླ་རྩི་རྙེད་པ་ཐོབ་ནས་སླར། །རྔོན་ལ་ཡང་དག་སྤྲོ་བའི་དམ་ཚིག་འཕེན།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཆོས་སྤྱོད་ཀྱི་མན་ངག་ལས།\", \"head\": \"མེ་ཏོག་སྟན་སོགས་རབ་འབུལ་ཞིང༌། །ས་ཕྱོགས་སྤྱོད་ལམ་སྡོམ་པ་དང༌། །སྲོག་ཆགས་ཀུན་ལ་འཚེ་མི་བྱ། །བླ་མ་ལ་ནི་ཡང་དག་དད། །མ་ཡེངས་བླ་མའི་གདམས་ངག་ཉོན། །དོགས་སེལ་ཕྱིར་ན་སྐྱོན་ཚིག་འདྲི། །ཉན་པོ་ཡན་ལག་དྲུག་དང་ལྡན།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"འདུལ་བ་ལུང་ལས།\", \"head\": \"མ་གུས་པ་ལ་ཆོས་མི་བཤད། །མི་ན་བཞིན་དུ་མགོ་གཡོགས་དང༌། །གདུགས་དང་འཁར་བ་མཚོན་ཐོགས་དང༌། །མགོ་བོ་གཡོགས་པ་དག་ལ་མིན།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"head\": \"འགྲེང་ཉལ་དམའ་བར་འདུག་དང་ཕྱི་ནས་འོང༌། །ལམ་གྱི་འགྲམ་དང་དོ་ཀེར་ཞྭ་ཅོད་པན། །འཕྲེང་དང་རལ་གྲི་གླང་པོ་རྟར་བཞོན་དང༌། །མཆིལ་ལྷམ་འཁར་གདུགས་མཚོན་ཆ་རལ་གྲི་དང༌། །དགྲ་ཆ་གོ་ཆ་གྱོན་པ་རྣམས་ལ་བཤད།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"མདོ་ལས།\", \"head\": \"ཇི་ལྟར་ཁྱིམ་ནི་ལེགས་གཡོགས་པ། །མུན་པས་ཁེབས་པའི་ནང་ཞུགས་ན། །མིག་ལྡན་བཞིན་དུ་མཐོང་མི་ནུས། །དེ་བཞིན་འདི་ནང་རིགས་སྐྱེས་པའི། །མི་ནི་བློ་གྲོས་ལྡན་གྱུར་ཀྱང༌། །སྡིག་པ་དང་ནི་དགེ་བའི་ཆོས། །མ་ཐོས་བར་དུ་ཤེས་མི་འགྱུར།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཆེད་དུ་བརྗོད་པའི་ཚོམས་ལས།\", \"head\": \"ཐོས་པས་ཆོས་རྣམས་ཤེས་པར་འགྱུར། །ཐོས་པས་སྡིག་ལས་ལྡོག་པར་འགྱུར། །ཐོས་པས་དོན་མ་ཡིན་པ་སྤོང། །ཐོས་པས་མྱ་ངན་འདས་པ་ཐོབ།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"སྐྱེ་རབས་ལས།\", \"head\": \"ཐོས་པ་མ་རིག་མུན་སེལ་སྒྲོན་མེ་ཡིན། །རྐུན་པོ་ལ་སོགས་མི་ཁྱེར་ནོར་གྱི་མཆོག །ཀུན་ཏུ་རྨོངས་པའི་དགྲ་འཇོམས་མཚོན་ཆ་ཡིན། །གྲགས་དང་དཔལ་དང་གཏེར་གྱི་མཆོག་ཀྱང་ཡིན། །ཡ་རབས་རྣམས་དང་ཕྲད་ན་སྐྱེས་ཀྱི་མཆོག །ཚོགས་ཀྱི་ནང་ན་མཁས་རྣམས་མགུ་བར་འགྱུར།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཆོས་ཀྱི་དབང་པོའི་ཞལ་སྔ་ནས།\", \"head\": \"ཐར་པ་མཐུན་པའི་ཚོགས་ཀྱི་ལམ་མཆོག་ཏུ། །ཐོས་པ་ཁོ་ནས་རང་རྒྱུད་གྲོལ་དགོས་ཏེ། །སྒོམ་པའི་ཡེ་ཤེས་ཅིག་ཅར་སྐྱེ་དཀའ་བས། །ཤེས་རབ་གསུམ་ལས་དང་པོ་ཐོས་པ་མཆོག\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"མདོ་ལས།\", \"head\": \"དམ་ཆོས་ཉན་པའི་དུས་དག་གི །རྔའམ་གཎྜི་བརྡུང་བའི་སྒྲ། །ཐོས་པས་བྱང་ཆུབ་ཐོབ་གྱུར་ན། །ཉན་རྣམས་ལྷག་པར་སྨོས་ཅི་དགོས།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"སོ་སོ་ཐར་པ་ལས།\", \"head\": \"མང་དུ་ཐོས་པ་ནགས་ཀྱི་ནང་དག་ཏུ། །ལང་ཚོ་ཡོལ་བ་རྣམས་ཀྱིས་གནས་པ་བདེ།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"སྐྱེ་རབས་ལས།\", \"head\": \"ཐོས་པའི་རྗེས་སུ་སྒྲུབ་ལ་ནན་ཏན་སྦྱོར། །སྐྱེ་བའི་རྫོང་ལས་ཚེགས་ཆུང་ཐར་བར་འགྱུར།\", \"tail\": \"\"}]}",
