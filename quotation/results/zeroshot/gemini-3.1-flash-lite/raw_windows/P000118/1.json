  "raw_text": "{\n  \"spans\": [\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"རྗེ་བཙུན་མ་ཕམ་པས།\",\n      \"head\": \"ས་ནི་དང་པོ་ཡིན་པར་འདོད། །འདི་ནི་བསྐལ་པ་དཔག་མེད་ཀྱིས། །\",\n      \"tail\": \"\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"head\": \"གྲངས་མེད་གཉིས་ནི་རྫོགས་པ་ཡིས། །སྒོམ་པའི་ལམ་ནི་ཚར་ཕྱིན་ཏེ། །\",\n      \"tail\": \"\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"དེ་དང་མཐུན་པར་འཇིགས་མེད་ཞབས་ཀྱིས།\",\n      \"head\": \"དེ་ལྟར་བསྐལ་པ་གྲངས་མེད་པ་དང་པོས་ཚོགས་ཀྱི་ས་ནས་བརྩམས་ནས་ས་དང་པོའི་བར་རྫོགས་པར་བྱེད་དོ། །གཉིས་པས་ནི་དྲི་མ་མེད་པ་ལ་སོགས་པ་དྲུག་གོ །གསུམ་པས་ནི་མི་གཡོ་བའི་ས་ནས་བརྩམས་ཏེ་སངས་རྒྱས་ཀྱི་ས་ཡི་བར་རོ་\",\n      \"tail\": \"ཞེས་མདོ་ལས་སོ། །\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"མདོ་རྒྱ་ཆེར་རོལ་པ་ལས་ཀྱང༌།\",\n      \"head\": \"བསྐལ་པ་གྲངས་མེད་པ་བདུན་དུ་དགེ་བའི་རྩ་བ་ཡང་དག་པར་བསྒྲུབས་པ།\",\n      \"tail\": \"\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"ཨ་བྷ་ཡ་དང་སྟོབས་བཅུ་དཔལ་བཤེས་ཀྱིས།\",\n      \"head\": \"འདི་ལྟར་བྱང་ཆུབ་སེམས་དཔའི་ཚོགས་ཀྱི་ཀུན་ཏུ་རྫོགས་པ་ནི་བསྐལ་པ་གྲངས་མེད་གཅིག་འདའ་བར་འགྱུར་རོ། །དེའི་རྗེས་སུ་མོས་པས་སྤྱོད་པའི་ས་ཡོངས་སུ་རྫོགས་པར་འགྱུར་བ་ནི་བསྐལ་པ་གྲངས་མེད་གཉིས་འདའོ། །དེའི་རྗེས་སུ་ས་དང་པོ་རབ་ཏུ་དགའ་བ་ནས་བཟུང་སྟེ་ས་བཅུ་པ་ཆོས་ཀྱི་སྤྲིན་གྱིས་ཇི་སྲིད་དུ་སོ་སོར་བསྐལ་པ་གྲངས་མེད་གསུམ་གྱིས་རྫོགས་པར་བྱས་ཏེ། སངས་རྒྱས་ཀྱི་ས་ཀུན་ཏུ་བཟང་པོ་སྒྲུབ་པར་བྱེད་པོར་འགྱུར་རོ། །དེ་ལྟར་བསྐལ་པ་གྲངས་མེད་སུམ་ཅུ་རྩ་གསུམ་གྱིས་སངས་རྒྱས་ཉིད་ཐོབ་བོ་ཞེས་ཟེར་རོ་\",\n      \"tail\": \"ཞེས་ཟེར་རོ་\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"དཀོན་མཆོག་སྤྲིན་གྱི་མདོར།\",\n      \"head\": \"དེ་བཞིན་གཤེགས་པ་ནི་བསྐལ་པ་གྲངས་མེད་པ་དུ་མས་ཡང་དག་པར་བསྒྲུབས་པ་ཡིན་ཏེ། རིགས་ཀྱི་བུ། དེ་བཞིན་གཤེགས་པ་ནི་དཔག་པ་དང༌། བསམ་པ་དང༌། བརྟག་པར་མི་ནུས་སོ། །\",\n      \"tail\": \"\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"བྱང་ས་ལས།\",\n      \"head\": \"བསྐལ་ཆེན་རེ་ལ་ལོ་ཟླ་ཞག་དུས་སྐད་ཅིག་སོགས་གྲངས་མེད་པས་གྲངས་མེད་དུ་བཏགས་པའི་ཕྱོགས་གཅིག་དང༌། བསྐལ་ཆེན་ཉིད་བགྲང་བ་ལས་འདས་པ་ལ་གྲངས་མེད་དུ་བཏགས་པའི་ཕྱོགས་གཅིག་སྟེ་རྣམ་གཞག་གཉིས་གསུངས་པ་\",\n      \"tail\": \"གཉིས་གསུངས་པ་\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"ཐེག་བསྡུས་ལས།\",\n      \"head\": \"བཟང་དང་སྨོན་པའི་སྟོབས་ཅན་དང༌། །སེམས་བརྟན་ཁྱད་པར་འགྲོ་བ་ཡི། །བྱང་ཆུབ་སེམས་དཔའ་གྲངས་མེད་གསུམ། །ཀུན་ཏུ་རྩོམ་པར་མཛད་པ་ཡིན། །\",\n      \"tail\": \"\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"དཀོན་མཆོག་སྤྲིན་ལས།\",\n      \"head\": \"དོན་དམ་བྱང་ཆུབ་ཀྱི་སེམས་ཇི་ལྟ་བ་བཞིན་ཐོག་མར་མངོན་དུ་གསལ་བར་མཛད་པ་ས་དང་པོ་ཐོབ་པ་ནས་བགྲང་བར་གསུངས་པ་\",\n      \"tail\": \"\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"སྡུད་པ་ལས།\",\n      \"head\": \"བདག་ཉིད་ཆེན་པོ་སེམས་ཅན་ཡོངས་སུ་སྨིན་བྱ་དང༌། །ཞིང་སྦྱོང་ཕ་རོལ་ཕྱིན་རྫོགས་དོན་བྱེད་ཁོ་ནར་ཟད། །\",\n      \"tail\": \"\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"མདོ་སྡེ་རྒྱན་ལས།\",\n      \"head\": \"ལུས་ཅན་ཐེག་པ་ཆེན་པོ་དང༌། །ཐེག་པ་དམན་ལ་མོས་པ་དང༌། །གཉིས་པོ་འདུན་པར་བྱ་བ་དང༌། །གདུལ་བའི་ཞིང་ན་བརྟན་རྣམས་ཀྱི། །སྤྱོད་པ་བཞི་པོ།\",\n      \"tail\": \"\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"ལང་ཀར་གཤེགས་པ་ལས།\",\n      \"head\": \"གཙང་མའི་རིས་དག་སྤངས་པ་ཡི། །འོག་མིན་གནས་མཆོག་ཉམས་དགའ་བར། །ཡང་དག་སངས་རྒྱས་དེར་སངས་རྒྱས། །སྤྲུལ་པ་པོ་གཅིག་འདིར་སངས་རྒྱས། །\",\n      \"tail\": \"\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"ལང་ཀར་གཤེགས་པ་ལས།\",\n      \"head\": \"འདོད་པའི་ཁམས་དང་གཟུགས་མེད་དུ། །སངས་རྒྱས་མངོན་པར་འཚང་མི་རྒྱ། །གཟུགས་ཀྱི་ཁམས་ཀྱི་འོག་མིན་དུ། །འདོད་ཆགས་བྲལ་ཁྱེད་དེར་སངས་རྒྱས། །\",\n      \"tail\": \"\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"སློབ་དཔོན་ངག་དབང་གྲགས་པས།\",\n      \"head\": \"དཔལ་ལྡན་སྟུག་པོ་བཀོད་པ་ཉིད་དུ་དོན་དམ་ཐུགས་ཆུད་ཅིང༌། །དགའ་ལྡན་སྐྱེ་བོའི་དོན་མཛད་ཕྱིར་ནི་དམ་པ་ཏོག་དཀར་གྱུར། །དེ་ནས་འདིར་ནི་འགྲོ་བའི་དོན་དུ་ཤཱཀྱའི་ཏོག་གྱུར་གང༌། །འཆི་བདག་ལས་རྒྱལ་སྒྱུ་མ་ཀུན་སྟོན་དེ་ནི་རྒྱལ་གྱུར་ཅིག །\",\n      \"tail\": \"\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"རྡོ་རྗེ་ཐེག་པ་བྱ་བའི་རྒྱུད་ལས་ནི།\",\n      \"head\": \"མེ་ཏོག་ཀུན་ཏུ་སྟོན་ལས་སྔགས་ཐོས་ནས། །སྤྱོད་པ་སྤྱད་མཐར་དགའ་ལྡན་ནས་སྤྲུལ་སོགས། །\",\n      \"tail\": \"\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"རྣལ་འབྱོར་རྒྱུད་དེ་ཉིད་བསྡུས་པ་ནས།\",\n      \"head\": \"བྱང་ཆུབ་སེམས་དཔའ་དོན་གྲུབ་བྱང་ཆུབ་ཀྱི་སྙིང་པོར་བཞུགས་པ་ལ་སངས་རྒྱས་རྣམས་ཀྱིས་བསྐུལ་ནས། མི་གཡོ་བའི་ཏིང་ངེ་འཛིན་ལས་བཞེངས་ཏེ་སེམས་བསྐྱེད་ཅིང་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱིས་དབང་བསྐུར་ནས་མངོན་པར་རྫོགས་པར་སངས་རྒྱས་པར་བཤད་དོ། །\",\n      \"tail\": \"\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"སངས་རྒྱས་ཡེ་ཤེས་ཞབས་ཀྱི་གྲོལ་བའི་ཐིག་ལེ་ལས།\",\n      \"head\": \"ཅི་ཕྱིར་ཤཱཀྱ་ཐུབ་པ་ཡིས། །གྲངས་མེད་གསུམ་དུ་ཚོགས་བསགས་ཀྱང༌། །འདི་དོན་མ་རྟོགས་ནཻ་རཉྫར། །ཅི་ཡང་མ་ཡིན་ཏིང་འཛིན་གནས། །དེ་ཚེ་ཕྱོགས་བཅུའི་བདེ་གཤེགས་ཀྱིས། །ཐལ་བྱུང་བློ་ཅན་དེ་བཟློག་སྟེ། །ནམ་མཁའི་དབྱིངས་ལྟར་རྣམ་དག་པའོ། །ཟབ་གསལ་གཉིས་མེད་རབ་བསྟན་པས། །ནམ་ཕྱེད་དུས་ན་རྒྱལ་བ་ལྟར། །དེ་ཉིད་བསྒོམས་པས་ཐོ་རངས་དུས། །སྐད་ཅིག་གིས་ནི་ཡང་དག་རྟོགས། །འགྲོ་བ་འདུལ་བར་བྱ་བའི་ཕྱིར། །བྱང་ཆུབ་སྙིང་པོར་བཞུགས་ནས་ཀྱང༌། །དཔུང་ཆེན་བདུད་རྣམས་རབ་བཅོམ་སྟེ། །སེམས་ཅན་གཟུང་བར་བྱ་དོན་དུ། །ཆོས་ཀྱི་འཁོར་ལོ་བསྐོར་བའོ། །\",\n      \"tail\": \"\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"སྔ་འགྱུར་གྱི་རྒྱུད་སྒྱུ་འཕྲུལ་བླ་མ་ལས་ཀྱང༌།\",\n      \"head\": \"དོན་གྲུབ་དཀའ་ཐུབ་ལུས་ཅན་ལ། །ཕྱོགས་བཅུའི་རྒྱལ་བ་སྤྲིན་བཞིན་དུ། །འདུས་པས་ལོངས་སྤྱོད་དོན་གྱི་ཕྱིར། །སྲོད་དང་ཐོ་རངས་དུས་ཉིད་དུ། །ཉི་ཟླ་ཟ་བའི་དབང་བྱིན་ནས། །རོལ་པའི་ཀ་ར་བསྟན་པ་ཡིས། །དེ་བཞིན་དེ་བཞིན་གཤེགས་པའོ། །\",\n      \"tail\": \"\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"རྩེ་མོར།\",\n      \"head\": \"བསྐལ་པ་གྲངས་མེད་སྔོན་དུ་ནི། །བཅོམ་ལྡན་བྱང་ཆུབ་མཛད་པ་གང༌། །\",\n      \"tail\": \"\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"རྡོ་རྗེ་སྙིང་པོ་རྒྱན་གྱི་རྒྱུད་ལས།\",\n      \"head\": \"དེ་ནས་བཅོམ་ལྡན་འདས་ཤཱཀྱ་ཐུབ་པས་དེ་དག་གིས་གསོལ་བ་བཏབ་པའི་ཚིག་ཉེ་བར་གསན་ནས། འོག་མིན་གྱི་གནས་ནས་བྱོན་ཏེ་དགའ་ལྡན་གྱི་གནས་སུ་བཞུགས་ནས་དགའ་ལྡན་གྱི་རིས་ཀྱི་ལྷའི་བུ་རྣམས་ལ་ཆོས་བསྟན་ནས་ཟས་གཙང་གི་རིགས་ལ་མངོན་པར་གཟིགས་ཏེ།\",\n      \"tail\": \"\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"དུས་འཁོར་བསྡུས་རྒྱུད་ལས།\",\n      \"head\": \"མི་རྣམས་དགྲོལ་བའི་དོན་དུ་སྲས་དང་བཅས་པ་རྒྱལ་བའི་བདག་པོ་ལས་ཀྱི་སར་ནི་རབ་བཞུགས་ཏེ། །མངལ་ནི་རབ་ཏུ་བཟུང་བར་མཛད་ཅིང་མཆོག་གི་ཐུགས་རྗེ་དག་གིས་བྱང་ཆུབ་བསྐྱེད་པར་མཛད་ནས་ནི། །\",\n      \"tail\": \"\"\n    }\n  ]\n}",
