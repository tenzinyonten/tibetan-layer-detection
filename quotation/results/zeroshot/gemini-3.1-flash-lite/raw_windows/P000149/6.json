  "raw_text": "{\"spans\": [{\"label\": \"QUOTE\", \"frame\": \"ཀུན་མཁྱེན་ཆོས་རྗེས།\", \"head\": \"ཡང་བསམ་ཡང་གཞིགས་རིག་\", \"tail\": \"གཤིས་དོན་སྙིང་པོ་གནས། །\"}, {\"label\": \"QUOTE\", \"frame\": \"དཔལ་རང་བྱུང་ཞབས་ཀྱིས།\", \"head\": \"ཡོད་པ་མ་ཡིན་རྒྱལ་བས་\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"head\": \"ལྷུན་གྲུབ་ངོ་བོ་སུས་ཀྱང་མ་བྱས་པར། །འཆར་ཚུལ་མ་འགགས་ཅིར་ཡང་སྣང་དུ་རུང་། །འཁོར་འདས་ཀུན་འབྱུང་སྔ་ཕྱི་ཐོག་མཐའ་བྲལ། །སྐྱེ་མེད་ལྷུན་གྲུབ་མ་ངེས་དོན་གྱི་གཞི། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"head\": \"མེད་པ་མ་ཡིན་འཁོར་འདས་ཀུན་གྱི་གཞི། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"head\": \"འགལ་འདུ་མ་ཡིན་བརྗོད་\", \"tail\": \"བྱའི་ཡུལ་ལས་འདས། །\"}, {\"label\": \"QUOTE\", \"frame\": \"མན་ངག་གསེར་ཞུན་ལས།\", \"head\": \"སེམས་དེ་ངོས་བཟུང་གང་ཡང་མེད། །ཡོད་ན་ཡོད་པ་དེ་བསྒོམ་སྟེ། །མེད་ན་མེད་པ་དེ་བསྒོམ་ཀྱང་། །དེ་གཉིས་གང་དུ་ཕྱོགས་མི་ཆོད། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"head\": \"གཉིས་ཀ་མ་ཡིན་གཉིས་ཆོས་སྤངས། །གཅིག་ཏུ་མ་ཆོད་གཉིས་ཀར་སྣང་། །འདི་ཞེས་དམིགས་པ་མེད་པ་འདི། །སེམས་ཉིད་རྒྱལ་པོ་རང་གི་བབ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཨོ་རྒྱན་ཆེན་པོས།\", \"head\": \"བལྟས་པས་མཐོང་རྒྱུ་མེད་\", \"tail\": \"རང་གི་སེམས་ལ་ལྟོས། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཨོ་རྒྱན་ཆེན་པོས།\", \"head\": \"སེམས་ཉིད་མ་རྙེད་བྱ་བ་\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"པདྨ་བི་ཛས།\", \"head\": \"ངོ་བོ་ལ་རྟག་ཆད་མི་འདུག་ན། །རང་བཞིན་ལ་འཕོ་འགྱུར་མི་འདུག་ན། །ཆོས་དབྱིངས་ལ་བྲི་གང་མི་འདུག་ན། །འབྲས་བུ་ལ་ཐོབ་ཤོར་མི་འདུག་ན། །ལམ་ནོར་གོལ་བྱ་བ་ཅི་ལ་ཟེར། །སྒོམ་མ་བྱུང་བྱ་བ་ཅི་ལ་ཟེར། །གནད་མ་ཤེས་བྱ་བ་ཅི་ལ་ཟེར། །དོན་མ་རྟོགས་བྱ་བ་ཅི་ལ་ཟེར། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཇི་སྐད་དུ།\", \"head\": \"རང་གི་རང་གསལ་ཉི་མའི་སྙིང་པོ་འདྲ། །འདྲ་འམ་མི་འདྲ་རང་གི་སེམས་ལ་ལྟོས། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"head\": \"དངོས་ཆོས་རྡུལ་ཙམ་མེད་པར་ཡང་། །ཀུན་གསལ་ཤེས་པའི་རྩལ་དང་ལྡན། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"གནས་ལུགས་རིན་པོ་ཆེའི་མཛོད་ལས།\", \"head\": \"ཤར་གྲོལ་རིས་མེད་བདེ་ཀློང་གཅིག་ཏུ་འཁྱིལ། །ཤར་བའི་དུས་ན་རང་ཤར་རང་ས་ཟིན། །གནས་པའི་དུས་ན་རང་གནས་རང་ས་ཟིན། །གྲོལ་བའི་དུས་ན་རང་གྲོལ་རང་ས་ཟིན། །ཆོས་ཉིད་ཀློང་ནས་ཤར་གནས་རང་གྲོལ་བས། །གཞན་ནས་མ་གཡོས་ཆོས་སྐུའི་རོལ་པ་ཙམ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"head\": \"གང་སྣང་ཅི་ཤར་འཕྲོ་གནས་ཐམས་ཅད་དང་། །དུག་ལྔ་ལ་སོགས་རིག་པའི་རྩལ་རྣམས་ལ། །ཇི་ལྟར་འཆར་བ་དེ་ཉིད་རང་དུས་དེར། །ངོ་ཤེས་རྩལ་རྫོགས་རང་ཡལ་རྗེས་མེད་འགྲོ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"སྤྲོས་བྲལ་དོན་གསལ་ཆེན་པོའི་རྒྱུད་ལས།\", \"head\": \"རང་བྱུང་རིག་པ་ཆོས་སྐུ་དེ། །ཅི་ཡི་ངོ་བོར་མ་གྲུབ་པས། །མཚན་མ་འདུས་བྱས་ཐེ་ཚོམ་ཆོད། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"head\": \"ཆོས་སྐུ་རང་བྱུང་ཡེ་ཤེས་ལ། །རྒྱུ་རྐྱེན་མེད་པས་འདུས་བྱས་མེད། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"རྫོགས་ཆེན་ངེས་དོན་འདུས་པའི་རྒྱུད་ལས།\", \"head\": \"སྔ་ཕྱི་མེད་པར་རང་བྱུང་སྐུ། །སེམས་ལས་མ་བྱུང་སངས་རྒྱས་ཡིན། །འཕོ་འགྱུར་མེད་པས་སྡུག་བསྔལ་བྲལ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"head\": \"ད་ཡང་འདུས་པའི་སྙིང་པོ་ཉོན། །ངེས་དོན་སངས་རྒྱས་ཁྱད་པར་ཅན། །ཀུན་གཞི་མེད་ཕྱིར་སྣང་བ་མེད། །དེ་ཕྱིར་སེམས་མེད་རིག་པ་འདི། །སེམས་ལས་མ་བྱུང་སངས་རྒྱས་ཡིན། །ཐེག་དགུའི་ཆོས་ལས་ཁྱད་པར་འཕགས། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"head\": \"ཚོགས་བརྒྱད་མེད་ཕྱིར་སེམས་དང་བྲལ། །རང་བྱུང་སྙིང་པོའི་ཆོས་ཀྱི་སྐུ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"མདོ་སྡེ་རྒྱན་དུ།\", \"head\": \"ཆོས་ཉིད་སེམས་ལས་གཞན་པའི་སེམས་གཞན་ནི། །འོད་གསལ་མ་ཡིན་རང་བཞིན་ལ་བརྗོད་དོ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"རྒྱུད་བླ་མར།\", \"head\": \"སེམས་ཀྱི་རང་བཞིན་འོད་གསལ་གང་ཡིན་པ། །དེ་ནི་ནམ་མཁའ་བཞིན་དུ་འགྱུར་མེད་དོ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ནོར་བུ་ཕྲ་བཀོད་ལས།\", \"head\": \"སེམས་ནི་བག་ཆགས་ཀུན་གྱི་རྩ་བ་སྟེ། །སེམས་ཅན་ཀུན་གྱི་དྲི་མ་དང་པོར་བསྟན། །ཡིད་ནི་རླུང་དང་འདྲ་སྟེ་བག་ཆགས་བསྡུད། །སེམས་ཅན་ཀུན་གྱི་དྲི་མ་གཉིས་པར་བཤད། དབུགས་ནི་ཆུ་དང་འདྲ་སྟེ་བག་ཆགས་ཀུན་གྱི་གནས། སེམས་ཅན་ཀུན་གྱི་དྲི་མ་གསུམ་པའོ། །དུག་ལྔ་མེ་དང་འདྲ་སྟེ་སྣང་བ་ཡུལ་ལ་མཆེད། །སེམས་ཅན་ཀུན་གྱི་དྲི་མ་བཞི་པའོ། །འགྲོ་བ་ཀུན་ལ་དེ་བཞིན་རབ་ཏུ་གནས། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"རྫོགས་ཆེན་ངེས་དོན་འདུས་པའི་རྒྱུད་ལས།\", \"head\": \"སེམས་ལ་དུས་གསུམ་ཡོད་པའི་ཕྱིར། །ཚེ་ལ་སྔ་ཕྱི་ད་ལྟ་བྱུང་། །སེམས་ལ་འཕོ་འགྱུར་ཡོད་པའི་ཕྱིར། །དེ་ཕྱིར་ལུས་ལ་སྐྱེ་འཆི་བྱུང་། །ན་ཚ་བདེ་སྡུག་སྣ་ཚོགས་པ། །རང་སེམས་ཡིན་ཕྱིར་འཁོར་བར་སྨིན། །དེ་ཕྱིར་སེམས་ནི་སངས་རྒྱས་མིན། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"head\": \"རྒྱུ་ནི་འདུས་བྱས་མི་རྟག་ཕྱིར། །གཉེན་པོས་འཇིག་ཕྱིར་རྐྱེན་ཁར་འགྲོ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"head\": \"ཀུན་གཞིའི་དོན་ནི་འདུས་བྱས་ལ། །དེ་ལ་གཉེན་པོ་མེད་མི་སྲིད། །ལྷག་མཐོང་རང་བྱུང་ཡེ་ཤེས་ཀྱིས། །ཀུན་གཞི་རྩད་ནས་འཇོམས་པར་བྱེད། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"head\": \"མ་རྟོགས་རྨོངས་པའི་གང་ཟག་རྣམས། །ཆོས་སྐུ་རང་ཡང་སེམས་ཡིན་ཟེར། །དེ་ཕྱིར་ཚིག་ལས་དོན་མ་གོ། །མིང་ལས་ངེས་དོན་ཤེས་པ་དཀོན། །དེ་ཕྱིར་སེམས་ནི་སངས་མི་རྒྱ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"རང་ཤར་ལས།\", \"head\": \"རིག་པ་དང་མ་རིག་པའི་དཔེ་ནི་ཆུ་དང་རི་མོའི་ཚུལ་དེ། \", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"མུ་ཏིག་ཕྲེང་བ་ལས།\", \"head\": \"སེམས་དང་ཡེ་ཤེས་དབྱེ་བ་ནི། །མཁས་པ་རྣམས་ཀྱི་ཤེས་པར་བྱ། །སེམས་ནི་བག་ཆགས་ཀུན་གྱི་གཞི། །ལུས་ཅན་རྣམས་ཀྱི་དྲི་མ་ཡིན། །གཟུང་བ་ཡུལ་ལ་འཛིན་པ་སེམས། །དེ་ཕྱིར་འཁོར་བའི་ཆོས་ཉིད་དོ། །སེམས་དེ་བྲལ་ན་སངས་རྒྱས་ས། །ལུས་ཅན་ཀུན་གྱི་དྲི་མ་ཟད། །འགྲོ་བ་རྣམས་ནི་སེམས་དེས་འགྲོ། །དེ་མིན་འགྲོ་བར་ནུས་མིན་ཏེ། །དེ་ཕྱིར་འགྲོ་རྣམས་འཁྲུལ་འཁོར་བཞིན། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཀློང་དྲུག་པ་ལས།\", \"head\": \"རང་རིག་བསམ་པ་བྲལ་བ་དང་། །སེམས་ཀྱི་བྱུང་ཚུལ་སྣ་ཚོགས་གཉིས། །འདྲ་འོ་འདྲ་འོ་ནོར་ར་རེ། །ཤེས་རབ་རང་རྩལ་རྫོགས་པ་དང་། །ཡིད་ཀྱི་དྲན་པ་ཕྱིར་ཤོར་གཉིས། །འདྲ་འོ་འདྲ་འོ་ནོར་ར་རེ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"དཀོན་མཆོག་བརྩེགས་པ་ལས།\", \"head\": \"སེམས་དང་ཡིད་དང་རྣམ་པར་ཤེས་པ་དང་བྲལ་ལ། ཏིང་ངེ་འཛིན་གྱི་གནས་ཀྱང་མི་འདོར་བ་སྟེ་འདི་ནི་དེ་བཞིན་གཤེགས་པ་རྣམས་ཀྱི་ཐུགས་ཀྱི་གསང་བ་བསམ་གྱིས་མི་ཁྱབ་པའོ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཚིག་གསལ་ལས།\", \"head\": \"སེམས་དང་སེམས་ལས་བྱུང་བའི་སྤྲོས་པ་ཡང་རྒྱུན་ཆད་པ་དང་། \", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"head\": \"སེམས་འགགས་པ་དེ་སྐུ་ཡིས་མངོན་སུམ་མཛད། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"རྫོགས་པ་ཆེན་པོ་ནམ་མཁའ་དང་མཉམ་པའི་རྒྱུད་ལས།\", \"head\": \"པདྨ་འདམ་གྱིས་མ་གོས་ལྟར། །བྱང་ཆུབ་སེམས་ཀྱི་ངོ་བོ་ལ། །གཟུང་འཛིན་དྲི་མ་གཞི་ལ་མེད། །དེ་ཕྱིར་རང་བྱུང་སྙིང་པོ་འདི། །སུས་ཀྱང་མ་བྱས་མཛད་བཅོས་མིན། །རང་བྱུང་རིག་པའི་རྒྱལ་པོ་ཡིན། །དེ་ཕྱིར་འདུས་མ་བྱས་པའི་ཐུགས། །དེ་ལ་གཉེན་པོས་མི་བཤིག་ཕྱིར། །བཞག་ཅིང་བླང་བར་ནུས་པ་མེད། །དེ་དོན་རྟོགས་པའི་རྣལ་འབྱོར་དེ། །མི་ཡི་ལུས་ལ་སངས་རྒྱས་ཐུགས། །རང་བྱུང་སྐུ་ལ་ཚངས་པའི་གསུང་། །དེ་མ་ཐག་ཏུ་ཀུན་བཟང་ཉིད། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"head\": \"དུས་གསུམ་སངས་རྒྱས་སེམས་དང་བྲལ། །ཚོགས་བརྒྱད་མེད་པས་སེམས་ཀྱང་མེད། །རང་བྱུང་སྙིང་པོ་ཆོས་ཀྱི་སྐུ། །སེམས་ལས་མ་བྱུང་ཡེ་ཤེས་ཡིན། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"རྫོགས་ཆེན་ལྟ་བ་ཡེ་ཤེས་གཏིང་རྫོགས་ཀྱི་རྒྱུད་ལས།\", \"head\": \"ཡེ་ནས་གནས་པའི་རང་བྱུང་སྙིང་པོ་འདི། །རྒྱུ་ལས་མ་བྱུང་རྐྱེན་གྱིས་མ་བསྐྱེད་པས། །རྩོལ་བ་གང་ཡང་མ་བྱས་ཆོས་སྐུ་རུ། །རང་བྱུང་ཡེ་ཤེས་ཡིན་པར་ཡིད་ཀྱང་ཆེས། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"རིག་པ་རང་ཤར་ཆེན་པོའི་རྒྱུད་ལས།\", \"head\": \"བརྗོད་པའི་མཐའ་དང་བྲལ་བའི་ཆོས་སྐུ་ཆེན་པོ་འདི། །ཀུན་ལ་གནས་ཏེ་ཀུན་གྱི་རྟོགས་པ་མེད། །ཡིད་མེད་སེམས་མེད་མ་རིག་འཁྲུལ་པ་མེད། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"head\": \"སེམས་དང་བྲལ་བའི་རིག་པ་ལ། །སྣ་ཚོགས་སྣང་བ་དུས་གཅིག་རྫོགས། །\", \"tail\": \"\"}]}",
