  "raw_text": "{\"spans\": [{\"label\": \"QUOTE\", \"frame\": \"དཔལ་སྦས་ཀྱི་ཞུས་མདོ་ལས།\", \"head\": \"གང་གིས་ཕྱོགས་བཅུའི་སངས་རྒྱས་ལ། །\", \"tail\": \"ནམ་མཁར་གང་བ་རྟག་ཏུ་གནས། །\"}, {\"label\": \"QUOTE\", \"frame\": \"གུར་ལས།\", \"head\": \"སངས་རྒྱས་བྱང་ཆུབ་སེམས་དཔའ་དང་། །\", \"tail\": \"སངས་རྒྱས་སྐད་ཅིག་དེ་ལ་འབྱོན། །\"}, {\"label\": \"QUOTE\", \"frame\": \"རྒྱུད་ལས།\", \"head\": \"རྫས་དང་སྔགས་ཀྱི་སྦྱོར་བ་ལ། །\", \"tail\": \"དེ་ལ་སྦྱོར་བའི་དངོས་གྲུབ་ཉེ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཨོ་རྒྱན་ཆེན་པོས།\", \"head\": \"མ་ཡེངས་ཏིང་འཛིན་ལྡན་པས་བཟླ། །\", \"tail\": \"བསྐལ་པར་བཟླས་ཀྱང་འབྲས་མི་འབྱིན། །\"}, {\"label\": \"QUOTE\", \"frame\": \"རྔམ་གློག་ལས།\", \"head\": \"སྒྲ་ཆེན་མ་ཡིན་སྒྲ་ཆུང་མིན། །\", \"tail\": \"གླལ་སོགས་བར་དུ་ཆོད་པ་མིན། །\"}, {\"label\": \"QUOTE\", \"frame\": \"དམ་ཚིག་བཀོད་པ་ལས།\", \"head\": \"རྫོགས་པའི་རིམ་པ་བསྐལ་པའི་བར་དུ་ནི། །\", \"tail\": \"འབུམ་ཕྲག་ཉི་ཤུའི་ཆར་ཡང་མི་ཕོད་དོ། །\"}, {\"label\": \"QUOTE\", \"head\": \"མཚན་དང་དཔེ་བྱད་ལྡན་པའི་སྐུ། །\", \"tail\": \"སྐད་ཅིག་བླ་མ་དྲན་པ་མཆོག །\"}, {\"label\": \"QUOTE\", \"head\": \"བསྙེན་སྒྲུབ་བཟླས་པ་ས་ཡ་བས། །\", \"tail\": \"བླ་མའི་གསོལ་འདེབས་ལན་གཅིག་མཆོག །\"}, {\"label\": \"QUOTE\", \"head\": \"དྲིན་དང་ལྡན་པའི་བླ་མ་དེ། །\", \"tail\": \"གང་ཟག་དེ་ཡིས་འཛིན་པར་བྱེད། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཀུན་འདུས་རིན་པོ་ཆེའི་རྒྱུད་ལས།\", \"head\": \"གང་གིས་བསྐལ་པ་འབུམ་ཕྲག་ཏུ། །\", \"tail\": \"བསོད་ནམས་དེ་ནི་ཕ་མཐའ་ཡས། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཕལ་པོ་ཆེ་ལས།\", \"head\": \"འགྲོ་ཀུན་དགེ་བ་ཇི་སྙེད་ཡོད་པ་དང་། །\", \"tail\": \"ཀུན་ནས་ཀུན་ཀྱང་བཟང་པོ་རེག་གྱུར་ཅིག །\"}, {\"label\": \"QUOTE\", \"frame\": \"བློ་གྲོས་རྒྱ་མཚོའི་ཞུས་མདོ་ལས།\", \"head\": \"ཇི་ལྟར་ཆུ་ཐིགས་རྒྱ་མཚོ་ཆེ་ནང་ལྷུང་། །\", \"tail\": \"བྱང་ཆུབ་མ་ཐོབ་བར་དུ་དེ་མི་ཟད། །\"}, {\"label\": \"QUOTE\", \"frame\": \"སློབ་དཔོན་དཔའ་བོས།\", \"head\": \"ཇི་ལྟར་དགེ་བའི་རྩ་བ་དེ་ཀུན་ཀྱང་། །\", \"tail\": \"འཇིག་རྟེན་འདས་པ་ཉིད་ཀྱི་རྒྱུ་རུ་བསྔོ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"དཀོན་མཆོག་སྤྲིན་མདོ་ལས།\", \"head\": \"གང་ལ་དགེ་བ་མི་དམིགས་པ་དང་།