  "raw_text": "{\"spans\":[{\"label\":\"QUOTE\",\"head\":\"ཚུལ་ཁྲིམས་ཙམ་གྱིས་གཞན་ལ་གང་བརྙས་པ། །\",\"tail\":\"བརྙས་ཕྱིར་དེ་ནི་ཚུལ་ཁྲིམས་འཆལ་ཞེས་བྱ། །\"},{\"label\":\"QUOTE\",\"frame\":\"ཇོ་བོས་ཚུལ་ཁྲིམས་གྱི་སྤྱོད་པ་གླུར་བླངས་བ་ལས།\",\"head\":\"གཞན་སྐྱོན་མ་བརྟག་རང་སྐྱོན་བརྟག །\",\"tail\":\"ཚིག་ཀྱང་མཁས་པས་རིང་དུ་སྤང་། །\"},{\"label\":\"QUOTE\",\"frame\":\"སྡོམ་པ་གསུམ་བསྟན་པའི་མདོ་ལས།\",\"head\":\"ང་ནི་དཀར་གྱི་ཁྱོད་ནག་ཅེས། །\",\"tail\":\"ངག་ནི་ཤིན་ཏུ་བསྡམས་པར་གྱིས། །\"},{\"label\":\"QUOTE\",\"frame\":\"མྱང་འདས་ལས།\",\"head\":\"བྱང་ཆུབ་སེམས་དཔའ་སེམས་དཔའ་ཆེན་པོས། སེམས་ཅན་གྱི་\",\"tail\":\"ངན་སོང་དུ་སྐྱེ་བའི་ཕྱིར་རོ། །\"},{\"label\":\"QUOTE\",\"frame\":\"མྱང་འདས་ལས།\",\"head\":\"བྱང་ཆུབ་སེམས་དཔའ་གལ་ཏེ་ལེགས་པ་ཅུང་ཟད་མཐོང་ཡང་བསྔགས་ཤིང་བསྟོད་དོ། །\",\"tail\":\"སངས་རྒྱས་ཀྱི་རང་བཞིན་ནོ་\"},{\"label\":\"QUOTE\",\"frame\":\"ཆོས་ཡང་དག་པར་སྡུད་པའི་མདོ་ལས།\",\"head\":\"སེམས་ཅན་གྱི་ཞིང་ནི་བྱང་ཆུབ་སེམས་དཔའི་སངས་རྒྱས་ཀྱི་\",\"tail\":\"ལྷ་དང་མིར་འགྱུར་རོ། །\"},{\"label\":\"QUOTE\",\"frame\":\"དགེ་སློང་གི་བྱ་བ་རྒྱས་པའི་མདོ་ལས།\",\"head\":\"སེམས་ཅན་མགུ་བྱས་ལས་བྱུང་བའི། །\",\"tail\":\"བདེ་བར་གནས་པ་མ་མཐོང་ངམ། །\"},{\"label\":\"QUOTE\",\"frame\":\"མདོ་དེ་ཉིད་ལས།\",\"head\":\"མཛེས་པ་ཉིད་དང་ནད་མེད་དང་། །\",\"tail\":\"ཞི་བའང་འཁོར་བར་འཐོབ་པར་འགྱུར། །\"},{\"label\":\"QUOTE\",\"frame\":\"རྣལ་འབྱོར་གྱི་མཚན་ཉིད་ཀྱི་བདེན་པ་ལས།\",\"head\":\"གཟུགས་སུ་སྣང་རྣམས་སྐུ་ཉིད་ཡིན། །\",\"tail\":\"དེ་ཡི་ཤེས་པ་ཡེ་ཤེས་ཡིན། །\"},{\"label\":\"QUOTE\",\"frame\":\"བླ་མའི་ཡོན་ཏན་ཡོངས་སུ་བཟུང་བའི་རྒྱུད་ལས།\",\"head\":\"སེམས་ནི་སངས་རྒྱས་ཉིད་ཡིན་ཏེ། །\",\"tail\":\"ངུ་འབོད་ལ་སོགས་དམྱལ་ཆེན་འགྲོ། །\"},{\"label\":\"QUOTE\",\"frame\":\"སློབ་དཔོན་ཞི་བ་ལྷའི་ཞལ་ནས།\",\"head\":\"རྒྱལ་བ་རྣམས་དང་སེམས་ཅན་ལ། །\",\"tail\":\"སེམས་ཅན་ལ་མིན་ཅི་ཡི་ཚུལ། །\"},{\"label\":\"QUOTE\",\"frame\":\"ཇི་སྐད་དུ།\",\"head\":\"མིག་གིས་སེམས་ཅན་བལྟ་ན་ཡང་། །\",\"tail\":\"སངས་རྒྱས་ཉིད་དུ་འགྱུར་རོ་\"},{\"label\":\"QUOTE\",\"frame\":\"ཟླ་བ་སྒྲོན་མེའི་མདོ་ལས།\",\"head\":\"གང་གི་འཁྲུལ་པ་ཅི་མཐོང་ཡང་། །\",\"tail\":\"འབྲས་བུ་དེ་འདྲ་འཐོབ་པར་འགྱུར། །\"},{\"label\":\"QUOTE\",\"frame\":\"ཇི་ལྟར་སྨྲས་ན།\",\"head\":\"སྨྲས་ན་ཡིད་ཕེབས་འབྲེལ་བ་དང་། །\",\"tail\":\"འཇམ་ཞིང་རན་པར་སྨྲ་བར་བྱ། །\"},{\"label\":\"QUOTE\",\"frame\":\"པཎ་ཆེན་བློ་བཟང་ཡེ་ཤེས་ཀྱི་ཞལ་ནས།\",\"head\":\"དབུས་གཙང་མངའ་རིས་བར་གྱི་གྲུབ་པའི་མཐའ། །\",\"tail\":\"དག་སྣང་ནོར་བུའི་འོད་ཀྱིས་ཁྱབ་ན་ལེགས། །\"},{\"label\":\"QUOTE\",\"frame\":\"བྱང་ཆུབ་སེམས་དཔའ་ནོར་བུའི་ཕྲེང་བ་ལས།\",\"head\":\"ལས་དང་པོ་བ་ཡི་སེམས་ཅན་ལ། །སྟོན་པའི་འདུ་ཤེས་བསྐྱེད་པར་བྱ། །\",\"tail\":\"\"},{\"label\":\"QUOTE\",\"frame\":\"སྤྱན་སྔ་བས།\",\"head\":\"སེམས་ཅན་ཀུན་ལའང་སྟོན་པའི་འདུ་ཤེས་ཀྱིས། །དག་སྣང་དགོས་པ་མདོ་རྒྱུད་ཀུན་ནས་གསུངས། །\",\"tail\":\"\"},{\"label\":\"QUOTE\",\"frame\":\"ཇོ་བོ་རྗེས།\",\"head\":\"རང་དགེ་མ་བསམས་གཞན་དགེ་སོམ་ལ་ཀུན་ལ་བྲན་བཞིན་གུས་པར་མཛོད།\",\"tail\":\"\"},{\"label\":\"QUOTE\",\"frame\":\"རྗེ་རིན་པོ་ཆེས།\",\"head\":\"ཆོས་མཛད་འདུག་ཚད་རྣམས་ལ་མོས་གུས་གྱིས། །\",\"tail\":\"\"},{\"label\":\"QUOTE\",\"frame\":\"པཎ་ཆེན་རིན་པོ་ཆེས།\",\"head\":\"འཕགས་པའི་སྐྱེ་བོ་རྣམས་ཀྱི་མཛད་པ་རྣམ་ཐར་སོ་སོ་སྐྱེ་བོ་\",\"tail\":\"ཆོས་ཀྱི་རྒྱལ་མཚན་གསོལ་བ་འདེབས་སོ། །\"},{\"label\":\"QUOTE\",\"frame\":\"ཨོ་རྒྱན་རིན་པོ་ཆེས།\",\"head\":\"བཤེས་གཉེན་རྣམས་ཇི་ལྟར་བྱས་ནས་འདུག་ཀྱང་། དེ་རང་སྣང་\",\"tail\":\"མོས་པ་དང་དག་སྣང་ཞེ་ཐག་པ་ནས་གྱིས་ཤིག །\"},{\"label\":\"QUOTE\",\"frame\":\"རྗེ་བཙུན་མི་ལས།\",\"head\":\"ཆོས་ཐམས་ཅད་ལ་དག་སྣང་སྦྱོངས་ལ་སྒྲུབ་པའི་རྒྱལ་མཚན་ཚུགས།\",\"tail\":\"\"},{\"label\":\"QUOTE\",\"frame\":\"བསྔགས་བསྟོད་ལས།\",\"head\":\"བཅོམ་ལྡན་དུས་ཀུན་རྟོགས་པའི་ཆོས། །\",\"tail\":\"ཁྱོད་ཀྱི་ཐུགས་དག་ཐོགས་མི་མངའ།\"},{\"label\":\"QUOTE\",\"frame\":\"ཏིང་འཛིན་རྒྱལ་པོ་ལས།\",\"head\":\"ཟླ་བ་སྐར་མར་བཅས་པ་གནས་ལྟུང་ཞིང་། །\",\"tail\":\"ཁྱོད་ནི་མི་བདེན་པ་ཡི་ཚིག་མི་གསུངས། །\"},{\"label\":\"QUOTE\",\"frame\":\"མདོ་གཞན་ལས་ཀྱང་།\",\"head\":\"ནམ་མཁའ་ས་གཞིར་གྱུར་པའམ། །\",\"tail\":\"གཞན་དུ་འགྱུར་བ་མ་མཆིས་སོ། །\"},{\"label\":\"QUOTE\",\"frame\":\"སྒྱུ་འཕྲུལ་དྲྭ་བའི་བཤད་རྒྱུད་ཆེན་པོ་ལས།\",\"head\":\"ལྷ་དང་དྲང་སྲོང་བདེན་པའི་ངག །\",\"tail\":\"ཐམས་ཅད་མཁྱེན་པ་སྨོས་ཅི་དགོས། །\"},{\"label\":\"QUOTE\",\"frame\":\"གཙུག་ན་རིན་ཆེན་གྱི་མདོ་ལས།\",\"head\":\"ལུང་ནི་ངེས་འབྱེད་ཚིག་ཡིན་ཏེ། །\",\"tail\":\"ངེས་འབྱེད་ལུང་དུ་ཤེས་པར་བྱ། །\"},{\"label\":\"QUOTE\",\"frame\":\"འཕགས་པ་རྒྱན་སྟུག་པོའི་མདོ་ལས།\",\"head\":\"ཡིད་ཆེས་ལུང་དང་མི་ལྡན་པའི། །\",\"tail\":\"བདག་ཀྱང་ཆུད་ཟོས་གཞན་ཆུད་ཟོས། །\"},{\"label\":\"QUOTE\",\"frame\":\"སློབ་དཔོན་འཕགས་པའི་མན་ངག་དྲུག་ཅུ་པ་ལས།\",\"head\":\"གང་དག་བདག་དང་གཞན་གྱི་དོན་ལ་མངོན་བརྩོན་པའི། །\",\"tail\":\"ལྟུང་འགྱུར་ལྕགས་བསྲེག་བརྒྱ་ཕྲག་ལྕེ་ལ་འདེབས། །\"},{\"label\":\"QUOTE\",\"frame\":\"ངེས་པར་བརྗོད་པའི་རྒྱུད་བླ་མ་ལས།\",\"head\":\"རྣལ་འབྱོར་ལུང་ནི་མི་ཤེས་པ། །\",\"tail\":\"དཀོན་མཆོག་གསུམ་ནི་སྤང་མི་བྱ། །\"},{\"label\":\"QUOTE\",\"frame\":\"སློབ་དཔོན་ཨཱརྻ་དེ་བའི་མན་ངག་ལས།\",\"head\":\"གསང་སྔགས་མཐར་ཐུག་ལྟ་དུས་སུ། །\",\"tail\":\"ལུང་ཟབ་མན་ངག་ཚད་མར་བྱ། །\"},{\"label\":\"QUOTE\",\"frame\":\"ཀྲྀ་ཡ་བསམ་གཏན་ཕྱི་མ་ལས།\",\"head\":\"གསང་སྔགས་རྒྱ་མཚོ་ཆེན་པོ་ནི། །\",\"tail\":\"དབྱེ་བར་ནུས་པ་མ་ཡིན་ནོ། །\"},{\"label\":\"QUOTE\",\"frame\":\"འཇམ་དཔལ་སྒྱུ་འཕྲུལ་དྲྭ་བའི་བཤད་རྒྱུད་ལས།\",\"head\":\"ལུང་མ་གཏོགས་པར་རྟོག་གེ་ཡི། །\",\"tail\":\"རྣམ་པར་ལྟུང་བ་དཀའ་མ་ཡིན། །\"},{\"label\":\"QUOTE\",\"frame\":\"སློབ་དཔོན་འཕགས་པ་ལྷའི་མན་ངག་ལས།\",\"head\":\"མ་འོངས་ཕྱི་མའི་དུས་སུ་ནི། །\",\"tail\":\"དེ་ནི་རང་ཉིད་གཞན་བརླག་འགྱུར། །\"},{\"label\":\"QUOTE\",\"frame\":\"མགོན་པོ་བྱམས་པའི་རྒྱུད་བླ་མ་ལས།\",\"head\":\"གང་ཕྱིར་རྒྱལ་ལས་ཆེས་མཁས་འགའ་ཡང་འཇིག་རྟེན་འདི་ན་\",\"tail\":\"ཐུབ་ཚུལ་བཤིག་ཕྱིར་དེ་ཡང་དམ་ཆོས་ལ་ནི་གནོད་པ་བྱེད་པར་འགྱུར། །\"},{\"label\":\"QUOTE\",\"frame\":\"འདུལ་བ་ལུང་ལས།\",\"head\":\"བཅོམ་ལྡན་འདས་ཀྱིས་བཀའ་སྩལ་པ། རྗེས་སུ་གནང་གིས་ཅི་\",\"tail\":\"ལུང་བཞིན་དུ་ཚིག་དང་དོན་དུ་འབྲེལ་བར་སྟོན་ཅིག་\"},{\"label\":\"QUOTE\",\"frame\":\"གསེར་འོད་དམ་པའི་མདོ་ལས།\",\"head\":\"རྫོགས་པའི་བྱང་ཆུབ་ཏུ་འཚང་རྒྱ་བར་འདོད་པས། མདོ་སྡེ་\",\"tail\":\"དེའི་བསོད་ནམས་ཀྱི་ཕུང་པོ་དཔག་ཏུ་མེད་ཅིང་དགེ་བའི་རྩ་བ་དཔག་ཏུ་མེད་པ་འཕེལ་ལོ། །\"},{\"label\":\"QUOTE\",\"frame\":\"ཚངས་པས་ཞུས་པའི་མདོ་ལས།\",\"head\":\"བཅོམ་ལྡན་འདས་ཀྱིས་བཀའ་སྩལ་པ། ང་ཡོངས་སུ་མྱ་ངན་ལས་\",\"tail\":\"ཐེ་ཚོམ་རྣམས་ངའི་གསུང་རབ་མདོ་སྡེ་ཡན་ལག་བཅུ་གཉིས་དང་མཐུན་པར་གཅོད་པར་གྱིས་ཤིག །\"}]}",
