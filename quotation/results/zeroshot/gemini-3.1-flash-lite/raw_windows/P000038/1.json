  "raw_text": "{\"spans\": [{\"label\": \"QUOTE\", \"frame\": \"འཁོར་ལོ་སྡོམ་པའི་རྒྱུད་གསང་བ་བསམ་གྱིས་མི་ཁྱབ་པ་ལས།\", \"head\": \"ཐེག་པ་གསུམ་དང་བཅོ་བརྒྱད་\", \"tail\": \"ཐེག་པའི་མཐའ་ལ་ཐུག་པ་མེད། །\"}, {\"label\": \"QUOTE\", \"frame\": \"རྒྱ་ཆེར་རོལ་པ་ལས།\", \"head\": \"སངས་རྒྱས་ཀྱི་ཆོས་ཚད་མ་མཆིས་བ་ངེས་པར་བསྟན་པ།\", \"tail\": \"སྔོན་ཆད་གསུངས་པ་ལགས།\"}, {\"label\": \"QUOTE\", \"frame\": \"ཇོ་བོའི་རྣམ་ཐར་རྒྱས་པ་ཡོངས་གྲགས་ལས།\", \"head\": \"ཇོ་བོའི་ཐུགས་དགོངས་ལ། གསང་སྔགས་ཀྱི་\", \"tail\": \"ཇོ་བོའི་ཐུགས་རྒྱལ་ཡང་དེར་ཆག་\"}, {\"label\": \"QUOTE\", \"frame\": \"ཇོ་བོའི་ཞལ་ནས།\", \"head\": \"མི་ཡུལ་ན་ཐེག་པ་ཆུང་ངུའི་འདུལ་བ་ཉུང་།\", \"tail\": \"འདིའི་སྒོ་ནས་བྱས་པ་མང་\"}, {\"label\": \"QUOTE\", \"frame\": \"ཡང་ཇོ་བོའི་ཐུགས་དགོངས་ལ།\", \"head\": \"འོན་ཀྱང་མི་ཡུལ་ན་བཞུགས་པའི་\", \"tail\": \"མང་བ་ཡིན་གསུངས།\"}, {\"label\": \"QUOTE\", \"frame\": \"ཇོ་བོའི་ཞལ་ནས་\", \"head\": \"གསང་སྔགས་འདི་ལ་མི་ཤེས་པ་མེད་སྙམ།\", \"tail\": \"རྒྱ་གར་དུ་ཡང་མ་བྱུང་བར་འདུག་\"}, {\"label\": \"QUOTE\", \"frame\": \"རྗེ་བཙུན་ཡེ་ཤེས་རྒྱལ་མཚན་གྱིས།\", \"head\": \"དེ་ལྟར་ན་སྟོན་པ་ཐུགས་རྗེ་ཅན་དེ་ཉིད་ཀྱིས།\", \"tail\": \"སྨིན་ཅིང་གྲོལ་བར་མཛད་\"}, {\"label\": \"QUOTE\", \"frame\": \"མཁས་མཆོག་དབྱིག་གཉེན་གྱིས།\", \"head\": \"ཡང་དག་བསྡུས་པའི་གཞི་ཉམས་ཕྱིར། །མཐའ་དག་མིན་པ་གཏོགས་པ་ཡིན། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"སློབ་སྤྲིངས་ལས།\", \"head\": \"བསྟན་པ་རིན་ཆེན་མཆོག་ལྟར་བཟང་ལ་འཕན་མེད་པ། །\", \"tail\": \"སེལ་བར་བྱེད། །\"}, {\"label\": \"QUOTE\", \"frame\": \"གཞན་ཡང་གཡུང་སྟོན་ཞི་བྱེད་རི་ཁྲོད་པས་མཛད་པའི་རྗེ་མི་ལའི་རྣམ་ཐར་མཛོད་ནག་མར་གྲགས་པ་ལས།\", \"head\": \"སྤྱིར་མི་ལ་རས་ཆེན་གྱི་\", \"tail\": \"བརྒྱ་དང་ཉི་ཤུ་རྩ་བདུན་ཙམ་མཐོང་\"}, {\"label\": \"QUOTE\", \"frame\": \"ཞི་བྱེད་རི་ཁྲོད་པས་ཀྱང་།\", \"head\": \"ཁྲི་ཚོ་གཅིག་ཙམ་མཐོང་བ་ལེགས་སོ་\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"རྗེ་བཙུན་མི་ལ་རས་པའི་རྡོ་རྗེའི་མགུར་དྲུག་སོགས་གསུང་རྒྱུན་ཐོར་བུ་ལས།\", \"head\": \"རྣལ་འབྱོར་གྱི་དབང་ཕྱུག་མི་ལ་རས་པ་ཞེས་མཚན་\", \"tail\": \"ཉམས་ལེན་མཛད་\"}, {\"label\": \"QUOTE\", \"frame\": \"ངེས་དོན་འབྲུག་སྒྲ་ལས།\", \"head\": \"རང་གི་ལུགས་ལ་མ་གྲགས་པས། །\", \"tail\": \"མཐོང་རྒྱ་ཆུང་འདི་བཤོལ་བར་རིགས། །\"}, {\"label\": \"QUOTE\", \"frame\": \"རིན་ཆེན་ཕྲེང་བ་ལས།\", \"head\": \"བརྡ་སྤྲོད་པ་དག་ཇི་ལྟ་བུར། །\", \"tail\": \"ལྷག་པར་རབ་ཏུ་དད་བར་བྱ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"སྤྱོད་འཇུག་ལས།\", \"head\": \"འགྲོ་བའི་སྡུག་བསྔལ་སྨན་གཅིག་པུ། །\", \"tail\": \"ཡུན་རིང་གནས་གྱུར་ཅིག །\"}, {\"label\": \"QUOTE\", \"frame\": \"རྒྱུད་ལས།\", \"head\": \"ཚིག་རེ་ལ་ནི་སྣ་ཚོགས་དོན། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཆོས་རྗེ་འབྲུག་པ་ཀུན་ལེགས་ཀྱིས།\", \"head\": \"སངས་རྒྱས་ཆོས་རྣམས་སྡིག་སྤོང་དགེ་སྒྲུབ་གཅེས། །\", \"tail\": \"སྙིང་གཏམ་ཡིན། །\"}, {\"label\": \"QUOTE\", \"frame\": \"གང་ཤར་རང་གྲོལ་གྱིས།\", \"head\": \"དེང་སང་ཆོས་ལུགས་གྲུབ་མཐའ་མང་། །\", \"tail\": \"ཀུན་ལ་དག་སྣང་མཛོད་ཅིག་ཨང་། །\"}, {\"label\": \"QUOTE\", \"frame\": \"སློབ་དཔོན་ཆེན་པོས།\", \"head\": \"དག་སྣང་མོས་གུས་ཕྱོགས་མེད་དུ་བྱེད་པ་ཤིན་ཏུ་གལ་ཆེ།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"རྒྱུད་བླ་མ་ལས།\", \"head\": \"གང་ཞིག་རྒྱལ་བའི་བསྟན་པ་འབའ་ཞིག་གི །\", \"tail\": \"སྤྱི་བོར་བླང་། །\"}, {\"label\": \"QUOTE\", \"frame\": \"རྗེ་རིན་པོ་ཆེས།\", \"head\": \"བསོད་ནམས་ཚོགས་རབ་རབ་འབྱམས་རྒྱུ་ལས་འཁྲུངས་པའི་\", \"tail\": \"མིག་འཕྲུལ་བཞིན། །\"}, {\"label\": \"QUOTE\", \"frame\": \"གསང་བ་བསམ་གྱིས་མི་ཁྱབ་པའི་མདོ་ལས།\", \"head\": \"ནམ་མཁས་ཇི་སྲིད་ཁྱབ་གྱུར་པ། །སྐུ་ཡིས་ཀྱང་ནི་དེ་སྙེད་ཁྱབ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"དཔལ་ཨ་ར་ལིའི་རྒྱུད་ཆེན་པོ་ལས།\", \"head\": \"སྤྲུལ་པའི་སྐུ་སྟེ་སྐུ་ཡི་མཆོག །སངས་རྒྱས་སྤྲུལ་པའི་\", \"tail\": \"ཕྱོགས་བཅུར་སྤྲུལ་པ་སྣ་ཚོགས་འགྱེད། །\"}, {\"label\": \"QUOTE\", \"frame\": \"རྔ་བོ་ཆེའི་མདོ་ལས།\", \"head\": \"མྱ་ངན་མ་བྱེད་ཀུན་དགའ་བོ། །ང་ནི་ཕྱི་མའི་དུས་སུ་ནི། །\", \"tail\": \"ཁྱོད་ལ་སོགས་པའི་དོན་བྱེད་འགྱུར། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཡབ་སྲས་མཇལ་བའི་མདོ་ལས།\", \"head\": \"བརྒྱ་བྱིན་ཚངས་པའི་ཆ་བྱད་དང་། །ལ་ལ་བདུད་ཀྱི་ཆ་བྱད་\", \"tail\": \"སེམས་ཅན་རྣམས་ནི་འདུལ་བར་མཛད། །\"}, {\"label\": \"QUOTE\", \"frame\": \"སམ་བུ་ཊ་ལས།\", \"head\": \"སངས་རྒྱས་གར་མཁན་བསམ་མི་ཁྱབ། །བདག་གིས་བརྗོད་པར་ག་ལ་ནུས། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"རྡོ་རྗེ་དྲྭ་བའི་རྒྱུད་ལས།\", \"head\": \"གང་དང་གང་གི་གཟུགས་ཀྱིས་ནི། །ལུས་ཅན་རྣམས་ནི་\", \"tail\": \"ཆོས་རྣམས་སྟོན་པར་མཛད་པ་ཡིན། །\"}, {\"label\": \"QUOTE\", \"frame\": \"དེ་བཞིན་དུ་མདོ་ལས།\", \"head\": \"བདུད་ཀྱི་ལས་རྣམས་ཐུགས་ཆུད་ཀྱང་། །བདུད་ཀྱི་ལས་\", \"tail\": \"སེམས་ཅན་ཐམས་ཅད་གྲོལ་མཛད་པའོ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ངེས་དོན་འབྲུག་སྒྲ་ལས།\", \"head\": \"གཅེར་བུ་པ་རྣམས་འདུལ་བའི་ཕྱིར། །ཐུབ་པས་གཅེར་\", \"tail\": \"མཚན་བརྗོད་འགྲེལ་པ་ཉིད་ལས་གསུངས།\"}, {\"label\": \"QUOTE\", \"frame\": \"མྱང་འདས་བམ་པོ་གཅིག་པ་ལས།\", \"head\": \"རིགས་ཀྱི་བུ་ང་བསྐལ་པ་བཟང་པོ་འདིར་མུ་སྟེགས་གཅེར་\", \"tail\": \"བུ་པ་ལ་ཡིད་ཆེས་ཏེ་\"}, {\"label\": \"QUOTE\", \"frame\": \"དུས་འཁོར་ལས།\", \"head\": \"ཡོན་ཏན་གྱི་ཆོས་དང་ལྡན་པ་ཕྱི་རོལ་པའི་ནང་ན་\", \"tail\": \"བདག་ཅག་གིས་བསྙེན་བཀུར་བྱའོ་\"}, {\"label\": \"QUOTE\", \"frame\": \"མདོར་བསྡུས་བཞི་པ་ལས།\", \"head\": \"ཁྱབ་འཇུག་དང་དྲག་པོ་ལ་སོགས་པ་རྣམས་ཀྱི་ནང་ན་\", \"tail\": \"མཆོད་པ་དང་བཀུར་བར་བྱ་བ་ཡིན་ནོ་\"}, {\"label\": \"QUOTE\", \"frame\": \"རྣམ་སྣང་མངོན་བྱང་ལས།\", \"head\": \"མུ་སྟེགས་ཅན་ལ་སྨད་མི་བྱ། །མུ་སྟེགས་ཅན་ལ་\", \"tail\": \"རྣམ་པར་སྣང་མཛད་རིང་བའི་རྒྱུ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"བསྟན་པའི་སྙིང་པོ་ལས།\", \"head\": \"རྣམ་པར་སྣང་མཛད་ཆེན་པོ་དེའི་སྐུ་ལ་མེ་ཏོག་གི་\", \"tail\": \"ཕྱོགས་བཅུ་ཀུན་ཏུ་དེ་ལྟ་བུ་སྣང་བར་\"}, {\"label\": \"QUOTE\", \"frame\": \"སངས་རྒྱས་ཕལ་པོ་ཆེའི་མདོ་ལས།\", \"head\": \"གླིང་བཞི་འདི་ན་བཅོམ་ལྡན་འདས་དོན་གྲུབ་པ་དང་།\", \"tail\": \"མཚན་མི་མཐུན་པ་སྟོང་ཕྲག་བརྒྱད་ཅུར་ཤེས་སོ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"འཁོར་ལོ་སྡོམ་པས་ངེས་པར་བརྗོད་པའི་རྒྱུད་བླ་མ་ལས།\", \"head\": \"རྡོ་རྗེ་ཅན་ནི་ཐམས་ཅད་དུ། །ཆ་མེད་ཆ་ནི་རྣམ་\", \"tail\": \"བསྟན་ནས་འགྲོ་བ་འདུལ་པར་མཛད། །\"}]}",
  "attempts": 1,
