  "raw_text": "{\"spans\": [{\"label\": \"QUOTE\", \"frame\": \"ཡང་ཇོ་བོ་ཆེན་པོའི་ཞལ་ནས།\", \"head\": \"གཞན་ཡང་བླ་མ་དག་ཁོ་བོ་ལ་ཤིན་ཏུ་བྱམས་པ་ནི་བྱམས། ལ་ལ་སེམས་ཙམ་པ་ཡིན་པས། ངས་གྲུབ་མཐའ་མ་བཟུང་ཟེར་ནས། བཀའ་བཀྱོན་པ་སྐད་གསུངས་པའང་ཡོད་དེ་དྲང་དོན་ཡིན།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཤེས་རབ་སྒྲོན་མེའི་རྒྱ་ཆེར་འགྲེལ་པ་ལས།\", \"head\": \"བསྟན་པ་ཞེས་བྱ་བ་ནི། ལྷ་དང་མི་བདུད་རྩིའི་གོ་འཕང་ཐོབ་པར་འདོད་པ་རྣམས་ཡོངས་སུ་ཤེས་པར་བྱ་བ་དང་། སྤང་བར་བྱ་བ་དང་མངོན་སུམ་དུ་བྱ་བ་དང་བསྒོམ་པར་བྱ་བ་དག་ལ་ཕྱིན་ཅི་མ་ལོག་པར་སྟོན་པ་སྟེ་བཅོམ་ལྡན་འདས་ཀྱི་གསུང་རབ་ཅེས་བྱ་བ་ཡིན་ནོ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"བྱང་ཆུབ་སེམས་འགྲེལ་ལས།\", \"head\": \"རང་ཉིད་ངེས་བཞིན་གཞན་དག་ལ། །ངེས་པ་བསྐྱེད་པར་འདོད་པ་ཡིས། །རྟག་ཏུ་འཁྲུལ་པ་མེད་པར་ནི། །མཁས་རྣམས་རབ་ཏུ་འཇུག་པ་ཡིན། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"རྣམ་འགྲེལ་ལས་ཀྱང་།\", \"head\": \"ཐབས་བྱུང་དེ་རྒྱུ་ལྐོག་གྱུར་པ། །དེ་འཆད་པ་ནི་དཀའ་བ་ཡིན། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"རྒྱལ་བའི་ཡུམ་ལས་ཀྱང་།\", \"head\": \"བྱང་ཆུབ་སེམས་དཔའ་རྣམས་ཀྱིས་ནི་ཉན་ཐོས་ཀྱི་ལམ་གང་ཡིན་པ་དང་རང་སངས་རྒྱས་ཀྱི་ལམ་གང་ཡིན་པ་དང་སངས་རྒྱས་ཀྱི་ལམ་གང་ཡིན་པའི་ལམ་ཐམས་ཅད་བསྐྱེད་པར་བྱ་ཞིང་ལམ་ཐམས་ཅད་ཤེས་པར་བྱའོ། །དེ་དག་ཀྱང་ཡོངས་སུ་རྫོགས་པར་བྱ་ཞིང་དེ་དག་གི་ལམ་གྱི་བྱ་བ་ཡང་བྱ་ལ།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"དཔལ་རྡོ་རྗེ་རྩེ་མོ་ལས།\", \"head\": \"འཚོ་བའི་སྲོག་གི་ཕྱིར་ཡང་ནི། །བྱང་ཆུབ་སེམས་ནི་དོར་མི་བྱ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"head\": \"ཕ་རོལ་ཕྱིན་དྲུག་སྤྱོད་པ་ནི། །ནམ་ཡང་འདོར་བར་མི་བྱའོ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"རྡོ་རྗེ་མཁའ་འགྲོ་དང་སམྦུ་ཊ་དང་རྡོ་རྗེ་རྩེ་མོ་རྣམས་སུ།\", \"head\": \"ཕྱི་ནང་གསང་བ་ཐེག་པ་གསུམ། །དམ་པའི་ཆོས་ནི་མ་ལུས་གཟུང་། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"རྒྱལ་བའི་ཡུམ་ལས།\", \"head\": \"རྒྱལ་བ་འདས་དང་མ་བྱོན་ད་ལྟར་གང་བཞུགས་པ། །ཀུན་ལམ་ཕ་རོལ་ཕྱིན་པ་འདི་ཡིན་གཞན་མ་ཡིན། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"དགེ་བའི་བཤེས་གཉེན་སྟོན་པ་རིན་པོ་ཆེའི་ཞལ་ནས་ཀྱང་།\", \"head\": \"བསྟན་པ་ཐམས་ཅད་གྲུ་བཞི་ལམ་གྱིས་འཁྱེར་ཤེས་པ་ངའི་བླ་མ།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"རྒྱུད་བླ་མ་ལས།\", \"head\": \"གང་ཕྱིར་རྒྱལ་ལས་ཆེས་མཁས་འགའ་ཡང་འཇིག་རྟེན་འདི་ན་ཡོད་མིན་ཏེ། མ་ལུས་དེ་ཉིད་མཆོག་ནི་ཚུལ་བཞིན་ཀུན་མཁྱེན་གྱིས་མཁྱེན་གཞན་མིན་པ། །དེ་ཕྱིར་དྲང་སྲོང་དེ་ཉིད་ཀྱིས་བཞག་མདོ་སྡེ་གང་ཡིན་དེ་མི་དཀྲུག །ཐུབ་ཚུལ་བཤིག་ཕྱིར་དེ་ཡང་དམ་ཆོས་ལ་ནི་གནོད་པ་བྱེད་པར་འགྱུར། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"རྣལ་འབྱོར་པ་ཆེན་པོ་བྱང་ཆུབ་རིན་ཆེན་གྱི་ཞལ་ནས།\", \"head\": \"གདམས་ངག་ལ་ནང་བྱན་ཚུད་པ་ནི། བེའུ་བུམ་ལག་མཐིལ་ཙམ་ཞིག་ལ་ངེས་པ་རྙེད་པ་ལ་མི་ཟེར་གྱི་གསུང་རབ་ཐམས་ཅད་གདམས་ངག་ཏུ་གོ་བ་ལ་ཟེར་\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཇོ་བོ་ཆེན་པོའི་སློབ་མ་སྒོམ་པ་རིན་ཆེན་བླ་མས་ཀྱང་།\", \"head\": \"ཨ་ཏི་ཤའི་གདམས་ངག་ལ་སྟན་ཐོག་གཅིག་ཏུ་ལུས་ངག་ཡིད་གསུམ་རྡུལ་དུ་བརླགས་པས་ད་གཞུང་ཐམས་ཅད་གདམས་ངག་ཏུ་གོ་བ་ཞིག་བྱུང་\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"མཛོད་ལས།\", \"head\": \"སྟོན་པའི་དམ་ཆོས་རྣམ་གཉིས་ཏེ། །ལུང་དང་རྟོགས་པའི་བདག་ཉིད་དོ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"སྒོམ་པའི་རིམ་པ་ཐ་མ་ལས།\", \"head\": \"ཡང་ཐོས་པ་དང་བསམ་པ་ལས་བྱུང་བའི་ཤེས་རབ་ཀྱིས་རྟོགས་པ་གང་ཡིན་པ་དེ་ཉིད་བསྒོམས་པ་ལས་བྱུང་བའི་ཤེས་རབ་ཀྱིས་བསྒོམ་པར་བྱའི་གཞན་དུ་མ་ཡིན་ཏེ་རྟ་དཀྱུ་ས་བསྟན་ནས་རྒྱུག་པ་བཞིན་ནོ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"རྣམ་པར་འཐག་པ་ཐམས་ཅད་བསྡུས་པའི་མདོ་ལས།\", \"head\": \"འཇམ་དཔལ་དམ་པའི་ཆོས་སྤོང་བའི་ལས་ཀྱི་སྒྲིབ་པ་ནི་ཕྲའོ། །འཇམ་དཔལ་གང་དེ་བཞིན་གཤེགས་པས་གསུངས་པའི་བཀའ་ལ་ལ་ནི་བཟང་བར་འདུ་ཤེས་ལ་ལ་ནི་ངན་པར་འདུ་ཤེས་པ་ནི་ཆོས་སྤོང་བའོ། །གང་ཆོས་སྤོང་བ་དེས་ཆོས་སྤངས་པས་དེ་བཞིན་གཤེགས་པ་ལ་སྐུར་བ་འདེབས་པ་ཡིན། དགེ་འདུན་ལ་ངན་དུ་བརྗོད་པ་ཡིན་ནོ། །འདི་ནི་རིགས་པའོ་འདི་ནི་མི་རིགས་པའོ་ཞེས་ཟེར་ན་ཆོས་སྤོང་བའོ། །འདི་ནི་བྱང་ཆུབ་སེམས་དཔའ་རྣམས་ཀྱི་ཆེད་དུ་གསུངས་པའོ་འདི་ནི་ཉན་ཐོས་རྣམས་ཀྱི་ཆེད་དུ་གསུངས་པའོ་ཞེས་ཟེར་ན་ཆོས་སྤོང་བ་ཡིན་ནོ། །འདི་ནི་རང་སངས་རྒྱས་རྣམས་ཀྱི་ཆེད་དུ་གསུངས་པའོ་ཞེས་ཟེར་ན་ཆོས་སྤོང་བ་ཡིན་ནོ། །འདི་ནི་བྱང་ཆུབ་སེམས་དཔའ་རྣམས་ཀྱི་བསླབ་པ་མ་ཡིན་ནོ་ཞེས་ཟེར་ན་ཆོས་སྤོང་བ་ཡིན་ནོ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཏིང་ངེ་འཛིན་རྒྱལ་པོ་ལ