  "raw_text": "{\"spans\": [{\"label\": \"QUOTE\", \"frame\": \"ཡང་དེ་ཉིད་ལས།\", \"head\": \"བློ་གྲོས་ཆེན་པོ། གལ་ཏེ་ཀུན་གཞིའི་རྣམ་པར་ཤེས་པ་\", \"tail\": \"མངོན་སུམ་གྱི་སྤྱོད་ཡུལ་དུ་བྱ་སྟེ།\"}, {\"label\": \"QUOTE\", \"frame\": \"རྡོ་རྗེ་སྙིང་འགྲེལ་ལས།\", \"head\": \"ལུས་གནས་ཡེ་ཤེས་ཆེན་པོ་ནི། །དངོས་པོ་ཀུན་ལ་ཁྱབ་པ་པོ།\", \"tail\": \"ཡེ་ཤེས་ལ་ནི་འཇིག་པ་མེད། །\"}, {\"label\": \"QUOTE\", \"frame\": \"རྒྱུད་བླ་མ་ལས།\", \"head\": \"རྫོགས་སངས་སྐུ་ནི་འཕྲོ་ཕྱིར་དང༌། །དེ་བཞིན་ཉིད་དབྱེར་མེད་\", \"tail\": \"རྟག་ཏུ་བདེ་གཤེགས་སྙིང་པོ་ཅན། །\"}, {\"label\": \"QUOTE\", \"frame\": \"མདོ་སྡེ་ཀུན་བཏུས་ལས།\", \"head\": \"དེ་བཞིན་ཉིད་ནི་ཐམས་ཅད་ལ། །ཁྱད་པར་མེད་ཕྱིར་དག་\", \"tail\": \"འགྲོ་ཀུན་དེ་ཡི་སྙིང་པོ་ཅན། །\"}, {\"label\": \"QUOTE\", \"frame\": \"དཔལ་མགོན་འཕགས་པ་ཀླུ་སྒྲུབ་ཀྱི་ཞལ་སྔ་ནས་ཀྱང༌།\", \"head\": \"ཇི་ལྟར་མར་མེ་བུམ་ནང་གནས། །ཅུང་ཞིག་སྣང་བར་མི་འགྱུར་བ།\", \"tail\": \"ཆོས་ཀྱི་དབྱིངས་ཀྱང་མི་མཐོང་ངོ༌། །\"}, {\"label\": \"QUOTE\", \"head\": \"ཁམས་ཡོད་ན་ནི་ལས་བྱས་པས། །ས་ལེ་སྦྲམ་དག་མཐོང་བར་འགྱུར།\", \"tail\": \"ཉོན་མོངས་འབའ་ཞིག་སྐྱེ་བར་ཟད། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཇོ་བོ་ཆེན་པོའི་ལམ་སྒྲོན་རྩ་འགྲེལ་ལས།\", \"head\": \"ཡང་ན་ཐེག་པ་ཆེན་པོ་དབུ་མའི་གྲུབ་མཐའ་བཙན་པར་\", \"tail\": \"དེ་བཞིན་གཤེགས་པའི་སྙིང་པོ་ཅན་ནོ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཀླུ་སྒྲུབ་ཀྱི་ཞལ་ལས།\", \"head\": \"ཆོས་ཀྱི་དབྱིངས་ལ་དབྱེར་མེད་ཕྱིར། །གཙོ་བོ་ཐེག་དབྱེར་\", \"tail\": \"སེམས་ཅན་འཇུག་པར་བྱ་ཕྱིར་ཡིན། །\"}, {\"label\": \"QUOTE\", \"frame\": \"དམ་པས།\", \"head\": \"རང་བྱུང་ཀུན་གཞི་ཆེན་པོ་ནི། །འཁོར་འདས་ཀུན་གྱི་རྩ་བར་\", \"tail\": \"བྱང་ཆུབ་ཆེན་པོར་གྲོལ་ཐབས་རྙེད། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཡང་དེ་ཉིད་ལས།\", \"head\": \"མ་བསྟན་བར་དུ་གོ་མི་རུང༌། །མ་བཙལ་བར་དུ་སུས་མི་\", \"tail\": \"བདེ་བར་གཤེགས་པ་ཤུགས་རྟོགས་བྱ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"རྒྱུད་ཀློང་གསལ་ལས།\", \"head\": \"བདེ་གཤེགས་ངོ་བོ་འགྲོ་ཀུན་ལ། །ཏིལ་ལ་མར་གྱིས་ཁྱབ་\", \"tail\": \"ལྷག་མེད་ཡེ་ཤེས་ངང་དུ་བཟློག། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཀླུ་སྒྲུབ་ཀྱིས།\", \"head\": \"འདི་ནི་གང་ཡང་སྐྱེ་བ་མེད། །གང་ཡང་འགག་པ་ཡོད་མ་ཡིན།\", \"tail\": \"ཐམས་ཅད་སེམས་ལས་གཞན་མ་ཡིན། །\"}, {\"label\": \"QUOTE\", \"frame\": \"དམ་པས།\", \"head\": \"བརྒྱད་ཁྲི་བཞི་སྟོང་བསམ་འདས་ཀྱང༌། །སེམས་ལས་མ་\", \"tail\": \"ཅིར་སྣང་སྟོང་པའི་རྒྱ་ཡིས་གདབ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ལང་གཤེགས་ལས།\", \"head\": \"སེམས་ཙམ་དུ་ནི་རྟོག་པ་དང༌། །ཕྱི་རོལ་དངོས་པོ་རྣམས་\", \"tail\": \"ལམ་དེ་ཉིད་ནི་དབུ་མའོ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"སྡུད་པ་ལས།\", \"head\": \"ཆོས་རྣམས་རང་བཞིན་མེད་པར་ཡོངས་སུ་ཤེས་གྱུར་པ། །འདི་ནི་ཤེས་རབ་ཕ་རོལ་ཕྱིན་མཆོག་སྤྱོད་པ་ཡིན། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཟབ་དོན་ལས།\", \"head\": \"གདོད་ནས་ཆོས་ཉིད་གློ་བུར་དྲི་མ་དང་བཅས་པ། །གཞི་ལམ་འབྲས་བུ་རྟོགས་ལ་ལྟ་སྒོམ་སྤྱོད་པས་གཞོམ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"རྗེ་བཙུན་དམ་པ་རིན་པོ་ཆེས།\", \"head\": \"སངས་རྒྱས་ཟེར་བའི་སྒྲ་བོ་ཆེ། གཡེར་པོ་ཆེ། རྩིས་པོ་ཆེ་དེ་ཡང༌། ཡེ་གདོད་\", \"tail\": \"དེ་ཁྱེད་རང་གིས་གནས་ལུགས་ཤེས་པ་ཝལ་ལེ་འཁྱུག་གེ་བ་འདི་རང་ཡིན་ནོ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"རྗེ་བཙུན་ཏཻ་ལོ་པས།\", \"head\": \"རི་རབ་གསེར་གྱི་ངོས་ལ་བྱ་གནས་པས། །བྱ་ཡི་རང་བཞིན་བོར་ནས་གསེར་དུ་སྣང༌། །མཁས་པ་གང་གིས་སྐྱེ་བ་མེད་རྟོགས་ན། །དངོས་པོའི་རང་བཞིན་བོར་ནས་བདེ་བ་ཆེ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཡང་དེ་ཉིད་ཀྱིས།\", \"head\": \"བདག་ཉིད་གདོད་མ་ཉིད་ནས་སངས་རྒྱས་ཡིན་པ་ལ། །མ་རྟོགས་དབང་གིས་སངས་རྒྱས་ཉིད་དུ་མ་མཐོང་ངོ༌། །གཉིས་མེད་གང་གིས་རྟོགས་པ་དེ་ནི་ཕྱག་རྒྱ་ཆེ། །རྟོགས་པའི་ཡུལ་ན་མཐོང་བ་མེད་ཅིང་ཐོབ་པ་མེད། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"པཎ་ཆེན་ན་རོའི་ཞལ་ནས།\", \"head\": \"འཁོར་ལོས་སྒྱུར་རྒྱལ་དཔུང་ཚོགས་ཀྱིས། །གླིང་རྣམས་ཀུན་ལ་དབང་བསྒྱུར་བཞིན། །ལྷན་ཅིག་སྐྱེས་པའི་རོ་རྙེད་པས། །འཁོར་བ་དག་ལ་དབང་བསྒྱུར་ངོ་མཚར་ཆེ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"བ་སུ་ད་རའི་ཞལ་ནས།\", \"head\": \"གང་གིས་མ་རྟོགས་གོང་དུ་རོ་འདི་འབྲས་ཅན་དག་དང་ཁྱད་པར་ཆེ། །དེ་བཞིན་མ་རྟོགས་བར་དུ་སངས་རྒྱས་སེམས་ཅན་ཁྱད་པར་བརྟག།རྟོགས་པའི་དུས་ན་འཁོར་བ་དག་ཀྱང་སངས་རྒྱས་ཆེ། །དེ་ཕྱིར་རྟོགས་དང་མ་རྟོགས་དབྱེ་བ་དཀའ་བས་ཁྱད་མེད་དོ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"སློབ་དཔོན་ཕྱོགས་ཀྱི་གླང་པོས།\", \"head\": \"བྱ་བ་གཏོང་བ་མན་ངག་ཡིན། །ཞེ་འདོད་མེད་ན་རྟོགས་པ་ཡིན། །བསྒྲུབ་བྱ་མེད་ན་སྤྱོད་པ་ཡིན། །སྨྲ་བརྗོད་བྲལ་ན་ཉམས་མྱོང་ཡིན། །བླང་དོར་བྲལ་ན་འབྲས་བུ་ཡིན། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"མ་གཅིག་གིས།\", \"head\": \"རྒྱུ་ནི་རང་རིག་བྱང་ཆུབ་སེམས། །ཏིལ་ལ་མར་གྱིས་ཁྱབ་པ་བཞིན། །སེམས་ཅན་ཀུན་ལ་ཁྱབ་པར་གནས། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཡང་དེ་ཉིད་ཀྱིས།\", \"head\": \"སེམས་ལ་གཉིས་སུ་མ་མཆིས་པས། །བལྟས་པས་རང་གི་སེམས་མི་མཐོང༌། །མཐོང་ན་ཆོས་ཉིད་དོན་མི་རིང༌། །དེ་བས་བལྟ་བར་བྱ་བ་ནི། །རྡུལ་ཙམ་ཡོད་པ་མ་ཡིན་ནོ། །བལྟ་རྒྱུ་མེད་པའི་ཚུལ་དུ་བལྟ། །མ་མཐོང་ཐག་ཆོད་རྟོགས་ཚད་ཡིན། །དེ་བས་གཞན་དུ་རྙེད་མི་འགྱུར། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ལེའུ་ལག་ལས།\", \"head\": \"སེམས་ཀྱི་རང་བཞིན་འདི་འདྲ་ནི། །སངས་རྒྱས་ཀྱིས་ཀྱང་མཐོང་མི་སྲིད། །མ་མཐོང་བ་ཉིད་དེ་མཐོང་ཡིན། །དེས་ན་ཆོས་རྣམས་བཏགས་པ་སྟེ། །བཏགས་པ་ཙམ་ཉིད་བརྗོད་དུ་མེད། །བཏགས་པའི་ཆོས་དང་སྨིག་རྒྱུའི་ཆུས། །བསླུ་བར་ངེས་ཀྱི་དེར་མ་འཛིན། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"བདེན་གཉིས་ལས།\", \"head\": \"མ་མཐོང་བ་ཉིད་ཆོས་མཐོང་ཡིན། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཤིན་ཏུ་ཟབ་པའི་མདོ་ལས།\", \"head\": \"སྣང་བ་མེད་ཚུལ་གནས་པ་འདི། །བདེན་པ་མཐོང་ཞེས་དེ་ལ་གསུངས། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"འཇམ་དཔལ་མཚན་བརྗོད་ལས།\", \"head\": \"གྲུབ་པ་མཐར་ཕྱིན་འཁྲུལ་པ་མེད། །ནོར་བ་ཐམས་ཅད་རྣམ་པར་སྤངས། །དོན་གསུམ་ཐེ་ཚོམ་མེད་པའི་བློ། །ཀུན་དོན་ཡོན་ཏན་གསུམ་གྱི་བདག།\", \"tail\": \"\"}]}",
