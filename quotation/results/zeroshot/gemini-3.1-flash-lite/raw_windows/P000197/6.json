  "raw_text": "{\"spans\": [{\"label\": \"QUOTE\", \"frame\": \"ཕ་དམ་པས།\", \"head\": \"མངོན་མཚན་ཅན་ལ་བར་ཆད་འབྱུང་བ་མང་།\", \"tail\": \"གསང་སྤྱོད་ཉམས་སུ་ལོངས་ཤིག་དིང་རི་བ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཨོ་རྒྱན་རིན་པོ་ཆེས།\", \"head\": \"མངོན་ཤེས་མེད་པའི་འགྲོ་དོན་མི་ཡོང་སྟེ།\", \"tail\": \"ཐོག་མར་སྒྲུབ་ལ་བརྩོན་འགྲུས་རིམ་པར་བསྐྱེད། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཇོ་བོ་རྗེས།\", \"head\": \"དང་པོ་རང་ཉིད་མ་ཐུལ་བར།\", \"tail\": \"གཞན་དག་ཇི་ལྟར་ཐུལ་བར་འགྱུར། །\"}, {\"label\": \"QUOTE\", \"frame\": \"དམ་པ་རྒྱ་གར་གྱིས།\", \"head\": \"བདུད་ཀྱི་འཇུག་པ་དང་པོ་བྱ་བ་ཡིན། རང་ཆུ་ནང་དུ་ལུས་པས།\", \"tail\": \"གཞན་ལ་ཕན་མི་ཐོགས་པས་གཟབ་འཚལ།\"}, {\"label\": \"QUOTE\", \"frame\": \"མར་པས།\", \"head\": \"ཁྱེད་རང་རྒྱུད་སློབ་མར་མི་ལྡན་པས། །གཞན་གྱི་སློབ་དཔོན་\", \"tail\": \"འདུ་འཛི་མལ་བཞག་དབེན་པ་བརྟེན། །སྒྲུབ་པའི་བར་ཆད་སློབ་མ་སྤོངས། །\"}, {\"label\": \"QUOTE\", \"frame\": \"འཇིགས་མེད་གླིང་པས།\", \"head\": \"མཐུན་འཇུག་ཐག་པས་འཆིང་བ་ཡི། །འགྲོ་དོན་བདུད་ཀྱིས་བསླུས་པ་ཡིན། །\", \"tail\": \"ཞེན་པ་ནང་ནས་གྲོལ་ཙ་ན། །ཅི་བྱས་ཐམས་ཅད་གཞན་དོན་འགྱུར། །\"}, {\"label\": \"QUOTE\", \"frame\": \"མདོ་དྲན་པ་ཉེར་བཞག་ལས།\", \"head\": \"གཟའ་སྐར་བརྩི་བ་དང་། རི་མོ་བྲི་བ་དང་། སྙན་ངག་སློབ་པ་དང་། ཟས་སུ་གཡེང་བ་དང་།\", \"tail\": \"རྩེ་གཅིག་ཏུ་མཉམ་པར་འཇོག་པར་བྱེད་དོ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཀློང་ཆེན་པས།\", \"head\": \"ནགས་ནི་ཆུ་གཙང་མེ་ཏོག་འབྲས་མང་ཞིང་། །བྲག་རི་ཕུག་དང་རྡོ་ལེབ་ཁང་བཟང་དང་། །\", \"tail\": \"ཆུ་འགྲམ་མེ་ཏོག་བུང་བ་གླུ་ལེན་མཛེས། །\"}, {\"label\": \"QUOTE\", \"frame\": \"སློབ་དཔོན་དཔའ་བོས།\", \"head\": \"བུང་བ་རྒྱགས་ལྡིང་གླུ་ལེན་ཅིང་། །ལྗོན་ཤིང་ལོ་མའི་གར་བྱེད་ལ། །\", \"tail\": \"ཙནྡན་སྤོས་སོགས་དྲི་ངད་ལྡང་། །སྒོམ་པའི་ཡོན་ཏན་དུ་མར་ལྡན། །\"}, {\"label\": \"QUOTE\", \"frame\": \"བྱེ་བྲག་ཏུ་སེམས་ཉིད་ངལ་གསོ་ལས།\", \"head\": \"རི་རྩེ་ནགས་ཁྲོད་མཚོ་གླིང་ལ་སོགས་པ། །དུས་བཞི་ཡིད་ནི་མཐུན་པའི་གནས་དག་ཏུ། །\", \"tail\": \"རྩེ་གཅིག་མི་གཡོ་ཞི་བའི་ཏིང་འཛིན་སྒྲུབས། །\"}, {\"label\": \"QUOTE\", \"frame\": \"རྗེ་མི་ལས།\", \"head\": \"མི་མེད་ལུང་པའི་རི་སུལ་ན། །སྐྱོ་ཆད་དེ་བ་ལ་སངས་དུས་མེད། །\", \"tail\"