  "raw_text": "{\"spans\": [{\"label\": \"QUOTE\", \"head\": \"བཅོས་མིན་དད་པས་དུས་བཞིའི་འགྱུར་ལྡོག་ངོམ། །\", \"tail\": \"ནགས་མཐའི་མི་རྒོད་བཞིན། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཨིནྡྲ་བྷཱུ་ཏིས།\", \"head\": \"རྣལ་འབྱོར་ཉམས་པ་གཅིག་གིས་ནི། །རྣལ་འབྱོར་ཅན་ཀུན་མ་རུངས་བྱེད། །སྦལ་པ་རྨ་ཅན་གཅིག་གིས་ནི། །སྦལ་པ་ཐམས་ཅད་རྨ་ཅན་བྱེད། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"གྲུབ་ཐོབ་ཨོ་རྒྱན་པས།\", \"head\": \"གྲོགས་བླ་མ་མིན་པས་སྐྱོབས་མ་མྱོང་། །དགྲ་དམ་ཉམས་མིན་པས་ཐུབ་མ་མྱོང་། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"བདུད་རྩི་འབྱུང་བའི་རྒྱུད་ལས།\", \"head\": \"རྡོ་རྗེ་སློབ་དཔོན་སྨོད་པ་ན། །ཞིང་བཅུ་མངོན་སྤྱོད་ལས་ཀྱིས་བཟློག །ནུས་པ་ཡོད་པར་མ་གྱུར་ན། །རྣ་ཆ་དྲན་པས་དགའ་བར་བྱ། །\", \"tail\": \"ངན་སོང་དག་ཏུ་འཚོད་པར་འགྱུར། །\"}, {\"label\": \"QUOTE\", \"frame\": \"རྡོ་རྗེ་གུར་ལས།\", \"head\": \"དབང་བསྐུར་ཆོས་བཤད་མཆོག་ཐུབ་པའི། །སློབ་མས་བླ་མའི་བཀའ་འདས་ན། །འཇིག་རྟེན་འདིར་ཡང་སྡུག་བསྔལ་ཞིང་། །\", \"tail\": \"ཕྱི་མ་རྡོ་རྗེ་མནར་མེད་འགྲོ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཨ་ཏི་བཀོད་པ་ཆེན་པོ་ལས།\", \"head\": \"བླ་མ་དང་ནི་ཉེ་བའི་འཁོར། །རྡོ་རྗེའི་སྤུན་དང་སྲིང་མོ་ལ། །ངན་སྨྲས་ཚིག་གིས་ཟུར་ཙམ་ཡང་། །\", \"tail\": \"ཐུར་དུ་བལྟས་ཏེ་དམྱལ་བར་འགྲོ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཡེ་ཤེས་གྲུབ་པའི་རྩ་རྒྱུད་ལས།\", \"head\": \"བླ་མའི་རྫས་དང་འཁོར་རྣམས་དང་། །ཉེ་འཁོར་སུན་འབྱིན་བརྣབ་སེམས་སྤངས། །མཛད་པ་སྣ་ཚོགས་སེམས་ཅན་ལ། །\", \"tail\": \"ཉེས་པའི་ལོག་པར་ལྟ་བ་དོར། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཡོན་ཏན་མཛོད་ལས།\", \"head\": \"མཛད་སྤྱོད་གང་ལ་ལོག་པར་མི་བལྟ་སྟེ། །འཕགས་པའི་ཡུལ་གྱི་དབང་ཕྱུག་ཕལ་མོ་ཆེ། །གདོལ་པ་གཡུང་པོ་སྡིག་སྤྱོད་ཕལ་པའི་ཚུལ། །\", \"tail\": \"ཚུལ་སོགས་བསམ་ནས་རང་གིས་རང་ཉིད་འཆོས། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཀློང་རྒྱུད་ལས།\", \"head\": \"བླ་མ་འཁྲུལ་བ་སྲིད་མཐར་ཡང་། །འབྱུང་བ་མེད་ཅིང་གལ་ཏེ་ནི། །ལྟར་སྣང་འཁྲུལ་བ་ལྟར་སྣང་རུང་། །\", \"tail\": \"སེར་པོ་མཐོང་བ་ཉིད་དང་མཚུངས། །\"}, {\"label\": \"QUOTE\", \"head\": \"དུས་གཅིག་མི་བརྒྱ་བསད་ན་ཡང་། །སངས་རྒྱས་འགྲོ་ལ་ཕན་མཛད་ཉིད། །བཙུན་མོ་བརྒྱ་ལ་རོལ་ན་ཡང་། །བདེ་ཆེན་ཡེ་ཤེས་ཕྱག་རྒྱ་ཆེ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"དམ་ཚིག་བཀོད་རྒྱུད་ལས།\", \"head\": \"ས་ཞེས་བྱ་བ་བསྐྱེད་པ་ལ། །མ་ཞེས་བྱ་བ་མ་ཉམས་ན། །དངོས་གྲུབ་ཐམས་ཅད་སྟེར་བ་སྟེ། །\", \"tail\": \"མེ་ཡི་སྡུག་བསྔལ་མྱོང་བར་འགྱུར། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཇི་སྐད་དུ།\", \"head\": \"བསགས་པ་རྒྱ་ཆེན་ཕ་ཡི་ནོར་སྐལ་དེ། །རྗེས་འཇུག་བུ་ཡིས་འབད་པས་བཟུང་མིན་ན། །སྲིད་པའི་ཁོངས་ན་དེ་ལས་རྨོངས་པ་སུ། །\", \"tail\": \"གསེར་དང་ར་གན་མཉམ་པ་སུ་ཞིག་ཡོད། །\"}, {\"label\": \"QUOTE\", \"frame\": \"མདོ་ཏིང་ངེ་འཛིན་རྒྱལ་པོ་ལས།\", \"head\": \"འཇིག་རྟེན་ཁམས་ནི་ཐམས་ཅད་དུ། །ངས་ནི་མདོ་སྡེ་གང་བཤད་པ། །ཚིག་འབྲུ་ཐ་དད་དོན་གཅིག་སྟེ། །\", \"tail\": \"དེ་དག་ཐམས་ཅད་བསྒོམ་པར་འགྱུར། །\"}, {\"label\": \"QUOTE\", \"frame\": \"དཔལ་མར་མེ་མཛད་ཀྱིས།\", \"head\": \"ཤེས་བྱའི་ཆོས་ནི་རྣམ་པ་དཔག་ཏུ་མེད། །ཚེ་ཡི་ཚད་ནི་ཇི་ཡོད་མི་ཤེས་པས། །ངང་པས་ཆུ་ལས་འོ་མ་ལེན་པ་བཞིན། །\", \"tail\": \"རང་གི་འདོད་པ་དེ་དག་བླང་བར་བྱ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཡོན་ཏན་མཛོད་ལས།\", \"head\": \"ཤེས་བྱ་ནམ་མཁའི་གཟའ་སྐར་འདྲ། །བསླབ་དགོས་གནས་ལ་ཟད་པ་མེད། །ད་རེས་ཆོས་སྐུ་སྙིང་པོའི་དོན། །\", \"tail\": \"འགྱུར་མེད་བཙན་ས་ཟིན་ན་ལེགས། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ལོ་ཆེན་བཻ་རོ་ཙ་ནས།\", \"head\": \"ཚིག་གི་རྩ་བ་མ་གཅོད་དོན་གྱི་རྩ་བ་ཆོད། །དོན་གྱི་རྩ་བ་ཆོད་ན་ཚིག་རྩ་དེ་རུ་འདུས། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"སངས་རྒྱས་སྙིང་པོའི་མདོ་ལས།\", \"head\": \"དམུས་ལོང་ཞིག་གིས་གཞན་ལ་མར་གྱི་ཁ་དོག་དྲིས་པར་ཁ་བ་འདྲའོ་ཞེས་སྨྲས་པ་དང་དེས་ཁ་བ་ལ་རེག་པས་མར་གྱི་ཁ་དོག་གྲང་མོར་འཛིན་ནས། ཁ་བའི་ཁ་དོག་དྲིས་པར་ངང་པའི་གཤོག་པ་འདྲ་སྨྲས་པས་ངང་པའི་གཤོག་སྒྲ་ཐོས་པས་ཁ་བའི་ཁ་དོག་འུར་འུར་པོ་འཛིན་ནས། ཡང་གཤོག་པའི་ཁ་དོག་དྲིས་པས་དུང་འདྲ་ཞེས་དུང་ལ་རེག་པས་འཇམ་པོར་འཛིན་ནས་\", \"tail\": \"མ་འཕྲོད་པ་ལྟ་བུ་དང་།\"}, {\"label\": \"QUOTE\", \"frame\": \"ཕལ་པོ་ཆེ་ལས།\", \"head\": \"དཔེར་ན་འོན་པ་རོལ་མོ་མཁན། །གཞན་དག་དེ་ཡིས་དགའ་བྱེད་ཀྱང་། །བདག་ཉིད་ཀྱིས་ནི་མི་ཐོས་ལྟར། །\", \"tail\": \"བསྒོམས་པས་རོ་ནི་མྱོང་བར་འགྱུར། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཇི་སྐད་དུ།\", \"head\": \"ཐོས་ནས་ཉམས་སུ་མ་བླངས་ན། །བུ་རམ་ཐོས་ཏེ་མ་ཟོས་འདྲ། །རོ་མཆོག་མི་མྱོང་དགོས་པ་མེད། །མྱང་ཀྱང་མི་ཕན་མཐའ་སྐྱོང་དགོས། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"དཀོན་བརྩེགས་ལས།\", \"head\": \"མ་བསྒྲལ་བས་ནི་བསྒྲལ་མི་ནུས། །མ་གྲོལ་བས་ནི་བགྲོལ་མི་ནུས། །ལོང་བས་ལམ་ཡང་སྟོན་མི་ནུས། །གྲོལ་བས་དགྲོལ་བར་བསྐྱེད་པར་ནུས། །\", \"tail\": \"མིག་ལྡན་ལོག་ལ་ལམ་སྟོན་ནུས། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཞལ་གདམས་ལས།\", \"head\": \"ཐོས་པས་ཆོག་པའི་སྒོམ་པ་དེ་ཡིན་ན། །ཐར་པ་ནག་པོ་སངས་རྒྱས་མ་ཡིན་ནམ། །ཐོས་པ་མེད་པས་སྒོམ་པ་མེད་གྱུར་ན། །སངས་རྒྱས་རང་རྒྱལ་དགག་པ་མ་ཡིན་ནམ། །\", \"tail\": \"གདོད་མའི་མགོན་པོ་དགག་པ་མ་ཡིན་ནམ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"དཀོན་བརྩེགས་ལས།\", \"head\": \"འོད་སྲུང་། ང་དང་ང་འདྲ་བས་ཆོས་དང་གང་ཟག་གི་ཚད་བཟུང་བར་བྱ་ཡི། གང་ཟག་གིས་གང་ཟག་དང་ཆོས་ཀྱི་ཚོད་ནི་གཟུང་བར་མི་བྱ་སྟེ་ལྟུང་བར་འགྱུར་བའི་ཕྱིར་རོ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"མདོ་སྡེ་རྒྱན་ལས།\", \"head\": \"མི་རིགས་པ་ཡིས་གཟུགས་ལའང་མི་རིགས་ན། །ཐེ་ཚོམ་ཟ་བའི་ཆོས་ལ་སྨོས་ཅི་དགོས། །དེ་བས་བཏང་སྙོམས་བཞག་ན་ཉེས་པ་མེད། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"དགོངས་འདུས་ལས།\", \"head\": \"བླ་མ་མེད་པའི་གོང་རོལ་ན། །སངས་རྒྱས་བྱ་བའི་མིང་ཡང་མེད། །བསྐལ་པ་སྟོང་གི་སངས་རྒྱས་ཀྱང་། །བླ་མ་དག་ལ་བསྟེན་ནས་བྱུང་། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཚུལ་གསུམ་སྒྲོན་མེ་ལས།\", \"head\": \"དོན་གཅིག་ན་ཡང་མ་རྨོངས་དང་། །ཐབས་མང་དཀའ་བ་མེད་པ་དང་། །དབང་པོ་རྣོན་པོའི་དབང་བྱས་ནས། །སྔགས་ཀྱི་ཐེག་པ་ཁྱད་པར་འཕགས། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"རྒྱུད་བརྟག་གཉིས་ལས།\", \"head\": \"སེམས་ཅན་རྣམས་ནི་སངས་རྒྱས་ཉིད། །འོན་ཀྱང་གློ་བུར་དྲི་མས་བསྒྲིབས། །དྲི་མ་དེ་བསལ་སངས་རྒྱས་དངོས། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"རྒྱུད་བླ་མ་ལས།\", \"head\": \"རང་བྱུང་ཉིད་ཀྱི་དོན་དམ་དེ། །དད་པ་ཉིད་ཀྱིས་རྟོགས་བྱ་ཡིན། །ཉི་མའི་དཀྱིལ་འཁོར་འོད་འབར་བ། །མིག་མེད་པས་ནི་མཐོང་མི་འགྱུར། །\", \"tail\": \"\"}]}",
