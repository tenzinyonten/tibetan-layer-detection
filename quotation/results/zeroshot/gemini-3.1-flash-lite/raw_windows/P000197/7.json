  "raw_text": "{\"spans\": [{\"label\": \"QUOTE\", \"frame\": \"རྗེ་ལྷ་རྩེ་བས།\", \"head\": \"ཉམས་ལེན་མོས་གུས་སུ་གོ་ནས། །གཅིག་ཤེས་ཀུན་གྲོལ་དེ་ལོན་སོང་། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"རྗེ་རྒོད་ཚང་པས།\", \"head\": \"གསང་སྔགས་ལམ་ནས་ཚེ་གཅིག་ལ་སངས་རྒྱས་ཟེར་བ་མང་སྟེ། གཞན་གྱི་ཁས་མི་ལོན། མོས་གུས་ཀྱི་ཁས་ལོན་པ་ཡིན།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"རྒྱལ་དབང་རྗེས།\", \"head\": \"སྒོམ་སྲན་གྱི་གྲོལ་བར་ཐེ་ཚོམ་ཟ། །མོས་གུས་ཀྱིས་གྲོལ་བར་ཐེ་ཚོམ་མེད། །དེ་གནད་ཀ་ཡོད་མེད་ཀྱི་ཁྱད་པར་ཡིན། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"གླིང་རས་པས།\", \"head\": \"དཔེ་ཡི་གེ་གཅིག་ཀྱང་མ་བྲིས་ཏེ། །རྒྱལ་བའི་བསྟན་པ་རབ་འབྱམས་ལ། །ཤེས་པའི་སྣང་བ་དེ་ནས་བྱུང་། །ཤེས་རབ་ཀྱི་མིག་གཅིག་གནང་བ་འདྲ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"རྣམ་སྣང་མངོན་བྱང་ལས།\", \"head\": \"ལུས་བསྲང་རྡོ་རྗེ་སྐྱིལ་ཀྲུང་བཅའ། །ཡིད་ནི་རྩེ་གཅིག་ཕྱག་རྒྱ་ཆེ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"རྒྱུད་ལས།\", \"head\": \"འབྱུང་བཞི་ལུས་ཀྱི་འདུག་ཚུལ་ནི། །བདེ་དང་ཡངས་དང་ལྷོད་དང་གསུམ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"དཀར་བརྒྱུད་གོང་མ་རྣམས་ཀྱིས།\", \"head\": \"རྟེན་འབྲེལ་ལུས་ལ་བསྒྲིགས་ན། རྟོགས་པ་སེམས་ལ་འཆར།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"གདན་བཞི་ལས།\", \"head\": \"རླུང་དང་ངག་ནི་གཡོ་མེད་པ། །འདི་ཡི་བསམ་གཏན་ཉེ་བར་འགྲུབ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཇི་སྐད་དུ།\", \"head\": \"བསམ་དང་བསམ་བྱ་ཐམས་ཅད་ཡོངས་དོར་ལ། །ཇི་ལྟར་བུ་ཆུང་ལྷུག་པར་གནས་པ་བཞིན། །བླ་མའི་ལུང་ལ་བསྒྲིམས་ཏེ་གུས་འབད་ན། །ལྷན་ཅིག་སྐྱེས་པ་འབྱུང་བར་ཐེ་ཚོམ་མེད། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཆོས་དྲུག་ལས།\", \"head\": \"མིག་དང་ཤེས་པ་མ་འགྱུར་བར། །རླུང་སེམས་དྲིལ་ལ་དྲག་ཏུ་གཅུན། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"བཤེས་སྤྲིངས་ལས།\", \"head\": \"དབང་ཕྱུག་ལུས་གཏོགས་དྲན་པ་བདེ་གཤེགས་ཀྱིས། །བགྲོད་པ་གཅིག་པུའི་ལམ་དུ་ཉེ་བར་བསྟན། །ད་ནི་བསྒྲིམས་ནས་མངོན་པར་བསྲུང་བགྱི་སྟེ། །དྲན་པ་ཉམས་པས་ཆོས་ཀུན་འཇིག་པར་འགྱུར། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"རྗེ་བྱམས་པས།\", \"head\": \"ལས་རྣམས་ཀུན་གྱི་རྩ་བ་དྲན་པ་སྟེ། །སྔོན་དུ་བཞག་པར་བྱ་བ་འདུན་པ་ཡིན། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"མདོ་སྡེ་རྒྱན་ལས།\", \"head\": \"དམིགས་པ་ཉིད་ལ་སེམས་གཏད་ནས། །དེ་རུ་རྣམ་པར་གཡེང་མི་བྱ། །རྣམ་གཡེང་མྱུར་དུ་རྟོགས་བྱས་ནས། །སླར་ཡང་དེ་ལ་བརླན་པར་བྱ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"དྭགས་པོ་ཆོས་རྗེས།\", \"head\": \"མ་ཡེངས་པ་ནི་སངས་རྒྱས་ཀུན་གྱི་ལམ། །མ་ཡེངས་པ་ནི་དགེ་བའི་བཤེས་དང་གཉེན། །མ་ཡེངས་པ་ནི་གདམས་པ་ཀུན་གྱི་གཙོ། །མ་ཡེངས་རྒྱུན་གྱི་དྲན་པ་འདི་སྐྱོང་དང་། །དུས་གསུམ་སངས་རྒྱས་ཀུན་གྱི་གཞུང་ལམ་ཡིན། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཏཻ་ལོ་པས།\", \"head\": \"བློ་དམན་སྐྱེ་བོ་དོན་ལ་མི་གནས་པས། །དང་པོ་དམིགས་རྟེན་ཚོགས་ལ་གོམས་པར་གཅེས། །ལྟ་སྟངས་སེམས་འཛིན་ཡན་ལག་དུ་མ་ལས། །རིག་པ་ངང་གིས་མི་གནས་བར་དུ་ཟུངས། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ལམ་སྒྲོན་ལས།\", \"head\": \"དམིགས་རྟེན་གང་རུང་གཅིག་ལ་ནི། །ཡིད་ནི་དགེ་ལ་བཞག་པར་བྱ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"རྗེ་མི་ལས།\", \"head\": \"རྣམ་རྟོག་ནི་ལྕགས་ཀྱི་སྤར་བུ་དགུ་བརྩེགས་ཀྱི་ཕུག་ཏུ་བཅུག་ཀྱང་འདུག་པ་མིན།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"མདོ་ཏིང་འཛིན་རྒྱལ་པོ་ལས།\", \"head\": \"གསེར་གྱི་ཁ་དོག་ལྟ་བུའི་སྐུ་ལུས་ནི། །འཇིག་རྟེན་མགོན་པོ་ཀུན་ནས་མཛེས་པ་སྟེ། །དམིགས་པ་དེ་ལ་གང་ཞིག་སེམས་འཇོག་པ། །བྱང་ཆུབ་སེམས་དེ་མཉམ་པར་བཞག་ཅེས་བྱ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"རྒྱུད་ལས།\", \"head\": \"སངས་རྒྱས་ཐུགས་ཀྱི་ངོ་བོ་ཉིད་། །ཡི་གེ་ཧཱུྃ་གིས་ཡིད་སྒྲིབ་སྦྱངས། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"རྡོ་རྗེ་མཁའ་འགྲོ་ལས།\", \"head\": \"མཁའ་འགྲོ་མ་ཡི་སྣ་རྩེར་ནི། །ཡུངས་དཀར་རྣམ་པར་གནས་པ་སྒོམས། །མཁའ་འགྲོ་མ་ལུས་ཡུངས་དཀར་དུའོ། །དེ་ལྟ་བུ་ནི་བསྒོམས་གྱུར་ན། །རང་ཉིད་བྱིན་རླབས་རབ་ཏུ་འགྲུབ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"གསང་བ་སྒྲོན་མའི་རྒྱུད་ལས།\", \"head\": \"དམིགས་པ་དག་ལ་བརྟེན་ནས་སུ། །མི་དམིགས་པ་དག་རབ་ཏུ་བསྐྱེད། །མི་དམིགས་པ་ལ་གོམས་བྱས་ཀྱང་། །དམིགས་མེད་ངོ་བོ་ཉིད་དུ་འགྲུབ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"བཤེས་སྤྲིངས་ལས།\", \"head\": \"དབང་ཕྱུག་ལུས་གཏོགས་དྲན་པ་བདེ་གཤེགས་ཀྱིས། །བགྲོད་པ་གཅིག་པུའི་ལམ་དུ་ཉེ་བར་བསྟན། །ད་ནི་བསྒྲིམས་ནས་མངོན་པར་བསྲུང་བགྱི་སྟེ། །དྲན་པ་ཉམས་པས་ཆོས་ཀུན་འཇིག་པར་འགྱུར། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"རྗེ་བྱམས་པས།\", \"head\": \"ལས་རྣམས་ཀུན་གྱི་རྩ་བ་དྲན་པ་སྟེ། །སྔོན་དུ་བཞག་པར་བྱ་བ་འདུན་པ་ཡིན། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"མདོ་སྡེ་རྒྱན་ལས།\", \"head\": \"དམིགས་པ་ཉིད་ལ་སེམས་གཏད་ནས། །དེ་རུ་རྣམ་པར་གཡེང་མི་བྱ། །རྣམ་གཡེང་མྱུར་དུ་རྟོགས་བྱས་ནས། །སླར་ཡང་དེ་ལ་བརླན་པར་བྱ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"དྭགས་པོ་ཆོས་རྗེས།\", \"head\": \"མ་ཡེངས་པ་ནི་སངས་རྒྱས་ཀུན་གྱི་ལམ། །མ་ཡེངས་པ་ནི་དགེ་བའི་བཤེས་དང་གཉེན། །མ་ཡེངས་པ་ནི་གདམས་པ་ཀུན་གྱི་གཙོ། །མ་ཡེངས་རྒྱུན་གྱི་དྲན་པ་འདི་སྐྱོང་དང་། །དུས་གསུམ་སངས་རྒྱས་ཀུན་གྱི་གཞུང་ལམ་ཡིན། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཏཻ་ལོ་པས།\", \"head\": \"བློ་དམན་སྐྱེ་བོ་དོན་ལ་མི་གནས་པས། །དང་པོ་དམིགས་རྟེན་ཚོགས་ལ་གོམས་པར་གཅེས། །ལྟ་སྟངས་སེམས་འཛིན་ཡན་ལག་དུ་མ་ལས། །རིག་པ་ངང་གིས་མི་གནས་བར་དུ་ཟུངས། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ལམ་སྒྲོན་ལས།\", \"head\": \"དམིགས་རྟེན་གང་རུང་གཅིག་ལ་ནི། །ཡིད་ནི་དགེ་ལ་བཞག་པར་བྱ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"རྗེ་མི་ལས།\", \"head\": \"རྣམ་རྟོག་ནི་ལྕགས་ཀྱི་སྤར་བུ་དགུ་བརྩེགས་ཀྱི་ཕུག་ཏུ་བཅུག་ཀྱང་འདུག་པ་མིན།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཞང་རིན་པོ་ཆེས།\", \"head\": \"གནས་པ་དང་པོ་བྱུང་དུས་སུ། །རི་གཟར་ལོག་ནས་རྦབ་འདྲིལ་འདྲ། །རྣམ་རྟོག་ཟམ་མི་ཆད་པར་ལྡང་། །སྒོམ་སྙམ་མེད་དམ་སྙམ་པའོ། །རྣམ་རྟོག་ཅུང་ཟད་ཚོར་བ་སྟེ། །ཤེས་པ་ཅུང་ཟད་གནས་པ་ཡིན། །གནས་པ་མེད་པའི་གོང་རོལ་ན། །རྣམ་རྟོག་རང་གར་ཤོར་བ་ཡིན། །རྟག་པར་འགྱུས་ཀྱང་ངོ་མ་ཤེས། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"རྗེ་མི་ལས།\", \"head\": \"གེགས་གོལ་ས་མང་བའི་རྩུབ་ཉམས་དེ། །ཆོས་སྐྱོན་ཅན་ཡིན་པ་མ་ལགས་ཏེ། །རྟགས་མྱུར་དུ་ཐོན་པའི་སྔ་ལྟས་ཡིན། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"རྗེ་པད་མ་དཀར་པོས།\", \"head\": \"སེམས་མ་བཅིངས་མ་བཅིངས་ལྷོད་ལ་ཞོག །སེམས་བཅིང་ན་ཕྱོགས་བཅུར་འགྲོ་བར་རྩོམ། །རྒྱ་ཡན་དུ་བཞག་ན་རྣལ་དུ་བབ། །ཡེངས་མེད་དུ་བསྐྱང་ན་རང་མཚང་རིག །བཅས་བཅོས་འགའ་བྱེད་ན་སྒོམ་གྱིས་བསླུ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ས་ར་ཧས།\", \"head\": \"བཅིང་པར་གྱུར་ན་ཕྱོགས་བཅུར་འགྲོ་བ་རྩོམ། །ཐོངས་པར་གྱུར་ན་མི་གཡོ་བརྟན་པར་གནས། །གོ་ལྡོག་རྔ་མོང་ལྟ་བུར་བདག་གིས་རྟོགས། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཏིལླི་པས།\", \"head\": \"མ་བཅོས་གཉུག་མའི་ངང་དུ་གློད་ལ་ཞོག །བཅིངས་པ་གློད་ན་གྲོལ་བ་ཐེ་ཚོམ་མེད། །སེམས་ལ་རྣམ་རྟོག་བྱུང་ན་རྣལ་འབྱོར་པས། །རས་བལ་བཞིན་དུ་མ་བཅོས་གློད་ལ་ཞོག །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"རྗེ་མི་ལས།\", \"head\": \"ལྷོད་ཀྱི་གློད་པས་རང་ས་ཟིན། །རིག་པའི་ཆུ་བོ་དྭངས་སྙིགས་ཕྱེད། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ས་ར་ཧས།\", \"head\": \"མ་བཅོས་སོ་མར་བཞག་ན་རྟོགས་པ་འཆར། །ཆུ་བོའི་རྒྱུན་བཞིན་བསྐྱངས་ན་ཡོངས་ཀྱང་འཆར། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"དྭགས་པོས།\", \"head\": \"འཇུར་བུས་བཅིང་པའི་སེམས་ཉིད་འདི། །གློད་ན་གྲོལ་བ་ཐེ་ཚོམ་མེད། །འགྱུ་བ་དངོས་མེད་བསེར་བུ་འདྲ། །འཛིན་པ་མ་ཞུགས་འགྱུས་པས་ཆོག །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"རྗེ་རྒོད་ཚང་པས།\", \"head\": \"ཡང་གཅིག་རྣམ་རྟོག་སྐྱེས་པ་ན། །ངོ་ཡིས་ཙེར་གྱིས་བཟུང་མཛོད་ལ། །ཁོ་རང་ཐོག་ཏུ་ལྷོད་ལ་ཞོག །རང་སར་གྲོལ་བ་ཐེ་ཚོམ་མེད། །བར་དུ་རིག་པ་ཁྲོལ་དུ་ཆུག །འགྱུ་བ་དངོས་མེད་བསེར་བུ་འདྲ། །འཛིན་པ་མ་ཞུགས་འགྱུས་པས་ཆོག །དེ་ལ་རྣམ་རྟོག་སྒོམ་ཤར་ཟེར། །\", \"tail\": \"\"}]}",
