  "raw_text": "{\"spans\": [{\"label\": \"QUOTE\", \"head\": \"ལྷག་མཐོང་སྔ་ན་ཞི་གནས་མེད། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"དགོངས་པ་ངེས་འགྲེལ་ལས།\", \"head\": \"བསམ་གཏན་གྱིས་ནི་ཉོན་མོངས་པ་རྣམ་པར་གནོན་ཏེ། ཤེས་རབ་ཀྱིས་ནི་\", \"tail\": \"བག་ཉལ་རྣམས་ལེགས་པར་འཇོམས་པར་བྱེད་དོ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཇི་སྐད་དུ།\", \"head\": \"ཞི་གནས་མེད་པའི་ལྷག་མཐོང་དེ། །རླུང་གསེབ་དཀྱིལ་གྱི་\", \"tail\": \"དྭངས་པའི་དུས་སྐབས་འབྱུང་མི་སྲིད། །\"}, {\"label\": \"QUOTE\", \"frame\": \"དཀོན་མཆོག་སྤྲིན་མདོ་ལས།\", \"head\": \"ཞི་གནས་ནི་སེམས་རྩེ་གཅིག་པའོ། །ལྷག་མཐོང་ནི་ཡང་དག་པ་\", \"tail\": \"ཆོས་ཉིད་སོ་སོར་རྟོགས་པའོ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ལྗོན་པས་ཞུས་མདོ་ལས།\", \"head\": \"ཞི་གནས་ནི་རྩེ་གཅིག་པའོ། །ལྷག་མཐོང་ནི་རིག་ཆའོ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཏིལླི་པས།\", \"head\": \"དཔེར་ན་ནམ་མཁའ་མཐོང་བ་ཐ་སྙད་རབ་བཏགས་ཀྱང་། །ནམ་མཁའ་ལ་ནི་འདི་\", \"tail\": \"ཆོས་རྣམས་མ་ལུས་དེ་རུ་མ་འདུས་མེད། །\"}, {\"label\": \"QUOTE\", \"frame\": \"རྒྱལ་དབང་རྗེས།\", \"head\": \"མི་ལ་ལས་སྟོང་ཉིད་སྟོང་ཉིད་ཟེར། །སྟོང་མཁན་སྟོང་ཡུལ་མ་གྲུབ་\", \"tail\": \"གཤིས་རང་བཞིན་གྱི་སྟོང་པ་ཡིན་པ་འདྲ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"མི་ཏྲ་ཛྭ་ཀིས།\", \"head\": \"གདོད་ནས་སྐྱེ་བ་མེད་པ་ནི། །འཁོར་འདས་ཀུན་གྱི་བྱེད་རྒྱུ་ཅན། །\", \"tail\": \"བླ་མའི་དྲིན་གྱིས་ཤེས་པར་བྱོས། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ས་ར་ཧ་པས།\", \"head\": \"མདུན་དང་རྒྱབ་དང་ཕྱོགས་བཅུ་རུ། །གང་གང་མཐོང་བ་དེ་དེ་ཉིད། །\", \"tail\": \"ད་ནི་སུ་ལའང་འདྲི་བར་མི་བྱའོ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཏིལླི་པས།\", \"head\": \"དཔེར་ན་ནམ་མཁའི་རང་བཞིན་ཁ་དོག་དབྱིབས་ལས་འདས། །དཀར་ནག་\", \"tail\": \"དགེ་སྡིག་དཀར་ནག་ཆོས་ཀྱིས་གོས་མི་འགྱུར། །\"}, {\"label\": \"QUOTE\", \"frame\": \"བྱམས་པ་མགོན་པོས།\", \"head\": \"འདི་ལ་བསལ་བྱ་ཅི་ཡང་མེད། །གཞག་པར་བྱ་བ་ཅུང་ཟད་མེད། །ཡང་དག་\", \"tail\": \"ཡང་དག་མཐོང་ན་རྣམ་པར་གྲོལ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཡུམ་ལས།\", \"head\": \"སྨྲ་བསམ་བརྗོད་མེད་ཤེས་རབ་ཕ་རོལ་ཕྱིན། །མ་སྐྱེས་མི་འགག་ནམ་\", \"tail\": \"དུས་གསུམ་རྒྱལ་བའི་ཡུམ་ལ་ཕྱག་འཚལ་ལོ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"མདོ་སྡུད་པ་ལས།\", \"head\": \"ནམ་མཁའ་མཐོང་ཞེས་སེམས་ཅན་ཚིག་ཏུ་རབ་བརྗོད་ཀྱང་། །ནམ་མཁའ་\", \"tail\": \"མཐོང་བ་དཔེ་གཞན་གྱིས་ནི་བསྙད་པར་ནུས་མ་ཡིན། །\"}, {\"label\": \"QUOTE\", \"frame\": \"མངའ་བདག་མཻ་ཏྲི་པས།\", \"head\": \"གཞི་ཡི་རང་བཞིན་ཡོངས་སུ་ཤེས། །གཉུག་མ་མཚོན་དུ་མེད་པ་འདི། །\", \"tail\": \"རང་དང་འདུ་འབྲལ་གཉིས་སུ་མེད། །\"}, {\"label\": \"QUOTE\", \"frame\": \"རྒྱལ་པོ་ཨིནྡྲ་བྷཱུ་ཏིས།\", \"head\": \"རང་བཞིན་ཡེ་ནས་རྣམ་དག་པས། །གདོད་མའི་ཤེས་པ་སྤྲོས་དང་བྲལ། །\", \"tail\": \"བདག་ཀྱང་འདི་ཉིད་རྟོགས་པས་གྲོལ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"རྗེ་རྒོད་ཚང་པས།\", \"head\": \"ཟབ་ཞི་སྤྲོས་བྲལ་འདུས་མ་བྱས་པའི་དབྱིངས། །རང་བཞིན་རྣམ་དག་བདེ་\", \"tail\": \"རང་གསལ་ཉིད་དུ་བཞག་པ་ཉམས་ལེན་ཡིན། །\"}, {\"label\": \"QUOTE\", \"frame\": \"བྲམ་ཟེ་ཆེན་པོས།\", \"head\": \"གང་ལ་དམིགས་ཀྱང་དམིགས་པ་དེ་ཡིས་ཐར་པ་བསྒྲིབས། །བཟང་བར་བཏགས་\", \"tail\": \"དམན་པའི་ལས་ལ་བརྟགས་པས་རྣམ་སྨིན་རྒྱུན་མི་ཆད། །\"}, {\"label\": \"QUOTE\", \"head\": \"ཀྱེ་མ་འདོད་པའི་དངོས་པོ་གང་ལ་ཆགས་མ་བྱེད། །འདི་ནི་བདེ་ཆེན་སེམས་མཆོག་\", \"tail\": \"དྲི་མ་མེད་པའི་སེམས་ལ་འདོད་པའི་མཚོན་གྱིས་བཏབ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"རྗེ་སྒམ་པོ་པས།\", \"head\": \"ཇི་སྲིད་འཛིན་པའི་བརྟོད་ཕུར་མ་ཕྱིན་བར། །དེ་སྲིད་རྣམ་རྟོག་ཡོད་པས་ལས་\", \"tail\": \"མ་ཡེངས་དྲན་པའི་བྱ་ར་བརྟེན་དང་ལེགས། །\"}, {\"label\": \"QUOTE\", \"frame\": \"རྗེ་འབྲི་གུང་པས།\", \"head\": \"འབྲས་བུ་ལ་ངེས་ཤེས་སྐྱེས་ཙ་ན། །ཐོ་ཅོའི་རྩིང་ཧྲལ་ཡང་རྫུན་པོ་གདའ། །\", \"tail\": \"བློ་གཏད་ཅིག་འདུག་གམ་མི་འདུག་ལྟོས། །\"}, {\"label\": \"QUOTE\", \"head\": \"ཆགས་ན་ལྷ་ལ་ཆགས་ན་མི་གྲོལ་ཏེ། །ཞེན་ན་ཆོས་ལ་ཞེན་ནའང་འཆིང་བའི་རྒྱུ། །\", \"tail\": \"དེས་ན་གང་ལའང་ཆགས་པར་མི་བྱའོ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཏིལླི་པས།\", \"head\": \"ཏིལ་གྱི་ཤུན་པ་ཙམ་གྱི་ཟུག་རྔུས་ཀྱང་། །ནམ་ཞིག་སྡུག་བསྔལ་འབའ་ཞིག་\", \"tail\": \"གང་ལ་ཞེན་པ་ཡོད་ན་དེ་ཡང་ཐོང་། །\"}, {\"label\": \"QUOTE\", \"frame\": \"རྗེ་མི་ལས།\", \"head\": \"ཕྱི་སྣང་བ་ཇི་ལྟར་སྣང་ལགས་ཀྱང་། །མ་རྟོགས་དུས་སུ་འཁྲུལ་སྣང་སྟེ། །\", \"tail\": \"སྐྱེ་མེད་ཆོས་ཀྱི་སྐུ་རུ་གོ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཆོས་རྗེ་རང་བྱུང་རྡོ་རྗེས།\", \"head\": \"ཕྱི་རོལ་སྣང་བ་སྣ་ཚོགས་འདི། །རང་གི་སེམས་ཀྱི་ཆོ་འཕྲུལ་ཏེ། །གཞན་དུ་\", \"tail\": \"དེ་ཕྱིར་རང་གི་སེམས་སུ་ལྟོས། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཏིལླི་པས།\", \"head\": \"གསེར་གྱི་རི་ཡི་ངོས་ནས་བྱ་འཕུར་ན། །བྱ་ཡི་རང་བཞིན་བོར་ནས་སེར་པོ་\", \"tail\": \"འཁོར་བའི་རང་བཞིན་བོར་ནས་ཆོས་སྐུ་སྣང་། །\"}, {\"label\": \"QUOTE\", \"frame\": \"དྭགས་པོས།\", \"head\": \"སེམས་ཉིད་ལྷན་ཅིག་སྐྱེས་པ་ཆོས་ཀྱི་སྐུ། །སྣང་བ་ལྷན་ཅིག་སྐྱེས་པ་ཆོས་\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"དྭགས་སྒོམ་ཚུལ་ཁྲིམས་སྙིང་པོས།\", \"head\": \"སེམས་ཉིད་ལྷན་ཅིག་སྐྱེས་པ་ཆོས་ཀྱི་སྐུ། །རྣམ་རྟོག་ལྷན་ཅིག་སྐྱེས་པ་ཆོས་སྐུའི་\", \"tail\": \"དེ་ཕྱིར་གཤིས་མདངས་དབྱེར་མེད་ལྷན་ཅིག་སྐྱེས། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ལོ་རས་ཀྱིས།\", \"head\": \"ཚོགས་དྲུག་ཡུལ་དུ་ཅི་ཤར་ཡང་། །ཡིད་ཀྱི་འཛིན་པ་མ་ཞུགས་ན། །ཐམས་\", \"tail\": \"དབྱེར་མེད་རྟོགས་སམ་སྒོམ་ཆེན་རྣམས། །\"}, {\"label\": \"QUOTE\", \"frame\": \"གྲུབ་ཐོབ་ཅེར་སྒོམ་པས།\", \"head\": \"ཇི་ལྟར་སྣང་བ་ཐམས་ཅད་ནི། །རིག་པ་སེམས་ཀྱི་རང་ངོ་ཡིན། །དེ་ལ་\", \"tail\": \"སྣང་སྟོང་དབྱེར་མེད་ཤེས་པར་བྱོས། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཨོ་རྒྱན་ཆེན་པོས།\", \"head\": \"སྣ་ཚོགས་སྣང་བའི་འཆར་སྒོ་མ་བཅོས་པར། །ཅིར་སྣང་ངོ་ཤེས་ཆོས་སྐུའི་\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཤ་བ་རི་པས།\", \"head\": \"རྟོགས་པ་ཅན་ལ་བསྒོམ་བྱ་སྒོམ་བྱེད་མེད། །ཇི་ལྟར་ནམ་མཁས་ནམ་མཁའ་དམིགས་སུ་\", \"tail\": \"སྣ་ཚོགས་རོ་གཅིག་བདེ་ཆེན་རྒྱུན་ཆད་མེད། །\"}, {\"label\": \"QUOTE\", \"frame\": \"དྭགས་པོས།\", \"head\": \"རང་སེམས་ལྷན་ཅིག་སྐྱེས་པ་ཆོས་སྐུ་དངོས། །སྣང་བ་ལྷན་ཅིག་སྐྱེས་པ་ཆོས་སྐུའི་\", \"tail\": \"གནས་སྐབས་གསུམ་དུ་འཆོལ་བྲལ་མེད་པ་བརྟེན། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ས་ར་ཧས།\", \"head\": \"ཁམས་གསུམ་མ་ལུས་འདི་དག་ཐམས་ཅད་ནི། །འདོད་ཆགས་ཆེན་པོ་གཅིག་ཏུ་\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"རྒྱལ་མཚན་དཔལ་བཟང་གིས།\", \"head\": \"སྣང་བ་སྣ་ཚོགས་རྟེན་ཅིང་འབྲེལ་འབྱུང་ཡིན། །སྟོང་པ་ཕྱོགས་ཡན་ཁོ་ནར་མི་བལྟ་བར། །\", \"tail\": \"ཐབས་རྣམས་ཀུན་ལ་རྩལ་སྦྱང་བྱེད་པ་གནད། །\"}, {\"label\": \"QUOTE\", \"frame\": \"རྗེ་རྒྱ་རས་ཀྱིས།\", \"head\": \"རོ་གཅིག་རྣལ་འབྱོར་ནོན་ཙ་ན། །འགྲོ་དོན་ས་བོན་དེ་རུ་གདའ། །རང་ལ་\", \"tail\": \"མི་བདེན་བཞིན་དུ་རྟེན་འབྲེལ་བསྒྲིགས། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཌོམ་བྷི་ཧེ་རུ་ཀས།\", \"head\": \"སྲིད་ཞི་མཉམ་ཉིད་སྤྲོས་དང་བྲལ། །རྩོལ་སྒྲུབ་བྱེད་པ་ཤ་ཐང་ཆད། །ཡུལ་\", \"tail\": \"བཟང་ངན་འཛིན་པ་སྙིང་རེ་རྗེ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"བིར་བ་པས།\", \"head\": \"ཀུན་རྫོབ་སངས་རྒྱས་མི་རེའི་གདེང་ཆེན་ལྡན་གྱུར་ཀྱང་། །བསོད་ནམས་ཚོགས་ཆེན་\", \"tail\": \"བཀའ་དྲིན་ཅན་གྱི་བླ་མ་སྤྱི་བོའི་གཙུག་ཏུ་ཁུར། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཡེ་ཤེས་མཁའ་འགྲོ་ལས།\", \"head\": \"ཅིར་སྣང་སྒོམ་དུ་མ་ཤར་ན། །གཉེན་པོ་བརྟེན་པས་ག་ལ་སྤངས། །ཡུལ་\", \"tail\": \"སྒྱུ་མར་ཤེས་ན་རང་སར་གྲོལ། །\"}]}",
