  "raw_text": "{\n  \"spans\": [\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"ཡེ་ཤེས་དམ་པའི་མདོ་ལས།\",\n      \"head\": \"བསོད་ནམས་ཀྱི་ཚོགས་འཁོར་བའི་ཚོགས་ཞེས་ཏེ།\",\n      \"tail\": \"མྱ་ངན་ལས་འདས་པ་ཐོབ་པར་བྱེད་དོ། །\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"ཤྲཱི་སིང་ཧས།\",\n      \"head\": \"སྟོང་གསུམ་རིན་ཆེན་མཆོད་རྟེན་གྱིས། །ཁེངས་བྱས་བསོད་ནམས་གང་ཡིན་པ། །དེས་ཀྱང་སྒོམ་པའི་ཆར་མི་ཉེ། །སེམས་ཅན་ཀུན་ལ་རིན་ཆེན་ནོར། །ཕུང་པོ་དུ་མ་སྦྱིན་པ་བས། །དགེ་རྩ་ཏིང་འཛིན་ཆར་མི་ཉེ། །སྒོམ་པའི་བསོད་ནམས་ཚད་ལས་འདས། །\",\n      \"tail\": \"\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"གཙུག་ཏོར་ཆེན་པོའི་མདོ་ལས།\",\n      \"head\": \"བསྐལ་པ་མང་པོ་ཐོས་པ་དང་བསམ་པ་བས་ནི་ཉིན་གཅིག་ཆོས་ཉིད་ཀྱི་དོན་སྒོམ་པ་བསོད་ནམས་ཆེ།\",\n      \"tail\": \"\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"གཙུག་ཏོར་དཀར་པོའི་མདོ་ལས།\",\n      \"head\": \"གངྒཱའི་རྡུལ་སྙེད་ཀྱི་བསྐལ་པར་མདོ་སྡེ་རྣམས་བྲི་ཞིང་ཀློག་ལ་ཁ་བཏོན་དུ་བྱེད་པ་བས། ཐ་ན་ཉིན་གཅིག་ཙམ་དུ་ཟག་པ་མེད་པའི་ཤེས་རབ་སྒོམ་ན་སྔ་མ་ལས་བསོད་ནམས་དཔག་མེད་ཆེའོ། །\",\n      \"tail\": \"\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"ས་སྙིང་འཁོར་ལོ་བཅུ་པའི་མདོ་ལས།\",\n      \"head\": \"ཀློག་པ་དང་། ཉན་པ་དང་། འཆད་པ་དང་། ཁ་བཏོན་བསྐལ་པར་བྱེད་པ་ལས། ཉི་མ་གཅིག་བསྒོམས་པས་བསོད་ནམས་ཆེའོ། །\",\n      \"tail\": \"\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"འཇིགས་མེད་གླིང་པས།\",\n      \"head\": \"གཅིག་པུར་བྱ་བ་བཏང་ནས་ནི། །སྒྲུབ་ཚུགས་ཟིན་པའི་རྣལ་འབྱོར་པ། །དེ་ལས་ཆེ་བའི་བསོད་ནམས་ནི། །སྟོང་གསུམ་འདི་ན་མི་རྙེད་དོ། །\",\n      \"tail\": \"\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"ཏིང་འཛིན་རྒྱལ་པོ་ལས།\",\n      \"head\": \"ཁམས་གསུམ་གྱི་སེམས་ཅན་ཐམས་ཅད་ཆོས་དགེ་བ་བཅུ་ཡི་ལམ་ལ་བཀོད་པ་བས། ཆོས་བདག་མེད་པ་ལ་མོས་ནས་དགོན་པའི་ཕྱོགས་སུ་གོམ་པ་བདུན་བོར་བ་བསོད་ནམས་ཆེ།\",\n      \"tail\": \"\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"head\": \"སྐད་ཅིག་བསམ་གཏན་ཐུན་ཞུགས་ན། །ཁམས་གསུམ་གང་བའི་སེམས་ཅན་ལ། །སྲོག་སྦྱིན་པས་ནི་འདི་དོན་ཆེ། །\",\n      \"tail\": \"\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"དེ་ཁོ་ན་ཉིད་ངེས་པར་བསྟན་པའི་མདོ་ལས།\",\n      \"head\": \"ཤཱ་རིའི་བུ་གང་གིས་བསྐལ་པ་གཅིག་གི་བར་དུ་ཉན་པ་བས། གང་གིས་སེ་གོལ་གཏོགས་པ་ཙམ་གྱི་བར་དུ་དེ་ཁོ་ན་ཉིད་ལ་མཉམ་པར་བཞག་པ་བསོད་ནམས་ཆེའོ། །\",\n      \"tail\": \"\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"དགོངས་འདུས་ལས།\",\n      \"head\": \"མར་མེ་གཅིག་གིས་བྱེད་ལས་ཀྱིས། །བསྐལ་པར་གནས་ཀྱི་མུན་པ་སེལ། །སྙིང་པོའི་དོན་རིག་སྐད་ཅིག་པས། །སྔར་ཞེན་བག་ཆགས་མ་ལུས་སེལ། །\",\n      \"tail\": \"\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"ཕྱག་ཆེན་གངྒཱ་མ་ལས།\",\n      \"head\": \"དཔེར་ན་ལྗོན་ཤིང་ཡལ་ག་ལོ་འདབ་རྒྱས། །རྩ་བཅད་ཡལ་ག་ལོ་མ་ཁྲི་འབུམ་ཉམས། །དེ་བཞིན་རང་སེམས་འོད་གསལ་སྐད་ཅིག་གིས། །བསྐལ་པར་བསགས་པའི་སྡིག་སྒྲིབ་མ་ལུས་སེལ། །\",\n      \"tail\": \"\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"གསང་བ་བདུད་རྩི་རྒྱལ་པོའི་རྒྱུད་ལས།\",\n      \"head\": \"མཆོད་དང་གཏོར་མ་ལ་སོགས་པ། །ལས་ཀྱི་བྱ་བ་སྣ་ཚོགས་ཀུན། །སེམས་ཀྱི་དེ་ཉིད་རྙེད་གྱུར་ན། །ཐམས་ཅད་དེ་ཡིས་སྡུད་པར་ངེས། །\",\n      \"tail\": \"\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"སངས་རྒྱས་མཉམ་སྦྱོར་ལས།\",\n      \"head\": \"གཟུགས་བརྙན་ལུགས་མ་ལ་སོགས་ལ། །རྣལ་འབྱོར་འབྱུང་བར་མི་འགྱུར་གྱི། །བྱང་ཆུབ་སེམས་ལ་རབ་བརྟེན་ན། །དེ་ལས་རྣལ་འབྱོར་ལྷར་འགྱུར་རོ། །\",\n      \"tail\": \"\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"མཛོད་ལས།\",\n      \"head\": \"ཚུལ་གནས་ཐོས་དང་བསམ་ལྡན་པས། །སྒོམ་པ་ལ་ནི་རབ་ཏུ་སྦྱོར། །\",\n      \"tail\": \"\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"རབ་ཏུ་མི་གནས་པའི་རྒྱུད་ལས།\",\n      \"head\": \"རྣལ་མའི་སྦྱོར་བ་རྟོགས་བྱའི་ཕྱིར། །བཅོས་མ་ཡིས་ནི་བཟླས་པ་དང་། །བཅོས་མ་ཡིས་ནི་བསྒོམ་པར་བྱ། །རྣལ་མའི་སྦྱོར་བ་རྟོགས་གྱུར་ན། །བཅོས་མ་དག་ཀྱང་ཕྱི་རོལ་ཏེ། །དཔེར་ན་གཟིངས་ལ་ཞུགས་ནས་ནི། །ཕ་རོལ་ཕྱིན་ནས་དོར་བ་ལྟར། །བཅོས་མ་དག་ཀྱང་མི་བྱའོ། །\",\n      \"tail\": \"\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"ཀུན་བྱེད་རྒྱལ་པོ་ལས།\",\n      \"head\": \"སེམས་ནི་འཁོར་འདས་ཀུན་གྱི་བྱེད་པོ་སྟེ། །ཀུན་བྱེད་རྒྱལ་པོ་འདི་ཉིད་ཤེས་པར་བྱོས། །\",\n      \"tail\": \"\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"སློབ་དཔོན་རིན་པོ་ཆེས།\",\n      \"head\": \"སེམས་ནི་འཁོར་འདས་ཀུན་གྱི་བྱེད་པོ་སྟེ། །སེམས་ལས་མིན་པའི་འཁོར་འདས་གང་ཡང་མེད། །བཟང་ངན་ལེགས་ཉེས་ཐམས་ཅད་སེམས་ཀྱིས་བྱེད། །བདེ་སྡུག་མ་ལུས་ཀུན་གྱི་ས་བོན་འདེབས། །\",\n      \"tail\": \"\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"གུར་ལས།\",\n      \"head\": \"རིན་ཆེན་སེམས་ལས་ཕྱིར་གྱུར་པའི། །སངས་རྒྱས་མེད་ཅིང་སེམས་ཅན་མེད། །\",\n      \"tail\": \"\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"སམྦུ་ཊ་ལས།\",\n      \"head\": \"ཕྱི་དང་ནང་གི་བདག་ཉིད་ཅན། །འདི་དག་ཐམས་ཅད་སེམས་ཀྱིས་བཏགས། །སེམས་ལས་མ་གཏོགས་པ་ཉིད་ནི། །གཞན་དུ་ཡོད་པ་མ་ཡིན་ནོ། །\",\n      \"tail\": \"\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"ས་ར་ཧས།\",\n      \"head\": \"ཆོས་རྣམས་ཐམས་ཅད་རང་གི་སེམས་ཡིན་ཏེ། །སེམས་ལས་མ་གཏོགས་ཆོས་གཞན་རྡུལ་ཙམ་མེད། །\",\n      \"tail\": \"\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"དཀོན་མཆོག་སྤྲིན་མདོ་ལས།\",\n      \"head\": \"འཇིག་རྟེན་སེམས་ཀྱིས་ཁྲིད་པ་སྟེ། །སེམས་ཀྱིས་སེམས་ནི་མི་མཐོང་ངོ་། །དགེ་བ་འམ་ནི་མི་དགེ་བའི། །ལས་ནི་སེམས་ཀྱིས་བསགས་པ་ཡིན། །སེམས་ནི་མགལ་མེ་བཞིན་དུ་འཁོར། །སེམས་ནི་རྦ་རླབས་བཞིན་དུ་གཡོ། །སེམས་ནི་ནགས་མེ་བཞིན་དུ་འབར། །སེམས་ནི་ཆུ་ཆེན་བཞིན་དུ་འབབ། །\",\n      \"tail\": \"\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"ཆོས་འབྱུང་བ་མེད་པའི་མདོ་ལས།\",\n      \"head\": \"འཇམ་དཔལ་ཆོས་བདག་མེད་པ་རྣམ་པར་ཤེས་ན། དེས་ལས་ཀྱི་སྒྲིབ་པ་ཐམས་ཅད་དག་པར་འགྱུར་རོ། །\",\n      \"tail\": \"\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"བརྟག་གཉིས་ལས།\",\n      \"head\": \"རྨོངས་ཕྱིར་འཁོར་བའི་གཟུགས་ཅན་ཉིད། །རྨོངས་མེད་འཁོར་བ་དག་པས་ནི། །འཁོར་བ་མྱ་ངན་འདས་པར་འགྱུར། །\",\n      \"tail\": \"\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"ཀླུ་སྒྲུབ་ཀྱིས།\",\n      \"head\": \"གང་ཞིག་འཁོར་བའི་རྒྱུ་གྱུར་པ། །དེ་ཉིད་སྦྱང་པ་བྱས་པ་ལས། །དག་པ་དེ་ཉིད་མྱ་ངན་འདས། །\",\n      \"tail\": \"\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"ཀུན་བྱེད་ལས།\",\n      \"head\": \"ཀུན་བྱེད་རྒྱལ་པོ་རང་སེམས་འདི་ཉིད་ཡིན་བཞིན་དུ་འདི་ཀ་རང་གིས་རང་འདུལ་བྱེད་དགོས། འཁོར་བའི་རྩ་བ་རང་སེམས་ལ་ཐུག་བཞིན་རྩ་བ་ཆོད་པ་བྱེད་དགོས། སངས་རྒྱས་ཀྱི་སྙིང་པོ་སེམས་ལ་ཐུག་བཞིན་དེ་ལྟར་བསྒྲུབ་པར་བྱའོ། །\",\n      \"tail\": \"\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"ཨོ་རྒྱན་རིན་པོ་ཆེས།\",\n      \"head\": \"ཆོས་ཀུན་རྩ་བ་རང་གི་སེམས་ཉིད་དེ། །ནང་དུ་མཉམ་པར་བཞག་པས་དོན་རྟོགས་འགྱུར། །ལུས་ངག་དགེ་སྦྱོར་ཙམ་གྱི་སོ་ན་མིན། །དེས་ན་གཅིག་པུར་རང་སེམས་བལྟ་བ་གནད། །\",\n      \"tail\": \"\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"རྗེ་མི་ལས།\",\n      \"head\": \"ཕྱག་རྒྱ་ཆེན་པོ་སྒོམ་དུས་སུ། །ལུས་ངག་དགེ་ལ་མ་བརྩོན་ཅིག །མི་རྟོག་ཡེ་ཤེས་ཡལ་ཉེན་གདའ། །\",\n      \"tail\": \"\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"ཇོ་བོས།\",\n      \"head\": \"གཅིག་ཏུ་མཉམ་བཞག་སེམས་བརྟན་ན༑ །ལུས་ངག་དགེ་བ་ཅི་ཕྱིར་བརྩོན། །\",\n      \"tail\": \"\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"སློབ་དཔོན་དཔའ་བོས།\",\n      \"head\": \"ཁ་ཅིག་དགེ་བའི་ལས་བྱེད་ཀྱང་། །རྣམ་པར་བདེན་དོན་མི་ཤེས་བཞིན། །རྨི་ལམ་ཡུལ་གྱི་བདེ་བ་ཙམ། །ཐོབ་ནས་སླར་ཡང་ཉམས་པར་གྱུར། །\",\n      \"tail\": \"\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"དབུ་མ་བཞི་བརྒྱ་པ་ལས།\",\n      \"head\": \"ཚུལ་ཁྲིམས་ལས་ནི་ཉམས་བླ་ཞིང་། །ལྟ་ལས་ཅིས་ཀྱང་ཉམས་མ་ཡིན། །ཚུལ་ཁྲིམས་ཀྱིས་ནི་བདེ་འགྲོར་འགྲོ། །ལྟ་བས་གོ་འཕང་མཆོག་ལ་སྦྱོར། །\",\n      \"tail\": \"\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"སྡོམ་གསུམ་རྣམ་ངེས་ལས།\",\n      \"head\": \"འབྲས་བུའི་མཐར་ཐུག་སངས་རྒྱས་ཉག་གཅིག་སྟེ། །ཟབ་རྒྱས་ཆོས་ཀྱི་སྒོ་འཕར་བགྲང་ཡས་ཀྱང་། །གསང་ཆེན་སྨིན་གྲོལ་ལམ་མཆོག་མ་བརྟེན་པ། །ཐོབ་པ་མིན་ཞེས་རྫོགས་སངས་རྒྱས་དེས་གསུངས། །\",\n      \"tail\": \"\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"ངལ་གསོ་ལས།\",\n      \"head\": \"ཤེས་རབ་ལྡན་པ་ཐབས་ཀྱིས་གྲོལ་འགྱུར་ཏེ། །ཇི་ལྟར་དུག་ལ་སྔགས་ཀྱིས་བཏབ་པ་བཞིན། །ཤེས་རབ་མེད་ན་ཐབས་ཀྱིས་འཆིང་གྱུར་ཏེ། །སྨན་ཉིད་ནད་དུ་སོང་ནས་གདུང་བ་ལྟར། །དེ་ཕྱིར་གནས་ལུགས་རྟོགས་པའི་ཤེས་རབ་