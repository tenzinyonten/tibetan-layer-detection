  "raw_text": "{\"spans\": [{\"label\": \"QUOTE\", \"head\": \"གནས་པ་མེད་པའི་གོང་རོལ་ན། །རྣམ་རྟོག་རང་གར་ཤོར་བ་ཡིན། །རྟག་པར་འགྱུས་ཀྱང་ངོ་མ་ཤེས། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"རྗེ་མི་ལས།\", \"head\": \"གེགས་གོལ་ས་མང་བའི་རྩུབ་ཉམས་དེ། །ཆོས་སྐྱོན་ཅན་ཡིན་པ་མ་ལགས་ཏེ། །རྟགས་མྱུར་དུ་ཐོན་པའི་སྔ་ལྟས་ཡིན། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"རྗེ་པད་མ་དཀར་པོས།\", \"head\": \"སེམས་མ་བཅིངས་མ་བཅིངས་ལྷོད་ལ་ཞོག །སེམས་བཅིང་ན་ཕྱོགས་བཅུར་འགྲོ་བར་རྩོམ། །རྒྱ་ཡན་དུ་བཞག་ན་རྣལ་དུ་བབ། །ཡེངས་མེད་དུ་བསྐྱང་ན་རང་མཚང་རིག །བཅས་བཅོས་འགའ་བྱེད་ན་སྒོམ་གྱིས་བསླུ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ས་ར་ཧས།\", \"head\": \"བཅིང་པར་གྱུར་ན་ཕྱོགས་བཅུར་འགྲོ་བ་རྩོམ། །ཐོངས་པར་གྱུར་ན་མི་གཡོ་བརྟན་པར་གནས། །གོ་ལྡོག་རྔ་མོང་ལྟ་བུར་བདག་གིས་རྟོགས། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཏིལླི་པས།\", \"head\": \"མ་བཅོས་གཉུག་མའི་ངང་དུ་གློད་ལ་ཞོག །བཅིངས་པ་གློད་ན་གྲོལ་བ་ཐེ་ཚོམ་མེད། །སེམས་ལ་རྣམ་རྟོག་བྱུང་ན་རྣལ་འབྱོར་པས། །རས་བལ་བཞིན་དུ་མ་བཅོས་གློད་ལ་ཞོག །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"རྗེ་མི་ལས།\", \"head\": \"ལྷོད་ཀྱི་གློད་པས་རང་ས་ཟིན། །རིག་པའི་ཆུ་བོ་དྭངས་སྙིགས་ཕྱེད། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ས་ར་ཧས།\", \"head\": \"མ་བཅོས་སོ་མར་བཞག་ན་རྟོགས་པ་འཆར། །ཆུ་བོའི་རྒྱུན་བཞིན་བསྐྱངས་ན་ཡོངས་ཀྱང་འཆར། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"དྭགས་པོས།\", \"head\": \"འཇུར་བུས་བཅིང་པའི་སེམས་ཉིད་འདི། །གློད་ན་གྲོལ་བ་ཐེ་ཚོམ་མེད། །འགྱུ་བ་དངོས་མེད་བསེར་བུ་འདྲ། །འཛིན་པ་མ་ཞུགས་འགྱུས་པས་ཆོག །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"རྗེ་རྒོད་ཚང་པས།\", \"head\": \"ཡང་གཅིག་རྣམ་རྟོག་སྐྱེས་པ་ན། །ངོ་ཡིས་ཙེར་གྱིས་བཟུང་མཛོད་ལ། །ཁོ་རང་ཐོག་ཏུ་ལྷོད་ལ་ཞོག །རང་སར་གྲོལ་བ་ཐེ་ཚོམ་མེད། །བར་དུ་རིག་པ་ཁྲོལ་དུ་ཆུག །འགྱུ་བ་དངོས་མེད་བསེར་བུ་འདྲ། །འཛིན་པ་མ་ཞུགས་འགྱུས་པས་ཆོག །དེ་ལ་རྣམ་རྟོག་སྒོམ་ཤར་ཟེར། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཉམས་སྒྲོན་ལས།\", \"head\": \"དེས་ན་དལ་དབབ་ཆུ་བོ་བཞིན། །རེས་གནས་རེས་རྟོག་ཐུན་ཕྱེད་གནས། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"དུས་འཁོར་རྩ་རྒྱུད་ལས།\", \"head\": \"ལུས་ངག་སེམས་ཀྱི་དབེན་པ་ཡིས། །མི་རྟོག་ཏིང་འཛིན་སྐྱེ་བར་འགྱུར། །མི་རྟོག་ཏིང་འཛིན་སྐྱེས་པ་ཡིས། །ཤེས་རབ་ཡེ་ཤེས་སྐྱེ་བར་འགྱུར། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"གསང་བ་སྒྲོན་མེ་ལས།\", \"head\": \"ཞི་གནས་བསྒོམས་པས་ལྷག་མཐོང་སྐྱེ། །ལྷག་མཐོང་ཡེ་ཤེས་སྐྱེ་བའི་རྒྱུ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"སྤྱོད་འཇུག་ལས།\", \"head\": \"ཞི་གནས་རབ་ལྡན་ལྷག་མཐོང་ནི། །ཉོན་མོངས་ཚོགས་རྣམས་ཞི་བར་བྱེད། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"གྲུབ་ཐོབ་ས་ར་ཧས།\", \"head\": \"བྲམ་ཟེས་སྐུད་པ་འཁལ་བ་ལྟ་བུ་\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"བིར་བ་པས།\", \"head\": \"དོན་དམ་རྣལ་མ་ཆགས་མེད་དོན་ལ་སྤྱད་པར་བྱ་འདོད་ན། །མི་སྤང་མི་ཞེན་མི་སྤྱོད་མི་བསྒྲུབ་མི་འགོག་པར། །རང་ལུགས་ཅི་བདེར་སྤྱོད་པ་དེ་ནི་རབ་མཆོག་དམ་པའོ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"རྗེ་སྒམ་པོ་པས།\", \"head\": \"བཅས་བཅོས་མ་བྱེད་ལྷུག་པར་ཞོག །ལྟ་ཉུལ་མ་བྱེད་རང་གར་ཞོག །ཡིད་ལ་མ་བྱེད་དམིགས་མེད་ཞོག །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"རྗེ་བཙུན་གྱིས།\", \"head\": \"ཉམས་ལ་ཡིད་ཆེས་བྱ་མི་རུང་། །དེ་ལ་ཡིད་ཆེས་སྐྱེས་པ་ན། །རྣམ་རྟོག་བགེགས་ཀྱི་དབང་དུ་འགྲོ། །དེ་དེ་ཡིན་ཏེ་དེ་དེ་མིན། །སྡོང་པོ་ཡིན་ཏེ་འབྲས་བུ་མིན། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"རྗེ་བཙུན་གྱིས།\", \"head\": \"ལས་ཉོན་མོངས་རྣམ་རྟོག་ཇེ་ཧྲག་ཀྱང་། །སེམས་མ་ཡེངས་དྲན་པས་དེ་ཚུག་ཟུངས། །གཤིས་ཞི་བར་གནས་པའི་ངང་ཉིད་ལས། །དུས་འགྱུར་ལྡོག་མེད་ཕྱིར་བརྟན་པར་གྱིས། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"པྲ་ཁྲིད་ལས།\", \"head\": \"མི་རྟོག་ཐིག་ལེའི་ངང་ལ་གནས་པ་ནི། །མི་བསྐྱོད་དྭངས་པ་རྒྱ་མཚོ་ཆེན་པོའི་ངང་། །མི་གཡོ་གསལ་བ་ཏིལ་གྱི་མར་མེ་བཞིན། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཀུན་མཁྱེན་རིན་པོ་ཆེས།\", \"head\": \"ཉམས་བན་བུན་ཟང་ཟིང་འར་འུར་པོ། །རྒྱུས་མེད་ཀྱིས་མཐོང་ན་སྐྱོན་དུ་མཐོང་། །ཉམས་མེད་ལ་དྲིས་ན་མགོ་བོ་འཁོར། །འདི་བདེ་སྟོང་རྒྱས་པའི་མྱུ་གུ་ཡིན། །འདི་ལ་བཅོས་པ་མ་བྱེད་པར། །བྱུང་རྒྱལ་དུ་སྐྱོངས་དང་དེ་ཀས་ཆོག །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"གླིང་རས་པས།\", \"head\": \"ཉམས་མྱོང་འཇའ་ཚོན་འདྲ་བའི་རི་མོ་ལ། །བློ་ཆུང་བྱིས་སྦ་འདྲ་བའི་སྒོམ་ཆེན་ཆགས། །བསླུ་བྲིད་གོལ་ས་ཡིན་ཏེ་ངོ་མ་ཤེས། །དེ་ལ་བདེན་ཞེན་རེ་དོགས་ཆགས་སྡང་བྱེད། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"རྗེ་པདྨ་དཀར་པོས།\", \"head\": \"ཉམས་སྣ་ཚོགས་འཆར་བའི་ལྟད་མོ་ལ། །ཁ་ཕྱིར་བལྟས་བྱས་ན་མང་དུ་འཕེལ། །དེས་གནས་ལུགས་རྟོགས་པའི་གོ་མི་ཆོད། །སེམས་མ་བཅོས་ཇི་བཞིན་ངང་དུ་ཞོག །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"སྣང་བ་བཅུ་དྲུག་ལས།\", \"head\": \"ཕྱི་ནང་རྟགས་ཀྱི་རིམ་པ་རྣམས། །སྐྱེས་ཀྱང་དགའ་བྲོད་མི་བྱ་ཞིང་། །མེད་ཀྱང་མི་དགའ་སྐྱེ་མི་བྱ། །ཐམས་ཅད་མཉམ་པ་ཉིད་དུ་བཅོམ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"རྗེ་འབྲུག་པས།\", \"head\": \"དཔལ་བསམ་གྱིས་མི་ཁྱབ་གཉུག་མའི་དོན། །རང་རིག་གིས་གཏན་ལ་མ་ཕེབས་ན། །གཞན་རྐྱེན་གྱིས་རྟོགས་པར་མི་ནུས་པས། །ངེས་དོན་གྱི་བླ་མ་ནང་ནས་ཚོལ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཏིལླི་པས།\", \"head\": \"དཔེར་ན་ནམ་མཁའི་དཀྱིལ་ལ་བརྟགས་བྱས་ན། །མཐའ་དང་དབུས་སུ་འཛིན་པ་འགག་པ་ལྟར། །དེ་བཞིན་སེམས་ཀྱིས་སེམས་ལ་བརྟགས་བྱས་ན། །རྣམ་རྟོག་ཚོགས་འགག་སེམས་ཀྱི་རང་བཞིན་མཐོང་། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"རྒྱལ་བའི་དབང་པོས།\", \"head\": \"བློས་བྱས་ཀྱི་ལྟ་བ་བཟང་ཡང་འཇིག །བློ་འདས་ལ་ལྟ་བའི་ངོ་བོ་མེད། །བལྟ་བྱ་དང་ལྟ་བྱེད་དབྱེར་མེད་པའི། །ངེས་པ་དེ་བླ་མའི་དྲིན་ལས་རྙེད། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"འོད་སྲུང་གིས་ཞུས་པའི་མདོ་ལས།\", \"head\": \"ཤིང་ཉིད་དྲུད་པ་ལས་ནི་མེ་འབྱུང་ཞིང་། །བྱུང་བ་དེ་ཡིས་དེ་ཉིད་བསྲེག་པར་བྱེད། །དེ་བཞིན་ཤེས་རབ་དབང་པོ་སྐྱེས་ནས་ནི། །སྐྱེས་པ་དེ་ཡིས་དེ་ཉིད་རྟོགས་པར་བྱེད། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"རྒྱུད་ལས།\", \"head\": \"གང་གིས་འཆིང་བར་བྱེད་པའི་རྒྱུ། །དེ་ནི་གྲོལ་བར་བྱེད་པའི་ལམ། །འདི་ན་འཆིང་བ་འགའ་ཡང་མེད། །འཆིང་བ་གང་ཡིན་དེ་གྲོལ་བ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"མཻ་ཏྲི་པས།\", \"head\": \"མ་སྐྱེས་པ་ལ་རྟོག་པ་གློ་བུར་བ། །རྟོག་པ་དེ་ཉིད་དབྱིངས་ཀྱི་ངོ་བོར་གནས། །དེ་ཉིད་གདོད་ནས་ཐ་དད་མེད་པའོ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"head\": \"རྟོགས་པ་སྣ་ཚོགས་སེམས་ཀྱི་ངོ་བོ་འདི། །ཐུག་འཕྲད་ཙམ་གྱིས་མ་གྲུབ་ཕྱག་རྒྱ་ཆེ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"རྗེ་མར་པས།\", \"head\": \"ཡིད་ཀྱི་གཡོ་བ་གཟུང་འཛིན་གཉིས། །སྤྲོས་བྲལ་ཆོས་ཀྱི་སྐུ་རུ་ཐིམ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"འཇིག་རྟེན་མགོན་པོས།\", \"head\": \"མ་རིག་འཁོར་བའི་འཁྲུལ་རྟོག་དང་། །རང་རིག་ཡེ་ཤེས་ཆེན་པོ་གཉིས། །གཞི་ལ་བྱེ་བྲག་ཐ་དད་མེད། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"གླིང་རས་པས།\", \"head\": \"རྣམ་རྟོག་ཆོས་སྐུར་རྟོགས་ལགས་པས། །སྐྱོན་ཡོན་གྱི་འཛིན་པ་སྟོར་ནས་ཐལ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"དྭགས་པོས།\", \"head\": \"སྤྲིན་ལས་ཁ་བ་བྱུང་གྱུར་ཀྱང་། །རྡོ་ཚན་སྟེང་དུ་བྱུང་མ་ཐག །དེ་དུས་ཉིད་དུ་ཆུར་འགྱུར་བཞིན། །གཡེང་བའི་རྟོག་པ་བྱུང་གྱུར་ན། །བྱུང་རྗེས་ཉིད་དུ་སེམས་སུ་ཤེས། །སེམས་ཉིད་ཆོས་སྐུ་སྤྲོས་བྲལ་དུ། །འབད་མི་དགོས་པ་ཤུགས་ཀྱིས་འབྱུང་། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"སེམས་ཀྱི་མཚན་ཉིད་གབ་པ་མངོན་ཕྱུང་ལས།\", \"head\": \"བདེན་པར་འཛིན་པའི་བུད་ཤིང་ཚིག་པས་ན། །འཁོར་བར་སྐྱེ་བའི་ས་བོན་རུལ་བ་ཡིན། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"སྤྱོད་འཇུག་ལས།\", \"head\": \"སྟོང་པ་ཉིད་དང་བྲལ་བའི་སེམས། །འགགས་པ་སླར་ཡང་སྐྱེ་འགྱུར་ཏེ། །འདུ་ཤེས་མེད་པའི་སྙོམས་འཇུག་བཞིན། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"རྗེ་བཙུན་གྱིས།\", \"head\": \"སེམས་རྫིང་ཆུ་བཞིན་དུ་འཁྱིལ་བ་དེ། །རྟོག་པའི་འཕྲོ་འདུ་བཀག་པ་ཙམ། །འཁོར་བའི་རྒྱ་མཚོ་དེས་མི་སྒྲོལ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"དྭགས་པོས།\", \"head\": \"རྟོགས་པ་མེད་པའི་ལྟ་བ་དེ། །མཐའ་བྲལ་ཟེར་ཡང་བློས་བྱས་ཡིན། །གདོས་ཐག་མ་ཆོད་སྒོམ་ཆེན་དེ། །ཏིང་འཛིན་བཟང་ཡང་འཁོར་བའི་རྒྱུ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"head\": \"མི་རྟོག་ལྟེངས་པོ་སྒོམ་གྱི་བདུད། །ངེས་ཤེས་གཏིང་ནས་མ་སྐྱེས་པར། །ཉམས་མྱོང་བཟང་ཞེས་མི་བརྗོད་དོ། །གཉིས་འཛིན་ཅན་གྱི་སྒོམ་ཆེན་དེ། །ཉམས་སུ་མྱོང་ཡང་དོན་མ་ཡིན། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"རྗེ་འབྲི་གུང་པས།\", \"head\": \"ཉམས་མྱོང་བཟང་པོ་མ་བཅོས་པ། །ལྷ་གནས་གོང་མར་སྐྱེ་བའི་རྒྱུ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"སྒྲུབ་བརྒྱུད་པས་གསུངས་ལས།\", \"head\": \"ཞི་མ་གནས་ན་ལྷག་མཐོང་མེད། །ལྷག་མཐོང་སྔ་ན་ཞི་གནས་མེད། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"དགོངས་པ་ངེས་འགྲེལ་ལས།\", \"head\": \"བསམ་གཏན་གྱིས་ནི་ཉོན་མོངས་པ་རྣམ་པར་གནོན་ཏེ། ཤེས་རབ་ཀྱིས་ནི་བག་ཉལ་རྣམས་ལེགས་པར་འཇོམས་པར་བྱེད་དོ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཇི་སྐད་དུ།\", \"head\": \"ཞི་གནས་མེད་པའི་ལྷག་མཐོང་དེ། །རླུང་གསེབ་དཀྱིལ་གྱི་མར་མེ་བཞིན། །བརྟན་ཆ་ནམ་ཡང་འབྱུང་མི་སྲིད། །ལྷག་མཐོང་མེད་པའི་ཞི་གནས་དེ། །རྫིང་ཆུ་རྙོག་མ་འཁྱིལ་བ་འདྲ། །དྭངས་པའི་དུས་སྐབས་འབྱུང་མི་སྲིད། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"དཀོན་མཆོག་སྤྲིན་མདོ་ལས།\", \"head\": \"ཞི་གནས་ནི་སེམས་རྩེ་གཅིག་པའོ། །ལྷག་མཐོང་ནི་ཡང་དག་པ་ཇི་བཞིན་དུ་ཆོས་ཉིད་སོ་སོར་རྟོགས་པའོ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ལྗོན་པས་ཞུས་མདོ་ལས།\", \"head\": \"ཞི་གནས་ནི་རྩེ་གཅིག་པའོ། །ལྷག་མཐོང་ནི་རིག་ཆའོ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཏིལླི་པས།\", \"head\": \"དཔེར་ན་ནམ་མཁའ་མཐོང་བ་ཐ་སྙད་རབ་བཏགས་ཀྱང་། །ནམ་མཁའ་ལ་ནི་འདི་འདྲ་བརྗོད་དུ་མེད། །དེ་བཞིན་རང་སེམས་འོད་གསལ་བརྗོད་གྱུར་ཀྱང་། །འདི་ལྟར་འགྲུབ་ཅེས་ཐ་སྙད་གདག་གཞི་མེད། །སེམས་ཀྱི་རང་བཞིན་གདོད་ནས་ནམ་མཁའ་འདྲ། །ཆོས་རྣམས་མ་ལུས་དེ་རུ་མ་འདུས་མེད། །\", \"tail\": \"\"}]}",
