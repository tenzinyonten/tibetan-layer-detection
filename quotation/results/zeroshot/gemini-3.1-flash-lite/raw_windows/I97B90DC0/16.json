   \"frame\": \"རྒྱུད་ལས།\",\n      \"head\": \"གསེར་རམ་དངུལ་ལས་བྱས་པ་ཡི། །ཟངས་སམ་ས་ལས་བྱས་ཀྱང་རུང༌། །\",\n      \"tail\": \"\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"རྒྱུད་ལས།\",\n      \"head\": \"རྩ་བ་ནག་པོ་ར་རི་མེད། །མཆུ་འཕྱང་མགྲིན་རིང་ལྟོ་བ་ཆེ། །\",\n      \"tail\": \"\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"རྒྱུད་ལ་ལར།\",\n      \"head\": \"བུམ་པ་ཞབས་མེད་ལྟོ་བ་ཟླུམ། །\",\n      \"tail\": \"\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"ལཱུ་ཡི་པའི་རྒྱ་གཞུང་ལས།\",\n      \"head\": \"དཀྱིལ་འཁོར་པ་ནི་ཐམས་ཅད་ཀྱི། །\",\n      \"tail\": \"མཁས་པས་བུམ་པའི་ལོགས་ལ་དགོད། །\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"ལཱུ་ཡི་པས།\",\n      \"head\": \"རས་ནི་དཀར་པོ་མ་ཉམས་པས། །བུམ་པའི་མགུལ་བ་དཀྲི་བར་བྱ། །\",\n      \"tail\": \"\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"ལཱུ་ཡི་པས།\",\n      \"head\": \"ཆོ་ག་མཁས་པས་སྲད་བུ་ནི། །དཀར་པོས་རས་ཀྱི་སྟེང་ནས་འཆིང༌། །\",\n      \"tail\": \"\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"head\": \"ཨ་མྲ་ཨུ་དུམ་ཝཱ་ར་དང༌། །\",\n      \"tail\": \"བུམ་པ་རྣམས་ཀྱི་ཁ་རྒྱན་བྱ། །\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"རྒྱུད་ལས།\",\n      \"head\": \"བུམ་པ་ཆུས་ནི་སུམ་གཉིས་བཀང༌། །\",\n      \"tail\": \"སུམ་ཆས་ཆོས་སྐུ་སྐྱེ་མེད་མཚོན། །\"\n    },\n    {\n      \"label\": \"QUOTE\",\n      \"frame\": \"རྒྱུད་ལས།\",\n      \"head\": \"གུ་གུལ་དང་ནི་ཨ་ག་རུས། །བདུག་ཅིང་དྲི་ལྔའི་ཆུ་ཡིས་དགང༌། །\",\n      \"tail\": \"\"\n    }\n  ]\n}",
