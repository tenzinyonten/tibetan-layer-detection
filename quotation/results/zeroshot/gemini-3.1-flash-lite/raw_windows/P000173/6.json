  "raw_text": "{\"spans\": [{\"label\": \"QUOTE\", \"frame\": \"རྣལ་འབྱོར་གྱི་དབང་ཕྱུག་གླིང་གིས༑\", \"head\": \"གཞི་རྩ་བྲལ་བའི་སེམས་ཉིད་ལ། །མདང་རྨི་ལམ་ཉམས་སུ་མྱོང་བ་དེ།\", \"tail\": \"སློབ་དཔོན་གཅིག་ལགས་ཏེ་གོ་ལགས་སམ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"གྲུབ་ཐོབ་ཨོ་རྒྱན་པས།\", \"head\": \"སེམས་དང་སྣང་བ་གཉིས་པོ་མེ་དང་ཚ་བ་བཞིན་དུ་གནས་པ་ཡིན་མོད།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"དོ་ཧ་ལས།\", \"head\": \"ཁམས་གསུམ་མ་ལུས་འདི་དག་ཐམས་ཅད་ནི། །འདོད་ཆགས་ཆེན་པོ་གཅིག་ཏུ་ཁ་དོག་སྒྱུར་ཅིག་དང་། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"རི་ཁྲོད་ཞབས་ཀྱིས།\", \"head\": \"གངྒཱ་ལ་སོགས་ཆུ་ཀླུང་སྣ་ཚོགས་པ། །བ་ཚྭ་ཅན་གྱི་རྒྱ་མཚོར་རོ་གཅིག་ལྟར།\", \"tail\": \"ཆོས་ཀྱི་དབྱིངས་སུ་རོ་གཅིག་ཤེས་པར་གྱིས། །\"}, {\"label\": \"QUOTE\", \"frame\": \"བྲམ་ཟེ་ཆེན་པོས།\", \"head\": \"རྟོག་པར་གྱུར་ན་ཐམས་ཅད་དེ་ཡིན་ཏེ། །དེ་ལས་གཞན་ཞིག་སུས་ཀྱང་རྙེད་མི་འགྱུར། །\", \"tail\": \"བསྟན་བཅོས་སྙིང་ལ་འཆང་བའང་དེ་ཡིན་ནོ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ས་ར་ཧས།\", \"head\": \"ཇི་སྲིད་སེམས་ལས་རྣམས་འཕྲོས་པ། །དེ་སྲིད་མགོན་པོའི་རང་བཞིན་ཏེ༑ །\", \"tail\": \"ཆུ་དང་རླབས་དག་གཞན་ཡིན་ནམ། །\"}, {\"label\": \"QUOTE\", \"head\": \"རྦ་རླབས་ཇི་ལྟར་ཆེ་ཡང་རྒྱ་མཚོའི་ངང་། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཀུན་སྤྱོད་ལས།\", \"head\": \"གང་དུ་བདེ་ཆེན་ཞེས་བྱ་གཅིག་པུ་ཉིད། །གཅིག་པུའི་ཉམས་ཀྱིས་དུ་མའི་གར་མཛད་དོ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"བསྲེ་སྐོར་གྱི་གཞུང་ལས།\", \"head\": \"ཀྱེ་ཧོ། འདི་ནི་རང་རིག་ཡེ་ཤེས་ཏེ། །ངག་གི་ལམ་འདས་ཡིད་ཀྱི་སྤྱོད་ཡུལ་མིན༑ །\", \"tail\": \"རང་གིས་རང་ཉིད་འཚོལ་ཏེ་ཤེས་པར་བྱོས། །\"}, {\"label\": \"QUOTE\", \"head\": \"མི་མནོ་མི་བསམ་མི་དཔྱད་ཅིང་། །མི་བསྒོམ་མི་སེམས་རང་བབས་བཞག །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཀུན་མཁྱེན་པདྨ་དཀར་པོས།\", \"head\": \"གཞི་དང་ཉམས་ལེན་ཉམས་མྱོང་དང་། །དྲོད་རྟགས་འབྱེད་དང་འབྲས་བུ་ནི། །\", \"tail\": \"ལམ་ནི་ངེས་པའི་མདོར་བསྡུས་སོ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཡང་དགོན་པས།\", \"head\": \"ཕྱག་རྒྱ་ཆེན་པོ་ནི། བྲམ་ཟེ་ཆེན་པོ་ས་ར་ཧའི་བཞེད་ཀྱིས། རྐྱེན་གསུམ་དང་བྲལ་བ། དགའ་བ་བཞི་ལས་འདས་པ།\", \"tail\": \"འོད་གསལ་ལས་ཁྱད་པར་དུ་གྱུར་པ་ཡིན་ནོ། །\"}, {\"label\": \"QUOTE\", \"head\": \"མདོར་ན་ཐ་མལ་གྱི་ཤེས་པ་སུས་ཀྱང་བཟོ་མ་བྱས་པའི་ཨང་སོ་རེ་བ་འདི། ཁོ་རང་གི་ཁོ་རང་ངོ་ཤེས་པ་དེ་ལ་ཕྱག་རྒྱ་ཆེན་པོའི་དགེ་སྦྱོར་སྐྱེས་པ་ཟེར་བ་ཡིན་ནོ།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཤ་ཝ་རིས།\", \"head\": \"ཐ་མལ་ཤེས་པ་རང་ལུགས་གཉུག་མ་ལ། །བཅོས་མའི་དམིགས་པ་དག་གིས་མི་སླད་དེ༑ །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"head\": \"མ་བཟུང་མ་བཏང་རང་ག་ཉིད་དུ་ཞོག །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"རྗེ་མི་ལས།\", \"head\": \"ཐ་མལ་ཤེས་པ་སྐྱོང་སྐྱོང་ནས༑ །མ་རིག་འཁྲུལ་པ་བརྗེད་དེ་ཐལ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"རྗེ་དྭགས་པོས།\", \"head\": \"ཐ་མལ་ཤེས་པས་ཆོག་པའི་ཉམས་ལེན་འདི༑ །སངས་རྒྱས་མི་གཟུགས་ཅན་གྱི་དྲིན་ལས་རྙེད། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"རྗེ་ཡང་དགོན་པས།\", \"head\": \"ཉམས་དང་ཏིང་ངེ་འཛིན་གྱི་བྱེ་བྲག་ཕྱེད་ཅིང་སྒོམ་དུ་ངོ་སྤྲོད་པའི་བླ་མ་ནི་མང་ལ།\", \"tail\": \"ཐ་མལ་གྱི་ཤེས་པ་སྒོམ་དུ་ངོ་སྤྲོད་པའི་བླ་མ་ནི་ཉིན་མོའི་སྐར་མ་བས་ཀྱང་དཀོན་པ་ཡིན་ནོ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཕ་དམ་པས།\", \"head\": \"སྣང་བ་དགྲར་ལངས་ཁང་སྟོང་རྐུན་མ་འདྲ། །དོན་ལ་ཐོབ་ཤོར་མེད་དོ་དིང་རི་བ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཤ་ཝ་རིས།\", \"head\": \"རང་གི་སེམས་ཉིད་རྟོགས་ན་ཕྱག་རྒྱ་ཆེན་པོ་སྟེ། །ཇི་ལྟར་སྣང་བ་འདི་ཡང་རང་གི་སེམས་ལས་ལོགས་ན་མེད། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"མདོ་སྡེ་རྒྱན་ལས།\", \"head\": \"སེམས་ལས་གཞན་མེད་པར་ནི་བློས་རིག་ནས། །དེ་ནས་སེམས་ཀྱང་མེད་པ་ཉིད་དུ་རྟོགས། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཕ་དམ་པས།\", \"head\": \"རྣམ་རྟོག་ངན་པ་སྤང་ལ་ཆུ་རྡོལ་འདྲ། །བཀག་བས་ཁེགས་པ་མེད་དོ་དིང་རི་བ༑ །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ས་ར་ཧས།\", \"head\": \"རྣམ་རྟོག་ཡེ་ཤེས་ཆེན་པོ་སྟེ། །འཁོར་བའི་རྒྱ་མཚོ་སྐེམ་བྱེད་ཡིན༑ །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ས་ར་ཧས།\", \"head\": \"སྙིང་རྗེ་དང་བྲལ་སྟོང་པ་ཉིད་ཞུགས་གང་། །དེས་ནི་ལམ་མཆོག་རྙེད་པར་མི་འགྱུར་རོ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ནཱ་རོ་པས།