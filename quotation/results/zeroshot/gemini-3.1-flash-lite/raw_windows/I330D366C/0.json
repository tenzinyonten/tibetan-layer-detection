  "raw_text": "{\"spans\": [{\"label\": \"QUOTE\", \"frame\": \"ཕག་མོ་གྲུ་པ་ཁམས་པའི་ཞལ་ནས།\", \"head\": \"དྲན་པ་གསུམ་གལ་ཆེ་སྟེ། དལ་འབྱོར་གྱི་ལུས་ཆུད་མི་གསན་པ་དྲན་པ་དང་། བླ་མ་དཀོན་མཆོག་མཆོད་པར་དྲན་པ་དང་།\", \"tail\": \"སྟོང་པ་ཉིད་བསྒོམ་པ་རྗེས་སུ་དྲན་པའོ། །\"}, {\"label\": \"QUOTE\", \"head\": \"དམྱལ་བ་ཡི་དྭགས་དུད་འགྲོ་དང་། །\", \"tail\": \"ལྐུགས་པ་འདི་དག་མི་ཁོམ་བརྒྱད། །\"}, {\"label\": \"QUOTE\", \"frame\": \"སྡུད་པ་ལས།\", \"head\": \"མི་ཁོམ་བརྒྱད་སྤངས་དེ་ཡིས་དལ་བ་རྟག་ཏུ་རྙེད། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"དེ་ལྟར་ཡང་།\", \"head\": \"མི་ཉིད་དབུས་སྐྱེས་དབང་པོ་ཚང་། །\", \"tail\": \"ལས་མཐའ་མ་ལོག་གནས་ལ་དད། །\"}, {\"label\": \"QUOTE\", \"frame\": \"སྤྱོད་འཇུག་ལས།\", \"head\": \"དེ་ཉིད་ཕྱིར་ན་བཅོམ་ལྡན་གྱིས། །\", \"tail\": \"མི་ཉིད་ཤིན་ཏུ་ཐོབ་དཀའ་གསུངས། །\"}, {\"label\": \"QUOTE\", \"frame\": \"སློབ་དཔོན་ཞི་བ་ལྷའི་ཞལ་ནས།\", \"head\": \"དལ་འབྱོར་འདི་ནི་ཤིན་ཏུ་ཐོབ་པར་དཀའ། །\", \"tail\": \"ཕྱིས་འདི་ཡང་དག་འབྱོར་བ་ག་ལ་འགྱུར། །\"}, {\"label\": \"QUOTE\", \"frame\": \"སྤྱོད་འཇུག་ལས།\", \"head\": \"ཡིད་བརྟན་མི་རུང་འཆི་བདག་འདི། །\", \"tail\": \"གློ་བུར་ཚེ་ལ་ཡིད་མི་བརྟན། །\"}, {\"label\": \"QUOTE\", \"frame\": \"སྤྱོད་འཇུག་ལས།\", \"head\": \"མི་ཡི་གྲུ་ལ་བློབརྟེན་ནས་ནི། །\", \"tail\": \"རྨོངས་པ་དུས་སུ་གཉིད་མ་ལོག །\"}, {\"label\": \"QUOTE\", \"frame\": \"སྡོམ་པ་འབྱུང་བ་ལས།\", \"head\": \"བླ་མ་སངས་རྒྱས་བླ་མ་ཆོས། །\", \"tail\": \"ཀུན་གྱི་བྱེད་པོ་བླ་མ་ཡིན། །\"}, {\"label\": \"QUOTE\", \"head\": \"མཆོད་པ་ཀུན་གྱི་ཐོག་མར་ནི། །\", \"tail\": \"བླ་མའི་མཆོད་པ་བརྩམ་པར་བྱ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"གདན་བཞི་ལས།\", \"head\": \"དམངས་རིགས་སྟོང་ཕྲག་གཉིས་དག་ནི། །\", \"tail\": \"སློབ་དཔོན་གཅིག་དང་མཉམ་པར་མཆོད། །\"}, {\"label\": \"QUOTE\", \"frame\": \"སྨན་བླའི་མདོ་ལས།\", \"head\": \"གང་དག་བསླབ་པའི་གཞི་ལྔ་པོ་དག་འཛིན་པ་དང་།\", \"tail\": \"ངན་སོང་གསུམ་གྱི་སྡུག་བསྔལ་མེད་པར་ཤེས་པར་བྱའོ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཏིང་ངེ་འཛིན་རྒྱལ་པོ་ལས།\", \"head\": \"གང་ཕྱིར་སངས་རྒྱས་བཞུགས་པ་འམ། །\", \"tail\": \"སེམས་མཉམ་པ་བཞིན་འབྲས་བུ་མཉམ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"སྙིང་རྗེ་པདྨ་དཀར་པོ་ལས།\", \"head\": \"གང་དག་ཁ་ཅིག་སྐུ་གཟུགས་ལ་དམིགས་ནས་མེ་ཏོག་གཅིག་ཙམ་དོར་ན།\", \"tail\": \"མར་མེ་ཕུལ་ན་བསོད་ནམས་གྲངས་མེད་པར་བསྐྱེད་པ་ལྟ་ཅི་སྨོས་\"}, {\"label\": \"QUOTE\", \"frame\": \"མངོན་རྟོགས་རྒྱན་ལས།\", \"head\": \"གཞན་གྱིས་མྱོང་བ་མ་ཡིན་ཏེ། །\", \"tail\": \"བློ་དང་ལྡན་པས་མཐོང་འགྱུར་ཕྱིར། །\"}, {\"label\": \"QUOTE\", \"frame\": \"དབུས་མཐའ་ལས།\", \"head\": \"ཡི་གེ་འབྲི་མཆོད་སྦྱིན་པ་དང་། །\", \"tail\": \"བསོད་ནམས་ཕུང་པོ་དཔག་ཏུ་མེད། །\"}, {\"label\": \"QUOTE\", \"frame\": \"བསིལ་བ་ཚལ་ཆེན་པོའི་མདོ་ལས།\", \"head\": \"གང་ལ་ཕུལ་བ་དོན་ཆེ་བ། །\", \"tail\": \"དགེ་འདུན་ལ་ཡང་ཕྱག་འཚལ་ལོ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"མཛོད་ལས།\", \"head\": \"སྐྱེས་མཐའི་བྱང་ཆུབ་སེམས་དཔའ་ལ། །\", \"tail\": \"ཡོན་ནི་གཞལ་དུ་མེད་པའོ། །\"}, {\"label\": \"QUOTE\", \"head\": \"རྣལ་འབྱོར་སྤྱོད་པས་སྟོང་པ་ཉིད། །\", \"tail\": \"བདུད་རྩི་ཉིད་ཀྱང་དུག་ཏུ་འགྱུར། །\"}, {\"label\": \"QUOTE\", \"frame\": \"རྩ་བ་ཤེས་རབ་ལས།\", \"head\": \"སྟོང་པ་ཉིད་ལ་ལྟ་ཉེས་ན། །\", \"tail\": \"རིག་སྔགས་ལོག་པར་སྒྲུབ་པ་བཞིན། །\"}, {\"label\": \"QUOTE\", \"head\": \"འདི་ལ་ལོག་པར་གཟུང་གྱུར་ན། །\", \"tail\": \"མནར་མེད་པར་ནི་སྤྱི་ཚུགས་འགྲོ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"བྱམས་པས།\", \"head\": \"སངས་རྒྱས་རྣམས་ལ་བསྙེན་བཀུར་བྱས། །\", \"tail\": \"འདི་མཉན་པ་ཡི་སྣོད་ཡིན་ནོ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"དཔལ་ལྡན་ཟླ་བ་གྲགས་པས།\", \"head\": \"སོ་སོ་སྐྱེ་བོའི་དུས་ནའང་སྟོང་པ་ཉིད་ཐོས་ནས། །\", \"tail\": \"དེ་ལ་དེ་ཡི་རྗེས་སུ་འགྲོ་བའི་ཡོན་ཏན་འབྱུང་། །\"}, {\"label\": \"QUOTE\", \"frame\": \"སྤྱོད་འཇུག་ལས།\", \"head\": \"ཡན་ལག་འདི་དག་ཐམས་ཅད་ནི། །\", \"tail\": \"ཞི་བར་འདོད་པས་ཤེས་རབ་བསྐྱེད། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཚད་མ་རྣམ་འགྲེལ་ལས།\", \"head\": \"སྟོང་ཉིད་རྟོགས་པས་གྲོལ་འགྱུར་གྱི། །\", \"tail\": \"བསྒོམ་པ་ལྷག་མ་དེ་དོན་ཡིན། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཧེ་བཛྲ་ལས།\", \"head\": \"ལྷན་ཅིག་སྐྱེས་པ་བདེ་བའི་རོ། །\", \"tail\": \"བདག་གིས་བསོད་ནམས་ལས་ཤེས་བྱ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"དབུ་མ་རྩ་བ་ཤེས་རབ་ལས།\", \"head\": \"ཡོད་ཅེས་བྱ་བ་རྟག་པར་ལྟ། །\", \"tail\": \"མཁས་པས་གནས་པར་མི་བྱའོ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"གསང་འདུས་ལས།\", \"head\": \"དངོས་པོ་ཐམས་ཅད་དང་བྲལ་ཞིང་། །\", \"tail\": \"སྟོང་པ་ཉིད་ཀྱི་མཚན་ཉིད་དོ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཚད་མ་རྣམ་འགྲེལ་ལས།\", \"head\": \"བྱམས་སོགས་རྨོངས་དང་འགལ་མེད་ཕྱིར། །\", \"tail\": \"ཉེས་པ་ཤིན་ཏུ་ཚར་གཅོད་མིན། །\"}, {\"label\": \"QUOTE\", \"head\": \"གཞན་ཡང་སེམས་གསུམ་རྒྱལ་བའི་འབྱུང་གནས་འདི། །\", \"tail\": \"སྨན་མ་ཞུ་ཡང་དུག་ཏུ་འགྱུར། །\"}, {\"label\": \"QUOTE\", \"head\": \"བརྒྱ་བྱིན་མཆོད་འོས་དག་ཏུ་གྱུར་ནས་ཀྱང་། །\", \"tail\": \"མནར་མེད་པར་ནི་ཡང་དག་འཇུག་འཚལ་ལོ། །\"}, {\"label\": \"QUOTE\", \"head\": \"ངང་པ་མཚོ་ལ་འཇུག་པ་བཞིན། །\", \"tail\": \"མནར་མེད་པར་ཡང་འཇུག་པར་བྱེད། །\"}, {\"label\": \"QUOTE\", \"frame\": \"སྡུད་པ་ལས།\", \"head\": \"གཏོང་བར་གནས་དང་སེམས་ཅན་ཡོངས་སུ་མི་གཏོང་དང་། །\", \"tail\": \"ཇི་སྐད་སྨྲས་བཞིན་བྱེད་དང་བདེ་གཤེགས་བྱིན་རླབས་ཅན། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཨཱརྱ་དེ་ཝས།\", \"head\": \"བསོད་ནམས་ཆུང་བའི་སྐྱེ་བོ་ཡང་། །\", \"tail\": \"སྲིད་པ་ཧྲུལ་པོར་བཏང་བ་ཡིན། །\"}, {\"label\": \"QUOTE\", \"frame\": \"རྣམ་བཤད་རིག་པ་ལས།\", \"head\": \"མ་དད་པ་དང་ང་རྒྱལ་དང་། །\", \"tail\": \"སྐྱོ་བས་ཉན་པའི་དྲི་མ་ཡིན། །\"}, {\"label\": \"QUOTE\", \"frame\": \"སྤྱོད་འཇུག་ལས།\", \"head\": \"ཤེས་བཞིན་མེད་པའི་སྐྱོན་ཆགས་པས། །\", \"tail\": \"དྲན་པ་ལ་ནི་དེ་མི་གནས། །\"}, {\"label\": \"QUOTE\", \"frame\": \"མདོ་ལས།\", \"head\": \"དགེ་སློང་དག་གམ་མཁས་རྣམས་ཀྱིས། །\", \"tail\": \"བླང་བར་བྱ་ཡིས་གུས་ཕྱིར་མིན། །\"}, {\"label\": \"QUOTE\", \"head\": \"བསྔོ་བ་མི་ཟད་ལམ་པ་སྟེ། །\", \"tail\": \"འཕེལ་དང་འགྱུར་བར་བྱེད་ཕྱིར་རོ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"སྐྱེས་རབས་ལས།\", \"head\": \"ཐོས་པ་མ་རིག་མུན་སེལ་སྒྲོན་མེ་ཡིན། །\", \"tail\": \"གྲགས་དང་དཔལ་གྱི་གཏེར་གྱུར་མཆོག་ཀྱང་ཡིན། །\"}, {\"label\": \"QUOTE\", \"frame\": \"བྱང་ཆུབ་སེམས་དཔའི་སྡེ་སྣོད་ལས།\", \"head\": \"ཐོས་པས་ཆོས་རྣམས་ཤེས་པར་བྱེད། །\", \"tail\": \"ཐོས་པས་མྱ་ངན་འདས་པ་ཐོབ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"སའི་སྡེ་ལས།\", \"head\": \"དོན་མེད་དོན་ལོག་དོན་དང་ལྡན། །\", \"tail\": \"བསྟན་བཅོས་སུམ་ཚན་གསུམ་དུ་འབྱུང་། །\"}, {\"label\": \"QUOTE\", \"frame\": \"སྤྱོད་འཇུག་ལས།\", \"head\": \"སྨན་དཔྱད་བཀླགས་པ་ཙམ་གྱིས་ནི། །\", \"tail\": \"ནད་པ་ལ་ཡང་ཕན་མི་འགྱུར། །\"}, {\"label\": \"QUOTE\", \"frame\": \"འཁོར་བ་ཐོག་མ་མེད་པའི་མདོ་ལས།\", \"head\": \"མ་ཡི་ཐུག་མཐའ་རྒྱ་ཤུག་ཚིག་གུ་ཙམ། །\", \"tail\": \"རི་ལུར་བགྲངས་ཀྱང་ས་ཡིས་ལང་མི་འགྱུར། །\"}, {\"label\": \"QUOTE\", \"frame\": \"མངོན་པ་མཛོད་ལས།\", \"head\": \"ཚུལ་གནས་ཐོས་དང་བསམ་ལྡན་པས། །\", \"tail\": \"སྒོམ་པ་ལ་ནི་རབ་ཏུ་སྦྱོར། །\"}, {\"label\": \"QUOTE\", \"frame\": \"སྡོང་པོ་བཀོད་པ་ལས་ཀྱང་།\", \"head\": \"དཔེར་ན་མཚོ་ཆེན་མཉན་པ་ཞིག །\", \"tail\": \"མ་བསྒོམས་ཆོས་ཀྱང་དེ་བཞིན་ནོ། །\"}]}",
