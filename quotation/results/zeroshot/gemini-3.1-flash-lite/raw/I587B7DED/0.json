  "raw_text": "{\"spans\":[{\"label\":\"QUOTE\",\"frame\":\"བུ་མོས་སྨྲས་པ།\",\"head\":\"འདི་ན་སྐྱེས་པ་མེད་ཅིང་\",\"tail\":\"རྣམ་པར་འཁྲུལ་པར་གྱུར། །\"},{\"label\":\"QUOTE\",\"frame\":\"གསང་བ་ཐིག་ལེ་ལས།\",\"head\":\"གྲུ་འཛིན་རི་ཡི་རྩེ་མོ་རུ། །\",\"tail\":\"ཤཱཀྱ་སེངྒེས་གསུངས་པའི་རྒྱུད། །\"},{\"label\":\"QUOTE\",\"head\":\"མ་སྐྱེ་བ་མེད་པའི་ཆོས་\",\"tail\":\"བདག་འཇིགས་པ་ཀུན་ལས་སྐྱབ་ཏུ་གསོལ། །\"},{\"label\":\"QUOTE\",\"frame\":\"སློབ་དཔོན་སེངྒེ་བཟང་པོས།\",\"head\":\"ཡུམ་ནི་གཉིས་ཏེ། བཞེད་\",\"tail\":\"ཟག་མེད་ཀྱི་ཕུང་པོ་སྐྱེད་བྱེད་དོ། །\"},{\"label\":\"QUOTE\",\"frame\":\"དབུ་མ་རྩ་ཤེར་ལས།\",\"head\":\"བདག་ལས་མ་ཡིན་གཞན་ལས་མིན། །\",\"tail\":\"སྐྱེ་བ་ནམ་ཡང་ཡོད་མ་ཡིན། །\"},{\"label\":\"QUOTE\",\"frame\":\"མདོ་སྡེ་རྒྱན་ལས་ཀྱང༌།\",\"head\":\"ཡོན་མིན་མེད་མིན་དེ་བཞིན་མིན་གཞན་མིན། །\",\"tail\":\"རྣམ་པར་དག་འགྱུར་འདི་ནི་དེ་ཉིད་མཚན། །\"},{\"label\":\"QUOTE\",\"frame\":\"དུས་ཀྱི་འཁོར་ལོར།\",\"head\":\"དགྲ་དང་སེངྒེ་གླང་ཆེན་\",\"tail\":\"དོན་རྣམས་ཉམས། །\"},{\"label\":\"QUOTE\",\"head\":\"རང་ཆོས་སྐུ་ཡིན་པར་མ་ཤེས་\",\"tail\":\"ཡུམ་ལྷ་མོ་ཁྱོད་ཀྱིས་སྐྱབ་ཏུ་གསོལ། །\"},{\"label\":\"QUOTE\",\"frame\":\"རྡོ་རྗེ་གུར་ལས།\",\"head\":\"རིན་ཆེན་སེམས་ལས་ཕྱིར་གྱུར་\",\"tail\":\"སངས་རྒྱས་མེད་ཅིང་སེམས་ཅན་མེད། །\"},{\"label\":\"QUOTE\",\"frame\":\"རྒྱུད་བླ་མ་ལས།\",\"head\":\"ལུས་ཅན་ལ་ཡོད་ཟག་པ་མེད་པའི་ཤེས་\",\"tail\":\"སྦྲང་མའི་རྩི་དང་འདྲ། །\"},{\"label\":\"QUOTE\",\"frame\":\"ཆོས་དབྱིངས་བསྟོད་པར།\",\"head\":\"ཉོན་མོངས་ནང་ན་ཡེ་ཤེས་ཀྱང༌། །\",\"tail\":\"དེ་བཞིན་དྲི་མ་མེད་པར་གནས། །\"},{\"label\":\"QUOTE\",\"frame\":\"ཟླ་བ་གྲགས་པས་ཀྱང༌།\",\"head\":\"ཆོས་རྣམས་རང་བཞིན་ཁོ་ན་ལ། །\",\"tail\":\"གནས་པའི་བློ་ལ་སངས་རྒྱས་བརྗོད། །\"},{\"label\":\"QUOTE\",\"frame\":\"སམ་བྷུ་ཊ་ལས།\",\"head\":\"རང་གི་ལུས་ལ་སངས་རྒྱས་བཞུགས། །\",\"tail\":\"ལུས་ལས་གཞན་དུ་སངས་རྒྱས་འདོད། །\"},{\"label\":\"QUOTE\",\"frame\":\"ས་ར་ཧས།\",\"head\":\"མཁས་པ་ཐམས་ཅད་བསྟན་འཆོས་འཆད་པ་ན། །\",\"tail\":\"ལུས་ལ་སངས་རྒྱས་ཡོད་པ་མ་རྟོགས་སོ། །\"},{\"label\":\"QUOTE\",\"frame\":\"རྡོ་རྗེ་རྩེ་མོ་ལས།\",\"head\":\"ས་བོན་ཀུན་ལྡང་ཀུན་གཞི་ནི། །\",\"tail\":\"ཕྱི་དང་ནང་གི་བདག་ཉིད་འདོད། །\"},{\"label\":\"QUOTE\",\"frame\":\"སེམས་འགྲེལ་ལས།\",\"head\":\"ཀུན་རྫོབ་ཉོན་མོངས་ལས་ལས་བྱུང༌། །\",\"tail\":\"སེམས་ནི་བག་ཆགས་དག་གིས་བསགས། །\"},{\"label\":\"QUOTE\",\"frame\":\"འཕགས་པ་ཀླུས།\",\"head\":\"གསུམ་པོ་དག་ལས་གཉིས་བྱུང་ཞིང༌། །\",\"tail\":\"གསུམ་བྱུང་སྲིད་པའི་འཁོར་ལོ་སྟེ། །\"},{\"label\":\"QUOTE\",\"head\":\"ཆོས་སྙིང་ནས་རྒྱུད་ལ་མ་སྐྱེས་\",\"tail\":\"ཡུམ་ཡང་དག་གི་ལྷ་མོས་སྐྱབ་ཏུ་གསོལ། །\"},{\"label\":\"QUOTE\",\"frame\":\"སློབ་དཔོན་དཔའ་བོས།\",\"head\":\"ཁྱོད་ཀྱི་ཆོས་ལ་མི་ཕྱོགས་པའི། །\",\"tail\":\"སྡུག་བསྔལ་རབ་འབྱུང་སྲིད་པ་སྒྲུབ། །\"},{\"label\":\"QUOTE\",\"frame\":\"ཚངས་པ་ཁྱད་པར་སེམས་ཀྱིས་ཞུས་པ་ལས།\",\"head\":\"བརྫུན་པའམ་ནི་བདེན་པ་ཞིག །\",\"tail\":\"མུ་སྟེགས་བྱེད་དང་ཁྱད་པར་མེད། །\"},{\"label\":\"QUOTE\",\"frame\":\"ཡེ་ཤེས་སྙིང་པོ་ཀུན་ལས་བཏུས་པ་ལས།\",\"head\":\"སངས་རྒྱས་ཆོས་ནི་རྣམ་པ་བཞིར། །\",\"tail\":\"བཤད་པས་དེ་ཉིད་བསྒྲུབ་པའོ། །\"},{\"label\":\"QUOTE\",\"frame\":\"ཡོན་ཏན་རིན་པོ་ཆེ་སྡུད་པ་ལས།\",\"head\":\"གལ་ཏེ་བྱང་ཆུབ་སེམས་དཔའ་ཏིང་འཛིན་བསམ་\",\"tail\":\"སངས་རྒྱས་ཡོན་ཏན་ཡོངས་ཉམས་མཉན་པ་གྲུ་ཞིག་བཞིན། །\"},{\"label\":\"QUOTE\",\"head\":\"རྟོགས་པར་དཀའ་བ་རང་གི་སེམས་\",\"tail\":\"ཡུམ་དྲན་པའི་ལྷ་མོས་སྐྱབ་ཏུ་གསོལ། །\"},{\"label\":\"QUOTE\",\"frame\":\"རྒྱུད་བླ་མ་ལས།\",\"head\":\"ཕྲ་ཕྱིར་ཐོས་པའི་ཡུལ་མིན་ཏེ། །\",\"tail\":\"སྒོམ་པ་ལ་སོགས་ཡུལ་མ་ཡིན། །\"},{\"label\":\"QUOTE\",\"frame\":\"སྡུད་པར།\",\"head\":\"ཇི་སྲིད་དགེ་བའི་རྩ་བ་དེ་ནི་མ་རྫོགས་\",\"tail\":\"དེ་སྲིད་སྟོང་ཉིད་དམ་པ་དེ་ནི་རྟོགས་མི་འགྱུར། །\"},{\"label\":\"QUOTE\",\"frame\":\"མདོ་སྡེ་རྒྱན་ལས།\",\"head\":\"བྱང་ཆུབ་ལ་ནི་ཉེ་བ་དང༌། །\",\"tail\":\"དེ་ཕྱིར་རབ་དགའ་ཞེས་བྱའོ། །\"},{\"label\":\"QUOTE\",\"frame\":\"འཕགས་པ་སྡུད་པ་ལས།\",\"head\":\"ཆུ་ཡི་ཐིག་པ་བུམ་པ་དང་པོ་ཐ་མའི་བར། །\",\"tail\":\"རིམ་གྱིས་དཀར་པོའི་ཡོན་ཏན་རྫོགས་པའི་སངས་རྒྱས་འགྱུར། །\"},{\"label\":\"QUOTE\",\"frame\":\"མངོན་རྟོགས་རྒྱན་ལས་ཀྱང༌།\",\"head\":\"སེམས་ནི་སྔ་མས་བྱང་ཆུབ་བར། །\",\"tail\":\"རིགས་མིན་ཕྱི་མས་ཀྱང་མ་ཡིན། །\"},{\"label\":\"QUOTE\",\"frame\":\"སློབ་དཔོན་ཨརྻ་དེ་བས།\",\"head\":\"ཇི་ལྟར་ཤིང་ལ་གནས་པའི་མེ། །\",\"tail\":\"འདིར་ནི་བྱང་ཆུ