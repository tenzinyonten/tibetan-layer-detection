  "raw_text": "{\"spans\":[{\"label\":\"QUOTE\",\"frame\":\"རྒྱལ་ཚབ་མི་ཕམ་མགོན་གྱིས་མདོ་སྡེ་རྒྱན་དུ།\",\"head\":\"བྱང་ཆུབ་སེམས་དཔའ་རྟག་ཏུ་ནི། །ཁྱིམ་པ་འཁོར་ལོས་\",\"tail\":\"སྐྱེ་བ་ཐམས་ཅད་དུ། །སེམས་ཅན་རྣམས་ཀྱི་དོན་བྱེད་དོ། །\"},{\"label\":\"QUOTE\",\"frame\":\"མངོན་པ་མཛོད་ལས།\",\"head\":\"འཁོར་ལོས་བསྒྱུར་བ་འབྱུང་བ་ནི། །སྟོང་ཕྲག་བརྒྱད་ཅུ་ལས་མི་འཕྱི། །\",\"tail\":\"\"},{\"label\":\"QUOTE\",\"frame\":\"མཛོད་ལས།\",\"head\":\"གསེར་དངུལ་ཟངས་ལྕགས་འཁོར་ལོ་ཅན། །དེ་དག་གླིང་གཅིག་གླིང་གཉིས་དང་། །\",\"tail\":\"གསུམ་དང་བཞི་ལ་མས་རིམ་བཞིན། །\"},{\"label\":\"QUOTE\",\"frame\":\"དབང་སྒྱུར་ཚུལ་ནི།\",\"head\":\"ཕས་བསུ་རང་འགྲོ་གཡུལ་བཤམས་དང་། །མཚོན་བརྩམས་པས་རྒྱལ་གནོད་པ་མེད། །\",\"tail\":\"\"},{\"label\":\"QUOTE\",\"frame\":\"མཛོད་འགྲེལ་ལས།\",\"head\":\"དེ་དག་ལ་སྐྱེས་བུ་ཆེན་པོའི་མཚན་སུམ་ཅུ་རྩ་གཉིས་ཀྱང་ཡོད་དེ། དཔེར་ན་སངས་རྒྱས་རྣམས་ཀྱི་བཞིན་ནོ། །\",\"tail\":\"\"},{\"label\":\"QUOTE\",\"frame\":\"མངོན་འབྱུང་ལས།\",\"head\":\"མཚན་མི་གསལ་དང་ལྡན་ན་མིའི་དབང་པོ། །གླིང་བཞི་རྣམས་ཀྱི་དབང་ཕྱུག་\",\"tail\":\"མི་མཆོག་སངས་རྒྱས་ཆོས་འཁོར་བསྐོར་བར་འགྱུར། །\"},{\"label\":\"QUOTE\",\"frame\":\"མཛོད་ལས་ཀྱང་།\",\"head\":\"ཐུབ་མཚན་ཡུལ་ལ་གནས་པ་དང་། །གསལ་བར་རྫོགས་པས་འཕགས་པ་ཡིན། །\",\"tail\":\"\"},{\"label\":\"QUOTE\",\"frame\":\"རྒྱ་ཆེ་རོལ་པ་ལས།\",\"head\":\"འཁོར་ལོ་སྒྱུར་བའི་རྒྱལ་པོ་མཐའ་བཞི་ལས་རྣམ་པར་རྒྱལ་བ་ཆོས་དང་ལྡན་པ་\",\"tail\":\"རྟ་མཆོག་རིན་པོ་ཆེ་དང་། བློན་པོ་རིན་པོ་ཆེ་དང་བདུན་ནོ། །\"},{\"label\":\"QUOTE\",\"frame\":\"མངོན་འབྱུང་གི་མདོ་ལས།\",\"head\":\"ལྷ་རྫས་ལས་གྲུབ་ལྟེ་བ་ཤིན་ཏུ་ཟླུམ། །རྩིབས་སྟོང་ལྡན་ཞིང་\",\"tail\":\"སྡང་བའི་དགྲ་ལས་རྣམ་པར་རྒྱལ་གྱུར་པའི། །འཁོར་ལོ་རིན་ཆེན། །\"},{\"label\":\"QUOTE\",\"frame\":\"མངོན་འབྱུང་ལས།\",\"head\":\"ཡན་ལག་ཐམས་ཅད་ལེགས་པར་སྐྱེས་པ་ནི། །རབ་གནས་གངས་ཅན་\",\"tail\":\"རྒྱལ་པོ་ལ་འོས་མཁའ་ལ་རབ་འགྲོ་བའི། །རིན་ཆེན་མཆོག་དེ་འདི་ཡིས་ཐོབ་པར་འགྱུར། །\"},{\"label\":\"QUOTE\",\"frame\":\"མངོན་འབྱུང་ལས།\",\"head\":\"ཐོ་རེངས་དུས་སུ་ཕྱོགས་རྣམས་མ་ལུས་པའི། །ས་རྣམས་བསྐོར་\",\"tail\":\"རྨ་བྱའི་མགྲིན་པའི་སྤུ་ལྟར་ཡིད་འོང་བའི། །རྟ་མཆོག་རིན་ཆེན་འདི་ཡིས་ཐོབ་པར་འགྱུར། །\"},{\"label\":\"QUOTE\",\"frame\":\"མངོན་འབྱུང་གི་མདོ་ལས།\",\"head\":\"གཟུགས་མཛེས་ལྟ་ན་སྡུག་ཅིང་ཚུལ་བཟང་མ། །པགས་པའི་མདོག་\",\"tail\":\"ཡིད་འོང་འདོད་དགུའི་རེག་བྱ་དང་ལྡན་པའི། །བཙུན་མོ། །\"},{\"label\":\"QUOTE\",\"frame\":\"མངོན་འབྱུང་ལས།\",\"head\":\"རིན་ཆེན་ངོ་བོ་ལྷ་རྫས་བཻ་ཌཱུརྱ། །ཀུན་ཏུ་དཔག་ཚད་ཙམ་དུ་སྣང་བྱེད་\",\"tail\":\"དྲི་མེད་ཉིན་མོ་ཇི་བཞིན་མཚན་དེ་བཞིན། །ནོར་བུ་རིན་ཆེན་དེ་འདིས་ཐོབ་པར་འགྱུར། །\"},{\"label\":\"QUOTE\",\"frame\":\"མངོན་འབྱུང་ལས།\",\"head\":\"གང་ཡང་རྒྱལ་ལ་མུ་ཏིག་མདངས་ལྡན་པས། །གསེར་སོགས་མང་པོ་\",\"tail\":\"བཟོད་ལྡན་མཚུངས་པའི་ཁྱིམ་བདག་ནོར་ལྡན་ཏེ། །བློན་པོ་རིན་ཆེན་འདི་ཡིས་ཐོབ་པར་འགྱུར། །\"},{\"label\":\"QUOTE\",\"frame\":\"མངོན་འབྱུང་ལས།\",\"head\":\"འགྲོ་དང་ལྡོག་དང་ཀུན་ནས་འོང་གྱུར་པའི། །མ་ལུས་བདུད་དཔུང་\",\"tail\":\"དཔའ་བརྟན་འབྱོར་པའི་དཔུང་དང་བཅས་པ་ཡི། །དམག་དཔོན་རིན་ཆེན། །\"},{\"label\":\"QUOTE\",\"frame\":\"གཞན་ཡང་མངོན་འབྱུང་ལས།\",\"head\":\"དཔའ་ཞིང་བརྟུལ་ཕོད་ཡན་ལག་མཆོག་གཟུགས་ལྡན། །བུ་སྟོང་དག་ནི་འདི་ལ་འབྱུང་འགྱུར་ཞིང་། །\",\"tail\":\"\"},{\"label\":\"QUOTE\",\"frame\":\"སློབ་དཔོན་ར་བྷ་ས་ན་རེ།\",\"head\":\"སྒེག་པ་དཔའ་བ་མི་སྡུག་པ། །རྒོད་དང་དྲག་ཤུལ་འཇིགས་སུ་རུང་། །\",\"tail\":\"སྙིང་རྗེ་རྔམ་དང་ཞི་བ་དང་། །མཉེས་གཤིན་པ་སྟེ་ཉམས་བཅུའོ། །\"},{\"label\":\"QUOTE\",\"frame\":\"མདོ་ལས།\",\"head\":\"ཚད་མེད་ཤིང་ངན་ལས་བྱས་དང་། །བརྡུངས་པས་སྒྲ་ནི་མི་འབྱུང་བ། །\",\"tail\":\"སངས་རྒྱས་ཡུམ་འདི་བརྡུངས་པ་ན། །ཡུལ་འཁོར་འཚེ་བ་ངེས་པར་འབྱུང་། །\"},{\"label\":\"QUOTE\",\"frame\":\"དེས་ན་མདོ་ལས།\",\"head\":\"ཚད་ནི་ཆུ་རུ་སོར་ཚད་ཀྱི། །བརྒྱད་ཅུ་རྩ་བཞི་ཉིད་བྱ་ཞིང་། །\",\"tail\":\"\"},{\"label\":\"QUOTE\",\"frame\":\"དེའང་མདོ་ལས།\",\"head\":\"གླུ་བདུན་གྱིས་ནི་བརྒྱན་པ་ལྟར། །བསྐྱེད་པའི་རིམ་པས་བརྡུང་བར་བྱ། །\",\"tail\":\"\"},{\"label\":\"QUOTE\",\"frame\":\"རྒྱུད་བླར།\",\"head\":\"སྤྲོ་དང་སྟོན་ལ་བཞིན་གུས་དང་། །\",\"tail\":\"\"},{\"label\":\"QUOTE\",\"head\":\"སྤུ་ཡི་རྩེ་མོ་གཅིག་ལ་ཡང་། །ཞིང་རྣམས་བྱེ་བྲག་བསམ་མི་ཁྱབ། །དེ་དག་འདྲེས་པར་གྱུར་པ་མེད། །\",\"tail\":\"\"},{\"label\":\"QUOTE\",\"frame\":\"སྡོམ་འབྱུང་ལས།\",\"head\":\"སྙིང་གའི་ཆུ་སྐྱེས་དབུས་སོན་པ། །ཆུ་ཤིང་མེ་ཏོག་ལྟ་བུར་སྟོང་། །\",\"tail\":\"\"},{\"label\":\"QUOTE\",\"frame\":\"སློབ་དཔོན་ཡེ་ཤེས་རྡོ་རྗེས་ལང་གཤེགས་ཀྱི་གླེང་གཞིའི་འགྲེལ་པར་དྲངས་པ་ལྟར།\",\"head\":\"དྲུག་སྐྱེས་རྨ་བྱའི་སྒྲ་ལྟར་སྒྲོག །ཁྱུ་མཆོག་བ་ལང་སྐད་ཀྱིས་རྩོམ། །\",\"tail\":\"བློ་གསལ་རྟ་སྐད་ལྟ་བུར་འཚེར། །འཁོར་ཉན་གླང་པོ་སྒྲོག་པ་བཞིན། །\"},{\"label\":\"QUOTE\",\"frame\":\"སྔོན་གྱི་གཙུག་ལག་ལས།\",\"head\":\"རྩེ་མོ་རློམ་པར་བླང་བ་ནི། །ལྔ་པ་དང་ནི་བར་མའི་དབྱངས། །\",\"tail\":\"འཐབ་མོ་འཇིགས་དང་བཅས་པ་ལ། །བློ་གསལ་དབྱངས་ནི་བླང་བར་བྱ། །\"},{\"label\":\"QUOTE\",\"frame\":\"ཀླུ་སྒྲུབ་ཀྱིས།\",\"head\":\"མ་ཡི་ཐུག་མཐའ་རྒྱ་ཤུག་ཚིག་གུ་ཙམ། །རིལ་བུ་བསྒྲིལ་ཀྱང་ས་ཡིས་ལང་མི་འགྱུར། །\",\"tail\":\"\"},{\"label\":\"QUOTE\",\"frame\":\"ཏིང་ངེ་འཛིན་རྒྱལ་པོར།\",\"head\":\"ཇི་ལྟར་སྒྱུ་མ་མཁན་གྱིས་སྤྲུལ་པའི་གཟུགས་། །རྟ་དང་གླང་པོ་ཤིང་རྟ་\",\"tail\":\"དེ་ལ་ཇི་བཞིན་སྣང་བ་གང་ཡང་མེད། །ཆོས་རྣམས་ཐམས་ཅད་དེ་བཞིན་ཤེས་པར་གྱིས། །\"},{\"label\":\"QUOTE\",\"frame\":\"དུས་འཁོར་གྱི་མན་ངག་ལས།\",\"head\":\"ལུས་ངག་སེམས་ནི་དབེན་པ་ལས། །མི་རྟོག་ཏིང་འཛིན་སྐྱེ་བར་ངེས། །\",\"tail\":\"མི་རྟོག་ཏིང་འཛིན་སྐྱེས་པ་ཡིས། །མི་རྟོག་ཡེ་ཤེས་སྐྱེ་བར་འགྱུར། །\"},{\"label\":\"QUOTE\",\"frame\":\"སློབ་དཔོན་སངས་རྒྱས་གསང་བས་སྒྱུ་འཕྲུལ་ལམ་རིམ་དུའང་།\",\"head\":\"མི་དམིགས་ཤིན་ཏུ་མི་དམིགས་དང་། །རྗེས་སུ་མི་དམིགས་རིམ་པ་ཡིས། །\",\"tail\":\"དེ་ཉིད་རང་གསལ་མི་གཡོ་བ། །ཞི་གནས་ལྷག་མཐོང་ཟུང་དུ་འབྲེལ། །\"},{\"label\":\"QUOTE\",\"frame\":\"ཨ་ཏི་བཀོད་པ་ཆེན་པོ་ལས།\",\"head\":\"ཡིད་ཅན་རྣམས་ལ་སེམས་ཀྱི་སྡེ། །ནམ་མཁའ་ཅན་ལ་ཀློང་གི་སྡེ། །རིམ་རྩོལ་བྲལ་ལ་མན་ངག་སྡེ། །\",\"tail\":\"\"},{\"label\":\"QUOTE\",\"frame\":\"ཐལ་འགྱུར་ལས།\",\"head\":\"རང་བཞིན་དག་པ་ཆེན་པོའི་མཐའ། །ཆོས་རྣམས་རང་སར་བཞག་པ་སྟེ། །\",\"tail\":\"འགྱུ་ཟད་རྟོག་པ་མེད་པ་དང་། །བློ་ཟད་ཡིད་ལས་འདས་པའོ། །\"},{\"label\":\"QUOTE\",\"frame\":\"གསང་བ་སྒྲ་རྒྱུད་ལས།\",\"head\":\"སྔ་ཕྱི་དྲན་རྟོག་མེད་པ་ཡི། །རིག་གེ་སང་ངེ་སལ་ལེ་བ། །\",\"tail\":\"ད་ལྟའི་ཤེས་པ་འདི་ཉིད་ལ། །ཆོས་སྐུ་བཞི་ལྡན་ངོས་བཟུང་ངོ་། །\"},{\"label\":\"QUOTE\",\"frame\":\"གསང་བ་སྒྲ་རྒྱུད་ལས།\",\"head\":\"དེ་ལ་གདེངས་ཀྱིས་གྲོལ་བར་བཤད། །ཡེ་ནས་གྲོལ་བས་བསྐྱར་གཞི་མེད། །\",\"tail\":\"ཅེར་གྱིས་གྲོལ་བས་མཐོང་སར་ཡལ། །ཡོངས་སུ་གྲོལ་བས་འབད་མེད་པའོ། །\"},{\"label\":\"QUOTE\",\"frame\":\"མགོན་པོ་བྱམས་པས།\",\"head\":\"ཆོས་ལ་ཉེས་སྨོད་ཐུབ་པའི་གཞུང་ལས་བཀག །\",\"tail\":\"\"},{\"label\":\"QUOTE\",\"frame\":\"མགོན་པོ་བྱམས་པས།\",\"head\":\"དེ་ནི་རྟག་དང་བརྟན་ཕྱིར་དང་། །ཞི་བའི་ཕྱིར་དང་གཡུང་དྲུང་ཕྱིར། །\",\"tail\":\"\"}]}",
