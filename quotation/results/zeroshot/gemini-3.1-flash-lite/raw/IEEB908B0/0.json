  "raw_text": "{\"spans\": [{\"label\": \"QUOTE\", \"frame\": \"ཁྱད་པར་འཕགས་བསྟོད་ལས།\", \"head\": \"བྲམ་ཟེ་རྣམས་ནི་དགེ་སྡིག་དག །\", \"tail\": \"བྱས་པ་དང་ཕྲད་མེད་གསུངས། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཆེད་དུ་བརྗོད་པའི་ཚོམས་ལས།\", \"head\": \"སྲིད་པའི་ཟུག་རྔུ་གཅོད་བྱེད་ལམ། །ངས་ནི་ཁྱེད་ཅག་རྣམས་ལ་བསྟན། །\", \"tail\": \"དེ་བཞིན་གཤེགས་པ་སྟོན་པ་སྟེ། །ཁྱེད་ཅག་རྣམས་ཀྱིས་བྱ་དགོས་སོ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཏིང་འཛིན་རྒྱལ་པོ་ལས།\", \"head\": \"དེས་ནི་རབ་ཏུ་བཟང་པོའི་ཆོས་བཤད་ཀྱང༌། །\", \"tail\": \"ནད་པ་སྨན་གྱི་རྐྱལ་བ་ཐོགས་པ་དག །བདག་གི་ནད་ནི་གསོ་བར་མི་ནུས་བཞིན། །\"}, {\"label\": \"QUOTE\", \"frame\": \"དྲན་པ་ཉེར་བཞག་ལས།\", \"head\": \"དགེ་བ་ཡིས་ནི་བདེ་བ་ཐོབ། །\", \"tail\": \"དེ་ལྟར་དགེ་དང་མི་དགེ་བའི། །ལས་ཀྱི་འབྲས་བུ་གསལ་བར་བསྟན། །\"}, {\"label\": \"QUOTE\", \"frame\": \"དྲན་ཉེ་ལས།\", \"head\": \"ལུས་ཅན་རྣམས་ཀྱི་བདེ་སྡུག་ནི། །ལས་རྣམས་ཡིན་པར་ཐུབ་པས་གསུངས། །\", \"tail\": \"སྣ་ཚོགས་རྣམ་པར་འཁྱམས་ཤིང་འཇུག །ལས་ཀྱི་དྲ་བ་འདི་ཆེ་འོ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཆེད་དུ་བརྗོད་པའི་ཚོམས་ལས།\", \"head\": \"མཁའ་ལ་བྱ་དག་གནས་པ་དེའི། །\", \"tail\": \"ལེགས་པར་བྱས་དང་ཉེས་པར་བྱས། །དེ་དག་འགྲོ་བའི་རྗེས་སུ་འབྲངས། །\"}, {\"label\": \"QUOTE\", \"frame\": \"མདོ་དྲན་ཉེར་ལས།\", \"head\": \"ལུས་ཅན་རྣམས་ཀྱི་ལས་རྣམས་ནི། །\", \"tail\": \"ཚོགས་ཤིང་དུས་ལ་བབ་པ་ན། །འབྲས་བུ་ཉིད་དུ་སྨིན་པར་འགྱུར། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཏིང་རྒྱལ་ལས།\", \"head\": \"ཟླ་བ་སྐར་མ་ཞེས་པ་གནས་ལྟུང་ཞིང༌། །\", \"tail\": \"ནམ་མཁའི་ཁམས་ནི་རྣམ་པ་གཞན་གྱུར་ཀྱང༌། །ཁྱོད་ནི་མི་བདེན་པ་ཡི་ཚིག་མི་གསུང༌། །\"}, {\"label\": \"QUOTE\", \"frame\": \"དྲན་ཉེར་ལས།\", \"head\": \"མེ་ནི་གྲང་བར་འགྱུར་ཡང་སྲིད། །\", \"tail\": \"ཉི་ཟླ་ཐང་ལ་ལྷུང་ཡང་སྲིད། །ལས་ཀྱི་རྣམ་སྨིན་བསླུ་མི་སྲིད། །\"}, {\"label\": \"QUOTE\", \"frame\": \"སྤྱོད་འཇུག་ལས།\", \"head\": \"འདི་འདྲའི་དལ་བ་རྙེད་གྱུར་ནས། །\", \"tail\": \"དེ་ལས་བསླུས་པ་གཞན་མེད་དེ། །དེ་ལས་རྨོངས་པའང་གཞན་མེད་དོ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"སློབ་དཔོན་ཀླུ་སྒྲུབ་ཀྱིས།\", \"head\": \"འཐོབ་དཀའི་འཛམ་གླིང་མི་ཡི་ལུས། །དེ་ཐོབ་དུས་སུ་ངན་སོང་རྒྱུ། །\", \"tail\": \"རབ་ཏུ་བསྒྲིམ་སྟེ་བཅད་པར་བྱ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"མཛོད་ལས།\", \"head\": \"དེ་ལས་ཆེ་ལོང་བསྡུས་ནས་ནི། །དགེ་དང་མི་དགེ་ཅི་རིགས་པར། །\", \"tail\": \"ལས་ཀྱི་ལམ་ནི་བཅུར་གསུངས་སོ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཕར་ཕྱིན་བསྡུས་པ་ལས།\", \"head\": \"མཐོ་རིས་ཐར་པའི་བདེ་ལམ་གྱུར་པ་སྟེ། །ལས་ལམ་བཅུ་པོ་འདི་ལས་ཉམས་མི་བྱ། །\", \"tail\": \"མདོར་བསྡུས་ཚུལ་ཁྲིམས་ཡིན་ཞེས་རྒྱལ་བས་གསུངས། །\"}, {\"label\": \"QUOTE\", \"frame\": \"རྒྱ་མཚོས་ཞུས་པའི་མདོའི་དོན་བསྡུ་ན།\", \"head\": \"དགེ་བའི་ཆོས་རྣམས་ཞེས་བྱ་བ་ནི་ལྷ་མིའི་སྐྱེ་རྒུའི་ཕུན་སུམ་ཚོགས་པའི་རྩ་བའི་རྟེན་ནོ། །\", \"tail\": \"འདི་ལྟ་སྟེ། དགེ་བ་བཅུའི་ལས་རྣམས་ཏེ།\"}, {\"label\": \"QUOTE\", \"head\": \"དཔེར་ན་གྲོང་དང་ལྗོངས་ཡུལ་འཁོར། རྒྱལ་པོའི་ཕོ་བྲང༌། རྩ་ཤིང༌།\", \"tail\": \"སངས་རྒྱས་ཀྱི་ཆོས་ཐམས་ཅད་ཀྱི་གནས་ཡིན་ནོ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ས་བཅུའི་མདོ་ལས།\", \"head\": \"བཅུ་པོ་འདི་དག་འཁོར་བར་སྐྲག་ནས་སྙིང་རྗེ་དང་བྲལ་བར་གཞན་གྱི་སྒྲའི་རྗེས་སུ་འབྲང་བས་ནི་ཉན་ཐོས་ཀྱི་འབྲས་བུ་འཐོབ།\", \"tail\": \"རྣམ་པ་ཐམས་ཅད་དུ་ཆོས་སྦྱངས་ན་སངས་རྒྱས་ཀྱི་ཆོས་ཐམས་ཅད་འགྲུབ་\"}, {\"label\": \"QUOTE\", \"frame\": \"ཆགས་མེད་རིན་པོ་ཆེའི་ཞལ་ནས།\", \"head\": \"བསྐལ་པ་གྲངས་མེད་འདས་པའི་སྔོན་རོལ་དུ། །\", \"tail\": \"ལུས་ནི་མ་བླངས་བྱ་བ་གཅིག་ཀྱང་མེད། །\"}, {\"label\": \"QUOTE\", \"head\": \"དེ་ཚེ་སྡིག་སྒྲིབ་བསགས་པའི་ལས་ངན་ནི། །གཟུགས་སུ་གྲུབ་ན་ནམ་མཁར་མི་ཤོང་ཙམ། །\", \"tail\": \"བསྐལ་པ་བྱེ་བ་བརྒྱར་ཡང་ཆུད་མི་ཟ། །ནམ་ཞིག་རང་གི་ལུས་ལ་ངེས་པར་སྨིན། །\"}, {\"label\": \"QUOTE\", \"frame\": \"སྣ་ཚོགས་རང་གྲོལ་གྱི་ཞལ་ནས།\", \"head\": \"ཕུན་ཚོགས་རང་དབང་ཡོད་ཚེ་ལེ་ལོར་བསྡད། །\", \"tail\": \"བཟློག་མེད་འཆི་བདག་བྱུང་ཚེ་འགྱོད་པས་གཟིར། །\"}, {\"label\": \"QUOTE\", \"head\": \"ཚེ་འདི་གང་ཆོས་མིན་གྱི་དབང་བཏང་ནས། །\", \"tail\": \"རང་གདོང་ལ་རང་ཉིད་ཀྱིས་འཕྱར་ཚེ་འཕྱིས། །\"}, {\"label\": \"QUOTE\", \"frame\": \"བདེ་སྨོན་ལས།\", \"head\": \"འགྱོད་པ་མེད་ན་བཤགས་པས་མི་དག་པས། །\", \"tail\": \"ངོ་ཚ་འཇིགས་སྐྲག་འགྱོད་པ་ཆེན་པོས་བཤགས། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཆགས་མེད་རིན་པོ་ཆེས།\", \"head\": \"ཆུར་ལོན་ཞེས་པ་ཆུ་རགས་བརྩིགས་པའི་མིང༌། །\", \"tail\": \"སེམས་ལ་དམ་བཅའ་དྲག་པོའི་རག་བརྩིག་གོ །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཆགས་མེད་རིན་པོ་ཆེས།\", \"head\": \"སྡིག་པ་བྱས་ཀྱང་སྐྱོན་མེད་བཤགས་ཆོག་བསམ། །\", \"tail\": \"དེ་བཞིན་བཤགས་ཀྱང་དག་པར་མི་འགྱུར་གསུངས། །\"}, {\"label\": \"QUOTE\", \"frame\": \"བདེ་སྨོན་ལས།\", \"head\": \"ཕྱིན་ཆད་སྡོམ་སེམས་མེད་ན་མི་དག་པས། །\", \"tail\": \"ད་ནི་མི་བྱེད་སེམས་ལ་དམ་བཅའ་བཟུང༌། །\"}, {\"label\": \"QUOTE\", \"frame\": \"བདེ་སྨོན་ལས།\", \"head\": \"སངས་རྒྱས་སྤྱན་གྱིས་ཉིན་མཚན་དུས་དྲུག་ཏུ། །\", \"tail\": \"རྟག་ཏུ་མ་འདྲེས་སོ་སོར་སྙན་ལ་གསན། །\"}, {\"label\": \"QUOTE\", \"frame\": \"འཇམ་དཔལ་ལས།\", \"head\": \"མཆོད་འོས་བསྟོད་འོས་ཕྱག་གི་གནས། །\", \"tail\": \"ཕྱག་བྱར་འོས་པ་བླ་མའི་རབ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"བདེན་པ་པོའི་ལེའུ་ལས།\", \"head\": \"ཐུབ་པའི་ཐུགས་རྗེ་ཆེན་པོ་རྟག་འབྱུང་སྟེ། །\", \"tail\": \"དེ་མི་འབྱུང་བ་ནམ་ཡང་སྲིད་མ་ཡིན། །\"}, {\"label\": \"QUOTE\", \"frame\": \"མདོ་ལས།\", \"head\": \"གང་ཞིག་འགྱོད་ཚངས་བྱེད་འདོད་ན། །\", \"tail\": \"དེ་ནི་འགྱོད་ཚངས་མཆོག་ཡིན་ནོ། །\"}, {\"label\": \"QUOTE\", \"frame\": \"སྐྱེས་རབས་ལས།\", \"head\": \"དགེ་དང་མི་དགེའི་ལས་རྣམས་གོམས་བྱས་པས། །\", \"tail\": \"དེ་ལྟ་བུ་དག་ཆེད་དུ་མ་བསྒྲིམས་ཀྱང༌། །ཚེ་རབས་གཞན་ལ་རྨི་ལམ་བཞིན་དུ་སྤྱོད། །\"}, {\"label\": \"QUOTE\", \"frame\": \"ཚོམས་ལས།\", \"head\": \"བདག་ཉིད་བདེ་བ་འཐོབ་འདོད་ཅིང༌། །\", \"tail\": \"སྡིག་ལས་དེ་ཡི་རྣམ་སྨིན་དག །ངུ་ཞིང་ཉམས་སུ་མྱོང་བར་འགྱུར། །\"}, {\"label\": \"QUOTE\", \"frame\": \"དེ་ཉིད་ལས།\", \"head\": \"གལ་ཏེ་སྡིག་པའི་ལས་བྱས་སམ། །\", \"tail\": \"ཀོག་ཅེས་ལངས་ཏེ་བྲོས་ན་ཡང༌། །སྡིག་བསྔལ་ལས་ནི་ཐར་མི་འགྱུར། །\"}, {\"label\": \"QUOTE\", \"frame\": \"རྣམ་འབྱེད་ལས།\", \"head\": \"ངག་རྣམས་བསྲུང་ཞིང་ཡིད་ཀྱིས་རབ་བསྡམས་ཏེ། །\", \"tail\": \"ལས་ལམ་གསུམ་པོ་འདི་དག་རབ་སྦྱངས་ནས། །དྲང་སྲོང་གསུངས་པའི་ལམ་ནི་འཐོབ་པར་འགྱུར། །\"}]}",
