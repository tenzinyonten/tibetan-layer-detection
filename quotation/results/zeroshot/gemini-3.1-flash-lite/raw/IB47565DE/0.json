  "raw_text": "{\"spans\": [{\"label\": \"QUOTE\", \"frame\": \"ཇི་སྐད་དུ།\", \"head\": \"རྣམ་རྟོག་མ་རིག་ཆེན་པོ་སྟེ། །འཁོར་བའི་རྒྱ་མཚོར་ལྟུང་བྱེད་ཡིན། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཇི་སྐད་དུ།\", \"head\": \"དང་པོར་མ་ཡིན་ཉིད་དག་ནི། ནད་པའི་ཕྱིར།\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཞེས་གསུངས་ཏེ།\", \"head\": \"མ་རིག་ནས་བརྩམས་རྒ་ཤིའི་བར། །ཁོ་བོ་རྨི་ལམ་སྒྱུ་འདྲར་འདོད། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཞེས་གསུངས་སོ། །\", \"head\": \"སྲིད་པ་དང་ཞི་བ་ནི་རང་བཞིན་མེད་པར་མཉམ་པ་ཡིན་གྱི་ཡོན་ཏན་གྱིས་མཉམ་པ་ནི་མིན་ནོ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཞེས་གསུངས་སོ། །\", \"head\": \"གང་གང་ཡོངས་སུ་གོམས་གྱུར་པ། །གོམས་པ་ཡོངས་སུ་རྫོགས་པ་ན། །དེ་གསལ་མི་རྟོག་འབྲས་བུ་ཅན། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཞེས་གསུངས་སོ། །\", \"head\": \"སྟོང་པ་ཉིད་དང་བྲལ་བའི་སེམས། །འགགས་པ་སླར་ཡང་སྐྱེ་འགྱུར་ཏེ། །འདུ་ཤེས་མེད་པའི་སྙོམས་འཇུག་བཞིན། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཞེས་པ་དང་།\", \"head\": \"རྗེས་སུ་འབྲེལ་ལ་ཕྱིན་ཅི་ལོག །རྗེས་སུ་འབྲེལ་བཅས་ཟློག་པ་དང་། །ཕྱིན་ཅི་མ་ལོག་ཕྱིན་ཅི་ལོག །རྗེས་སུ་འབྲེལ་མེད་སྒོམ་པའོ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཞེས་གསུངས་སོ། །\", \"head\": \"སོ་སོ་སྐྱེ་བོ་ཕྱིན་ཅི་ལོག །བདེན་པ་མཐོང་བ་ཟློག་པ་སྟེ། །དེ་བཞིན་གསུངས་སོ། །བདེན་པ་མཐོང་བ་ཟློག་པ་སྟེ། །དེ་བཞིན་གཤེགས་པ་ཇི་ལྟ་བཞིན། །ཕྱིན་ཅི་མ་ལོག་སྤྲོས་མེད་ཉིད། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཇི་སྐད་དུ།\", \"head\": \"རྣམ་རྟོག་མ་རིག་ཆེན་པོ་སྟེ། །འཁོར་བའི་རྒྱ་མཚོར་ལྟུང་བྱེད་ཡིན། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཞེས་སོ། །\", \"head\": \"སེམས་ཀྱི་གླང་པོ་ཡན་པ་འདི། །དམིགས་པའི་ཀ་བ་བརྟན་པོ་ལ། །དྲན་པའི་ཐག་པས་ངེས་བཅིངས་ཏེ། །ཤེས་རབ་ལྕགས་ཀྱུས་རང་དབང་བྱ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཞེས་སོ། །\", \"head\": \"གྲོལ་བའི་དོན་དུ་སྒོམ་གཙོ་ཕྱིར། །སྒོམ་པའི་སེམས་ལ་སྒོམ་ཕྱིར་རོ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"སྤྱོད་འཇུག་ལས།\", \"head\": \"གང་ནས་བཟུང་སྟེ་སེམས་ཅན་ཁམས། །མཐའ་ཡས་རབ་ཏུ་བསྒྲལ་བའི་ཕྱིར། །མི་ལྡོག་པ་ཡི་སེམས་ཀྱིས་སུ། །སེམས་དེ་ཡང་དག་བླངས་གྱུར་ན། །དེ་ནས་བཟུང་སྟེ་གཉིད་ལོག་གམ། །བག་མེད་གྱུར་ཀྱང་བསོད་ནམས་ཤུགས། །རྒྱུན་མི་ཆད་པ་དུ་མ་ཞིག །ནམ་མཁའ་མཉམ་པ་རབ་ཏུ་འབྱུང་། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཞེས་སོགས་གསུངས་པའི་དོན་གྱི་སྒོམ་ཚུལ་ལོ། །\", \"head\": \"དམིགས་པ་མི་རྟག་ལ་སོགས་པ། །བདེན་པའི་རྟེན་ཅན། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཞེས་གསུངས་པའི་དོན་ཡིན་ནོ། །\", \"head\": \"ཤེས་རབ་ཀྱིས་ནི་ཡོངས་རྟོག་པ། །ཐམས་ཅད་དམིགས་སུ་མེད་པར་རོ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཞེས་འབྱུང་བ་ལྟར།\", \"head\": \"སེམས་ཀྱི་གཡེང་བ་ཆུང་ངུ་ནི། །བློ་ལྡན་རྣམས་ཀྱིས་ཤེས་པར་བྱ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཞེས་གསུངས་སོ། །\", \"head\": \"རྗེས་སུ་འབྲེལ་ལ་ཕྱིན་ཅི་ལོག །རྗེས་སུ་འབྲེལ་བཅས་ཟློག་པ་དང་། །ཕྱིན་ཅི་མ་ལོག་ཕྱིན་ཅི་ལོག །རྗེས་སུ་འབྲེལ་མེད་སྒོམ་པའོ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཞེས་གསུངས་སོ། །\", \"head\": \"སོ་སོ་སྐྱེ་བོ་ཕྱིན་ཅི་ལོག །བདེན་པ་མཐོང་བ་ཟློག་པ་སྟེ། །དེ་བཞིན་གཤེགས་པ་ཇི་ལྟ་བཞིན། །ཕྱིན་ཅི་མ་ལོག་སྤྲོས་མེད་ཉིད། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཞེས་སོ། །\", \"head\": \"གལ་ཏེ་ཆོས་ལ་བདག་མེད་སོ་སོར་རྟོག །སོ་སོར་དེར་རྟོག་མྱ་ངན་འདས་ཐོབ་རྒྱུ། །རྒྱུ་གཞན་གྱིས་ནི་སྡུག་བསྔལ་ཞི་མི་འགྱུར། །ལྷག་སྤྱོད་ཀྱིས་ནི་ཏིང་འཛིན་བསྒོམས་པ་བཞིན། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཞེས་སོ། །\", \"head\": \"ཏིང་འཛིན་དེ་ཡི་བྱེད་པ་ཉིད། །ལུང་སྟོན་པ་དང་རློམ་པ་ཟད། །གསུམ་པོ་ཕན་ཚུན་ངོ་བོ་གཅིག །ཏིང་འཛིན་རྣམ་པར་མི་རྟོག་པ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཞེས་གསུངས་པ་ལྟར་རོ། །\", \"head\": \"བུ་རམ་རང་བཞིན་མངར་བ་དང་། །མེ་ཡི་རང་བཞིན་ཚ་བ་ལྟར། །དེ་བཞིན་ཆོས་རྣམས་ཐམས་ཅད་ཀྱི། །རང་བཞིན་སྟོང་པ་ཉིད་དུ་གཅིག །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཞེས་སོ། །\", \"head\": \"གལ་ཏེ་སྟོང་མིན་ཅུང་ཟད་ཡོད། །སྟོང་པ་ཅུང་ཟད་ཡོད་པར་འགྱུར། །མི་སྟོང་ཅུང་ཟད་ཡོད་མིན་ན། །སྟོང་པ་ཡོད་པར་ག་ལ་འགྱུར། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཞེས་གསུངས་སོ། །\", \"head\": \"ཀུན་རྟོག་ཐམས་ཅད་གཞོམ་པའི་ཕྱིར། །སྟོང་ཉིད་བདུད་རྩི་བསྟན་པར་མཛད། །གང་ལ་དེ་ལ་འཛིན་ཡོད་པ། །དེ་ནི་ཁྱོད་ཀྱིས་སྨད་པར་མཛད། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཞེས་སོ། །\", \"head\": \"སེམས་མི་རྟོག་པར་འགྱུར་ཏེ། རྡོ་རྗེ་ཟླ་བ་རྟོགས་ནས་ནི། །སེམས་ལ་དམིགས་པ་ཐོབ་པར་འགྱུར། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཞེས་སོ། །\", \"head\": \"ཐམས་ཅད་མཁྱེན་པར་དེ་གནས་འགྱུར། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཞེས་སོ། །\", \"head\": \"བཟླས་བརྗོད་དང་ནི་དཀའ་ཐུབ་ཀུན། །ཡུན་རིང་དུས་སུ་སྤྱད་བྱས་ཀྱང་། །སེམས་གཞན་གཡེང་བས་བྱས་པ་ནི། །དེ་ཉིད་རིག་པས་དོན་མེད་གསུངས། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"མཛོད་ལས།\", \"head\": \"གང་གི་གསུམ་ལ་སྐྱབས་འགྲོ་བ། །སངས་རྒྱས་དགེ་འདུན་བྱེད་པའི་ཆོས། །སློབ་དང་མི་སློབ་གཉིས་ཀ་དང་། །མྱ་ངན་འདས་ལ་སྐྱབས་སུ་འགྲོ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཞེས་དང་།\", \"head\": \"འདུས་མ་བྱས་ཤིང་ལྷུན་གྱིས་གྲུབ། །གཞན་གྱི་རྐྱེན་གྱིས་རྟོགས་མིན་པ། །མཁྱེན་དང་བརྩེ་དང་ནུས་པར་ལྡན། །དོན་གཉིས་ལྡན་པའི་སངས་རྒྱས་ཉིད། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཞེས་དང་།\", \"head\": \"བསམ་མེད་གཉིས་མེད་རྟོག་མེད་དང་། །དག་བསལ་གཉེན་པོའི་ཕྱོགས་ཉིད་ཀྱི། །གང་ཞིག་གང་གིས་ཆགས་བྲལ་བ། །བདེན་གཉིས་མཚན་ཉིད་ཅན་དེ་ཆོས། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཞེས་དང་།\", \"head\": \"ཇི་ལྟ་ཇི་སྙེད་ནང་གི་ནི། །ཡེ་ཤེས་གཟིགས་པ་དག་པའི་ཕྱིར། །བློ་ལྡན་ཕྱིར་མི་ལྡོག་པའི་ཚོགས། །བླ་མེད་ཡོན་ཏན་དང་ལྡན་ཉིད། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཞེས་དང་།\", \"head\": \"འབྱུང་བ་དཀོན་ཕྱིར་དྲི་མེད་ཕྱིར། །རྒྱན་གྱུར་ཕྱིར་དང་མཆོག་ཉིད་ཕྱིར། །འགྱུར་བ་མེད་ཕྱིར་དཀོན་མཆོག་ཉིད། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"སྤྱོད་འཇུག་ལས།\", \"head\": \"གང་ནས་བཟུང་སྟེ་སེམས་ཅན་ཁམས། །མཐའ་ཡས་རབ་ཏུ་བསྒྲལ་བའི་ཕྱིར། །མི་ལྡོག་པ་ཡི་སེམས་ཀྱིས་སུ། །སེམས་དེ་ཡང་དག་བླངས་གྱུར་ན། །དེ་ནས་བཟུང་སྟེ་གཉིད་ལོག་གམ། །བག་མེད་གྱུར་ཀྱང་བསོད་ནམས་ཤུགས། །རྒྱུན་མི་ཆད་པ་དུ་མ་ཞིག །ནམ་མཁའ་མཉམ་པ་རབ་ཏུ་འབྱུང་། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཞེས་པའི་དོན་ནོ། །\", \"head\": \"གཟུགས་སྟོང་པའོ་\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཞེས་གསུངས་སོ། །\", \"head\": \"ཡང་དག་རྣམ་པར་རྟོག་པ་གང་། །དེ་ནི་སྟོན་པས་མ་རིག་གསུངས། །དེ་ལས་ཡན་ལག་བཅུ་གཉིས་འབྱུང་། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཞེས་གསུངས་སོ། །\", \"head\": \"འཇིག་རྟེན་ཁམས་ནི་སྟོང་ཕྲག་ཏུ། །ང་ཡིས་མདོ་ནི་གང་གསུངས་པ། །ཡི་གེ་ཐ་དད་དོན་གཅིག་སྟེ། །ཡོངས་སུ་བསྒྲགས་པ་ནུས་མ་ཡིན། །མི་གང་དོན་ལ་མཁས་རྣམས་ཀྱིས། །དངོས་པོ་གཅིག་ནི་བསམ་བྱས་ན། །དེ་དག་ཐམས་ཅད་བསྒོམ་གྱུར་ཏེ། །ཆོས་རྣམས་ཀུན་གྱི་བདག་མེད་ཡིན། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཞེས་པའོ། །\", \"head\": \"གཏན་ཚིགས་ཆེན་པོ་ལྔ་\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཞེས་སོགས་གསུངས་པའི་དོན་ལེགས་པར་བཟུང་ངོ་། །\", \"head\": \"དམིགས་པ་ཆོས་རྣམས་ཐམས་ཅད་དེ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཞེས་སོ། །\", \"head\": \"ཆོས་ལ་ཁོང་ཁྲོ་བདག་ལྟ་དང་། །འཁོར་བའི་སྡུག་བསྔལ་གྱིས་འཇིགས་དང་། །སེམས་ཅན་དོན་ལ་ལྟོས་མེད་ཉིད། །འདོད་ཆེན་མུ་སྟེགས་ཉན་ཐོས་དང་། །རང་བྱུང་རྣམས་ཀྱི་སྒྲིབ་རྣམ་བཞི། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཞེས་པའོ། །\", \"head\": \"ཐེག་མཆོག་ལ་མོས་ས་བོན་ཤེས་རབ་ནི། །སངས་རྒྱས་ཆོས་སྐྱེད་མ་དང་བསམ་གཏན་གྱི། །བདེ་བའི་མངལ་གནས་སྙིང་རྗེའི་མ་མ་ཅན། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཞེས་པ་མདོར་བསྟན་རྒྱས་བཤད་ཀྱིས་བསྟན་ནོ། །\", \"head\": \"གཙང་བདག་བདེ་དང་རྟག་ཉིད་ཀྱིས། །ཡོན་ཏན་ཕ་རོལ་ཕྱིན་པ་འབྲས། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཇི་སྐད་དུ།\", \"head\": \"ཆོས་སྒྲུབ་པ་ཡི་ཐབས་རྣམས་ནི། །མདོར་ན་དད་དང་ཤེས་རབ་བོ། །དད་ཅན་ཉིད་ཕྱིར་ཆོས་ལ་བརྟེན། །ཤེས་རབ་ལྡན་ཕྱིར་ཡང་དག་རིག །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཞེས་སོ། །\", \"head\": \"མངོན་མཐོའི་རྒྱུ་ནི་ཚུལ་ཁྲིམས་ལས་གཞན་མེད། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཞེས་སོ། །\", \"head\": \"གལ་ཏེ་ཕུང་པོ་བདག་ཡིན་ནོ། །སྐྱེ་དང་འཇིགས་པ་ཅན་དུ་འགྱུར། །གལ་ཏེ་ཕུང་པོ་རྣམས་ལས་གཞན། །ཕུང་པོ་མཚན་ཉིད་མེད་པར་འགྱུར། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཞེས་སོ། །\", \"head\": \"ལས་དང་ཉོན་མོངས་ཟད་པས་ཐར། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཞེས་པའོ། །\", \"head\": \"གལ་ཏེ་སྟོང་མིན་ཅུང་ཟད་ཡོད། །སྟོང་པ་ཅུང་ཟད་ཡོད་པར་འགྱུར། །མི་སྟོང་ཅུང་ཟད་ཡོད་མིན་ན། །སྟོང་པ་ཡོད་པར་ག་ལ་འགྱུར། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཞེས་སོ། །\", \"head\": \"གང་ཞིག་སྐྱེ་དང་འཇིག་པ་དག །འདི་ཡིས་ཚུལ་གྱི་སྤངས་གྱུར་པ། །རྟེན་ཅིང་འབྲེལ་འབྱུང་གསུངས་པ་ཡི། །ཐུབ་དབང་དེ་ལ་ཕྱག་འཚལ་ལོ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཞེས་སོ། །\", \"head\": \"གང་ཞིག་སྟོང་དང་རྟེན་འབྱུང་བ། །དབུ་མའི་ལམ་དུ་དོན་གཅིག་པར། །གསུང་མཆོག་མཚུངས་པ་མེད་པ་ཡི། །སངས་རྒྱས་དེ་ལ་ཕྱག་འཚལ་ལོ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཞེས་སོ། །\", \"head\": \"དེ་ཕྱིར་རྟེན་འབྱུང་རིགས་པ་འདི་ཡིས་ནི། །ལྟ་ངན་དྲྭ་བ་མཐའ་དག་གཅོད་པར་བྱེད། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཞེས་སོ། །\", \"head\": \"གལ་ཏེ་སྟོང་མིན་ཅུང་ཟད་ཡོད། །སྟོང་པའང་ཅུང་ཟད་ཡོད་པར་འགྱུར། །མི་སྟོང་ཅུང་ཟད་ཡོད་མིན་ན། །སྟོང་པའང་ཡོད་པར་ག་ལ་འགྱུར། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཞེས་སོ། །\", \"head\": \"གང་ལ་སྟོང་པ་ཉིད་ལྟ་བ། །དེ་དག་སྒྲུབ་དུ་མེད་པར་གསུངས། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཞེས་སོ། །\", \"head\": \"གལ་ཏེ་སྟོང་མིན་ཅུང་ཟད་ཡོད། །སྟོང་པའང་ཅུང་ཟད་ཡོད་པར་འགྱུར། །མི་སྟོང་ཅུང་ཟད་ཡོད་མིན་ན། །སྟོང་པའང་ཡོད་པར་ག་ལ་འགྱུར། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཞེས་སོ། །\", \"head\": \"ཀུན་རྟོག་ཐམས་ཅད་གཞོམ་པའི་ཕྱིར། །སྟོང་ཉིད་བདུད་རྩི་བསྟན་པར་མཛད། །གང་ལ་དེ་ལ་འཛིན་ཡོད་པ། །དེ་ནི་ཁྱོད་ཀྱིས་སྨད་པར་མཛད། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཞེས་སོ། །\", \"head\": \"གང་ལ་སྟོང་པ་ཉིད་ལྟ་བ། །དེ་དག་སྒྲུབ་དུ་མེད་པར་གསུངས། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཞེས་སོ། །\", \"head\": \"གང་ཕྱིར་དེ་ལྟར་ཟབ་པའི་ཆོས། །སྣོད་མིན་འགྲོ་ལ་མི་གསུང་བ། །ཀུན་མཁྱེན་ཐམས་ཅད་མཁྱེན་པས་ཤེས། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཞེས་སོ། །\", \"head\": \"ཉེས་པ་རྣམ་པ་ཐམས་ཅད་དག །འཇིག་ཚོགས་ལྟ་ལས་སྐྱེས་པ་ཡིན། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཞེས་སོ། །\", \"head\": \"ཉེས་པ་རྣམ་པ་ཐམས་ཅད་དག །འཇིག་ཚོགས་ལྟ་ལས་སྐྱེས་པ་ཡིན། །དེ་མ་རིག་དང་དེ་ལ་ཆགས། །དེ་ལས་ཞེ་སྡང་ལ་སོགས་འབྱུང་། །དེ་ཉིད་ཀྱིས་ན་ཉེས་རྣམས་ཀྱི། །རྒྱུ་ནི་གཏི་མུག་ཡིན་པར་གསུངས། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཞེས་སོ། །\", \"head\": \"བདག་མེད་བདག་དང་འགལ་བས་ན། །བདག་མེད་རྟོགས་པས་དེ་སུན་འབྱིན། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཞེས་སོ། །\", \"head\": \"འདི་ཡུལ་སུན་དབྱུང་མེད་པར་ནི། །དེ་སྤོང་བར་ནི་ནུས་མ་ཡིན། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཞེས་སོ། །\", \"head\": \"གང་ཞིག་སྐྱེ་དང་འཇིག་པ་དག །འདི་ཡིས་ཚུལ་གྱི་སྤངས་གྱུར་པ། །རྟེན་ཅིང་འབྲེལ་འབྱུང་གསུངས་པ་ཡི། །ཐུབ་དབང་དེ་ལ་ཕྱག་འཚལ་ལོ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཞེས་སོ། །\", \"head\": \"གང་ཞིག་སྟོང་དང་རྟེན་འབྱུང་བ། །དབུ་མའི་ལམ་དུ་དོན་གཅིག་པར། །གསུང་མཆོག་མཚུངས་པ་མེད་པ་ཡི། །སངས་རྒྱས་དེ་ལ་ཕྱག་འཚལ་ལོ། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཞེས་སོ། །\", \"head\": \"དེ་ཕྱིར་རྟེན་འབྱུང་རིགས་པ་འདི་ཡིས་ནི། །ལྟ་ངན་དྲྭ་བ་མཐའ་དག་གཅོད་པར་བྱེད། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཞེས་སོ། །\", \"head\": \"གལ་ཏེ་སྟོང་མིན་ཅུང་ཟད་ཡོད། །སྟོང་པའང་ཅུང་ཟད་ཡོད་པར་འགྱུར། །མི་སྟོང་ཅུང་ཟད་ཡོད་མིན་ན། །སྟོང་པའང་ཡོད་པར་ག་ལ་འགྱུར། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཞེས་སོ། །\", \"head\": \"གང་ལ་སྟོང་པ་ཉིད་ལྟ་བ། །དེ་དག་སྒྲུབ་དུ་མེད་པར་གསུངས། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཞེས་སོ། །\", \"head\": \"གལ་ཏེ་སྟོང་མིན་ཅུང་ཟད་ཡོད། །སྟོང་པའང་ཅུང་ཟད་ཡོད་པར་འགྱུར། །མི་སྟོང་ཅུང་ཟད་ཡོད་མིན་ན། །སྟོང་པའང་ཡོད་པར་ག་ལ་འགྱུར། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཞེས་སོ། །\", \"head\": \"ཀུན་རྟོག་ཐམས་ཅད་གཞོམ་པའི་ཕྱིར། །སྟོང་ཉིད་བདུད་རྩི་བསྟན་པར་མཛད། །གང་ལ་དེ་ལ་འཛིན་ཡོད་པ། །དེ་ནི་ཁྱོད་ཀྱིས་སྨད་པར་མཛད། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཞེས་སོ། །\", \"head\": \"གང་ལ་སྟོང་པ་ཉིད་ལྟ་བ། །དེ་དག་སྒྲུབ་དུ་མེད་པར་གསུངས། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཞེས་སོ། །\", \"head\": \"གལ་ཏེ་སྟོང་མིན་ཅུང་ཟད་ཡོད། །སྟོང་པའང་ཅུང་ཟད་ཡོད་པར་འགྱུར། །མི་སྟོང་ཅུང་ཟད་ཡོད་མིན་ན། །སྟོང་པའང་ཡོད་པར་ག་ལ་འགྱུར། །\", \"tail\": \"\"}, {\"label\": \"QUOTE\", \"frame\": \"ཞ